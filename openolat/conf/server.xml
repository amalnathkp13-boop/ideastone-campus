<?xml version="1.0" encoding="UTF-8"?>
<Server port="-1" shutdown="SHUTDOWN">
  <Service name="Catalina">
    <Connector port="8088" protocol="HTTP/1.1" connectionTimeout="20000"
               URIEncoding="UTF-8" maxHttpHeaderSize="16384" maxPostSize="-1"/>
    <Engine name="Catalina" defaultHost="localhost">
      <Host name="localhost" appBase="webapps" unpackWARs="false" autoDeploy="false" deployOnStartup="false">
        <Valve className="org.apache.catalina.valves.AccessLogValve" directory="logs"
               prefix="access" suffix=".log" pattern="%h %l %u %t &quot;%r&quot; %s %b %D"/>
      </Host>
    </Engine>
  </Service>
</Server>
