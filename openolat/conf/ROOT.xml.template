<?xml version="1.0" encoding="UTF-8"?>
<!-- Tomcat context for OpenOlat: deploys the exploded WAR at / and exposes the JNDI datasource -->
<Context docBase="/home/openolat/webapp" reloadable="false">
  <Resource name="jdbc/openolatDS" auth="Container" type="javax.sql.DataSource"
            driverClassName="org.postgresql.Driver"
            url="jdbc:postgresql://${DB_HOST}:5432/${DB_NAME}"
            username="${DB_USER}" password="${DB_PASSWORD}"
            maxTotal="100" maxIdle="30" maxWaitMillis="10000"
            validationQuery="SELECT 1" testOnBorrow="true"/>
</Context>
