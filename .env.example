# Copy to .env and change the passwords before any non-local deployment.
POSTGRES_USER=campus
POSTGRES_PASSWORD=campus

ODOO_DB=campus
ODOO_ADMIN_PASSWORD=admin
# true = load OpenEduCat demo data (students, courses, fees) for client demos
ODOO_DEMO=true
# true = upgrade the Ideastone modules automatically on start whenever the code changed (after git pull)
CAMPUS_AUTO_UPGRADE=true

# Public address of the platform (what users type in the browser). Everything
# — ERP, /lms/ and /sso/ — is served from this one address.
CAMPUS_DOMAIN=localhost
CAMPUS_PORT=80
CAMPUS_PUBLIC_URL=http://localhost

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
