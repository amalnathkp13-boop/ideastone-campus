{
  "realm": "campus",
  "enabled": true,
  "displayName": "Ideastone Campus",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {"name": "admin", "description": "College administration"},
      {"name": "faculty", "description": "Teaching staff"},
      {"name": "student"},
      {"name": "parent"}
    ]
  },
  "clients": [
    {
      "clientId": "odoo",
      "name": "Ideastone Campus ERP (Odoo)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": true,
      "redirectUris": ["http://localhost:8069/*", "http://campus.local/*"],
      "webOrigins": ["+"]
    },
    {
      "clientId": "openolat",
      "name": "Ideastone Campus LMS (OpenOlat)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "change-me-openolat-secret",
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:8088/*", "http://lms.campus.local/*"],
      "webOrigins": ["+"]
    }
  ],
  "users": [
    {
      "username": "demo.admin", "enabled": true, "firstName": "Campus", "lastName": "Admin",
      "email": "admin@campus.local", "emailVerified": true,
      "credentials": [{"type": "password", "value": "demo1234", "temporary": false}],
      "realmRoles": ["admin"]
    },
    {
      "username": "demo.faculty", "enabled": true, "firstName": "Priya", "lastName": "Raman",
      "email": "faculty@campus.local", "emailVerified": true,
      "credentials": [{"type": "password", "value": "demo1234", "temporary": false}],
      "realmRoles": ["faculty"]
    },
    {
      "username": "demo.student", "enabled": true, "firstName": "Arun", "lastName": "Kumar",
      "email": "student@campus.local", "emailVerified": true,
      "credentials": [{"type": "password", "value": "demo1234", "temporary": false}],
      "realmRoles": ["student"]
    }
  ]
}
