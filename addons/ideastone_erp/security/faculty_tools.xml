    <field name="model_id" ref="model_campus_student_leave_routing"/>
    <field name="groups" eval="[(4,ref('group_manager'))]"/>
    <field name="domain_force">[(1,'=',1)]</field>
  </record>
  <record id="acl_faculty_own_payslip" model="ir.model.access">
    <field name="name">Faculty own payslip</field>
    <field name="model_id" ref="model_campus_payslip"/>
    <field name="group_id" ref="openeducat_core.group_op_faculty"/>
    <field name="perm_read" eval="True"/>
  </record>
  <record id="rule_faculty_own_payslip" model="ir.rule">
    <field name="name">Faculty own payslip</field>
    <field name="model_id" ref="model_campus_payslip"/>
    <field name="groups" eval="[(4,ref('openeducat_core.group_op_faculty'))]"/>
    <field name="domain_force">[('employee_id.user_id','=',user.id),('state','in',['approved','done'])]</field>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>
