<odoo>
  <record id="acl_faculty_timetable_read" model="ir.model.access">
    <field name="name">Faculty own timetable read</field>
    <field name="model_id" ref="openeducat_timetable.model_op_session"/>
    <field name="group_id" ref="openeducat_core.group_op_faculty"/>
    <field name="perm_read" eval="True"/>
  </record>
  <record id="rule_faculty_timetable_boundary" model="ir.rule">
    <field name="name">Faculty timetable allocation boundary</field>
    <field name="model_id" ref="openeducat_timetable.model_op_session"/>
    <field name="domain_force">[(1,'=',1)] if user.has_group('openeducat_timetable.group_op_timetable_manager') or user.has_group('ideastone_erp.group_mvp_registrar') or not user.has_group('openeducat_core.group_op_faculty') else [('faculty_id.user_id','=',user.id)]</field>
  </record>
  <record id="rule_faculty_timetable_college" model="ir.rule">
    <field name="name">Timetable college boundary</field>
    <field name="model_id" ref="openeducat_timetable.model_op_session"/>
    <field name="domain_force">[('company_id','in',company_ids)]</field>
  </record>
  <record id="access_student_education" model="ir.model.access">
    <field name="name">Faculty previous academic information</field>
    <field name="model_id" ref="model_campus_student_education"/>
    <field name="group_id" ref="openeducat_core.group_op_faculty"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="True"/>
    <field name="perm_create" eval="True"/>
    <field name="perm_unlink" eval="True"/>
  </record>
  <record id="rule_student_education_owner" model="ir.rule">
    <field name="name">Personal previous academic information and college</field>
    <field name="model_id" ref="model_campus_student_education"/>
    <field name="domain_force">[('user_id','=',user.id),('company_id','in',company_ids)]</field>
  </record>
  <record id="access_faculty_activity" model="ir.model.access">
