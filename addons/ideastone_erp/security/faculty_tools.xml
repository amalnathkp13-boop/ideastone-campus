  <record id="acl_student_leave_internal" model="ir.model.access">
    <field name="name">Assigned student leave reviewers</field>
    <field name="model_id" ref="model_campus_student_leave"/>
    <field name="group_id" ref="base.group_user"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="True"/>
    <field name="perm_create" eval="True"/>
    <field name="perm_unlink" eval="True"/>
  </record>
  <record id="rule_student_leave_assigned" model="ir.rule">
    <field name="name">Student leave assigned reviewers and college</field>
    <field name="model_id" ref="model_campus_student_leave"/>
    <field name="domain_force">[('company_id','in',company_ids),'|','|','|',('user_id','=',user.id),('advisor_id','=',user.id),('hod_id','=',user.id),('principal_id','=',user.id)]</field>
  </record>
  <record id="rule_leave_routing_college" model="ir.rule">
    <field name="name">Student leave routing college</field>
