  </record>
  <record id="rule_leave_routing_faculty" model="ir.rule">
    <field name="name">Faculty assigned leave routing</field>
    <field name="model_id" ref="model_campus_student_leave_routing"/>
    <field name="groups" eval="[(4,ref('openeducat_core.group_op_faculty'))]"/>
    <field name="domain_force">['|','|',('advisor_id','=',user.id),('hod_id','=',user.id),('principal_id','=',user.id)]</field>
  </record>
  <record id="acl_leave_routing_group_college_admin" model="ir.model.access">
