<odoo>
  <record id="category_campus" model="ir.module.category"><field name="name">Campus Operations</field><field name="sequence">12</field></record>
  <record id="group_directory" model="res.groups"><field name="name">Campus directory reader</field><field name="category_id" ref="base.module_category_hidden"/><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record><record id="group_academic" model="res.groups"><field name="name">Academic operator</field><field name="category_id" ref="category_campus"/><field name="implied_ids" eval="[(4, ref('group_directory')), (4, ref('base.group_user'))]"/></record>
  <record id="group_services" model="res.groups"><field name="name">Campus services operator</field><field name="category_id" ref="category_campus"/><field name="implied_ids" eval="[(4, ref('group_directory')), (4, ref('base.group_user'))]"/></record>
  <record id="group_people" model="res.groups"><field name="name">HR and payroll operator</field><field name="category_id" ref="category_campus"/><field name="implied_ids" eval="[(4, ref('group_directory')), (4, ref('hr.group_hr_user')), (4, ref('hr_attendance.group_hr_attendance_manager')), (4, ref('hr_holidays.group_hr_holidays_user'))]"/></record>
  <record id="group_outreach" model="res.groups"><field name="name">Placement and alumni operator</field><field name="category_id" ref="category_campus"/><field name="implied_ids" eval="[(4, ref('group_directory')), (4, ref('base.group_user'))]"/></record>
  <record id="group_purchasing" model="res.groups"><field name="name">Purchasing operator</field><field name="category_id" ref="category_campus"/><field name="implied_ids" eval="[(4, ref('group_directory')), (4, ref('purchase.group_purchase_user')), (4, ref('stock.group_stock_user')), (4, ref('maintenance.group_equipment_manager'))]"/></record>
  <record id="group_finance" model="res.groups"><field name="name">Finance reviewer</field><field name="category_id" ref="category_campus"/><field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/></record>
  <record id="group_manager" model="res.groups"><field name="name">Campus manager</field><field name="category_id" ref="category_campus"/><field name="implied_ids" eval="[(4, ref('group_academic')), (4, ref('group_services')), (4, ref('group_people')), (4, ref('group_outreach')), (4, ref('group_purchasing')), (4, ref('group_finance')), (4, ref('openeducat_core.group_op_back_office'))]"/><field name="users" eval="[(4, ref('base.user_admin'))]"/></record>
</odoo>
