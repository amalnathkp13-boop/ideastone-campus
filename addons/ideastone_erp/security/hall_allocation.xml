<odoo>
    <record id="hall_company_rule" model="ir.rule">
        <field name="name">Hall inventory college boundary</field><field name="model_id" ref="model_campus_hall"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="global" eval="True"/>
    </record>
    <record id="hall_booking_company_rule" model="ir.rule">
        <field name="name">Hall requests college boundary</field><field name="model_id" ref="model_campus_hall_booking"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="global" eval="True"/>
    </record>
    <record id="hall_booking_hod_rule" model="ir.rule">
        <field name="name">HOD own department hall requests</field><field name="model_id" ref="model_campus_hall_booking"/>
        <field name="groups" eval="[(4, ref('group_mvp_hod'))]"/>
        <field name="domain_force">[('department_id', '=', user.dept_id.id)]</field>
    </record>
    <record id="hall_booking_authority_rule" model="ir.rule">
        <field name="name">Assigned hall allocation authority</field><field name="model_id" ref="model_campus_hall_booking"/>
        <field name="groups" eval="[(4, ref('group_services'))]"/>
        <field name="domain_force">[('hall_id.authority_id', '=', user.id)]</field>
    </record>
    <record id="hall_booking_manager_rule" model="ir.rule">
        <field name="name">Campus manager hall allocation register</field><field name="model_id" ref="model_campus_hall_booking"/>
        <field name="groups" eval="[(4, ref('group_manager'))]"/><field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
