<odoo>
  <record id="student_request_type_registrar" model="ir.model.access"><field name="name">Student request catalogue registrar</field><field name="model_id" ref="model_campus_student_request_type"/><field name="group_id" ref="group_mvp_registrar"/><field name="perm_read" eval="True"/><field name="perm_write" eval="True"/><field name="perm_create" eval="True"/></record>
  <record id="student_request_type_services" model="ir.model.access"><field name="name">Student request catalogue reader</field><field name="model_id" ref="model_campus_student_request_type"/><field name="group_id" ref="group_services"/><field name="perm_read" eval="True"/></record>
  <record id="student_request_events_registrar" model="ir.model.access"><field name="name">Student request history registrar</field><field name="model_id" ref="model_campus_student_request_event"/><field name="group_id" ref="group_mvp_registrar"/><field name="perm_read" eval="True"/></record>
  <record id="student_request_events_services" model="ir.model.access"><field name="name">Student request history services</field><field name="model_id" ref="model_campus_student_request_event"/><field name="group_id" ref="group_services"/><field name="perm_read" eval="True"/></record>
  <record id="student_requests_registrar" model="ir.model.access"><field name="name">Student requests registrar</field><field name="model_id" ref="model_campus_service_request"/><field name="group_id" ref="group_mvp_registrar"/><field name="perm_read" eval="True"/><field name="perm_write" eval="True"/><field name="perm_create" eval="True"/></record>
  <record id="student_type_company" model="ir.rule"><field name="name">Request types in permitted college</field><field name="model_id" ref="model_campus_student_request_type"/><field name="domain_force">['|',('company_id','=',False),('company_id','in',company_ids)]</field></record>
  <record id="student_type_write_company" model="ir.rule"><field name="name">Catalogue writes belong to the college; global templates are read only</field><field name="model_id" ref="model_campus_student_request_type"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="perm_read" eval="False"/></record>
  <record id="student_event_company" model="ir.rule"><field name="name">Student request events in permitted college</field><field name="model_id" ref="model_campus_student_request_event"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
</odoo>
