<odoo>
  <record id="calendar_event_admin_access" model="ir.model.access">
    <field name="name">College calendar admin</field><field name="model_id" ref="model_campus_calendar_event"/>
    <field name="group_id" ref="group_mvp_registrar"/>
    <field name="perm_read" eval="True"/><field name="perm_create" eval="True"/><field name="perm_write" eval="True"/>
    <field name="perm_unlink" eval="False"/>
  </record>
  <record id="calendar_event_readonly_access" model="ir.model.access">
    <field name="name">College calendar management read only</field><field name="model_id" ref="model_campus_calendar_event"/>
    <field name="group_id" ref="group_mvp_readonly"/>
    <field name="perm_read" eval="True"/><field name="perm_create" eval="False"/><field name="perm_write" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>
  <record id="calendar_event_college_rule" model="ir.rule">
    <field name="name">Calendar events in the active college</field>
    <field name="model_id" ref="model_campus_calendar_event"/>
    <field name="domain_force">[('company_id', '=', company_id)]</field>
  </record>
</odoo>
