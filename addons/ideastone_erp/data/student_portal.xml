<odoo noupdate="1">
  <record id="student_request_sequence" model="ir.sequence"><field name="name">Student request reference</field><field name="code">campus.student.request</field><field name="prefix">REQ/%(year)s/</field><field name="padding">6</field><field name="company_id" eval="False"/></record>
  <record id="student_request_bonafide" model="campus.student.request.type"><field name="name">Bonafide certificate</field><field name="code">bonafide</field><field name="company_id" eval="False"/><field name="guidance">Describe the certificate purpose and intended recipient. The college office reviews and issues the official document.</field></record>
  <record id="student_request_id" model="campus.student.request.type"><field name="name">ID card replacement</field><field name="code">id_replacement</field><field name="company_id" eval="False"/><field name="guidance">Explain why a replacement is required. The college office will confirm any processing requirements.</field></record>
  <record id="student_request_transcript" model="campus.student.request.type"><field name="name">Transcript / marks memo</field><field name="code">transcript</field><field name="company_id" eval="False"/><field name="guidance">Specify the academic periods and purpose. Only documents issued by authorized college staff become available here.</field></record>
  <record id="student_request_profile" model="campus.student.request.type"><field name="name">Profile correction</field><field name="code">profile_correction</field><field name="kind">grievance</field><field name="company_id" eval="False"/><field name="guidance">State the incorrect field and the requested correction. Attach supporting evidence when available. Official records remain locked until college review.</field></record>
  <record id="student_request_attendance" model="campus.student.request.type"><field name="name">Attendance correction</field><field name="code">attendance_correction</field><field name="kind">grievance</field><field name="company_id" eval="False"/><field name="guidance">Identify the class date, subject and the correction requested. Faculty or authorized staff must verify the official attendance record.</field></record>
  <record id="student_request_support" model="campus.student.request.type"><field name="name">Student support / other request</field><field name="code">support</field><field name="kind">grievance</field><field name="company_id" eval="False"/><field name="guidance">Explain the problem and the help needed. Do not include passwords or payment secrets.</field></record>
</odoo>
