<?xml version='1.0' encoding='utf-8'?>
<odoo noupdate="1">
  <record id="campus_student_sequence" model="ir.sequence">
    <field name="name">College student numbers</field>
    <field name="code">campus.student</field>
    <field name="prefix">STU/%(year)s/</field>
    <field name="padding">6</field>
    <field name="company_id" eval="False" />
  </record>
  <record id="campus_receipt_sequence" model="ir.sequence">
    <field name="name">College payment receipts</field>
    <field name="code">campus.receipt</field>
    <field name="prefix">RCPT/%(year)s/</field>
    <field name="padding">6</field>
    <field name="company_id" eval="False" />
  </record>
  <record id="mvp_notice_publication" model="ir.cron">
    <field name="name">Publish and expire college notices</field>
    <field name="model_id" ref="model_campus_circular" />
    <field name="state">code</field>
    <field name="code">model._cron_publish_notices()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
    <field name="numbercall">-1</field>
  </record>
</odoo>