<odoo>
  <record id="student_notice_priority_form" model="ir.ui.view"><field name="name">Student notice priority</field><field name="model">campus.circular</field><field name="inherit_id" ref="ideastone_erp.mvp_notices_form"/><field name="arch" type="xml"><xpath expr="//field[@name='campus_category']" position="after"><field name="campus_portal_priority"/></xpath></field></record>
  <record id="student_notice_priority_legacy" model="ir.ui.view"><field name="name">Circular student priority</field><field name="model">campus.circular</field><field name="inherit_id" ref="ideastone_erp.view_circular_form"/><field name="arch" type="xml"><xpath expr="//field[@name='audience']" position="after"><field name="campus_portal_priority" readonly="state in ('approved', 'done')"/></xpath></field></record>
  <template id="student_notices_workspace" inherit_id="ideastone_erp.student_workspace" name="Student notices center content">
    <xpath expr="//t[@t-elif=&quot;section == 'notices'&quot;][@t-call]" position="attributes"><attribute name="t-call">ideastone_erp.student_notices_content</attribute></xpath>
    <xpath expr="//nav[hasclass('student_subnav')]/a[@t-else]" position="before"><t t-elif="section == 'notices'"><a href="#student_notices_overview">Overview</a><a href="#student_notice_list">Notices &amp; Circulars</a><a href="#student_college_events">College Events</a><a href="#student_academic_calendar">Academic Calendar</a></t></xpath>
  </template>
  <template id="student_notice_card">
    <article class="notice-card" t-att-data-notice-record="'true' if not preview else None" t-att-data-category="n['category']" t-att-data-priority="n['priority']"><span t-att-class="'notice-icon ' + ('urgent' if n['priority'] == 'important' else 'violet' if n['category'].lower() in ['event', 'student life', 'cultural'] else 'green' if n['category'].lower() in ['placement', 'sports'] else '')"><i t-att-class="'fa fa-' + ('exclamation' if n['priority'] == 'important' else 'file-text-o')" aria-hidden="true"/></span><div><h3 class="notice-title" t-esc="n['name']"/><p t-if="preview" class="notice-desc" t-esc="n['summary']"/><div t-else="" class="notice-desc notice-body" t-out="notice_body(n['body'])"/><div class="meta"><span><t t-esc="n['category']"/> · <t t-esc="n['date']"/></span><span>Audience: <t t-esc="n['audience']"/></span><span t-if="not preview">Notice ID: <t t-esc="n['reference']"/></span><span t-if="not preview and n['expires']">Valid through <t t-esc="n['expires']"/></span></div><div t-if="not preview" class="notice-attachments"><a t-foreach="n['files']" t-as="file" t-att-href="'/my/campus/student/download/notice/%s' % file['id']"><i class="fa fa-paperclip" aria-hidden="true"/> <t t-esc="file['name']"/></a></div><form t-if="not preview" class="notice-read-form" method="post" action="/my/campus/student/action"><t t-call="ideastone_erp.student_action_fields"/><input type="hidden" name="operation" value="notice"/><input type="hidden" name="return_to" value="notices"/><input type="hidden" name="notice_id" t-att-value="n['id']"/><input type="hidden" name="read" t-att-value="'false' if n['read'] else 'true'"/><button type="submit" class="btn light" t-esc="'Mark unread' if n['read'] else 'Mark read'"/><span class="small subtle" t-esc="'Read' if n['read'] else 'Unread'"/></form></div><span t-att-class="'badge ' + n['tone']" t-esc="n['priority_label'] if n['priority'] != 'general' else 'New' if not n['read'] else 'General'"/></article>
  </template>
  <template id="student_notices_content" name="Student Notices and Calendar">
    <t t-set="u" t-value="d['notice_ui']"/><t t-set="preview" t-value="False"/>
    <div class="notices_view" t-att-data-today="d['today_iso']">
      <section id="student_notices_overview" data-notices-page="overview"><div class="pagehead"><div><h1>Notices &amp; Calendar</h1><p>Stay informed about college announcements, academic dates, campus activities and student life.</p></div><span class="pill"><i class="fa fa-calendar-o" aria-hidden="true"/> <t t-esc="d['placement']['programme']"/> · <t t-esc="d['placement']['section']"/></span></div>
        <div class="kpis"><article class="kpi"><span class="kicon"><i class="fa fa-file-text-o" aria-hidden="true"/></span><div class="kpi-label">Active notices</div><div class="value" t-esc="len(u['notices'])"/><div class="foot">Published announcements for your audience</div></article><article class="kpi violet"><span class="kicon"><i class="fa fa-star-o" aria-hidden="true"/></span><div class="kpi-label">Upcoming events</div><div class="value" t-esc="len(u['events'])"/><div class="foot">Published upcoming and ongoing college events</div></article><article class="kpi green"><span class="kicon"><i class="fa fa-calendar" aria-hidden="true"/></span><div class="kpi-label">This month</div><div class="value" t-esc="u['this_month']"/><div class="foot">Events and released examination dates</div></article><article class="kpi amber"><span class="kicon"><i class="fa fa-clock-o" aria-hidden="true"/></span><div class="kpi-label">Next scheduled date</div><div class="value next-date" t-esc="u['next']['when'].split(',')[0] if u['next'] else 'Not scheduled'"/><div class="foot" t-esc="u['next']['name'] if u['next'] else 'No upcoming dates have been released'"/></article></div>
        <div class="grid2"><section class="panel"><div class="panel-head"><div><h2>Important notices</h2><p class="small subtle section-note">Priority announcements relevant to students</p></div><a class="btn" href="#student_notice_list">View all notices →</a></div><t t-foreach="u['important']" t-as="n"><t t-call="ideastone_erp.student_notice_card"><t t-set="preview" t-value="True"/></t></t><p t-if="not u['important']" class="empty">No current notices are published for your student audience.</p></section><section class="panel"><div class="panel-head"><h2>Coming up next</h2><a class="btn" href="#student_academic_calendar">Open calendar</a></div><article t-foreach="u['upcoming']" t-as="item" class="list-row"><div t-att-class="'datebox ' + item['tone']"><t t-esc="item['month']"/><strong t-esc="item['number']"/></div><div><h3 t-esc="item['name']"/><p><t t-esc="item['when']"/> · <t t-esc="item['category']"/></p><p t-if="item['location']" t-esc="item['location']"/></div></article><p t-if="not u['upcoming']" class="empty">No upcoming events or released exam dates are available.</p><div class="callout overview-callout"><i class="fa fa-info-circle" aria-hidden="true"/><div><strong>Published dates</strong><p>Events come from the college's published event listings. Examination dates appear only after release by the examination office.</p></div></div></section></div>
        <section class="panel"><div class="panel-head"><div><h2>Explore campus life</h2><p class="small subtle section-note">Discover the types of activities your college may publish.</p></div></div><div class="category-grid"><article class="category"><span class="cicon"><i class="fa fa-music" aria-hidden="true"/></span><h3>Cultural &amp; entertainment</h3><p>College day, music, dance, drama, student talent and cultural celebrations.</p></article><article class="category"><span class="cicon sports"><i class="fa fa-trophy" aria-hidden="true"/></span><h3>Sports &amp; fitness</h3><p>Department tournaments, athletics, yoga, fitness challenges and team trials.</p></article><article class="category"><span class="cicon culture"><i class="fa fa-lightbulb-o" aria-hidden="true"/></span><h3>Technical &amp; innovation</h3><p>Hackathons, coding contests, project expos, robotics and technical fests.</p></article><article class="category"><span class="cicon deadline"><i class="fa fa-microphone" aria-hidden="true"/></span><h3>Learning &amp; careers</h3><p>Lectures, workshops, placement talks, alumni sessions and industry visits.</p></article><article class="category"><span class="cicon"><i class="fa fa-users" aria-hidden="true"/></span><h3>Clubs &amp; volunteering</h3><p>Outreach, student council, literary club, photography and associations.</p></article><article class="category"><span class="cicon pink"><i class="fa fa-leaf" aria-hidden="true"/></span><h3>Wellbeing &amp; community</h3><p>Health awareness, sustainability drives and community programmes.</p></article><article class="category"><span class="cicon sports"><i class="fa fa-book" aria-hidden="true"/></span><h3>Academic dates</h3><p>Released examination schedules and official academic announcements.</p></article><article class="category"><span class="cicon deadline"><i class="fa fa-star-o" aria-hidden="true"/></span><h3>Campus celebrations</h3><p>Freshers' day, farewell, department day and annual celebrations.</p></article></div></section>
      </section>

      <section id="student_notice_list" data-notices-page="notices" hidden="hidden"><div class="pagehead"><div><h1>Notices &amp; Circulars</h1><p>Official announcements and student-facing circulars in one searchable list.</p></div><span class="pill">Published communications</span></div><div class="filterbox"><div class="filters"><label class="field">Notice category<select data-notices-filter="category"><option value="all">All categories</option><option t-foreach="u['categories']" t-as="category" t-att-value="category" t-esc="category"/></select></label><label class="field">Priority<select data-notices-filter="priority"><option value="all">All priorities</option><option value="important">Important</option><option value="action">Action</option><option value="general">General</option></select></label><label class="field">Search notices<input type="search" data-notices-filter="search" placeholder="Title or keyword"/></label><div class="filter-actions"><button type="button" class="btn primary" data-notices-apply="notices">Apply</button><button type="button" class="btn" data-notices-reset="notices">Reset</button></div></div></div><section class="panel"><div class="panel-head"><div><h2>Published notices</h2><p class="small subtle section-note">Use priority and category filters to find relevant updates.</p></div><span class="pill green"><t t-esc="len(u['notices'])"/> published notices</span></div><div><t t-foreach="u['notices']" t-as="n"><t t-call="ideastone_erp.student_notice_card"/></t></div><p class="empty" data-notices-empty="notices" t-att-hidden="'hidden' if u['notices'] else None" t-esc="'No notices match these filters.' if u['notices'] else 'No current notices are published for your student audience.'"/></section><div class="callout"><i class="fa fa-info-circle" aria-hidden="true"/><div><strong>Notice authenticity</strong><p>These notices have passed the college publication workflow and match your audience. Use the listed reference and effective dates when contacting the college office.</p></div></div></section>

      <section id="student_college_events" data-notices-page="events" hidden="hidden"><div class="pagehead"><div><h1>College Events</h1><p>Discover published campus programmes, cultural activities, sports and learning events.</p></div><span class="pill violet">Student life &amp; activities</span></div><div class="filterbox"><div class="filters"><label class="field">Event category<select data-events-filter="category"><option value="all">All categories</option><option t-foreach="u['event_categories']" t-as="category" t-att-value="category" t-esc="category"/></select></label><label class="field">When<select data-events-filter="period"><option value="all">All upcoming</option><option t-foreach="u['periods']" t-as="period" t-att-value="period[0]" t-esc="period[1]"/></select></label><label class="field">Find an event<input type="search" data-events-filter="search" placeholder="Search title, venue, activity"/></label><div class="filter-actions"><button type="button" class="btn primary" data-notices-apply="events">Apply</button><button type="button" class="btn" data-notices-reset="events">Reset</button></div></div></div><div class="grid3"><article t-foreach="u['events']" t-as="e" class="event-card" data-event-record="" t-att-data-category="e['category']" t-att-data-period="e['period']"><div t-att-class="'event-banner ' + e['theme']"><div class="event-date"><t t-esc="e['month']"/><strong t-esc="e['number']"/></div><span t-att-class="'badge ' + ('new' if e['tone'] == 'sports' else 'event' if e['tone'] == 'culture' else 'soon' if e['theme'] == 'orange' else 'general')" t-esc="e['category']"/></div><div class="event-body"><h3 t-esc="e['name']"/><p t-esc="e['summary'] or 'See the published event details for the full programme.'"/><div class="event-details"><div><i class="fa fa-clock-o" aria-hidden="true"/><span><b t-esc="e['when']"/> – <t t-esc="e['end']"/></span></div><div><i class="fa fa-map-marker" aria-hidden="true"/><span><b t-esc="e['location']"/></span></div><div><i class="fa fa-users" aria-hidden="true"/><span t-esc="e['organizer']"/></div></div><div class="event-actions"><details class="event-description"><summary class="btn primary">Event details</summary><div class="notice-body" t-out="notice_body(e['description'])"/></details><button type="button" class="btn" data-event-ics="" t-att-data-key="e['key']" t-att-data-title="e['name']" t-att-data-start="e['start_utc']" t-att-data-end="e['end_utc']" t-att-data-location="e['location']">Add to calendar</button></div></div></article></div><p class="empty" data-notices-empty="events" t-att-hidden="'hidden' if u['events'] else None" t-esc="'No events match your search.' if u['events'] else 'No upcoming college events have been published.'"/><div class="callout event-callout"><i class="fa fa-info-circle" aria-hidden="true"/><div><strong>Event updates</strong><p>Times are shown in <t t-esc="d['timezone']"/>. Check the latest published details before attending. Add to calendar downloads a calendar file; it does not register you or save an in-app reminder.</p></div></div></section>

      <section id="student_academic_calendar" data-notices-page="calendar" hidden="hidden"><div class="pagehead"><div><h1>Academic Calendar</h1><p>View released examinations alongside published campus events and student activities.</p></div><span class="pill" data-notices-month-label=""/></div><div class="calendar-layout"><section class="panel"><div class="calendar-toolbar"><button type="button" class="btn" data-notices-month="prev">← Previous</button><h2 data-notices-month-title=""/><button type="button" class="btn" data-notices-month="next">Next →</button></div><div class="calendar-scroll" tabindex="0" aria-label="Monthly calendar; scroll horizontally on smaller screens"><div class="month-grid" data-notices-month-grid=""/></div><p class="small subtle section-note">Published college events and released examinations. Times use <t t-esc="d['timezone']"/>.</p><p class="empty" data-notices-calendar-empty="" hidden="hidden">No published events or released examinations fall in this month.</p></section><section class="panel"><div class="panel-head"><h2>Calendar legend</h2></div><div class="list-row"><div class="datebox">A</div><div><h3>Academic / exams</h3><p>Released examinations and academic events.</p></div></div><div class="list-row"><div class="datebox culture">C</div><div><h3>Cultural &amp; entertainment</h3><p>College celebrations and student performances.</p></div></div><div class="list-row"><div class="datebox sports">S</div><div><h3>Sports &amp; wellbeing</h3><p>Sport, fitness and community programmes.</p></div></div><div class="list-row"><div class="datebox deadline">D</div><div><h3>Deadlines / administration</h3><p>Follow official notices for any registration or submission deadlines.</p></div></div><div class="subtleline"/><h3>Important calendar details</h3><p class="small subtle calendar-guidance">Only published campus events and released exam dates are included. Notice expiry dates are not treated as submission deadlines.</p><button type="button" class="btn light calendar-print" data-notices-print="">Print calendar</button></section></div><section class="panel"><div class="panel-head"><h2>Academic milestones</h2><span class="pill amber">Follow official notices</span></div><div class="grid3"><article class="category"><span class="cicon"><i class="fa fa-pencil" aria-hidden="true"/></span><h3>CAT assessments</h3><p>Official assessment timetables, syllabus guidance and publication updates.</p></article><article class="category"><span class="cicon"><i class="fa fa-graduation-cap" aria-hidden="true"/></span><h3>University semester exams</h3><p>Released examinations and official registration, fee and hall-ticket notices.</p></article><article class="category"><span class="cicon"><i class="fa fa-thumb-tack" aria-hidden="true"/></span><h3>Academic submissions</h3><p>Check the college's published instructions for assignment and project deadlines.</p></article></div></section></section>
      <div hidden="hidden" data-notices-calendar-source=""><span t-foreach="u['calendar']" t-as="item" t-att-data-start="item['start_day']" t-att-data-end="item['end_day']" t-att-data-name="item['name']" t-att-data-tone="item['tone']"/></div>
    </div>
  </template>
</odoo>
