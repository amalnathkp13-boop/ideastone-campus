<odoo>
 <record id="action_green_card_mentor" model="ir.actions.client"><field name="name">Green Card – Mentor Review</field><field name="tag">ideastone_erp.green_card</field><field name="context">{'campus_module':'attendance','green_role':'mentor'}</field></record>
 <record id="action_green_card_hod" model="ir.actions.client"><field name="name">Green Card – HOD</field><field name="tag">ideastone_erp.green_card</field><field name="context">{'campus_module':'attendance','green_role':'hod'}</field></record>
 <template id="student_green_card_workspace" inherit_id="ideastone_erp.student_workspace" name="Student Green Card" priority="40">
  <xpath expr="//aside/nav/a[@t-foreach]" position="attributes"><attribute name="t-foreach">[item for item in d['navigation'] if item[0] != 'green-card']</attribute><attribute name="t-att-class">'student_nav_link active' if section == item[0] or (section == 'green-card' and item[0] == 'attendance') else 'student_nav_link'</attribute><attribute name="t-att-aria-current">'page' if section == item[0] or (section == 'green-card' and item[0] == 'attendance') else None</attribute></xpath>
  <xpath expr="//nav[hasclass('student_subnav')]" position="attributes"><attribute name="t-if">d and section != 'on-duty'</attribute></xpath>
  <xpath expr="//nav[hasclass('student_subnav')]/strong" position="attributes"><attribute name="t-esc">dict((item[0], item[1]) for item in d['navigation'])['attendance' if section == 'green-card' else section]</attribute></xpath>
  <xpath expr="//nav[hasclass('student_subnav')]/t[@t-elif=&quot;section == 'attendance'&quot;]" position="attributes"><attribute name="t-elif">section in ['attendance','green-card']</attribute></xpath>
  <xpath expr="//nav[hasclass('student_subnav')]/t[@t-elif=&quot;section in ['attendance','green-card']&quot;]" position="inside"><a t-att-href="student_url_for('green-card')" t-att-aria-current="'page' if section == 'green-card' else None">Green Card</a></xpath>
  <xpath expr="//nav[hasclass('student_subnav')]//a[@href='#student_attendance_overview']" position="attributes"><attribute name="href"/><attribute name="t-att-href">student_url_for('attendance') + '#student_attendance_overview'</attribute></xpath>
  <xpath expr="//nav[hasclass('student_subnav')]//a[@href='#student_attendance_summary']" position="attributes"><attribute name="href"/><attribute name="t-att-href">student_url_for('attendance') + '#student_attendance_summary'</attribute></xpath>
  <xpath expr="//nav[hasclass('student_subnav')]//a[@href='#student_attendance_register']" position="attributes"><attribute name="href"/><attribute name="t-att-href">student_url_for('attendance') + '#student_attendance_register'</attribute></xpath>
  <xpath expr="//nav[hasclass('student_subnav')]//a[@href='#student_attendance_hourly']" position="attributes"><attribute name="href"/><attribute name="t-att-href">student_url_for('attendance') + '#student_attendance_hourly'</attribute></xpath>
  <xpath expr="//nav[hasclass('student_subnav')]//a[@href='#student_attendance_calendar']" position="attributes"><attribute name="href"/><attribute name="t-att-href">student_url_for('attendance') + '#student_attendance_calendar'</attribute></xpath>
  <xpath expr="//header[hasclass('student_page_heading')]" position="attributes"><attribute name="t-if">section != 'green-card'</attribute></xpath>
  <xpath expr="//div[hasclass('student_breadcrumb')]" position="attributes"><attribute name="t-if">section != 'green-card'</attribute></xpath>
  <xpath expr="//t[@t-elif=&quot;section == 'requests'&quot;][@t-call]" position="before"><t t-elif="section == 'green-card'"><owl-component name="ideastone_erp.GreenCard" props='{"expectedRole":"student"}'/></t></xpath>
 </template>
 <template id="green_card_sheet" name="Approved student leave sheet">
  <html><head><title>Green Card · <t t-esc="row['reference']"/></title><meta charset="utf-8"/><style>body{font:14px/1.5 'Segoe UI',Arial,sans-serif;color:#14212d;max-width:850px;margin:40px auto;padding:20px}h1{font-size:26px}table{border-collapse:collapse;width:100%;margin:24px 0}td,th{border:1px solid #dce6f0;padding:12px;text-align:left}small{color:#63788c}.signatures{display:flex;justify-content:space-between;gap:30px;margin:40px 0}.print{background:#0964ef;color:white;border:0;padding:10px 16px;border-radius:5px}@media print{.print{display:none}body{margin:0}}</style></head><body><button class="print" onclick="window.print()">Print Leave Sheet</button><h1><t t-esc="company"/> · Green Card</h1><p>Approved leave authorization · <strong t-esc="row['reference']"/></p><table><tr><th>Student</th><td><t t-esc="row['student']"/> · <t t-esc="row['register']"/></td></tr><tr><th>Class / Department</th><td><t t-esc="row['class']"/> · <t t-esc="row['department']"/></td></tr><tr><th>Type</th><td t-esc="row['type'].title()"/></tr><tr><th>Period</th><td><t t-esc="row['from']"/> (<t t-esc="row['fromSession']"/>) to <t t-esc="row['to']"/> (<t t-esc="row['toSession']"/>) · <t t-esc="row['days']"/> days</td></tr><tr><th>Reason</th><td style="white-space:pre-wrap" t-esc="row['reason']"/></tr><tr><th>Status</th><td>Approved</td></tr></table><div class="signatures"><div><strong>Mentor · <t t-esc="row['mentor']"/></strong><br/><small t-esc="row['mentorAt']"/></div><div><strong>HOD · <t t-esc="row['hod']"/></strong><br/><small t-esc="row['hodAt']"/></div></div><h2>Recorded approval history</h2><p t-foreach="row['history']" t-as="entry"><t t-esc="entry['at']"/> · <t t-esc="entry['by']"/> · <t t-esc="entry['action']"/></p><small>Generated from recorded ERP approvals. This document authorizes leave and does not convert attendance to Present or On Duty.</small></body></html>
 </template>
</odoo>
