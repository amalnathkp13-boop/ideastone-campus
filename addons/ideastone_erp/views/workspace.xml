<odoo>
  <record id="view_responsibility_tree" model="ir.ui.view">
    <field name="name">campus.responsibility.tree</field><field name="model">campus.responsibility</field>
    <field name="arch" type="xml"><tree decoration-success="effective" decoration-muted="state in ('revoked','rejected')"><field name="faculty_id"/><field name="role"/><field name="company_id" groups="base.group_multi_company"/><field name="media_type_ids" widget="many2many_tags"/><field name="date_from"/><field name="date_to"/><field name="state" widget="badge"/><field name="effective"/><field name="approved_by"/></tree></field>
  </record>
  <record id="view_responsibility_form" model="ir.ui.view">
    <field name="name">campus.responsibility.form</field><field name="model">campus.responsibility</field>
    <field name="arch" type="xml"><form>
      <header><button name="action_request" type="object" string="Request approval" class="oe_highlight" invisible="state != 'draft'" groups="ideastone_erp.group_college_admin,ideastone_erp.group_manager"/>
        <button name="action_approve" type="object" string="Approve appointment" class="oe_highlight" invisible="state != 'requested'" groups="ideastone_erp.group_role_approver" confirm="Approve this faculty member for circulation in the selected collections?"/>
        <button name="action_reject" type="object" string="Reject" invisible="state != 'requested'" groups="ideastone_erp.group_role_approver"/>
        <button name="action_revoke" type="object" string="Revoke access" invisible="state != 'approved'" groups="ideastone_erp.group_college_admin,ideastone_erp.group_manager" confirm="Revoke this appointment immediately?"/>
        <field name="state" widget="statusbar" statusbar_visible="draft,requested,approved,revoked"/>
      </header>
      <sheet><h1>Faculty responsibility</h1><div class="alert alert-info" role="status">Library In-charge adds a collection-scoped circulation desk to the same faculty account. It grants no payroll, invoicing, user administration or result-publication rights. Approval must come from a different authorized person.</div>
        <group><group><field name="faculty_id" readonly="state != 'draft'" options="{'no_create':True}"/><field name="role" readonly="state != 'draft'"/><field name="company_id" readonly="state != 'draft'" groups="base.group_multi_company"/><field name="media_type_ids" widget="many2many_tags" readonly="state != 'draft'" options="{'no_create':True}"/></group><group><field name="date_from" readonly="state != 'draft'"/><field name="date_to" readonly="state != 'draft'"/><field name="effective"/><field name="active" invisible="True"/></group></group>
        <field name="justification" placeholder="Appointment authority and business reason…" readonly="state != 'draft'"/>
        <group string="Decision record"><field name="account_id"/><field name="requested_by"/><field name="approved_by"/><field name="approved_on"/><field name="decision_reason"/></group>
      </sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div>
    </form></field>
  </record>
  <record id="action_responsibilities" model="ir.actions.act_window"><field name="name">Access &amp; responsibilities</field><field name="res_model">campus.responsibility</field><field name="view_mode">tree,form</field></record>
  <menuitem id="menu_responsibilities" name="Access &amp; responsibilities" parent="menu_operations" action="action_responsibilities" groups="ideastone_erp.group_college_admin,ideastone_erp.group_manager,ideastone_erp.group_role_approver" sequence="3"/>
  <record id="view_attendance_export_wizard" model="ir.ui.view"><field name="name">campus.attendance.export.wizard</field><field name="model">campus.attendance.export.wizard</field><field name="arch" type="xml"><form string="Attendance shortage report"><div class="alert alert-info" role="status">Choose a period and threshold. Reports include completed attendance only and remain internal drafts.</div><details class="mb-3"><summary>Report scope</summary><p>Faculty exports include their own classes. Students without a completed attendance line in the period are excluded. The spreadsheet uses comma-separated values.</p></details><group><group><field name="academic_year" placeholder="2026–27"/><field name="semester" placeholder="Semester V"/><field name="date_from"/><field name="date_to"/></group><group><field name="course_id" options="{'no_create':True}"/><field name="batch_id" options="{'no_create':True}"/><field name="threshold"/></group></group><footer><button name="action_pdf" type="object" string="Download PDF" class="btn-primary"/><button name="action_csv" type="object" string="Download spreadsheet" class="btn-secondary"/><button string="Cancel" special="cancel"/></footer></form></field></record>
  <record id="action_attendance_export" model="ir.actions.act_window"><field name="name">Attendance shortage report</field><field name="res_model">campus.attendance.export.wizard</field><field name="view_mode">form</field><field name="target">new</field></record>
  <record id="paperformat_attendance_export" model="report.paperformat"><field name="name">VCET attendance A4</field><field name="format">A4</field><field name="orientation">Portrait</field><field name="margin_top">12</field><field name="margin_bottom">15</field><field name="margin_left">12</field><field name="margin_right">12</field><field name="header_line" eval="False"/><field name="header_spacing">0</field><field name="dpi">90</field></record>
  <record id="report_attendance_export" model="ir.actions.report"><field name="name">Attendance shortage report</field><field name="model">campus.attendance.export</field><field name="report_type">qweb-pdf</field><field name="report_name">ideastone_erp.attendance_export_document</field><field name="paperformat_id" ref="paperformat_attendance_export"/><field name="print_report_name">'VCET_Attendance_%s' % object.id</field></record>
  <template id="attendance_export_document"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="s" t-value="o.snapshot"/><t t-call="web.basic_layout">
    <div class="page" style="color:#15263a;font-family:Arial,sans-serif;font-size:12px">
      <div style="background:#082b4b;color:white;padding:24px;margin-bottom:24px"><table style="width:100%;border:0"><tr><td style="width:215px;border:0;vertical-align:middle"><img src="/ideastone_campus/static/src/img/vcet-wordmark.png" style="width:185px;background:white;padding:8px;border-radius:8px" alt="VCET"/></td><td style="border:0;vertical-align:middle"><h1 style="color:white;font-size:25px">Attendance Shortage Report</h1><p style="margin-bottom:0"><t t-esc="o.company_id.name"/> · <t t-esc="s['programme']"/> · <t t-esc="s['semester']"/></p></td></tr></table></div>
      <h3 style="color:#082b4b">REPORT METADATA</h3><table class="table table-borderless"><tbody><tr><td>Academic year<br/><strong t-esc="s['academic_year']"/></td><td>Report period<br/><strong><t t-esc="s['from']"/> – <t t-esc="s['to']"/></strong></td><td>Generated on<br/><strong t-esc="context_timestamp(o.create_date).strftime('%d %b %Y, %H:%M %Z')"/></td></tr><tr><td>Prepared by<br/><strong t-esc="o.user_id.name"/></td><td>Report ID<br/><strong>VCET-ATT-<t t-esc="o.id"/></strong></td><td>Publication state<br/><strong>DRAFT · Internal</strong></td></tr></tbody></table>
      <p>Batch: <t t-esc="s['batch']"/> · Source: Odoo 17 / OpenEduCat completed attendance</p>
      <h3 style="color:#082b4b">SUMMARY OF SELECTED PERIOD</h3><table class="table" style="background:#f4f7fb"><tbody><tr><td>STUDENTS REVIEWED<br/><strong style="font-size:25px" t-esc="len(s['rows'])"/></td><td>BELOW THRESHOLD<br/><strong style="font-size:25px" t-esc="s['shortage']"/></td><td>THRESHOLD<br/><strong style="font-size:25px"><t t-esc="s['threshold']"/>%</strong></td></tr></tbody></table>
      <h3 style="color:#082b4b">ATTENDANCE REGISTER</h3><table class="table table-sm"><thead style="background:#eaf1fa"><tr><th>Register ID</th><th>Student</th><th>Sessions</th><th>Present</th><th>Rate</th><th>Status</th></tr></thead><tbody><tr t-foreach="s['rows']" t-as="r" style="page-break-inside:avoid"><td t-esc="r['register']"/><td t-esc="r['name']"/><td t-esc="r['sessions']"/><td t-esc="r['present']"/><td><t t-esc="r['rate']"/>%</td><td t-esc="'Shortage' if r['shortage'] else 'Good'"/></tr><tr t-if="not s['rows']"><td colspan="6">No completed attendance in your permitted scope for these filters.</td></tr><tr><th colspan="2">Totals</th><th t-esc="s['sessions']"/><th t-esc="s['present']"/><td colspan="2"/></tr></tbody></table>
      <p style="font-size:10px">Counts reconcile to completed attendance lines in the permitted scope. Unrecorded periods are excluded. A draft export does not publish or alter attendance.</p><p style="font-size:9px;word-break:break-all">Snapshot SHA256: <t t-esc="o.checksum"/></p>
    </div><div class="footer" style="font-size:10px;color:#6c7b90">VCET Campus ERP · Internal draft · Report <t t-esc="o.id"/> · Page <span class="page"/> of <span class="topage"/></div>
  </t></t></t></template>
</odoo>
