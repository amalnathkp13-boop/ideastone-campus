<odoo>
  <template id="student_examinations_content" name="Student examinations and results content">
    <t t-set="u" t-value="d['exam_ui']"/>
    <div class="exam_view">
      <section id="student_exam_schedule" class="exam_page" data-exam-page="overview">
        <div class="exam_pagehead"><div><h1>Examinations &amp; Results</h1><p><t t-esc="d['placement']['programme']"/> · <t t-esc="d['placement']['section']"/> · Internal assessments and university examinations</p></div><span class="exam_pill"><i class="fa fa-calendar-o" aria-hidden="true"/> Academic year <t t-esc="d['placement']['year']"/></span></div>
        <div class="exam_kpis">
          <article class="exam_kpi"><span class="exam_kicon"><i class="fa fa-calendar" aria-hidden="true"/></span><span class="exam_kpi_label">Internal assessments</span><strong t-esc="str(len(u['internal'])) + ' recorded' if u['internal'] else 'Not scheduled'"/><small>Released assessment series for this placement</small></article>
          <article class="exam_kpi green"><span class="exam_kicon"><i class="fa fa-check" aria-hidden="true"/></span><span class="exam_kpi_label">Results published</span><strong><t t-esc="u['published_groups']"/> of <t t-esc="len(u['groups'])"/></strong><small>Assessment series with published marks</small></article>
          <article class="exam_kpi amber"><span class="exam_kicon"><i class="fa fa-clock-o" aria-hidden="true"/></span><span class="exam_kpi_label">Next scheduled assessment</span><strong t-esc="u['next_exam']['date'].split(',')[0] if u['next_exam'] else 'Not scheduled'"/><small t-esc="u['next_exam']['subject'] if u['next_exam'] else 'No upcoming released examination'"/></article>
          <article class="exam_kpi violet"><span class="exam_kicon"><i class="fa fa-dot-circle-o" aria-hidden="true"/></span><span class="exam_kpi_label">Average published score</span><strong t-esc="str(u['average']) + '%' if u['average'] is not None else 'Not recorded'"/><small>Across published marks only</small></article>
        </div>

        <section class="exam_panel"><div class="exam_panel_head"><div><h2>Continuous Assessment Tests</h2><p>Track internal assessments, publication status and key dates from one place.</p></div><span class="exam_pill violet"><t t-esc="len(u['internal'])"/> released series</span></div>
          <div t-if="u['internal']" class="exam_assessment_grid">
            <article t-foreach="u['internal']" t-as="g" t-att-class="'exam_assessment_card ' + ('complete' if g['status'] == 'published' else 'upcoming' if g['upcoming'] else '')"><div class="exam_assessment_top"><strong t-esc="g['name']"/><span t-att-class="'exam_badge ' + ('done' if g['status'] == 'published' else 'next' if g['upcoming'] else 'pending')" t-esc="'Results published' if g['status'] == 'published' else 'Partly published' if g['status'] == 'partial' else 'Upcoming' if g['upcoming'] else 'Scheduled'"/></div><p class="exam_subtle exam_small" t-esc="g['type'] or 'Internal assessment'"/><dl class="exam_meta"><div><dt>Exam dates</dt><dd><t t-esc="g['start']"/><t t-if="g['end'] != g['start']"> – <t t-esc="g['end']"/></t></dd></div><div><dt>Result published</dt><dd t-esc="g['published_on'] or ('Published' if g['published_count'] else 'Not yet')"/></div><div><dt>Subjects assessed</dt><dd><t t-esc="g['subject_count']"/> subjects</dd></div></dl><p class="exam_card_note" t-esc="'Review your released subject marks in My Results.' if g['published_count'] else 'Check the official schedule and prepare for this assessment.'"/><a t-att-href="'#student_results' if g['published_count'] else '#exam_upcoming_schedule'" t-att-class="'exam_button ' + ('light' if g['published_count'] else 'primary')"><t t-esc="'View results' if g['published_count'] else 'View schedule'"/> <i class="fa fa-arrow-right" aria-hidden="true"/></a></article>
          </div><p t-else="" class="exam_empty">No internal assessment series has been released for this placement.</p>
        </section>

        <section class="exam_panel"><div class="exam_panel_head"><div><h2>University Semester Examinations</h2><p>End-semester examinations follow university notifications and official college records.</p></div><span t-att-class="'exam_pill ' + ('green' if u['semester'] else 'amber')" t-esc="'Released records available' if u['semester'] else 'Official timetable awaited'"/></div>
          <div class="exam_semester_status"><span t-att-class="'exam_badge ' + ('next' if u['semester'] else 'pending')" t-esc="str(len(u['semester'])) + ' released series' if u['semester'] else 'No semester window announced'"/><span class="exam_badge next">Academic year <t t-esc="d['placement']['year']"/></span></div>
          <div class="exam_semester_grid"><article class="exam_semester_step"><span><i class="fa fa-file-text-o" aria-hidden="true"/></span><strong>1. Exam notification</strong><p>View the timetable and important deadlines when the examination office releases them.</p></article><article class="exam_semester_step"><span><i class="fa fa-check" aria-hidden="true"/></span><strong>2. Exam registration</strong><p>Confirm eligible papers and registration requirements with the college.</p></article><article class="exam_semester_step"><span><i class="fa fa-id-card-o" aria-hidden="true"/></span><strong>3. Hall ticket</strong><p>Use the official document after release and verify your details and examination centre.</p></article><article class="exam_semester_step"><span><i class="fa fa-star-o" aria-hidden="true"/></span><strong>4. Results &amp; revaluation</strong><p>Review published grades and the university's correction or revaluation deadlines.</p></article></div>
          <div class="exam_semester_bottom"><div class="exam_checklist"><h3>Semester examination checklist</h3><dl class="exam_meta"><div><dt>Exam timetable</dt><dd t-esc="'Released in schedule below' if u['semester'] else 'Awaiting official release'"/></div><div><dt>Registration &amp; fee status</dt><dd>Confirm with examination office</dd></div><div><dt>Exam centre / room</dt><dd>As printed on official hall ticket</dd></div><div><dt>Result &amp; revaluation dates</dt><dd>As officially notified</dd></div></dl></div><div class="exam_notice"><span class="exam_notice_icon"><i class="fa fa-info" aria-hidden="true"/></span><div><strong>Keep the university process clear</strong><p>Semester exams may have separate registration, fee, attendance, hall-ticket and revaluation rules. Follow official notices for each deadline.</p></div></div></div>
          <div t-if="u['semester']" class="exam_chips"><span t-foreach="u['semester']" t-as="g" class="exam_chip" t-esc="g['name']"/></div>
          <p t-if="not u['semester']" class="exam_section_note">No university examination records have been released for this placement.</p>
        </section>

        <section t-if="u['other']" class="exam_panel"><div class="exam_panel_head"><div><h2>Other released assessments</h2><p>Published assessment series outside internal CATs and university semester exams.</p></div></div><div class="exam_chips"><span t-foreach="u['other']" t-as="g" class="exam_chip" t-esc="g['name']"/></div></section>

        <div class="exam_grid2"><section id="exam_upcoming_schedule" class="exam_panel"><div class="exam_panel_head"><div><h2>Upcoming exam schedule</h2><p>Only examination dates released to students are shown. Times use <t t-esc="d['timezone']"/>.</p></div><span class="exam_pill amber"><t t-esc="len(u['upcoming'])"/> upcoming</span></div><div t-if="u['upcoming']"><div t-foreach="u['upcoming']" t-as="e" class="exam_schedule_row"><div class="exam_schedule_date"><strong t-esc="e['number']"/><span t-esc="e['month']"/></div><div class="exam_schedule_info"><strong t-esc="e['subject']"/><span><t t-esc="e['name']"/> · <t t-esc="e['start']"/> – <t t-esc="e['end']"/></span></div><span class="exam_schedule_day" t-esc="e['day']"/></div></div><p t-else="" class="exam_empty">No upcoming examination schedule has been released for this placement.</p><div class="exam_notice"><span class="exam_notice_icon"><i class="fa fa-info" aria-hidden="true"/></span><div><strong>Before the exam</strong><p>Carry your college ID, confirm the final room allocation and check whether an official hall ticket is required.</p></div></div></section>
          <section class="exam_panel"><div class="exam_panel_head"><h2>Exam readiness</h2><span class="exam_pill violet">Study support</span></div><div class="exam_insight"><span class="exam_insight_label"><i class="fa fa-lightbulb-o" aria-hidden="true"/> STUDY INSIGHT</span><h3 t-esc="'Focus on ' + u['lowest']['subject'] if u['lowest'] else 'Prepare for your next assessment'"/><p t-esc="'Your lowest published score is ' + str(u['lowest']['rate']) + '%. Use the official marks and faculty guidance to plan your revision.' if u['lowest'] else 'Once the college publishes marks, your subject scores will help you choose what to revise first.'"/><ul><li>Revise core concepts and case-based questions.</li><li>Use a short practice test for each subject.</li><li>Review faculty feedback when it is released.</li></ul></div><h3 class="exam_reminder_title">Important reminders</h3><dl class="exam_meta"><div><dt>Hall ticket</dt><dd>Use the official college or university issue</dd></div><div><dt>Exam venue</dt><dd>Confirm before attendance</dd></div><div><dt>Result policy</dt><dd>Only published marks are official</dd></div></dl></section></div>

        <section class="exam_panel"><div class="exam_panel_head"><div><h2>Latest result activity</h2><p>Recent publication and assessment updates</p></div><a class="exam_button" href="#student_results">Open My Results <i class="fa fa-arrow-right" aria-hidden="true"/></a></div><div class="exam_table_wrap"><table><thead><tr><th scope="col">Assessment</th><th scope="col">Activity</th><th scope="col">Date</th><th scope="col">Status</th></tr></thead><tbody><tr t-foreach="[g for g in u['groups'] if g['published_count']][:6]" t-as="g"><td><strong t-esc="g['name']"/></td><td>Subject-wise marks published</td><td t-esc="g['published_on'] or 'Date not recorded'"/><td><span class="exam_badge done">Published</span></td></tr><tr t-foreach="[g for g in u['groups'] if g['upcoming'] and not g['published_count']][:6]" t-as="g"><td><strong t-esc="g['name']"/></td><td>Released exam schedule</td><td t-esc="g['start']"/><td><span class="exam_badge next">Upcoming</span></td></tr><tr t-if="not u['published_groups'] and not [g for g in u['groups'] if g['upcoming']]"><td colspan="4" class="exam_empty">No result or upcoming schedule activity has been released.</td></tr></tbody></table></div></section>

        <section class="exam_panel"><div class="exam_panel_head"><div><h2>Question Papers &amp; Exam Practice</h2><p>College-approved study resources linked to your subjects.</p></div><span class="exam_pill violet">Study resources</span></div><div class="exam_notice"><span class="exam_notice_icon"><i class="fa fa-star-o" aria-hidden="true"/></span><div><strong>Use approved practice material</strong><p>Previous papers help with question patterns and time management. Repeated topics are revision guidance, never a prediction of future questions.</p></div></div><div class="exam_resource_grid"><article t-foreach="u['resources']" t-as="resource" class="exam_resource"><span class="exam_resource_icon"><i class="fa fa-file-text-o" aria-hidden="true"/></span><div><strong t-esc="resource['subject']"/><p>Question papers, model answers and practice resources released by the college.</p><div t-if="resource['files']" class="exam_resource_links"><a t-foreach="resource['files']" t-as="file" t-att-href="'/my/campus/student/download/resource/%s' % file['id']" t-esc="file['name']"/></div><span t-else="" class="exam_badge pending">Upload pending</span></div></article></div><p t-if="not u['resources']" class="exam_empty">No subjects are linked to this placement.</p><div class="exam_theme_head"><h3>Frequently asked question themes</h3><p>Faculty-curated themes may be published after academic review.</p></div><div class="exam_chips"><span class="exam_chip">2-mark definitions</span><span class="exam_chip">5-mark short notes</span><span class="exam_chip">10/15-mark essays</span><span class="exam_chip">Case-study questions</span><span class="exam_chip">Unit-wise revision</span><span class="exam_chip">Model answer / marking scheme</span></div><p class="exam_section_note">Only approved files appear here. Check the file name and upload date before using it for revision.</p></section>
        <div class="exam_notice exam_final_notice"><span class="exam_notice_icon"><i class="fa fa-info" aria-hidden="true"/></span><div><strong>Official records only</strong><p>Only schedules and marks released by the examination office are authoritative. This portal does not generate unofficial hall tickets.</p></div></div>
      </section>

      <section id="student_results" class="exam_page" data-exam-page="results" hidden="hidden"><div class="exam_pagehead"><div><h1>My Results</h1><p>Published assessment marks and subject-wise performance.</p></div><span class="exam_pill green">Published results only</span></div>
        <div class="exam_filter_card"><div class="exam_filter_top"><div class="exam_filter_title"><span><i class="fa fa-search" aria-hidden="true"/></span>Find results</div><small>Filter the published mark list</small></div><div class="exam_filters"><label>Assessment<select data-exam-filter="assessment"><option value="all">All assessments</option><t t-foreach="u['groups']" t-as="g"><option t-if="g['published_count']" t-att-value="g['id']" t-esc="g['name']"/></t></select></label><label>Subject<select data-exam-filter="subject"><option value="all">All subjects</option><option t-foreach="u['result_subjects']" t-as="s" t-att-value="s[0]" t-esc="s[1]"/></select></label><div class="exam_filter_actions"><button type="button" class="exam_button primary" data-exam-apply="">Apply filters</button><button type="button" class="exam_button" data-exam-reset="">Reset</button></div></div></div>
        <div class="exam_kpis"><article class="exam_kpi"><span class="exam_kicon"><i class="fa fa-dot-circle-o" aria-hidden="true"/></span><span class="exam_kpi_label">Published assessments</span><strong><t t-esc="u['published_groups']"/> / <t t-esc="len(u['groups'])"/></strong><small>Released marks only</small></article><article class="exam_kpi green"><span class="exam_kicon"><i class="fa fa-line-chart" aria-hidden="true"/></span><span class="exam_kpi_label">Average score</span><strong t-esc="str(u['average']) + '%' if u['average'] is not None else 'Not recorded'"/><small>Across published marks</small></article><article class="exam_kpi amber"><span class="exam_kicon"><i class="fa fa-pencil" aria-hidden="true"/></span><span class="exam_kpi_label">Highest subject score</span><strong t-esc="str(u['highest']['marks']) + ' / ' + str(u['highest']['maximum']) if u['highest'] else 'Not recorded'"/><small t-esc="u['highest']['subject'] if u['highest'] else 'No published subject marks'"/></article><article class="exam_kpi violet"><span class="exam_kicon"><i class="fa fa-comment-o" aria-hidden="true"/></span><span class="exam_kpi_label">Feedback entries</span><strong>Not available</strong><small>Faculty remarks are not released in this portal</small></article></div>
        <section class="exam_panel"><div class="exam_panel_head"><div><h2>Subject-wise results</h2><p>Only officially published marks and recorded grades are displayed.</p></div><button type="button" class="exam_button" data-exam-print="">Print results</button></div><div class="exam_table_wrap"><table><thead><tr><th scope="col">Assessment</th><th scope="col">Subject</th><th scope="col">Marks</th><th scope="col">Maximum</th><th scope="col">Score</th><th scope="col">Grade</th><th scope="col">Result</th></tr></thead><tbody><tr t-foreach="u['results']" t-as="r" class="exam_result_row" t-att-data-assessment="r['assessment_id']" t-att-data-subject="r['code'] or r['subject']"><td><strong t-esc="r['assessment']"/></td><td t-esc="r['subject']"/><td t-esc="r['marks']"/><td t-esc="r['maximum']"/><td><div class="exam_markbar"><strong t-esc="str(r['rate']) + '%' if r['rate'] is not None else '—'"/><div class="exam_progress"><span t-att-class="r['tone']" t-att-style="'width: ' + str(min(100, max(0, r['rate'] or 0))) + '%'"/></div></div></td><td><span t-att-class="'exam_grade ' + r['tone']" t-esc="r['grade']"/></td><td t-esc="r['status']"/></tr></tbody></table></div><p t-if="not u['results']" class="exam_empty">Results appear here after official publication. Draft and unpublished marks remain private.</p><p t-if="u['results']" class="exam_empty" data-exam-empty="" hidden="hidden">No results match the selected filters.</p></section>
        <div class="exam_grid2"><section class="exam_panel"><div class="exam_panel_head"><h2>Faculty feedback &amp; next steps</h2><span class="exam_pill violet">Study guidance</span></div><dl class="exam_meta"><div><dt>Strongest recorded subject</dt><dd t-esc="u['highest']['subject'] if u['highest'] else 'Awaiting published marks'"/></div><div><dt>Focus area</dt><dd t-esc="u['lowest']['subject'] if u['lowest'] else 'Awaiting published marks'"/></div><div><dt>Suggested action</dt><dd>Review official scores and practise regularly</dd></div></dl><p class="exam_section_note">Faculty remarks are shown only if the college releases them. This guidance does not calculate an official grade.</p></section><section class="exam_panel"><div class="exam_panel_head"><h2>Result support</h2></div><p class="exam_subtle">If a mark appears incorrect, contact the course faculty or examination office and include the assessment, subject and issue. Corrections follow college policy.</p><a class="exam_button light" t-att-href="student_url_for('requests')">How to raise a result query <i class="fa fa-arrow-right" aria-hidden="true"/></a></section></div>
        <div class="exam_notice exam_final_notice"><span class="exam_notice_icon"><i class="fa fa-info" aria-hidden="true"/></span><div><strong>Published records only</strong><p>Marks, grades and examination dates reflect the college records released to your account. Contact the examination office for official corrections.</p></div></div>
      </section>
    </div>
  </template>
</odoo>
