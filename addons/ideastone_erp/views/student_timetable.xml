<odoo>
  <template id="student_timetable_content" name="Student timetable content">
    <t t-set="tt" t-value="d['timetable']"/>
    <div class="student_timetable_view" t-att-data-today="d['today_iso']" t-att-data-week-start="tt['start']" t-att-data-week-end="tt['end']" t-att-data-enrolment="d['placement']['id']">
      <section id="student_timetable_planner" class="timetable_page" data-timetable-page="planner">
        <div class="timetable_page_head"><div><h1>Timetable</h1><p><t t-esc="d['placement']['programme']"/> · <t t-esc="d['placement']['semester']"/> · <t t-esc="d['placement']['section']"/></p></div><span class="timetable_pill"><i class="fa fa-calendar-o" aria-hidden="true"/> Published schedule · <t t-esc="d['timezone']"/></span></div>
        <div class="timetable_hero"><span class="timetable_hero_icon"><i class="fa fa-calendar" aria-hidden="true"/></span><div><h2>Your week, at a glance</h2><p>See your scheduled classes, rooms, faculty and breaks in one weekly view. Select a class to see more details.</p></div><span class="timetable_hero_tag" t-esc="tt['label']"/></div>
        <div class="timetable_stats">
          <article class="timetable_stat"><span class="timetable_stat_icon"><i class="fa fa-book" aria-hidden="true"/></span><span class="timetable_stat_label">Classes this week</span><strong t-esc="'%02d' % len(tt['active'])"/><small><t t-esc="tt['subjects']"/> subjects with scheduled classes</small></article>
          <article class="timetable_stat purple"><span class="timetable_stat_icon"><i class="fa fa-clock-o" aria-hidden="true"/></span><span class="timetable_stat_label">Scheduled hours</span><strong><t t-esc="tt['hours']"/> hrs</strong><small>Confirmed sessions this week</small></article>
          <article class="timetable_stat teal"><span class="timetable_stat_icon"><i class="fa fa-arrow-right" aria-hidden="true"/></span><span class="timetable_stat_label">Next class</span><strong t-esc="tt['upcoming'][0]['start_time'] if tt['upcoming'] else '—'"/><small t-esc="(tt['upcoming'][0]['subject'] + ' · ' + tt['upcoming'][0]['room']) if tt['upcoming'] else 'No upcoming class in this period'"/></article>
          <article class="timetable_stat green"><span class="timetable_stat_icon"><i class="fa fa-check" aria-hidden="true"/></span><span class="timetable_stat_label">Schedule conflicts</span><strong t-esc="tt['conflicts']"/><small t-esc="'Overlapping confirmed sessions' if tt['conflicts'] else 'No overlapping classes'"/></article>
        </div>
        <section class="timetable_card"><div class="timetable_card_head"><div><h2>Weekly class planner</h2><p>Week of <t t-esc="tt['label']"/> · Times shown in <t t-esc="d['timezone']"/></p></div><button type="button" class="timetable_outline timetable_print"><i class="fa fa-print" aria-hidden="true"/> Print timetable</button></div>
          <div class="timetable_controls" role="group" aria-label="Timetable view"><button type="button" class="timetable_pill_button" data-timetable-mode="today" aria-pressed="false">Today</button><button type="button" class="timetable_pill_button is-active" data-timetable-mode="week" aria-pressed="true">This week</button><button type="button" class="timetable_pill_button" data-timetable-mode="agenda" aria-pressed="false">Agenda view</button><div class="timetable_week_nav"><a t-att-href="'/my/campus/student/timetable?enrolment=%s&amp;date_from=%s&amp;date_to=%s' % (d['placement']['id'], tt['previous_start'], tt['previous_end'])" aria-label="Previous week">‹</a><span t-esc="tt['label']"/><a t-att-href="'/my/campus/student/timetable?enrolment=%s&amp;date_from=%s&amp;date_to=%s' % (d['placement']['id'], tt['next_start'], tt['next_end'])" aria-label="Next week">›</a></div></div>
          <div class="timetable_grid_wrap" data-timetable-grid=""><div class="timetable_grid" t-att-style="'--timetable-days: %s' % len(tt['days'])"><div class="timetable_day_head time">TIME</div><div t-foreach="tt['days']" t-as="day" class="timetable_day_head"><t t-esc="day['name']"/><strong t-esc="day['number']"/></div><t t-foreach="tt['rows']" t-as="row"><div class="timetable_time_cell" t-esc="row['time']"/><div t-foreach="row['cells']" t-as="cell" class="timetable_slot_cell"><button t-foreach="cell" t-as="s" type="button" t-att-class="'timetable_class ' + s['color']" t-att-data-subject="s['subject']" t-att-data-time="s['start'] + ' – ' + s['end_time']" t-att-data-faculty="s['faculty']" t-att-data-room="s['room']" t-att-data-code="s['code'] or ''" t-att-data-status="'Cancelled' if s['status'] == 'cancel' else 'Confirmed'" t-att-aria-label="'Class details for ' + s['subject']"><strong t-esc="s['subject']"/><small><t t-esc="s['start_time']"/>–<t t-esc="s['end_time']"/> · <t t-esc="s['room']"/></small></button></div></t></div></div>
          <div class="timetable_agenda" data-timetable-agenda="" hidden="hidden"><div t-foreach="tt['week']" t-as="s" class="timetable_agenda_item" t-att-data-day="s['day']"><span class="timetable_agenda_time" t-esc="s['start_time']"/><span t-att-class="'timetable_agenda_line ' + s['color']"/><span class="timetable_agenda_copy"><strong t-esc="s['subject']"/><small><t t-esc="s['faculty'] or 'Faculty not assigned'"/> · <t t-esc="s['room']"/> · <t t-esc="s['start']"/></small></span><span t-att-class="'timetable_status neutral' if s['status'] == 'cancel' else 'timetable_status purple'" t-esc="'Cancelled' if s['status'] == 'cancel' else (s['code'] or 'Class')"/></div><p t-if="not tt['week']" class="timetable_empty">No published classes are recorded for this week.</p><p class="timetable_empty timetable_today_empty" hidden="hidden">No published classes are recorded for today.</p></div>
          <p t-if="not tt['week']" class="timetable_empty timetable_grid_empty">No published classes are recorded for this week. Use the week arrows to check another week or contact the academic office.</p>
          <div t-if="tt['legend'] or any(s['status'] == 'cancel' for s in tt['week'])" class="timetable_legend"><span t-foreach="tt['legend']" t-as="entry"><i t-att-class="'timetable_dot ' + entry['color']"/><t t-esc="entry['label']"/></span><span t-if="any(s['status'] == 'cancel' for s in tt['week'])"><i class="timetable_dot neutral"/> Cancelled</span></div>
        </section>
        <div class="timetable_two_col"><section class="timetable_card"><div class="timetable_card_head"><h2>Upcoming sessions</h2><button type="button" class="timetable_text_link" data-timetable-open="overview">View overview <i class="fa fa-arrow-right" aria-hidden="true"/></button></div><div t-foreach="tt['upcoming']" t-as="s" class="timetable_list_row"><span t-att-class="'timetable_list_icon ' + s['color']"><i class="fa fa-calendar-o" aria-hidden="true"/></span><span class="timetable_list_copy"><strong t-esc="s['subject']"/><small><t t-esc="s['start']"/>–<t t-esc="s['end_time']"/> · <t t-esc="s['room']"/></small></span><span class="timetable_status good">Scheduled</span></div><p t-if="not tt['upcoming']" class="timetable_empty">No upcoming published sessions are recorded in the selected period.</p></section><section class="timetable_card timetable_assistant"><span class="timetable_ai_label"><i class="fa fa-lightbulb-o" aria-hidden="true"/> STUDY PLANNER</span><h2>Make the gaps work for you</h2><p>Use a free block between classes for reading or revision. This is a study suggestion, not a confirmed timetable event.</p><div class="timetable_ai_suggestion"><strong>Suggested focus · 45 minutes</strong><br/><t t-esc="'Review ' + tt['upcoming'][0]['subject'] + ' notes before your next class.' if tt['upcoming'] else 'Review your subject notes and check back when the college publishes a schedule.'"/></div></section></div>
      </section>
      <section id="student_timetable_overview" class="timetable_page" data-timetable-page="overview" hidden="hidden"><button type="button" class="timetable_back" data-timetable-open="planner"><i class="fa fa-arrow-left" aria-hidden="true"/> Timetable</button><div class="timetable_page_head"><div><h1>Timetable overview</h1><p>A compact view of your weekly academic rhythm and important schedule details.</p></div><span class="timetable_pill">Published college records</span></div>
        <div class="timetable_stats"><article class="timetable_stat"><span class="timetable_stat_label">Weekly classes</span><strong t-esc="'%02d' % len(tt['active'])"/><small>Confirmed classes this week</small></article><article class="timetable_stat purple"><span class="timetable_stat_label">Class hours</span><strong t-esc="tt['hours']"/><small>Hours this week</small></article><article class="timetable_stat teal"><span class="timetable_stat_label">Teaching rooms</span><strong t-esc="len(tt['rooms'])"/><small t-esc="', '.join(tt['rooms']) if tt['rooms'] else 'No rooms assigned'"/></article><article class="timetable_stat green"><span class="timetable_stat_label">Conflicts detected</span><strong t-esc="tt['conflicts']"/><small t-esc="'Review overlapping classes' if tt['conflicts'] else 'No overlaps in published sessions'"/></article></div>
        <div class="timetable_two_col"><section class="timetable_card"><div class="timetable_card_head"><h2>Weekly rhythm</h2><span t-att-class="'timetable_status amber' if tt['conflicts'] else 'timetable_status good'" t-esc="'Review conflicts' if tt['conflicts'] else 'No conflicts'"/></div><div t-foreach="tt['rhythm']" t-as="day" class="timetable_rhythm"><div><span t-esc="day['name']"/><strong><t t-esc="day['count']"/> sessions · <t t-esc="day['hours']"/> hrs</strong></div><div class="timetable_progress"><span t-att-class="day['color']" t-att-style="'width: ' + str(day['percent']) + '%'"/></div></div><div class="timetable_notice">These counts follow the published sessions in the selected week. Cancelled classes are excluded.</div></section><div class="timetable_stack"><section class="timetable_card"><div class="timetable_card_head"><h2>Faculty &amp; room guide</h2></div><div t-foreach="tt['faculty']" t-as="name" class="timetable_list_row"><span class="timetable_list_icon blue"><i class="fa fa-user" aria-hidden="true"/></span><span class="timetable_list_copy"><strong t-esc="name"/><small t-esc="', '.join(sorted({s['room'] for s in tt['active'] if s['faculty'] == name}))"/></span></div><p t-if="not tt['faculty']" class="timetable_empty">Faculty and rooms will appear after classes are published.</p></section><section class="timetable_card"><div class="timetable_card_head"><h2>Schedule notes</h2></div><div class="timetable_list_row"><span class="timetable_list_icon amber"><i class="fa fa-exclamation" aria-hidden="true"/></span><span class="timetable_list_copy"><strong>Check for room changes</strong><small>Room updates may be published by the academic office on short notice.</small></span></div><div class="timetable_list_row"><span class="timetable_list_icon green"><i class="fa fa-check" aria-hidden="true"/></span><span class="timetable_list_copy"><strong>Arrive 5 minutes early</strong><small>Keep a buffer for moving between teaching blocks.</small></span></div></section></div></div>
        <section class="timetable_card timetable_assistant timetable_overview_tip"><span class="timetable_ai_label"><i class="fa fa-lightbulb-o" aria-hidden="true"/> SCHEDULE INSIGHT</span><h2>Personalise your preparation time</h2><p>Review the weekly rhythm and reserve a free block for assignment work or questions for faculty. Suggestions here do not create timetable events.</p></section>
        <section class="timetable_card timetable_placement"><div class="timetable_card_head"><h2>View another placement or period</h2></div><form method="get" action="/my/campus/student/timetable"><label for="timetable_placement">Academic placement<select id="timetable_placement" name="enrolment"><option t-foreach="d['placements']" t-as="p" t-att-value="p['id']" t-att-selected="p['id'] == d['placement']['id']" t-esc="p['label']"/></select></label><label for="timetable_from">Class records from<input id="timetable_from" type="date" name="date_from" t-att-value="d['filters']['date_from']" required="required"/></label><label for="timetable_to">Through<input id="timetable_to" type="date" name="date_to" t-att-value="d['filters']['date_to']" required="required"/></label><button type="submit" class="timetable_button">Apply</button></form></section>
      </section>
      <dialog class="timetable_dialog" aria-labelledby="timetable_dialog_title"><div class="timetable_card_head"><h2 id="timetable_dialog_title">Class details</h2><button type="button" class="timetable_outline timetable_dialog_close">Close</button></div><dl class="timetable_details"><dt>Time</dt><dd data-timetable-detail="time"/><dt>Faculty</dt><dd data-timetable-detail="faculty"/><dt>Room / venue</dt><dd data-timetable-detail="room"/><dt>Subject code</dt><dd data-timetable-detail="code"/><dt>Status</dt><dd data-timetable-detail="status"/><dt>Placement</dt><dd><t t-esc="d['placement']['programme']"/> · <t t-esc="d['placement']['section']"/></dd></dl><p class="timetable_notice">Class details come from the published college timetable.</p></dialog>
    </div>
  </template>
</odoo>
