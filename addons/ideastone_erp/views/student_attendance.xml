<odoo>
  <template id="student_attendance_content" name="Student attendance content">
    <t t-set="a" t-value="d['attendance']"/>
    <t t-set="rate" t-value="a['rate'] or 0"/>
    <t t-set="margin" t-value="round(rate - a['threshold'], 1)"/>
    <t t-set="recorded" t-value="a['rate'] is not None"/>
    <t t-set="at_risk" t-value="recorded and a['shortage']"/>
    <t t-set="lowest" t-value="a['lowest_subject']"/>
    <div class="attendance_view" t-att-data-today="d['today_iso']" t-att-data-period-start="d['filters']['date_from']" t-att-data-period-end="d['filters']['date_to']">
      <section id="student_attendance_overview" class="attendance_page" data-attendance-page="overview">
        <div class="attendance_pagehead"><div><h1>My Attendance</h1><p>Track attendance, monitor subject-wise eligibility, and plan your next classes.</p></div><span t-att-class="'attendance_pill red' if at_risk else 'attendance_pill green' if recorded else 'attendance_pill'" t-esc="'Below threshold' if at_risk else 'Submitted records · Selected period' if recorded else 'Awaiting attendance records'"/></div>
        <form class="attendance_filter_card" method="get" action="/my/campus/student/attendance"><div class="attendance_filter_top"><div class="attendance_filter_title"><span class="attendance_filter_symbol"><i class="fa fa-search" aria-hidden="true"/></span>Refine attendance view</div><span>Choose a placement and reporting period</span></div><div class="attendance_filter_fields"><label>Academic placement<select name="enrolment"><option t-foreach="d['placements']" t-as="p" t-att-value="p['id']" t-att-selected="p['id'] == d['placement']['id']" t-esc="p['label']"/></select></label><label>From date<input type="date" name="date_from" t-att-value="d['filters']['date_from']" required="required"/></label><label>Through date<input type="date" name="date_to" t-att-value="d['filters']['date_to']" required="required"/></label><div class="attendance_filter_actions"><button type="submit" class="attendance_button primary">Apply filters</button><a class="attendance_button clear" t-att-href="'/my/campus/student/attendance?enrolment=%s' % d['placement']['id']">Reset</a></div></div></form>
        <div class="attendance_kpis">
          <article class="attendance_kpi green"><span class="attendance_kicon"><i class="fa fa-check" aria-hidden="true"/></span><span class="attendance_kpi_label">Overall attendance</span><strong t-esc="str(a['rate']) + '%' if recorded else '—'"/><small t-esc="'Below the college threshold' if at_risk else 'For the selected period' if recorded else 'No eligible sessions yet'"/></article>
          <article class="attendance_kpi"><span class="attendance_kicon"><i class="fa fa-list-alt" aria-hidden="true"/></span><span class="attendance_kpi_label">Sessions attended</span><strong><t t-esc="a['attended']"/><em> / <t t-esc="a['conducted']"/></em></strong><small><t t-esc="a['conducted'] - a['attended']"/> eligible sessions not attended</small></article>
          <article class="attendance_kpi amber"><span class="attendance_kicon"><i class="fa fa-calendar" aria-hidden="true"/></span><span class="attendance_kpi_label">Classes this week</span><strong t-esc="a['classes_this_week']"/><small t-esc="'Next class: ' + a['next_class'] if a['next_class'] else 'No upcoming published class in this period'"/></article>
          <article class="attendance_kpi purple"><span class="attendance_kicon"><i class="fa fa-star" aria-hidden="true"/></span><span class="attendance_kpi_label">Eligibility status</span><strong t-att-class="'attendance_bad_value' if at_risk else 'attendance_good_value' if recorded else ''" t-esc="'Needs attention' if at_risk else 'On track' if recorded else 'Not recorded'"/><small>College threshold: <b><t t-esc="a['threshold']"/>%</b></small></article>
        </div>
        <div class="attendance_grid2"><section class="attendance_panel"><div class="attendance_panel_head"><div><h2>Attendance at a glance</h2><p>Your current attendance against the college requirement</p></div><span t-att-class="'attendance_pill red' if at_risk else 'attendance_pill green' if recorded else 'attendance_pill'" t-esc="'Below threshold' if at_risk else 'Eligible' if recorded else 'No records'"/></div><div class="attendance_progress_wrap"><div class="attendance_ring" t-att-style="'--attendance-rate: ' + str(rate) + '%'" role="img" t-att-aria-label="'Overall attendance ' + str(a['rate']) + ' percent' if recorded else 'No eligible attendance recorded'"><span><t t-esc="str(a['rate']) + '%' if recorded else '—'"/><small>overall</small></span></div><div class="attendance_progress_copy"><div class="attendance_bigline" t-esc="('You’re ' + str(abs(margin)) + ' points ' + ('below' if at_risk else 'above') + ' the threshold') if recorded else 'Your attendance will appear here'"/><p t-esc="'Attend upcoming sessions and check any incorrect marks with the academic office.' if at_risk else 'Keep attending your scheduled classes to maintain eligibility.' if recorded else 'This view updates when the college submits attendance for your classes.'"/><div class="attendance_meter"><span t-att-style="'width: ' + str(rate) + '%'"/></div><div class="attendance_threshold_note"><span>0%</span><span>100%</span></div><div class="attendance_threshold_key"><span class="attendance_key_current">● Your attendance</span><span>— <t t-esc="a['threshold']"/>% minimum</span></div></div></div><div class="attendance_mini_stats"><div><strong t-esc="a['status_counts']['present'] + a['status_counts']['late']"/><span>Present / late</span></div><div><strong t-esc="a['status_counts']['absent']"/><span>Absent</span></div><div><strong t-esc="a['status_counts']['excused']"/><span>Excused</span></div></div></section>
          <section class="attendance_panel"><div class="attendance_panel_head"><h2>Attendance coach</h2><span class="attendance_pill purple"><i class="fa fa-lightbulb-o" aria-hidden="true"/> Smart insight</span></div><div class="attendance_coach"><span class="attendance_coach_icon"><i class="fa fa-lightbulb-o" aria-hidden="true"/></span><div><h3 t-esc="'Focus on ' + lowest['name'] if lowest and lowest['rate'] &lt; a['threshold'] else 'Keep your momentum going' if recorded else 'Start with your first record'"/><p t-esc="(lowest['name'] + ' has the lowest recorded subject attendance. Prioritise its upcoming sessions.') if lowest and lowest['rate'] &lt; a['threshold'] else 'Your attendance currently meets the college threshold. Keep checking each submitted register.' if recorded else 'Attendance guidance will use your submitted records once they are available.'"/><ul><li>Attend your next scheduled classes.</li><li>Review the register weekly for any incorrect marks.</li><li>Ask the academic office about excused attendance rules.</li></ul></div></div><div class="attendance_notice"><b>Important:</b> Guidance uses submitted records and the configured college threshold. Confirm eligibility rules with the academic office.</div></section></div>
        <div class="attendance_grid2"><section class="attendance_panel"><div class="attendance_panel_head"><div><h2>Subject-wise attendance</h2><p>Use this to spot subjects that need attention</p></div><a href="#student_attendance_summary" class="attendance_button" data-attendance-tab="summary">View full summary ↗</a></div><div class="attendance_subject_list"><div t-foreach="a['subjects']" t-as="s" class="attendance_subject_row"><div class="attendance_subject_name"><strong t-esc="s['name']"/><small><t t-esc="s['attended']"/> of <t t-esc="s['eligible']"/> eligible sessions</small></div><div class="attendance_meter"><span t-att-class="s['color']" t-att-style="'width: ' + str(s['rate'] or 0) + '%'"/></div><strong t-att-class="'attendance_percent bad' if s['shortage'] else 'attendance_percent good' if s['rate'] is not None else 'attendance_percent'" t-esc="str(s['rate']) + '%' if s['rate'] is not None else '—'"/></div><p t-if="not a['subjects']" class="attendance_empty">No subject attendance has been submitted for this period.</p></div></section>
          <section class="attendance_panel"><div class="attendance_panel_head"><h2>Recent attendance</h2><a href="#student_attendance_register" class="attendance_button" data-attendance-tab="register">Open register ↗</a></div><div class="attendance_table_wrap"><table><thead><tr><th>Date</th><th>Subject</th><th>Status</th></tr></thead><tbody><tr t-foreach="a['rows'][:5]" t-as="r"><td t-esc="r['date']"/><td t-esc="r['subject']"/><td><span t-att-class="'attendance_status ' + r['status']" t-esc="r['status'].title()"/></td></tr><tr t-if="not a['rows']"><td colspan="3" class="attendance_empty">No completed attendance sessions match this period.</td></tr></tbody></table></div></section></div>
        <section class="attendance_panel"><div class="attendance_panel_head"><div><h2>This week’s attendance calendar</h2><p>Quick visual of recorded class days</p></div><a href="#student_attendance_calendar" class="attendance_button" data-attendance-tab="calendar">Full calendar ↗</a></div><div class="attendance_week_grid" data-attendance-week=""/><t t-call="ideastone_erp.student_attendance_legend"/></section>
      </section>

      <section id="student_attendance_summary" class="attendance_page" data-attendance-page="summary" hidden="hidden"><div class="attendance_pagehead"><div><h1>Attendance Summary</h1><p>Detailed breakdown of attendance, eligibility, trends, and subject-level risk.</p></div><span t-att-class="'attendance_pill red' if at_risk else 'attendance_pill green' if recorded else 'attendance_pill'" t-esc="(str(a['rate']) + '% · ' + ('Below threshold' if at_risk else 'Eligible')) if recorded else 'No eligible sessions'"/></div>
        <div class="attendance_kpis"><article class="attendance_kpi green"><span class="attendance_kicon"><i class="fa fa-check" aria-hidden="true"/></span><span class="attendance_kpi_label">Attendance rate</span><strong t-esc="str(a['rate']) + '%' if recorded else '—'"/><small t-esc="(str(abs(margin)) + ' points ' + ('below' if at_risk else 'above') + ' threshold') if recorded else 'No eligible sessions'"/></article><article class="attendance_kpi"><span class="attendance_kicon"><i class="fa fa-list-alt" aria-hidden="true"/></span><span class="attendance_kpi_label">Eligible sessions</span><strong t-esc="a['conducted']"/><small>Across <t t-esc="len(a['subjects'])"/> subjects</small></article><article class="attendance_kpi amber"><span class="attendance_kicon"><i class="fa fa-clock-o" aria-hidden="true"/></span><span class="attendance_kpi_label">Late arrivals</span><strong t-esc="a['status_counts']['late']"/><small>Counted as present</small></article><article class="attendance_kpi purple"><span class="attendance_kicon"><i class="fa fa-calendar-minus-o" aria-hidden="true"/></span><span class="attendance_kpi_label">Excused</span><strong t-esc="a['status_counts']['excused']"/><small>Policy: <t t-esc="a['policy'].title()"/></small></article></div>
        <div class="attendance_summary_grid"><section class="attendance_panel"><div class="attendance_panel_head"><h2>Weekly attendance trend</h2><span class="attendance_pill">Last 6 recorded weeks</span></div><p class="attendance_subtle">Attended sessions as a percentage of eligible sessions</p><div t-if="a['weekly_trend']" class="attendance_chart"><div t-foreach="a['weekly_trend']" t-as="w" class="attendance_barcol"><strong><t t-esc="w['rate']"/>%</strong><div class="attendance_bar" t-att-style="'height: ' + str(max(w['rate'], 4)) + '%'"/><span t-esc="w['label']"/></div></div><p t-else="" class="attendance_empty">No eligible sessions are recorded in the selected period.</p><p class="attendance_threshold_note">College minimum: <t t-esc="a['threshold']"/>% · Selected period only</p></section><section class="attendance_panel"><div class="attendance_panel_head"><h2>Eligibility forecast</h2><span t-att-class="'attendance_pill red' if at_risk else 'attendance_pill green' if recorded else 'attendance_pill'" t-esc="'Needs attention' if at_risk else 'On track' if recorded else 'Pending'"/></div><p class="attendance_subtle" t-esc="'Your recorded attendance is below the configured threshold. Attend future classes and ask the college to confirm eligibility.' if at_risk else 'Your recorded attendance meets the configured threshold. Continue attending to protect eligibility.' if recorded else 'A forecast needs submitted eligible attendance records.'"/><div class="attendance_details"><div><span>Minimum required</span><strong><t t-esc="a['threshold']"/>%</strong></div><div><span>Current margin</span><strong t-att-class="'attendance_bad_value' if at_risk else 'attendance_good_value'" t-esc="(str(margin) + ' pts') if recorded else '—'"/></div><div><span>Subject at lowest rate</span><strong t-esc="lowest['name'] if lowest else 'Not recorded'"/></div></div><div class="attendance_notice">This view is an estimate from submitted records, not an official eligibility decision. Rules can vary by programme, subject and approved leave.</div></section></div>
        <section class="attendance_panel"><div class="attendance_panel_head"><div><h2>Subject-wise breakdown</h2><p>Attendance numerator and denominator for each subject</p></div><button type="button" class="attendance_button" data-attendance-export="summary">Export CSV ↓</button></div><div class="attendance_table_wrap"><table data-attendance-summary-table=""><thead><tr><th>Subject</th><th>Attended</th><th>Eligible sessions</th><th>Attendance</th><th>Threshold status</th><th>Suggested action</th></tr></thead><tbody><tr t-foreach="a['subjects']" t-as="s"><td t-esc="s['name']"/><td t-esc="s['attended']"/><td t-esc="s['eligible']"/><td><strong t-esc="str(s['rate']) + '%' if s['rate'] is not None else '—'"/></td><td><span t-att-class="'attendance_status absent' if s['shortage'] else 'attendance_status present' if s['rate'] is not None else 'attendance_status cancelled'" t-esc="'Below threshold' if s['shortage'] else 'Healthy' if s['rate'] is not None else 'Not recorded'"/></td><td t-esc="'Prioritise upcoming classes' if s['shortage'] else 'Maintain consistency' if s['rate'] is not None else 'Await submitted records'"/></tr><tr t-if="not a['subjects']"><td colspan="6" class="attendance_empty">No subject attendance has been submitted for this period.</td></tr></tbody></table></div></section>
      </section>

      <section id="student_attendance_register" class="attendance_page" data-attendance-page="register" hidden="hidden"><div class="attendance_pagehead"><div><h1>Session Register</h1><p>Review each recorded class, attendance status, and whether it counts toward eligibility.</p></div><button type="button" class="attendance_button primary" data-attendance-export="register">Export register ↓</button></div><div class="attendance_filter_card"><div class="attendance_filter_top"><div class="attendance_filter_title"><span class="attendance_filter_symbol"><i class="fa fa-filter" aria-hidden="true"/></span>Filter session records</div><span>Narrow records by subject, date, or attendance status</span></div><div class="attendance_filter_fields register"><label>Subject<select data-attendance-filter="subject"><option value="all">All subjects</option><option t-foreach="a['subjects']" t-as="s" t-att-value="s['name']" t-esc="s['name']"/></select></label><label>From date<input type="date" data-attendance-filter="from" t-att-value="d['filters']['date_from']"/></label><label>Through date<input type="date" data-attendance-filter="to" t-att-value="d['filters']['date_to']"/></label><label>Attendance status<select data-attendance-filter="status"><option value="all">All statuses</option><option value="present">Present</option><option value="late">Late</option><option value="absent">Absent</option><option value="onduty">On Duty</option><option value="excused">Excused</option><option value="cancelled">Cancelled</option></select></label><button type="button" class="attendance_button clear" data-attendance-reset="">Reset</button></div></div><section class="attendance_panel"><div class="attendance_panel_head"><div><h2>Attendance records</h2><p data-attendance-count="">Showing <t t-esc="len(a['rows'])"/> submitted sessions</p></div><input type="search" class="attendance_search" data-attendance-filter="search" placeholder="Search subject or date…" aria-label="Search attendance records"/></div><div class="attendance_table_wrap"><table data-attendance-register-table=""><thead><tr><th>Date &amp; time</th><th>Subject</th><th>Faculty</th><th>Room</th><th>Recorded status</th><th>Counts toward %</th><th>Record note</th></tr></thead><tbody><tr t-foreach="a['rows']" t-as="r" class="attendance_register_row" t-att-data-date="r['date_iso']" t-att-data-subject="r['subject']" t-att-data-status="r['status']"><td><strong t-esc="r['date']"/><small t-esc="r['time']"/></td><td t-esc="r['subject']"/><td t-esc="r['faculty']"/><td t-esc="r['room']"/><td><span t-att-class="'attendance_status ' + r['status']" t-esc="r['status'].title()"/></td><td><strong t-att-class="'attendance_good_value' if r['eligible'] else 'attendance_purple_value'" t-esc="'Yes' if r['eligible'] else 'No'"/></td><td t-esc="r['note']"/></tr><tr t-if="not a['rows']" class="attendance_no_records"><td colspan="7" class="attendance_empty">No completed attendance sessions match this period.</td></tr><tr class="attendance_no_matches" hidden="hidden"><td colspan="7" class="attendance_empty">No submitted sessions match these filters.</td></tr></tbody></table></div><div class="attendance_pagination"><span>Submitted college attendance records</span><span><t t-esc="len(a['rows'])"/> records</span></div></section><div class="attendance_notice"><b>Attendance correction:</b> If a record appears incorrect, contact the faculty member or academic office with the session date, subject and supporting evidence. This student view cannot edit attendance marks.</div></section>

      <section id="student_attendance_hourly" class="attendance_page" data-attendance-page="hourly" hidden="hidden">
        <div class="attendance_pagehead"><div><h1>Hourly Attendance</h1><p>Review attendance for each class session recorded for <t t-esc="d['student']['name']"/>.</p></div><span class="attendance_pill">Session-level view</span></div>
        <div class="attendance_filter_card"><div class="attendance_filter_top"><div class="attendance_filter_title"><span class="attendance_filter_symbol">◷</span>Filter hourly records</div><span>Uses class dates and times already present in this attendance register</span></div>
          <div class="attendance_filter_fields register">
            <label>Class date<input type="date" data-attendance-hourly-filter="date" aria-label="Class date"/></label>
            <label>Subject<select data-attendance-hourly-filter="subject" aria-label="Subject"><option value="all">All subjects</option><option t-foreach="a['subjects']" t-as="s" t-att-value="s['name']" t-esc="s['name']"/></select></label>
            <label>Attendance status<select data-attendance-hourly-filter="status" aria-label="Attendance status"><option value="all">All statuses</option><option value="present">Present</option><option value="late">Late</option><option value="absent">Absent</option><option value="onduty">On Duty</option><option value="excused">Excused</option><option value="cancelled">Cancelled</option></select></label>
            <label>Student<input t-att-value="d['student']['name']" readonly="readonly" aria-label="Student"/></label>
            <div class="attendance_filter_actions"><button class="attendance_button primary" type="button" data-attendance-hourly-apply="">Apply filters</button><button class="attendance_button clear" type="button" data-attendance-hourly-reset="">Reset</button></div>
          </div>
        </div>
        <div class="attendance_kpis">
          <article class="attendance_kpi green"><span class="attendance_kicon">✓</span><span class="attendance_kpi_label">Present / late sessions</span><strong data-attendance-hourly-count="attended">0</strong><small>Based on visible session records</small></article>
          <article class="attendance_kpi"><span class="attendance_kicon">◷</span><span class="attendance_kpi_label">Recorded sessions</span><strong data-attendance-hourly-count="recorded">0</strong><small>Only sessions in the submitted register</small></article>
          <article class="attendance_kpi purple"><span class="attendance_kicon">▣</span><span class="attendance_kpi_label">On Duty / excused / cancelled</span><strong data-attendance-hourly-count="other">0</strong><small>Shown separately from present</small></article>
          <article class="attendance_kpi amber"><span class="attendance_kicon">!</span><span class="attendance_kpi_label">Absent sessions</span><strong data-attendance-hourly-count="absent">0</strong><small>Check with faculty if incorrect</small></article>
        </div>
        <section class="attendance_panel"><div class="attendance_panel_head"><div><h2>Hourly class attendance register</h2><p>Each row is an existing class session, with its recorded time and attendance status.</p></div><input type="search" class="attendance_search" data-attendance-hourly-filter="search" placeholder="Search subject, faculty, room…" aria-label="Search hourly attendance"/></div>
          <div class="attendance_table_wrap"><table><thead><tr><th>Date</th><th>Class time</th><th>Subject</th><th>Faculty</th><th>Room</th><th>Hourly attendance</th><th>Counts toward %</th><th>Record note</th></tr></thead><tbody data-attendance-hourly-body="">
            <tr t-foreach="a['rows']" t-as="r" class="attendance_hourly_row" t-att-data-date="r['date_iso']" t-att-data-time="r['time']" t-att-data-subject="r['subject']" t-att-data-status="r['status']"><td><strong t-esc="r['date']"/></td><td t-esc="r['time']"/><td t-esc="r['subject']"/><td t-esc="r['faculty']"/><td t-esc="r['room']"/><td><span t-att-class="'attendance_status ' + r['status']" t-esc="'On Duty' if r['status'] == 'onduty' else r['status'].title()"/></td><td><strong t-att-class="'attendance_good_value' if r['eligible'] else 'attendance_purple_value'" t-esc="'Yes' if r['eligible'] else 'No'"/></td><td t-esc="r['note']"/></tr>
            <tr t-if="not a['rows']"><td colspan="8" class="attendance_empty">No submitted class sessions are available for this period.</td></tr><tr class="attendance_hourly_no_matches" hidden="hidden"><td colspan="8" class="attendance_empty">No class sessions match these filters.</td></tr>
          </tbody></table></div><div class="attendance_pagination"><span data-attendance-hourly-total="" aria-live="polite">Loading session records…</span><span>Submitted college attendance records</span></div>
        </section>
        <section class="attendance_panel"><div class="attendance_panel_head"><div><h2>Attendance by recorded time slot</h2><p>A compact breakdown of the class start times already present in the register.</p></div></div><div class="attendance_table_wrap"><table><thead><tr><th>Recorded start time</th><th>Sessions</th><th>Present / late</th><th>Absent</th><th>Other / excluded</th></tr></thead><tbody data-attendance-hourly-slots=""/></table></div>
          <div class="attendance_notice"><b>Recorded sessions only:</b> This view uses submitted class attendance and its saved start times. Classes without submitted attendance are not added as missing periods. On Duty and excused records follow the status and attendance policy saved by the college.</div>
        </section>
      </section>

      <section id="student_attendance_calendar" class="attendance_page" data-attendance-page="calendar" hidden="hidden"><div class="attendance_pagehead"><div><h1>Attendance Calendar</h1><p>Explore attendance by date and quickly identify patterns across the month.</p></div><span class="attendance_pill" data-attendance-month-label=""/></div><section class="attendance_panel"><div class="attendance_panel_head"><div><h2 data-attendance-month-title=""/><p>Submitted session markers for this student</p></div><div class="attendance_calendar_controls"><button type="button" class="attendance_button" data-attendance-month="prev" aria-label="Previous month">←</button><button type="button" class="attendance_button" data-attendance-month="today">Today</button><button type="button" class="attendance_button" data-attendance-month="next" aria-label="Next month">→</button></div></div><div class="attendance_month_grid" data-attendance-month-grid=""/><t t-call="ideastone_erp.student_attendance_legend"/></section><div class="attendance_grid2"><section class="attendance_panel"><h2>Calendar legend &amp; rules</h2><div class="attendance_details two"><div><span>Present</span><strong class="attendance_good_value">Counts as attended</strong></div><div><span>Late</span><strong class="attendance_warn_value">Counts as present</strong></div><div><span>Absent</span><strong class="attendance_bad_value">Counts as missed</strong></div><div><span>Excused</span><strong class="attendance_purple_value" t-esc="'Excluded from eligible sessions' if a['policy'] == 'exclude' else 'Counts as attended' if a['policy'] == 'present' else 'Follows college policy'"/></div></div><p class="attendance_subtle">Excused attendance follows the college’s configured policy. Confirm official eligibility rules with the academic office.</p></section><section class="attendance_panel"><h2>Helpful next steps</h2><p class="attendance_subtle">Use the register to verify a specific date. If leave was approved, check whether the final register excludes it from the denominator.</p><a href="#student_attendance_register" class="attendance_button primary" data-attendance-tab="register">Review session register ↗</a></section></div></section>
    </div>
  </template>
  <template id="student_attendance_legend"><div class="attendance_legend"><span><i class="attendance_dot present"/>Present</span><span><i class="attendance_dot late"/>Late</span><span><i class="attendance_dot absent"/>Absent</span><span><i class="attendance_dot excused"/>Excused</span><span><i class="attendance_dot future"/>No class / future</span></div></template>
</odoo>
