<odoo>
  <record id="action_owner_attendance_overview" model="ir.actions.client"><field name="name">Attendance Overview</field><field name="tag">ideastone_erp.owner_attendance_overview</field><field name="context">{'campus_module': 'attendance'}</field></record>
  <record id="access_assigned_attendance_review" model="ir.model.access"><field name="name">HR reads assigned attendance review</field><field name="model_id" ref="model_campus_service_request"/><field name="group_id" ref="ideastone_erp.group_people"/><field name="perm_read" eval="True"/></record>
  <record id="access_hod_attendance_review" model="ir.model.access"><field name="name">HOD reads assigned attendance review</field><field name="model_id" ref="model_campus_service_request"/><field name="group_id" ref="ideastone_erp.group_od_hod_approver"/><field name="perm_read" eval="True"/></record>
  <record id="access_readonly_hod_attendance_review" model="ir.model.access"><field name="name">Department head reads assigned attendance review</field><field name="model_id" ref="model_campus_service_request"/><field name="group_id" ref="ideastone_erp.group_mvp_hod"/><field name="perm_read" eval="True"/></record>
  <record id="rule_assigned_attendance_review" model="ir.rule"><field name="name">Only attendance reviews assigned to me</field><field name="model_id" ref="model_campus_service_request"/><field name="groups" eval="[(6, 0, [ref('ideastone_erp.group_people'), ref('ideastone_erp.group_od_hod_approver'), ref('ideastone_erp.group_mvp_hod'), ref('openeducat_core.group_op_faculty')])]"/><field name="domain_force">[('attendance_review_mode','!=',False),('attendance_review_assignee_id','=',user.id)]</field><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/></record>
  <record id="rule_owner_attendance_review" model="ir.rule"><field name="name">Retain owner service-register scope</field><field name="model_id" ref="model_campus_service_request"/><field name="groups" eval="[(4, ref('ideastone_erp.group_mvp_owner')), (4, ref('base.group_system'))]"/><field name="domain_force">[(1,'=',1)]</field></record>
  <record id="view_attendance_review_details" model="ir.ui.view"><field name="name">campus.service.attendance.review</field><field name="model">campus.service.request</field><field name="inherit_id" ref="view_service_request_form"/><field name="arch" type="xml"><xpath expr="//sheet/group" position="after"><group string="Attendance review" invisible="not attendance_review_mode"><field name="attendance_review_mode" readonly="True"/><field name="attendance_review_department" readonly="True"/><field name="attendance_review_assignee_id" readonly="True"/><field name="attendance_review_escalated" readonly="True"/></group></xpath></field></record>
</odoo>
