<odoo>
  <template id="student_action_fields">
    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
    <t t-if="portal_data"><input type="hidden" name="enrolment" t-att-value="portal_data['filters']['enrolment']"/><input type="hidden" name="date_from" t-att-value="portal_data['filters']['date_from']"/><input type="hidden" name="date_to" t-att-value="portal_data['filters']['date_to']"/></t>
  </template>
  <template id="student_workspace" name="Student workspace">
    <t t-call="web.frontend_layout">
      <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><t t-set="body_classname" t-value="'campus_student_body'"/>
      <t t-set="d" t-value="portal_data"/>
      <div id="campus_student_workspace" class="student_workspace">
        <a class="student_skip" href="#student_main">Skip to content</a>
        <aside id="student_sidebar" class="student_sidebar" aria-label="Student navigation">
          <a class="student_brand" href="/my/campus"><img src="/ideastone_campus/static/src/img/vcet-wordmark.png" alt="Campus ERP"/><span>Campus Management ERP</span></a>
          <span class="student_nav_heading">STUDENT WORKSPACE</span>
          <nav t-if="d"><a t-foreach="d['navigation']" t-as="item" t-att-href="student_url_for(item[0])" t-att-class="'student_nav_link active' if section == item[0] else 'student_nav_link'" t-att-aria-current="'page' if section == item[0] else None"><i t-att-class="'fa fa-' + item[2]" aria-hidden="true"/><span t-esc="item[1]"/></a></nav>
          <div class="student_sidebar_bottom"><strong t-if="d" t-esc="d['company']"/><span>Student self-service</span><a href="/web/session/logout?redirect=/web/login">Sign out <i class="fa fa-sign-out" aria-hidden="true"/></a></div>
        </aside>
        <button type="button" class="student_backdrop" aria-label="Close navigation" hidden="hidden"/>
        <div class="student_main_wrap">
          <header class="student_header"><div><button class="student_menu" type="button" aria-label="Toggle student navigation" aria-controls="student_sidebar" aria-expanded="false"><i class="fa fa-bars" aria-hidden="true"/></button><span class="student_header_title">My campus</span></div><div t-if="d" class="student_header_actions"><a t-att-href="student_url_for('notices')" aria-label="Notices"><i class="fa fa-bell-o" aria-hidden="true"/><span t-if="d['notice_badge'] and d['unread']" class="student_count" t-esc="d['unread']"/></a><a t-att-href="student_url_for('requests')" aria-label="Request updates"><i class="fa fa-inbox" aria-hidden="true"/><span t-if="d['updates']" class="student_count" t-esc="d['updates']"/></a><details class="student_profile_menu"><summary><span class="student_avatar" t-esc="d['student']['name'][:1]"/><span t-esc="d['student']['name']"/></summary><div><a t-att-href="student_url_for('profile')">My Profile</a><a t-att-href="student_url_for('account')">Account &amp; Preferences</a><a href="/web/session/logout?redirect=/web/login">Sign out</a></div></details></div></header>
          <nav t-if="d" class="student_subnav" aria-label="Student submodules"><strong t-esc="dict((item[0], item[1]) for item in d['navigation'])[section]"/><t t-if="section == 'profile'"><a href="#student_personal">Personal details</a><a href="#student_guardians">Guardian contacts</a><a href="#student_documents">Documents</a></t><t t-elif="section == 'academics'"><a href="#student_enrolment">Enrolment</a><a href="#student_subjects">Subjects</a><a href="#student_materials">Learning materials</a></t><t t-elif="section == 'attendance'"><a href="#student_attendance_summary">Summary</a><a href="#student_attendance_register">Session register</a></t><t t-elif="section == 'exams'"><a href="#student_exam_schedule">Exam schedule</a><a href="#student_results">My results</a></t><t t-elif="section == 'fees'"><a href="#student_fee_ledger">Fee details</a><a href="#student_receipts">Payment history</a></t><t t-elif="section == 'requests'"><a href="#student_request_new">New request</a><a href="#student_request_history">My requests</a></t><a t-else="" href="#student_main">Overview</a></nav>
          <main id="student_main" class="student_main" tabindex="-1">
            <div class="student_network_error alert alert-danger" role="alert" hidden="hidden"><span/><button type="button" class="btn btn-outline-danger student_retry">Retry</button></div>
            <div class="student_busy" role="status" hidden="hidden">Loading your saved records…</div>
            <div t-if="portal_error" class="student_panel"><h1>Student workspace</h1><div class="alert alert-info" role="alert" t-esc="portal_error"/><a class="btn btn-primary" href="/my/campus">Retry student access</a><p>For an account-link correction, contact the college office. Your login does not grant access to another student's information.</p><a href="/web/session/logout?redirect=/web/login">Sign out</a></div>
            <t t-if="d">
              <div class="student_breadcrumb"><span>My campus / <t t-esc="dict((item[0], item[1]) for item in d['navigation'])[section]"/></span><span t-esc="d['today']"/></div>
              <div t-if="saved" class="alert alert-success" role="status">Your changes have been saved.</div><div t-if="form_error" class="alert alert-danger" role="alert" t-esc="form_error"/>
              <div t-if="d['demo']" class="student_demo">DEMONSTRATION COLLEGE · SAMPLE DATA</div>
              <header class="student_page_heading"><div><h1 t-esc="dict((item[0], item[1]) for item in d['navigation'])[section]"/><p><t t-esc="d['placement']['programme']"/> · <t t-esc="d['placement']['semester']"/> · <t t-esc="d['placement']['section']"/></p></div><span class="student_chip"><i class="fa fa-id-card-o" aria-hidden="true"/> <t t-esc="d['student']['number']"/></span></header>
              <form t-if="d['placements'] and section in ['dashboard','academics','timetable','attendance','exams']" method="get" t-att-action="'/my/campus/student/' + section" class="student_filters student_panel"><label for="student_term">Academic placement<select id="student_term" name="enrolment" class="form-select"><option t-foreach="d['placements']" t-as="p" t-att-value="p['id']" t-att-selected="p['id'] == d['placement']['id']" t-esc="p['label']"/></select></label><label for="student_from">Class records from<input id="student_from" type="date" class="form-control" name="date_from" t-att-value="d['filters']['date_from']" required="required"/></label><label for="student_to">Through<input id="student_to" type="date" class="form-control" name="date_to" t-att-value="d['filters']['date_to']" required="required"/></label><button class="btn btn-primary" type="submit">Apply</button></form>
              <t t-if="section == 'dashboard'" t-call="ideastone_erp.student_dashboard"/>
              <t t-elif="section == 'profile'" t-call="ideastone_erp.student_profile"/>
              <t t-elif="section == 'academics'" t-call="ideastone_erp.student_academics"/>
              <t t-elif="section == 'timetable'" t-call="ideastone_erp.student_timetable"/>
              <t t-elif="section == 'attendance'" t-call="ideastone_erp.student_attendance"/>
              <t t-elif="section == 'exams'" t-call="ideastone_erp.student_exams"/>
              <t t-elif="section == 'fees'" t-call="ideastone_erp.student_fees"/>
              <t t-elif="section == 'notices'" t-call="ideastone_erp.student_notices"/>
              <t t-elif="section == 'requests'" t-call="ideastone_erp.student_requests"/>
              <t t-elif="section == 'library'" t-call="ideastone_erp.student_library"/>
              <t t-elif="section == 'help'" t-call="ideastone_erp.student_help"/>
              <t t-elif="section == 'account'" t-call="ideastone_erp.student_account"/>
              <footer class="student_footer"><t t-esc="d['company']"/> · Student workspace · Powered by Ideastone</footer>
            </t>
          </main>
        </div>
      </div>
    </t>
  </template>
  <template id="student_dashboard">
    <section class="student_welcome"><div><span>YOUR CAMPUS, CONNECTED</span><h2>Welcome back, <t t-esc="d['student']['name']"/></h2><p>Plan your classes, follow your progress and keep track of what needs attention.</p></div><i class="fa fa-graduation-cap" aria-hidden="true"/></section>
    <section class="student_stats" aria-label="Student summary">
      <a t-att-href="student_url_for('timetable')" class="student_stat"><i class="fa fa-calendar" aria-hidden="true"/><span>Today's classes</span><strong t-esc="len(d['today_classes'])"/><small>Remaining or in progress · <t t-esc="d['timezone']"/></small></a>
      <a t-att-href="student_url_for('attendance')" class="student_stat"><i class="fa fa-calendar-check-o" aria-hidden="true"/><span>Attendance</span><strong><t t-esc="str(d['attendance']['rate']) + '%' if d['attendance']['rate'] is not None else '—'"/></strong><small t-esc="'At risk' if d['attendance']['shortage'] else 'Good standing' if d['attendance']['rate'] is not None else 'No eligible sessions recorded'"/></a>
      <a t-att-href="student_url_for('fees')" class="student_stat"><i class="fa fa-inr" aria-hidden="true"/><span>Fees due</span><strong t-esc="money(d['fees']['due']) if d['fees']['recorded'] else '—'"/><small>All posted college invoices</small></a>
      <a t-att-href="student_url_for('exams')" class="student_stat"><i class="fa fa-file-text-o" aria-hidden="true"/><span>Upcoming exams</span><strong t-esc="len([e for e in d['exams'] if e['upcoming']])"/><small>Released schedules for this placement</small></a>
      <a t-att-href="student_url_for('notices')" class="student_stat"><i class="fa fa-bell-o" aria-hidden="true"/><span>Unread notices</span><strong t-esc="d['unread']"/><small>Published for your college and audience</small></a>
    </section>
    <div class="student_grid">
      <section class="student_panel"><div class="student_panel_heading"><h2>Today's schedule</h2><a t-att-href="student_url_for('timetable')">View timetable <i class="fa fa-angle-right"/></a></div><article t-foreach="d['today_classes'][:5]" t-as="s" class="student_record"><span class="student_chip" t-esc="s['start']"/><h3 t-esc="s['subject']"/><p><t t-esc="s['room']"/> · <t t-esc="s['faculty']"/></p></article><p t-if="not d['today_classes']" class="student_empty">No remaining classes are recorded for today in the selected academic placement.</p></section>
      <section class="student_panel"><div class="student_panel_heading"><h2>Attendance by subject</h2><a t-att-href="student_url_for('attendance')">Details</a></div><t t-call="ideastone_erp.student_attendance_bars"/></section>
      <section class="student_panel"><div class="student_panel_heading"><h2>Fee summary</h2><a t-att-href="student_url_for('fees')">Fee details</a></div><t t-if="d['fees']['recorded']"><p>Settled / paid <strong t-esc="money(d['fees']['paid'])"/> of <t t-esc="money(d['fees']['assessed'])"/></p><div class="student_progress" role="img" t-att-aria-label="'Settled ' + str(round(d['fees']['progress'], 1)) + ' percent'"><span t-att-style="'width: ' + str(d['fees']['progress']) + '%'"/></div><p class="student_muted">Outstanding balance: <strong t-esc="money(d['fees']['due'])"/></p><p t-if="not d['fees']['due']" class="student_success">No dues currently recorded.</p></t><p t-else="" class="student_empty">No posted fee ledger is recorded for your account. Contact the accounts office if an assessment is expected.</p></section>
      <section class="student_panel"><div class="student_panel_heading"><h2>Upcoming examinations</h2><a t-att-href="student_url_for('exams')">Exam schedule</a></div><article t-foreach="[e for e in d['exams'] if e['upcoming']][:4]" t-as="e" class="student_record"><h3 t-esc="e['subject']"/><p><t t-esc="e['name']"/> · <t t-esc="e['start']"/></p></article><p t-if="not any(e['upcoming'] for e in d['exams'])" class="student_empty">No upcoming examination schedule has been released for this placement.</p></section>
      <section class="student_panel"><div class="student_panel_heading"><h2>Recent notices</h2><a t-att-href="student_url_for('notices')">View all</a></div><article t-foreach="d['notices'][:4]" t-as="n" class="student_record"><span t-att-class="'student_chip' if n['read'] else 'student_chip student_unread'" t-esc="'Read' if n['read'] else 'Unread'"/><h3 t-esc="n['name']"/><p><t t-esc="n['date']"/> · <t t-esc="n['category']"/></p></article><p t-if="not d['notices']" class="student_empty">No current notices are published for your audience.</p></section>
      <section class="student_panel"><div class="student_panel_heading"><h2>My request updates</h2><a t-att-href="student_url_for('requests')">My requests</a></div><article t-foreach="d['requests'][:4]" t-as="r" class="student_record"><span class="student_chip" t-esc="r['status']"/><h3 t-esc="r['name']"/><p t-esc="r['reference']"/></article><p t-if="not d['requests']" class="student_empty">No requests submitted yet. The college request centre handles certificates, corrections and support.</p></section>
    </div>
    <section class="student_panel student_quick"><h2>Quick actions</h2><a t-att-href="student_url_for('timetable')">View timetable</a><a t-att-href="student_url_for('attendance')">My attendance</a><a t-att-href="student_url_for('fees')">Fee details</a><a t-att-href="student_url_for('exams') + '#student_results'">My results</a><a t-att-href="student_url_for('requests')">Request a certificate</a></section>
  </template>
  <template id="student_profile">
    <div class="student_grid">
      <section class="student_panel" id="student_personal"><h2>Personal details</h2><dl class="student_details"><dt>Official name</dt><dd t-esc="d['student']['name']"/><dt>Student number</dt><dd t-esc="d['student']['number']"/><dt>Register / roll number</dt><dd t-esc="d['student']['register']"/><dt>Status</dt><dd t-esc="d['student']['status'].replace('_',' ').title()"/><dt>Admission date</dt><dd t-esc="d['student']['admitted'] or 'Not recorded'"/><dt>Email</dt><dd t-esc="d['student']['email'] or 'Not recorded'"/></dl><p class="student_muted">Official identity and academic details are maintained by the college.</p><a class="btn btn-outline-primary" t-att-href="student_url_for('requests')">Request a correction</a></section>
      <section class="student_panel"><h2>Contact &amp; address</h2><form t-if="d['contact_edit']" action="/my/campus/student/action" method="post"><t t-call="ideastone_erp.student_action_fields"/><input type="hidden" name="operation" value="profile"/><input type="hidden" name="return_to" value="profile"/><label t-foreach="[('phone','Phone'),('mobile','Mobile'),('street','Address'),('street2','Address line 2'),('city','City'),('zip','Postal code')]" t-as="f" t-att-for="'profile_' + f[0]"><t t-esc="f[1]"/><input class="form-control" t-att-id="'profile_' + f[0]" t-att-name="f[0]" t-att-value="d['student'][f[0]]" maxlength="250"/></label><button type="submit" class="btn btn-primary">Save contact details</button></form><t t-else=""><p><strong>Phone:</strong> <t t-esc="d['student']['phone'] or d['student']['mobile'] or 'Not recorded'"/></p><p><strong>Address:</strong> <t t-esc="', '.join(v for v in [d['student']['street'],d['student']['street2'],d['student']['city'],d['student']['zip']] if v) or 'Not recorded'"/></p><p class="student_muted">Contact editing is controlled by your college. Submit a correction request to update locked details.</p></t></section>
      <section class="student_panel" id="student_guardians"><h2>Guardian contacts</h2><article t-foreach="d['guardians']" t-as="g" class="student_record"><h3 t-esc="g['name']"/><p><t t-esc="g['phone']"/> <t t-esc="g['email']"/></p></article><p t-if="not d['guardians']" class="student_empty">No guardian contact is recorded. Ask the college office to update your profile.</p></section>
      <section class="student_panel" id="student_documents"><h2>My documents</h2><article t-foreach="d['documents']" t-as="doc" class="student_record"><h3 t-esc="doc['name']"/><p t-esc="doc['state'].title()"/><a t-att-href="'/my/campus/student/download/document/%s' % doc['id']">Download <t t-esc="doc['filename']"/></a></article><p t-if="not d['documents']" class="student_empty">No documents are linked to your student record.</p></section>
    </div>
  </template>
  <template id="student_academics">
    <t t-call="ideastone_erp.student_academics_content"/>
    <!-- Keep the legacy inheritance target available while an installed module upgrades. -->
    <section id="student_materials" t-if="False"/>
  </template>
  <template id="student_timetable">
    <section class="student_panel"><div class="student_panel_heading"><h2>My class timetable</h2><span class="student_chip" t-esc="d['timezone']"/></div><p>Confirmed and cancelled classes from the college timetable for the selected placement and class-record period.</p><div class="student_timetable_controls" role="group" aria-label="Timetable range" t-att-data-today="d['today_iso']"><button type="button" class="btn btn-outline-primary" data-timetable="today" aria-pressed="false">Today</button><button type="button" class="btn btn-outline-primary" data-timetable="week" aria-pressed="false">This week</button><button type="button" class="btn btn-primary" data-timetable="all" aria-pressed="true">Selected period</button></div><p class="student_timetable_empty student_empty" role="status" hidden="hidden">No published classes fall in this timetable range.</p><div class="student_table_wrap"><table class="table"><thead><tr><th scope="col">Subject</th><th scope="col">Start</th><th scope="col">End</th><th scope="col">Faculty / room</th><th scope="col">Status</th><th scope="col">Updated</th></tr></thead><tbody><tr t-foreach="d['schedule']" t-as="s" class="student_timetable_row" t-att-data-day="s['day']"><td><strong t-esc="s['subject']"/><small t-esc="s['code']"/></td><td t-esc="s['start']"/><td t-esc="s['end']"/><td><t t-esc="s['faculty']"/><small t-esc="s['room']"/></td><td t-esc="'Cancelled' if s['status'] == 'cancel' else 'Confirmed'"/><td t-esc="s['updated']"/></tr></tbody></table></div><p t-if="not d['schedule']" class="student_empty">No timetable has been published for this placement and period. Check college notices or contact the academic office.</p></section>
  </template>
  <template id="student_attendance_bars">
    <div t-foreach="d['attendance']['subjects']" t-as="s" class="student_chart_row"><div><strong t-esc="s['name']"/><span><t t-esc="s['attended']"/> / <t t-esc="s['eligible']"/> · <t t-esc="str(s['rate']) + '%' if s['rate'] is not None else 'Not recorded'"/></span></div><div t-if="s['rate'] is not None" class="student_progress"><span t-att-style="'width: ' + str(s['rate']) + '%'"/></div><small t-if="s['shortage']" class="student_warning">Below the college attendance threshold</small></div><p t-if="not d['attendance']['subjects']" class="student_empty">No submitted attendance is recorded for this period.</p>
  </template>
  <template id="student_attendance">
    <section class="student_panel" id="student_attendance_summary"><h2>Attendance summary</h2><div class="student_attendance_total"><strong t-esc="str(d['attendance']['rate']) + '%' if d['attendance']['rate'] is not None else 'Not recorded'"/><span><t t-esc="d['attendance']['attended']"/> attended / <t t-esc="d['attendance']['conducted']"/> eligible sessions</span></div><p>College threshold: <strong><t t-esc="d['attendance']['threshold']"/>%</strong>. Late counts as present. Excused policy: <strong t-esc="d['attendance']['policy']"/>. Cancelled sessions are excluded.</p><p t-if="d['attendance']['shortage']" class="student_warning">Your recorded attendance is below the configured college threshold.</p><t t-call="ideastone_erp.student_attendance_bars"/></section>
    <section t-if="len(d['attendance']['trend']) &gt; 1" class="student_panel"><h2>Monthly attendance trend</h2><div t-foreach="d['attendance']['trend']" t-as="row" class="student_chart_row"><div><span t-esc="row['month']"/><strong><t t-esc="row['rate']"/>%</strong></div><div class="student_progress"><span t-att-style="'width: ' + str(row['rate']) + '%'"/></div></div></section>
    <section class="student_panel" id="student_attendance_register"><h2>Session register</h2><div class="student_table_wrap"><table class="table"><thead><tr><th scope="col">Date</th><th scope="col">Subject</th><th scope="col">Recorded status</th><th scope="col">In denominator</th><th scope="col">Action</th></tr></thead><tbody><tr t-foreach="d['attendance']['rows']" t-as="r"><td t-esc="r['date']"/><td t-esc="r['subject']"/><td t-esc="r['status'].title()"/><td t-esc="'Yes' if r['eligible'] else 'Excluded by policy'"/><td><a t-att-href="student_url_for('requests')">Request correction</a></td></tr></tbody></table></div><p t-if="not d['attendance']['rows']" class="student_empty">No completed attendance sessions match the selected period.</p></section>
  </template>
  <template id="student_exams">
    <section class="student_panel" id="student_exam_schedule"><h2>Released examination schedule</h2><p>Times are shown in <t t-esc="d['timezone']"/>. Only schedules released by the examination office are shown.</p><div class="student_table_wrap"><table class="table"><thead><tr><th scope="col">Examination</th><th scope="col">Subject</th><th scope="col">Start</th><th scope="col">End</th></tr></thead><tbody><tr t-foreach="d['exams']" t-as="e"><td t-esc="e['name']"/><td><t t-esc="e['subject']"/><small t-esc="e['code']"/></td><td t-esc="e['start']"/><td t-esc="e['end']"/></tr></tbody></table></div><p t-if="not d['exams']" class="student_empty">No exam schedule has been released for this academic placement.</p><div class="student_info">Official hall-ticket documents have not been configured for this portal. Contact the examination office for an issued document; no unofficial admit card is generated here.</div></section>
    <section class="student_panel" id="student_results"><h2>My published results</h2><div class="student_table_wrap"><table class="table"><thead><tr><th scope="col">Examination</th><th scope="col">Subject</th><th scope="col">Marks</th><th scope="col">Maximum</th><th scope="col">Official grade</th><th scope="col">Result</th></tr></thead><tbody><tr t-foreach="d['results']" t-as="r"><td t-esc="r['exam']"/><td><t t-esc="r['subject']"/><small t-esc="r['code']"/></td><td t-esc="r['marks']"/><td t-esc="r['maximum']"/><td t-esc="r['grade']"/><td t-esc="r['status']"/></tr></tbody></table></div><p t-if="not d['results']" class="student_empty">Results appear here after official publication. Draft and unpublished marks remain private.</p></section>
  </template>
  <template id="student_fees">
    <section class="student_stats student_fee_stats"><div class="student_stat"><span>Total assessed</span><strong t-esc="money(d['fees']['assessed']) if d['fees']['recorded'] else 'Not recorded'"/></div><div class="student_stat"><span>Settled / paid</span><strong t-esc="money(d['fees']['paid']) if d['fees']['recorded'] else 'Not recorded'"/></div><div class="student_stat"><span>Outstanding</span><strong t-esc="money(d['fees']['due']) if d['fees']['recorded'] else 'Not recorded'"/></div></section>
    <section class="student_panel" id="student_fee_ledger"><h2>My fee ledger</h2><p>All posted college invoices, including earlier academic periods. Balances include posted payments and accounting adjustments.</p><div class="student_table_wrap"><table class="table"><thead><tr><th scope="col">Invoice / fee heads</th><th scope="col">Date / due</th><th scope="col">Net assessed</th><th scope="col">Invoice discounts / concessions</th><th scope="col">Settled</th><th scope="col">Balance</th><th scope="col">Status</th></tr></thead><tbody><tr t-foreach="d['fees']['invoices']" t-as="i"><td><strong t-esc="i['name']"/><small t-esc="i['heads']"/><small><t t-esc="i['programme']"/> · <t t-esc="i['year']"/></small></td><td><t t-esc="i['date']"/><small>Due <t t-esc="i['due_date']"/></small></td><td t-esc="money(i['total'])"/><td t-esc="money(i['concession'])"/><td t-esc="money(i['paid'])"/><td t-esc="money(i['balance'])"/><td><span t-esc="i['state'].replace('_',' ').title()"/><small t-if="i['overdue']" class="student_warning">Overdue</small></td></tr></tbody></table></div><p t-if="not d['fees']['recorded']" class="student_empty">No posted fee ledger is recorded for your account.</p><p t-elif="not d['fees']['due']" class="student_success">No dues currently recorded.</p><div class="student_info">Online payment is not enabled through an approved college gateway. Contact the accounts office to pay; verified posted payments and official receipts appear below.</div></section>
    <section class="student_panel" id="student_receipts"><h2>Payment history &amp; official receipts</h2><div class="student_table_wrap"><table class="table"><thead><tr><th scope="col">Receipt</th><th scope="col">Date</th><th scope="col">Amount</th><th scope="col">Method / reference</th><th scope="col">Status</th><th scope="col">Document</th></tr></thead><tbody><tr t-foreach="d['fees']['payments']" t-as="p"><td t-esc="p['reference']"/><td t-esc="p['date']"/><td t-esc="money(p['amount'])"/><td><t t-esc="p['method'].title()"/><small t-esc="p['transaction']"/></td><td t-esc="p['status']"/><td><a t-att-href="p['url']">Download receipt</a></td></tr></tbody></table></div><p t-if="not d['fees']['payments']" class="student_empty">No posted college receipts are recorded. Pending or unverified payment attempts are not shown as paid.</p></section>
  </template>
  <template id="student_notices">
    <section class="student_panel"><h2>Published notices</h2><article t-foreach="d['notices']" t-as="n" class="student_notice"><div class="student_panel_heading"><div><span class="student_chip" t-esc="n['category']"/><h3 t-esc="n['name']"/><p><t t-esc="n['date']"/> · <t t-esc="'Read' if n['read'] else 'Unread'"/></p></div><form action="/my/campus/student/action" method="post"><t t-call="ideastone_erp.student_action_fields"/><input type="hidden" name="operation" value="notice"/><input type="hidden" name="return_to" value="notices"/><input type="hidden" name="notice_id" t-att-value="n['id']"/><input type="hidden" name="read" t-att-value="'false' if n['read'] else 'true'"/><button type="submit" class="btn btn-outline-primary" t-esc="'Mark unread' if n['read'] else 'Mark read'"/></form></div><div t-out="notice_body(n['body'])"/><a t-foreach="n['files']" t-as="f" t-att-href="'/my/campus/student/download/notice/%s' % f['id']" class="student_file">Download <t t-esc="f['name']"/></a></article><p t-if="not d['notices']" class="student_empty">No current notices are published for your student audience.</p></section>
    <section class="student_panel"><h2>Academic calendar</h2><p>Released exam dates are shown with their authoritative source. Class sessions remain in your timetable.</p><article t-foreach="d['exams']" t-as="e" class="student_record"><span class="student_chip">Examination</span><h3 t-esc="e['subject']"/><p><t t-esc="e['start']"/> · <t t-esc="e['name']"/></p></article><p t-if="not d['exams']" class="student_empty">No released examination events are available.</p><a t-att-href="student_url_for('timetable')">View class timetable</a></section>
  </template>
  <template id="student_requests">
    <section class="student_panel" id="student_request_new"><h2>Submit a student request</h2><form action="/my/campus/student/action" method="post" enctype="multipart/form-data"><t t-call="ideastone_erp.student_action_fields"/><input type="hidden" name="operation" value="request"/><input type="hidden" name="return_to" value="requests"/><input type="hidden" name="key" t-att-value="d['submission_key']"/><label for="student_request_type">Request type<select id="student_request_type" class="form-select student_request_type" name="type_id" required="required"><option t-foreach="d['request_types']" t-as="t" t-att-value="t['id']" t-att-data-guidance="t['guidance']" t-att-data-fee="t['fee']" t-att-data-limit="t['max_mb']" t-att-data-required="'true' if t['require_file'] else 'false'" t-esc="t['name']"/></select></label><p class="student_type_guidance student_info"/><p class="student_type_fee student_muted"/><label for="student_request_title">Title<input id="student_request_title" class="form-control" name="title" required="required" maxlength="200"/></label><label for="student_request_description">Details<textarea id="student_request_description" class="form-control" name="description" required="required" maxlength="5000" rows="4"/></label><label for="student_request_file">Supporting file<input id="student_request_file" class="form-control" type="file" name="file" accept=".pdf,.png,.jpg,.jpeg,.txt"/></label><p class="student_upload_guidance student_muted">Only PDF, PNG, JPEG and UTF-8 text are accepted. Files are checked on the server.</p><button type="submit" class="btn btn-primary">Submit request</button></form><p t-if="not d['request_types']" class="student_empty">No request types have been enabled. Contact the college office.</p></section>
    <section class="student_panel" id="student_request_history"><div class="student_panel_heading"><h2>My requests <span t-esc="'(%s)' % len(d['requests'])"/></h2><form t-if="d['updates']" action="/my/campus/student/action" method="post"><t t-call="ideastone_erp.student_action_fields"/><input type="hidden" name="operation" value="updates"/><input type="hidden" name="return_to" value="requests"/><button type="submit" class="btn btn-outline-primary">Mark updates read</button></form></div><details t-foreach="d['requests']" t-as="r" class="student_case"><summary><div><strong t-esc="r['name']"/><small><t t-esc="r['reference']"/> · <t t-esc="r['date']"/></small></div><span class="student_chip" t-esc="r['status']"/></summary><p t-esc="r['description']"/><p t-if="r['reply']"><strong>College response: </strong><t t-esc="r['reply']"/></p><p t-if="r['student_reply']"><strong>Your additional information: </strong><t t-esc="r['student_reply']"/></p><a t-if="r['file']" class="btn btn-primary" t-att-href="'/my/campus/student/download/request/%s' % r['id']">Download official document</a><form t-if="r['state'] == 'information'" action="/my/campus/student/action" method="post"><t t-call="ideastone_erp.student_action_fields"/><input type="hidden" name="operation" value="reply"/><input type="hidden" name="return_to" value="requests"/><input type="hidden" name="request_id" t-att-value="r['id']"/><label t-att-for="'student_reply_%s' % r['id']">Requested information<textarea t-att-id="'student_reply_%s' % r['id']" name="reply" class="form-control" required="required" maxlength="5000"/></label><button class="btn btn-primary" type="submit">Send information</button></form><form t-if="r['can_cancel']" action="/my/campus/student/action" method="post"><t t-call="ideastone_erp.student_action_fields"/><input type="hidden" name="operation" value="cancel"/><input type="hidden" name="return_to" value="requests"/><input type="hidden" name="request_id" t-att-value="r['id']"/><button class="btn btn-outline-danger" type="submit">Cancel request</button></form><h3>Status history</h3><div t-foreach="r['events']" t-as="e" class="student_record"><strong t-esc="e['name']"/><small t-esc="e['date']"/><p t-if="e['response']" t-esc="e['response']"/></div></details><p t-if="not d['requests']" class="student_empty">You have not submitted any student requests.</p></section>
  </template>
  <template id="student_library">
    <section class="student_panel"><h2>My library loans</h2><div class="student_table_wrap"><table class="table"><thead><tr><th scope="col">Book</th><th scope="col">Issued</th><th scope="col">Due</th><th scope="col">Status</th><th scope="col">Recorded fine</th></tr></thead><tbody><tr t-foreach="d['loans']" t-as="loan"><td><t t-esc="loan['name']"/><small t-esc="loan['code']"/></td><td t-esc="loan['issued']"/><td t-esc="loan['due']"/><td><t t-esc="loan['state'].replace('_',' ').title()"/><small t-if="loan['overdue']" class="student_warning">Overdue — contact the library</small></td><td t-esc="money(loan['penalty'])"/></tr></tbody></table></div><p t-if="not d['loans']" class="student_empty">No library loans are recorded for your account.</p><p class="student_muted">Renewal and reservations are handled by the library desk; this portal does not change circulation records.</p></section>
    <section class="student_panel"><h2>College catalogue</h2><label for="student_book_search">Filter listed titles<input id="student_book_search" type="search" class="form-control student_book_search" placeholder="Book name or code"/></label><div class="student_books"><article t-foreach="d['books']" t-as="book" class="student_record"><h3 t-esc="book['name']"/><p t-esc="book['code']"/></article></div><p t-if="not d['books']" class="student_empty">No physical titles are available in this college catalogue.</p><a t-att-href="student_url_for('academics') + '#student_materials'">Digital resources</a></section>
  </template>
  <template id="student_help">
    <section class="student_panel"><h2>College support</h2><p t-if="d['support_email']"><strong>Email:</strong> <a t-att-href="'mailto:' + d['support_email']" t-esc="d['support_email']"/></p><p t-if="d['support_phone']"><strong>Phone:</strong> <t t-esc="d['support_phone']"/></p><p t-if="not d['support_email'] and not d['support_phone']">Contact details have not been configured. Visit your college office or use the student request centre.</p><a class="btn btn-primary" t-att-href="student_url_for('requests')">Create support request</a><details class="student_faq"><summary>How do I correct my official details?</summary><p>Submit a Profile correction request with the field and supporting evidence. Official identity and academic records stay under college control.</p></details><details class="student_faq"><summary>Why are my results missing?</summary><p>Only officially published results are visible. Contact the examination office if publication is expected.</p></details><details class="student_faq"><summary>How are attendance shortages calculated?</summary><p>The college policy counts late as present and treats excused sessions according to its configured rule. Cancelled classes do not count.</p></details></section>
    <section class="student_panel"><h2>Institutional feedback</h2><p class="student_muted">Feedback is linked to your student account and visible to authorized college staff. Do not include passwords or confidential payment credentials.</p><form action="/my/campus/student/action" method="post"><t t-call="ideastone_erp.student_action_fields"/><input type="hidden" name="operation" value="feedback"/><input type="hidden" name="return_to" value="help"/><label for="student_feedback_period">Academic period<input id="student_feedback_period" class="form-control" name="period" required="required" maxlength="80" t-att-value="d['placement']['year']"/></label><label for="student_feedback_score">Rating<select id="student_feedback_score" class="form-select" name="score"><option value="1">1 — Needs improvement</option><option value="2">2 — Fair</option><option value="3">3 — Good</option><option value="4">4 — Very good</option><option value="5">5 — Excellent</option></select></label><label for="student_feedback_comments">Comments<textarea id="student_feedback_comments" class="form-control" name="comments" maxlength="5000" rows="4"/></label><button type="submit" class="btn btn-primary">Submit feedback</button></form></section>
  </template>
  <template id="student_account">
    <section class="student_panel"><h2>Account &amp; security</h2><p><strong>Signed in as:</strong> <t t-esc="d['login']"/></p><p>Password changes use the ERP's existing secure account flow. The portal never displays or stores a plaintext password.</p><a class="btn btn-outline-primary" href="/my/security">Manage account security</a><a class="btn btn-outline-danger" href="/web/session/logout?redirect=/web/login">Sign out</a></section>
    <section class="student_panel"><h2>In-app preferences</h2><form action="/my/campus/student/action" method="post"><t t-call="ideastone_erp.student_action_fields"/><input type="hidden" name="operation" value="preferences"/><input type="hidden" name="return_to" value="account"/><label class="student_checkbox" for="student_notice_badge"><input id="student_notice_badge" type="checkbox" name="notice_badge" t-att-checked="d['notice_badge']"/> Show unread notice count in the header</label><button class="btn btn-primary" type="submit">Save preferences</button></form><p class="student_muted">Notices remain available in the portal. Email/SMS delivery is not implied by this setting.</p></section>
  </template>
</odoo>
