<odoo>
  <record id="mvp_receipt_report" model="ir.actions.report">
    <field name="name">College fee receipt</field><field name="model">account.payment</field>
    <field name="report_type">qweb-pdf</field><field name="report_name">ideastone_erp.mvp_receipt_document</field>
    <field name="print_report_name">'Receipt-%s' % object.campus_receipt_number.replace('/', '-')</field>
  </record>
  <template id="mvp_receipt_document">
    <t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout">
      <div class="page"><h2>College fee receipt</h2><p t-if="o.company_id.campus_demo"><strong>DEMONSTRATION COLLEGE — SAMPLE DATA</strong></p>
        <div t-if="o.campus_reversal_id" class="alert alert-warning"><strong>REVERSED RECEIPT</strong><p t-field="o.campus_reversal_reason"/></div>
        <table class="table table-sm"><tbody>
          <tr><th>Receipt number</th><td><span t-field="o.campus_receipt_number"/></td><th>Date</th><td><span t-field="o.date"/></td></tr>
          <tr><th>Student</th><td><span t-field="o.campus_invoice_id.campus_student_id.name"/></td><th>Student number</th><td><span t-field="o.campus_invoice_id.campus_student_id.gr_no"/></td></tr>
          <tr><th>Programme</th><td><span t-field="o.campus_invoice_id.campus_course_id.name"/></td><th>Academic year</th><td><span t-field="o.campus_invoice_id.campus_year_id.name"/></td></tr>
          <tr><th>Invoice</th><td><span t-field="o.campus_invoice_id.name"/></td><th>Payment method</th><td><span t-field="o.campus_method"/></td></tr>
          <tr><th>Reference</th><td><span t-field="o.campus_reference"/></td><th>Received by</th><td><span t-field="o.campus_cashier_id.name"/></td></tr>
        </tbody></table>
        <h3>Amount received: <span t-field="o.amount" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></h3>
        <p>Invoice total: <span t-field="o.campus_invoice_id.amount_total"/> · Current unpaid balance: <span t-field="o.campus_invoice_id.amount_residual"/></p>
        <p>This receipt records the posted payment. Current balance may include later payments or reversals. A reversed receipt remains in the audit history.</p>
      </div>
    </t></t></t>
  </template>
</odoo>
