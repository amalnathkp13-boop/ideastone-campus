<odoo>
  <template id="student_academics_content" name="Student Academics content">
    <t t-set="subjects" t-value="d['subjects']"/>
    <t t-set="assignments" t-value="d.get('assignments', [])"/>
    <t t-set="materials" t-value="d['materials']"/>
    <t t-set="placement_ready" t-value="d['placement']['year'] != 'Not assigned' and d['placement']['semester'] != 'Not assigned'"/>
    <t t-set="allocated_count" t-value="len([s for s in subjects if s['faculty'] != 'Not allocated'])"/>
    <t t-set="due_count" t-value="len([a for a in assignments if a['can_submit']])"/>
    <t t-set="feedback_count" t-value="len([a for a in assignments if a['feedback'] or a['marks'] is not None])"/>
    <div class="student_academics_view">
      <section class="academic_page" id="student_academics_overview" data-academic-page="overview">
        <div class="academic_page_head"><div><h1>Academics</h1><p>Your academic placement, curriculum status and learning activity at a glance.</p></div><span class="academic_pill"><i class="fa fa-id-card-o" aria-hidden="true"/> Academic placement · <t t-esc="d['placement']['section']"/></span></div>
        <div class="academic_hero"><span class="academic_hero_icon"><i class="fa fa-graduation-cap" aria-hidden="true"/></span><div class="academic_hero_copy"><span>CURRENT ACADEMIC PLACEMENT</span><h2 t-esc="d['placement']['programme']"/><p><t t-esc="d['placement']['department']"/> · <t t-esc="d['placement']['section']"/></p></div><span class="academic_hero_tag" t-esc="'Academic year ' + d['placement']['year'] if d['placement']['year'] != 'Not assigned' else 'Academic year not assigned'"/></div>
        <form t-if="len(d['placements']) &gt; 1" class="academic_placement_select" method="get" action="/my/campus/student/academics"><label for="academic_placement">Academic placement</label><select id="academic_placement" name="enrolment"><option t-foreach="d['placements']" t-as="p" t-att-value="p['id']" t-att-selected="p['id'] == d['placement']['id']" t-esc="p['label']"/></select><button type="submit">View placement</button></form>
        <div class="academic_metrics">
          <article class="academic_metric"><span class="academic_metric_icon"><i class="fa fa-book" aria-hidden="true"/></span><span class="academic_metric_label">Subjects listed</span><strong t-esc="'%02d' % len(subjects)"/><small t-esc="'%s with teaching allocation' % allocated_count if subjects else 'No subjects assigned yet'"/></article>
          <article class="academic_metric purple"><span class="academic_metric_icon"><i class="fa fa-pencil" aria-hidden="true"/></span><span class="academic_metric_label">Assignments published</span><strong t-esc="'%02d' % len(assignments)"/><small t-esc="'%s available for submission' % due_count if assignments else 'No work published for this placement'"/></article>
          <article class="academic_metric teal"><span class="academic_metric_icon"><i class="fa fa-files-o" aria-hidden="true"/></span><span class="academic_metric_label">Learning resources</span><strong t-esc="'%02d' % len(materials)"/><small t-esc="'Approved materials published' if materials else 'No approved materials published'"/></article>
        </div>
        <div class="academic_layout"><div class="academic_stack">
          <section class="academic_card"><div class="academic_card_head"><h2>Academic placement details</h2><span class="academic_status neutral">College record</span></div><dl class="academic_rows"><dt>Programme</dt><dd t-esc="d['placement']['programme']"/><dt>Department</dt><dd t-esc="d['placement']['department']"/><dt>Academic year</dt><dd t-esc="d['placement']['year']"/><dt>Semester</dt><dd t-esc="d['placement']['semester']"/><dt>Section / batch</dt><dd t-esc="d['placement']['section']"/></dl><div t-if="not placement_ready" class="academic_callout"><span class="academic_callout_icon"><i class="fa fa-info" aria-hidden="true"/></span><div><strong>Placement setup is incomplete</strong><p>Academic year or semester is not assigned in your record. Contact the academic office if these details should already be available.</p></div></div></section>
          <section class="academic_card"><div class="academic_card_head"><h2>Curriculum snapshot</h2><a class="academic_link" href="#student_subjects">Open subjects <i class="fa fa-arrow-right" aria-hidden="true"/></a></div><div t-foreach="subjects[:4]" t-as="s" class="academic_list_row"><span class="academic_list_icon"><i class="fa fa-book" aria-hidden="true"/></span><span class="academic_list_copy"><strong><t t-esc="s['code']"/> · <t t-esc="s['name']"/></strong><small><t t-esc="s['faculty']"/> · <t t-esc="str(s['credits']) if s['credits'] else 'Credits not recorded'"/> <t t-if="s['credits']">credits</t> · <t t-esc="s['type'].title()"/></small></span><span t-att-class="'academic_status good' if s['faculty'] != 'Not allocated' else 'academic_status neutral'" t-esc="'Allocated' if s['faculty'] != 'Not allocated' else 'Pending'"/></div><p t-if="not subjects" class="academic_empty">No subjects have been assigned to this academic placement.</p></section>
        </div><div class="academic_stack">
          <section class="academic_card academic_assistant"><span class="academic_ai_label"><i class="fa fa-magic" aria-hidden="true"/> ACADEMIC GUIDE</span><h2>Suggested next steps</h2><p>These suggestions follow the records shown here and do not use a live AI analysis.</p><div class="academic_ai_suggestion"><strong>1. Confirm your placement</strong><br/><t t-esc="'Academic year and semester are recorded. Review them for accuracy.' if placement_ready else 'Academic year or semester is missing. Verify your placement with the department office.'"/></div><div class="academic_ai_suggestion"><strong>2. Check subject allocation</strong><br/><t t-esc="'Teaching allocation is recorded for all listed subjects.' if subjects and allocated_count == len(subjects) else 'Some teaching allocations are not recorded yet. Check again after the college publishes them.'"/></div><div class="academic_ai_suggestion"><strong>3. Revisit learning materials</strong><br/><t t-esc="'Approved resources are available in Learning materials.' if materials else 'No approved resources are listed yet. Check Learning materials for new publications.'"/></div></section>
          <section class="academic_card"><div class="academic_card_head"><h2>Quick access</h2><span class="academic_status neutral">Submodules</span></div><a class="academic_list_row" href="#student_enrolment"><span class="academic_list_icon"><i class="fa fa-id-card-o" aria-hidden="true"/></span><span class="academic_list_copy"><strong>Enrolment</strong><small>Placement information and checklist</small></span><span class="academic_link">Open <i class="fa fa-arrow-right" aria-hidden="true"/></span></a><a class="academic_list_row" href="#student_subjects"><span class="academic_list_icon"><i class="fa fa-book" aria-hidden="true"/></span><span class="academic_list_copy"><strong>Subjects</strong><small>Curriculum and subject details</small></span><span class="academic_link">Open <i class="fa fa-arrow-right" aria-hidden="true"/></span></a><a class="academic_list_row" href="#student_assignments"><span class="academic_list_icon"><i class="fa fa-pencil" aria-hidden="true"/></span><span class="academic_list_copy"><strong>Assignments &amp; feedback</strong><small>Published tasks and faculty feedback</small></span><span class="academic_link">Open <i class="fa fa-arrow-right" aria-hidden="true"/></span></a><a class="academic_list_row" href="#student_materials"><span class="academic_list_icon"><i class="fa fa-files-o" aria-hidden="true"/></span><span class="academic_list_copy"><strong>Learning materials</strong><small>Notes, readings and class resources</small></span><span class="academic_link">Open <i class="fa fa-arrow-right" aria-hidden="true"/></span></a></section>
        </div></div>
      </section>

      <section class="academic_page" id="student_enrolment" data-academic-page="enrolment" hidden="hidden">
        <a class="academic_back" href="#student_academics_overview"><i class="fa fa-arrow-left" aria-hidden="true"/> Academics</a><div class="academic_page_head"><div><h1>Enrolment</h1><p>Review the programme and placement information associated with your student record.</p></div><span class="academic_pill">Current placement</span></div>
        <div class="academic_metrics"><article class="academic_metric"><span class="academic_metric_icon"><i class="fa fa-id-card-o" aria-hidden="true"/></span><span class="academic_metric_label">Placement status</span><strong class="academic_metric_text" t-esc="d['placement']['status']"/><small>Recorded by your college</small></article><article class="academic_metric purple"><span class="academic_metric_icon"><i class="fa fa-university" aria-hidden="true"/></span><span class="academic_metric_label">Programme</span><strong class="academic_metric_text" t-esc="d['placement']['programme']"/><small t-esc="d['placement']['department']"/></article><article class="academic_metric teal"><span class="academic_metric_icon"><i class="fa fa-clock-o" aria-hidden="true"/></span><span class="academic_metric_label">Semester</span><strong class="academic_metric_text" t-esc="d['placement']['semester']"/><small t-esc="'Academic year ' + d['placement']['year']"/></article></div>
        <div class="academic_detail_grid"><section class="academic_card"><div class="academic_card_head"><h2>Enrolment details</h2><span class="academic_status neutral">College record</span></div><dl class="academic_rows"><dt>Student name</dt><dd t-esc="d['student']['name']"/><dt>Student number</dt><dd t-esc="d['student']['number']"/><dt>Register / roll number</dt><dd t-esc="d['student']['register']"/><dt>Programme</dt><dd t-esc="d['placement']['programme']"/><dt>Department</dt><dd t-esc="d['placement']['department']"/><dt>Placement / batch</dt><dd t-esc="d['placement']['section']"/><dt>Academic year</dt><dd t-esc="d['placement']['year']"/><dt>Semester</dt><dd t-esc="d['placement']['semester']"/></dl><div class="academic_notice">These details come from your current college record. Request a correction if an official field is wrong.</div></section>
          <section class="academic_card"><div class="academic_card_head"><h2>Enrolment checklist</h2><span t-att-class="'academic_status good' if placement_ready and (not subjects or allocated_count == len(subjects)) else 'academic_status amber'" t-esc="'Current' if placement_ready and (not subjects or allocated_count == len(subjects)) else 'Needs review'"/></div><div class="academic_list_row"><span class="academic_list_icon"><i class="fa fa-user" aria-hidden="true"/></span><span class="academic_list_copy"><strong>Student identity record</strong><small t-esc="'Student number is recorded.' if d['student']['number'] != 'Not assigned' else 'Student number has not been assigned.'"/></span><span t-att-class="'academic_status good' if d['student']['number'] != 'Not assigned' else 'academic_status amber'" t-esc="'Present' if d['student']['number'] != 'Not assigned' else 'Verify'"/></div><div class="academic_list_row"><span class="academic_list_icon"><i class="fa fa-university" aria-hidden="true"/></span><span class="academic_list_copy"><strong>Programme / department</strong><small><t t-esc="d['placement']['programme']"/> · <t t-esc="d['placement']['department']"/></small></span><span t-att-class="'academic_status good' if d['placement']['programme'] != 'Not assigned' else 'academic_status amber'" t-esc="'Present' if d['placement']['programme'] != 'Not assigned' else 'Verify'"/></div><div class="academic_list_row"><span class="academic_list_icon"><i class="fa fa-calendar" aria-hidden="true"/></span><span class="academic_list_copy"><strong>Academic year and semester</strong><small t-esc="'Both are recorded.' if placement_ready else 'One or both are not assigned.'"/></span><span t-att-class="'academic_status good' if placement_ready else 'academic_status amber'" t-esc="'Complete' if placement_ready else 'Verify'"/></div><div class="academic_list_row"><span class="academic_list_icon"><i class="fa fa-users" aria-hidden="true"/></span><span class="academic_list_copy"><strong>Teaching allocation</strong><small><t t-esc="allocated_count"/> of <t t-esc="len(subjects)"/> listed subjects have faculty recorded.</small></span><span t-att-class="'academic_status good' if subjects and allocated_count == len(subjects) else 'academic_status amber'" t-esc="'Complete' if subjects and allocated_count == len(subjects) else 'Verify'"/></div></section></div>
      </section>

      <section class="academic_page" id="student_subjects" data-academic-page="subjects" hidden="hidden">
        <a class="academic_back" href="#student_academics_overview"><i class="fa fa-arrow-left" aria-hidden="true"/> Academics</a><div class="academic_page_head"><div><h1>Subjects</h1><p>Explore the subjects listed under your current academic placement.</p></div><span class="academic_pill"><t t-esc="'%02d' % len(subjects)"/> subjects listed</span></div>
        <section class="academic_card"><div class="academic_filters"><label for="academic_subject_search">Search subjects<input id="academic_subject_search" class="academic_search" type="search" placeholder="Search code or subject name"/></label><label for="academic_subject_type">Subject type<select id="academic_subject_type" class="academic_type_filter"><option value="all">All types</option><option value="theory">Theory</option><option value="practical">Practical</option><option value="both">Both</option><option value="other">Other</option></select></label><button class="academic_button academic_reset_subjects" type="button">Reset filters</button></div><div class="academic_table_wrap"><table class="academic_table"><thead><tr><th scope="col">Code</th><th scope="col">Subject</th><th scope="col">Teaching allocation</th><th scope="col">Credits</th><th scope="col">Type</th><th scope="col">Action</th></tr></thead><tbody><tr t-foreach="subjects" t-as="s" class="academic_subject_row" t-att-data-type="s['type'].lower()" t-att-data-search="(s['code'] or '') + ' ' + s['name'] + ' ' + s['faculty']"><td><strong t-esc="s['code'] or '—'"/></td><td t-esc="s['name']"/><td><span t-att-class="'academic_status good' if s['faculty'] != 'Not allocated' else 'academic_status neutral'" t-esc="s['faculty']"/></td><td t-esc="s['credits'] if s['credits'] else 'Not recorded'"/><td t-esc="s['type'].title()"/><td><button type="button" class="academic_link academic_subject_open" t-att-data-subject-id="s['id']">View details <i class="fa fa-arrow-right" aria-hidden="true"/></button></td></tr></tbody></table></div><div class="academic_notice academic_subject_count" role="status" t-att-data-placement="d['placement']['section']"><t t-esc="len(subjects)"/> subjects listed · Placement: <t t-esc="d['placement']['section']"/></div><p t-if="not subjects" class="academic_empty">No subjects have been assigned to this academic placement.</p><p class="academic_empty academic_subject_no_match" role="status" hidden="hidden">No subjects match those filters.</p></section>
        <div class="academic_detail_grid academic_followup_grid"><section class="academic_card"><div class="academic_subject_placeholder"><div class="academic_card_head"><h2>Subject details</h2><span class="academic_status neutral">Select a subject</span></div><p class="academic_empty">Choose “View details” in the subject table to see the selected subject information here.</p></div><div t-foreach="subjects" t-as="s" class="academic_subject_detail" t-att-data-subject-panel="s['id']" hidden="hidden"><div class="academic_card_head"><h2 t-esc="s['name']"/><span class="academic_status purple">Subject selected</span></div><dl class="academic_rows"><dt>Subject code</dt><dd t-esc="s['code'] or 'Not recorded'"/><dt>Placement</dt><dd><t t-esc="d['placement']['programme']"/> · <t t-esc="d['placement']['section']"/></dd><dt>Subject type</dt><dd t-esc="s['type'].title()"/><dt>Teaching allocation</dt><dd t-esc="s['faculty']"/><dt>Credits</dt><dd t-esc="s['credits'] if s['credits'] else 'Not recorded'"/></dl><div t-if="s['faculty'] == 'Not allocated' or not s['credits']" class="academic_callout"><span class="academic_callout_icon"><i class="fa fa-info" aria-hidden="true"/></span><div><strong>Allocation pending</strong><p>Faculty or credit information will appear when the college records it.</p></div></div></div></section><section class="academic_card academic_assistant"><span class="academic_ai_label"><i class="fa fa-lightbulb-o" aria-hidden="true"/> STUDY SUGGESTION</span><h2>Build a subject study plan</h2><p>For a balanced routine, create a weekly reading block per subject and review lecture notes after each class. Adjust this when the official timetable is published.</p><div class="academic_ai_suggestion"><strong>Suggested focus</strong><br/><t t-esc="' · '.join(s['name'] for s in subjects[:3]) if subjects else 'Review your programme outline with the academic office.'"/></div></section></div>
      </section>

      <section class="academic_page" id="student_assignments" data-academic-page="assignments" hidden="hidden">
        <a class="academic_back" href="#student_academics_overview"><i class="fa fa-arrow-left" aria-hidden="true"/> Academics</a><div class="academic_page_head"><div><h1>Assignments &amp; feedback</h1><p>Track published coursework, submission status, grades and released faculty comments.</p></div><span class="academic_pill" t-esc="'%02d published assignments' % len(assignments) if assignments else 'No published assignments'"/></div>
        <div class="academic_metrics"><article class="academic_metric"><span class="academic_metric_icon"><i class="fa fa-pencil" aria-hidden="true"/></span><span class="academic_metric_label">Published assignments</span><strong t-esc="'%02d' % len(assignments)"/><small>For the selected placement</small></article><article class="academic_metric purple"><span class="academic_metric_icon"><i class="fa fa-upload" aria-hidden="true"/></span><span class="academic_metric_label">Submissions available</span><strong t-esc="'%02d' % due_count"/><small>Published work open for submission</small></article><article class="academic_metric green"><span class="academic_metric_icon"><i class="fa fa-check" aria-hidden="true"/></span><span class="academic_metric_label">Feedback released</span><strong t-esc="'%02d' % feedback_count"/><small>Released grades or comments</small></article></div>
        <div class="academic_layout"><div class="academic_stack"><section class="academic_card"><div class="academic_card_head"><h2>Assignment list</h2><span class="academic_status neutral">Current placement</span></div><div class="academic_table_wrap"><table class="academic_table"><thead><tr><th scope="col">Assignment</th><th scope="col">Subject</th><th scope="col">Due date</th><th scope="col">Status</th><th scope="col">Grade</th></tr></thead><tbody><tr t-foreach="assignments" t-as="a"><td><strong t-esc="a['name']"/></td><td t-esc="a['subject']"/><td t-esc="a['due']"/><td><span t-att-class="'academic_status purple' if a['state'] == 'accept' and (a['feedback'] or a['marks'] is not None) else 'academic_status good' if a['state'] in ('submit', 'accept') else 'academic_status amber' if a['can_submit'] or a['late'] else 'academic_status neutral'" t-esc="'Graded' if a['state'] == 'accept' and (a['feedback'] or a['marks'] is not None) else 'Submitted' if a['state'] in ('submit', 'accept') else 'Revision requested' if a['state'] == 'change' else 'Rejected' if a['state'] == 'reject' else 'Overdue' if a['late'] and not a['can_submit'] else 'Open' if a['can_submit'] else a['status']"/></td><td t-esc="str(a['marks']) + '/' + str(a['maximum']) if a['marks'] is not None else '—'"/></tr></tbody></table></div><p t-if="not assignments" class="academic_empty">No assignments are published for this placement.</p></section><section class="academic_card"><div class="academic_card_head"><h2>Faculty feedback</h2></div><div t-foreach="[a for a in assignments if a['feedback'] or a['marks'] is not None]" t-as="a" class="academic_list_row"><span class="academic_list_icon"><i class="fa fa-check" aria-hidden="true"/></span><span class="academic_list_copy"><strong t-esc="a['name']"/><small><t t-esc="a['teacher'] or 'Faculty'"/> · <t t-esc="a['submitted'] or a['due']"/></small><small t-if="a['feedback']" t-esc="a['feedback']"/></span><span t-if="a['marks'] is not None" class="academic_status good" t-esc="str(a['marks']) + '/' + str(a['maximum'])"/></div><p t-if="not feedback_count" class="academic_empty">No faculty feedback has been released for this placement.</p></section></div><div class="academic_stack"><section class="academic_card academic_assistant"><span class="academic_ai_label"><i class="fa fa-lightbulb-o" aria-hidden="true"/> STUDY PLANNER</span><h2>Prepare for your coursework</h2><p>Use the published assignment instructions and deadlines shown here. This guidance does not reveal private faculty plans.</p><div class="academic_ai_suggestion"><strong>Suggested 3-step routine</strong><br/>1. Organise notes by subject.<br/>2. Reserve a weekly revision session.<br/>3. Check this page after faculty updates.</div></section><section class="academic_card"><div class="academic_card_head"><h2>Submission guidance</h2></div><div class="academic_list_row"><span class="academic_list_icon">1</span><span class="academic_list_copy"><strong>Read instructions</strong><small>Check accepted file types and submission requirements.</small></span></div><div class="academic_list_row"><span class="academic_list_icon">2</span><span class="academic_list_copy"><strong>Submit before the deadline</strong><small>Keep a copy of your submitted work.</small></span></div><div class="academic_list_row"><span class="academic_list_icon">3</span><span class="academic_list_copy"><strong>Review released feedback</strong><small>Use faculty comments to improve future submissions.</small></span></div></section></div></div>
        <div class="academic_submission_slot"/>
      </section>

      <section class="academic_page" id="student_materials" data-academic-page="materials" hidden="hidden">
        <a class="academic_back" href="#student_academics_overview"><i class="fa fa-arrow-left" aria-hidden="true"/> Academics</a><div class="academic_page_head"><div><h1>Learning materials</h1><p>Find approved notes, readings and resources published for your subjects.</p></div><span class="academic_pill"><t t-esc="'%02d' % len(materials)"/> published resources</span></div>
        <section class="academic_card"><div class="academic_filters"><label for="academic_material_search">Search learning materials<input id="academic_material_search" class="academic_material_search" type="search" placeholder="Search by title or keyword"/></label><label for="academic_material_subject">Subject<select id="academic_material_subject" class="academic_material_subject"><option value="all">All subjects</option><option t-foreach="subjects" t-as="s" t-att-value="s['id']"><t t-esc="s['code']"/> · <t t-esc="s['name']"/></option></select></label><button class="academic_button academic_reset_materials" type="button">Reset filters</button></div><div class="academic_resources"><div t-foreach="materials" t-as="m" class="academic_resource" t-att-data-subject="m['subject_id']" t-att-data-search="m['name'] + ' ' + m['subject'] + ' ' + m['filename']"><span class="academic_resource_icon"><i class="fa fa-file-text-o" aria-hidden="true"/></span><span class="academic_list_copy"><strong t-esc="m['name']"/><small><t t-esc="m['code'] or m['subject']"/> · <t t-esc="m['filename']"/> · Published <t t-esc="m['date']"/></small></span><span class="academic_status good">Published</span><a class="academic_outline_button" t-att-href="'/my/campus/student/download/resource/%s' % m['id']">Download</a></div></div><p t-if="not materials" class="academic_empty">No approved materials have been published for this placement.</p><p class="academic_empty academic_material_no_match" role="status" hidden="hidden">No resources match the selected filters.</p></section>
        <div class="academic_detail_grid academic_followup_grid"><section class="academic_card"><div class="academic_card_head"><h2>Subject resource folders</h2></div><div t-foreach="subjects" t-as="s" class="academic_resource"><span class="academic_resource_icon"><i class="fa fa-book" aria-hidden="true"/></span><span class="academic_list_copy"><strong><t t-esc="s['code']"/> · <t t-esc="s['name']"/></strong><small>Approved resources linked to this subject</small></span><span t-att-class="'academic_status good' if any(m['subject_id'] == s['id'] for m in materials) else 'academic_status neutral'"><t t-esc="len([m for m in materials if m['subject_id'] == s['id']])"/> files</span></div><p t-if="not subjects" class="academic_empty">Subject folders will appear after subjects are assigned.</p></section><section class="academic_card academic_assistant"><span class="academic_ai_label"><i class="fa fa-lightbulb-o" aria-hidden="true"/> LEARNING TIP</span><h2>Make your notes easier to revise</h2><p>Organise each subject into lecture notes, key terms, case summaries and practice questions. This is a general study suggestion and does not summarise unpublished course content.</p><div class="academic_ai_suggestion"><strong>Suggested folder structure</strong><br/>Lecture notes · Readings · Case briefs · Revision questions</div></section></div>
      </section>
    </div>
  </template>
</odoo>
