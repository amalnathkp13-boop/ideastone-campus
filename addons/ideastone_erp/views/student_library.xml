<odoo>
  <template id="student_library_workspace" inherit_id="ideastone_erp.student_workspace" name="Student library main content">
    <xpath expr="//t[@t-elif=&quot;section == 'library'&quot;][@t-call]" position="attributes"><attribute name="t-call">ideastone_erp.student_library_content</attribute></xpath>
    <xpath expr="//nav[hasclass('student_subnav')]/a[@t-else]" position="before"><t t-elif="section == 'library'"><a href="#student_library_overview">Overview</a><a href="#student_library_catalogue">Catalogue</a><a href="#student_library_loans">My loans</a><a href="#student_library_reservations">Reservations &amp; requests</a><a href="#student_library_digital">Digital resources</a></t></xpath>
  </template>
  <template id="student_library_book_card">
    <article class="book-card"><div t-att-class="'book-cover ' + book['tone']"><i class="fa fa-book" aria-hidden="true"/></div><div class="book-info"><h3 t-esc="book['name']"/><p><t t-esc="book['subject']"/> · <t t-esc="book['authors']"/></p><span t-att-class="'status ' + book['status']" t-esc="book['availability']"/><div class="book-actions"><a class="btn" t-att-href="'#student_library_book_%s' % book['id']">Details</a><button type="button" class="btn" t-att-data-library-title="book['name']" t-att-data-library-intent="'request' if book['available'] else 'reserve'" t-esc="'Request' if book['available'] else 'Reserve'"/></div></div></article>
  </template>
  <template id="student_library_content" name="Student Library">
    <t t-set="u" t-value="d['library_ui']"/>
    <div class="library_view">
      <section id="student_library_overview" data-library-page="overview">
        <div class="pagehead"><div><h1>Library</h1><p>Find books, manage borrowed items and access learning resources.</p></div><span class="pill"><i class="fa fa-id-card-o" aria-hidden="true"/> Student access</span></div>
        <div class="kpis">
          <article class="kpi"><span class="kicon"><i class="fa fa-book" aria-hidden="true"/></span><div class="kpi-label">Books currently issued</div><p class="value" t-esc="u['issued']"/><div class="foot">Across your active library loans</div></article>
          <article class="kpi amber"><span class="kicon"><i class="fa fa-clock-o" aria-hidden="true"/></span><div class="kpi-label">Due soon / overdue</div><p class="value" t-esc="u['attention']"/><div class="foot">Due within three days or past the due date</div></article>
          <article class="kpi green"><span class="kicon"><i class="fa fa-refresh" aria-hidden="true"/></span><div class="kpi-label">Reserved items</div><p class="value" t-esc="u['ready']"/><div class="foot">Library staff confirm when a copy is ready</div></article>
          <article class="kpi violet"><span class="kicon"><i class="fa fa-inr" aria-hidden="true"/></span><div class="kpi-label">Recorded library fine</div><p class="value money" t-esc="money(u['fine'])"/><div class="foot">Recorded penalties; ask staff about payment status</div></article>
        </div>
        <section class="hero-search"><h2>What are you looking for?</h2><p>Search by book title, author, subject, ISBN or catalogue code.</p><form class="quick-search" data-library-search=""><label class="library-sr-only" for="library_overview_search">Search the catalogue</label><input id="library_overview_search" type="search" placeholder="e.g., Python Programming, accounting, author name"/><button type="submit" class="btn primary">Search catalogue →</button></form><div class="tagrow"><span class="tag">Textbooks</span><span class="tag">Reference books</span><span class="tag">Programming</span><span class="tag">Business &amp; law</span><a class="tag" href="#student_library_digital">Digital resources</a></div></section>
        <div class="grid2">
          <section class="panel"><div class="panel-head"><h2>My current loan</h2><a class="btn" href="#student_library_loans">View all loans</a></div><article t-foreach="u['current'][:1]" t-as="loan" class="list-row"><div class="book-cover"><i class="fa fa-book" aria-hidden="true"/></div><div class="loan-copy"><h3 t-esc="loan['name']"/><p>Catalogue code: <t t-esc="loan['code']"/> · Issued <t t-esc="loan['issued']"/></p><p><span t-att-class="'status ' + loan['tone']"><t t-esc="loan['status']"/> · due <t t-esc="loan['due']"/></span></p><p class="loan-note">Return or contact the library desk to confirm renewal eligibility. Fine status must be verified by the library.</p></div></article><p t-if="not u['current']" class="empty">No books are currently issued to your account.</p><div class="callout section-gap"><i class="fa fa-info-circle" aria-hidden="true"/><div><strong>Need more time?</strong> Submit a renewal enquiry before visiting the desk. A request is not approved until the library confirms it.</div></div></section>
          <section class="panel"><div class="panel-head"><h2>Library information</h2></div><div class="mini-stat"><span>Library hours</span><b>As published by library</b></div><div class="mini-stat"><span>Issue / renewal rules</span><b>Check circulation policy</b></div><div class="mini-stat"><span>Lost or damaged book</span><b>Contact library desk</b></div><div class="mini-stat"><span>Support</span><b>Library staff / circulation desk</b></div><p class="small subtle section-gap">Opening hours, loan limits, renewal eligibility and fines follow the college library’s approved policy. Contact staff for the current details.</p></section>
        </div>
        <section class="panel"><div class="panel-head"><h2>Explore the catalogue</h2><a class="btn" href="#student_library_catalogue">Browse all titles</a></div><div class="book-grid"><t t-foreach="u['featured']" t-as="book"><t t-call="ideastone_erp.student_library_book_card"/></t></div><p t-if="not u['featured']" class="empty">No active physical titles are recorded for your college.</p></section>
        <div class="callout"><i class="fa fa-info-circle" aria-hidden="true"/><div><strong>Your library records:</strong> Availability and due dates come from the college catalogue and circulation records. A request or renewal is not final until approved by library staff.</div></div>
      </section>
      <section id="student_library_catalogue" data-library-page="catalogue" hidden="hidden">
        <div class="pagehead"><div><h1>Library Catalogue</h1><p>Search the college collection and check availability before visiting the shelves.</p></div><span class="pill">College catalogue</span></div>
        <div class="filterbox"><div class="filters"><div class="field"><label for="library_catalogue_search">Search titles</label><input id="library_catalogue_search" type="search" data-library-filter="search" placeholder="Title, author, ISBN or code"/></div><div class="field"><label for="library_category">Subject area</label><select id="library_category" data-library-filter="category"><option value="all">All subjects</option><option t-foreach="u['categories']" t-as="category" t-att-value="category" t-esc="category"/></select></div><div class="field"><label for="library_availability">Availability</label><select id="library_availability" data-library-filter="availability"><option value="all">All titles</option><option value="available">Available</option><option value="issued">Currently issued</option></select></div><button type="button" class="btn" data-library-reset="">Reset</button></div></div>
        <section class="panel"><div class="panel-head"><h2>College catalogue</h2><span class="small subtle" data-library-count=""><t t-esc="len(u['books'])"/> titles</span></div><div class="table-wrap" tabindex="0" role="region" aria-label="College catalogue table"><table><thead><tr><th scope="col">Title / author</th><th scope="col">Catalogue code</th><th scope="col">Subject</th><th scope="col">Location</th><th scope="col">Availability</th><th scope="col">Action</th></tr></thead><tbody><tr t-foreach="u['books']" t-as="book" data-library-book="" t-att-data-category="book['category_keys']" t-att-data-availability="book['status']" t-att-data-search="' '.join([book['name'],book['authors'],book['code'],book['isbn'],book['subject']])"><td><div class="book-title" t-esc="book['name']"/><div class="book-meta">Author: <t t-esc="book['authors']"/> · Edition: <t t-esc="book['edition']"/></div></td><td t-esc="book['code']"/><td t-esc="book['subject']"/><td>Ask library desk</td><td><span t-att-class="'status ' + book['status']" t-esc="book['availability']"/></td><td><a class="btn" t-att-href="'#student_library_book_%s' % book['id']">Details</a></td></tr></tbody></table></div><p class="empty" data-library-empty="" t-att-hidden="'hidden' if u['books'] else None">No titles match these filters. Try another search or reset the filters.</p></section>
        <div class="callout"><i class="fa fa-info-circle" aria-hidden="true"/><div>Copy counts include active copies belonging to your college. Ask staff for shelf location and any borrowing restrictions.</div></div>
      </section>
      <section id="student_library_loans" data-library-page="loans" hidden="hidden">
        <div class="pagehead"><div><h1>My Loans</h1><p>Track issued books, due dates, renewals and library-recorded fines.</p></div><span t-att-class="'pill ' + ('amber' if u['attention'] else 'green')"><t t-esc="u['attention']"/> <t t-esc="'item needs' if u['attention'] == 1 else 'items need'"/> attention</span></div>
        <section class="panel"><div class="panel-head"><h2>Current and recent loans</h2><span class="small subtle">Your circulation records</span></div><div class="table-wrap" tabindex="0" role="region" aria-label="My library loans"><table><thead><tr><th scope="col">Book</th><th scope="col">Issue date</th><th scope="col">Due date</th><th scope="col">Return date</th><th scope="col">Status</th><th scope="col">Fine recorded</th><th scope="col">Action</th></tr></thead><tbody><tr t-foreach="u['loans']" t-as="loan"><td><div class="book-title" t-esc="loan['name']"/><div class="book-meta" t-esc="loan['code']"/></td><td t-esc="loan['issued']"/><td t-esc="loan['due']"/><td t-esc="loan['returned'] or '—'"/><td><span t-att-class="'status ' + loan['tone']" t-esc="loan['status']"/></td><td t-esc="money(loan['penalty'])"/><td><button t-if="loan['active']" type="button" class="btn primary" t-att-data-library-title="loan['name']" data-library-intent="renew" t-att-data-library-loan="loan['id']">Request renewal</button><span t-else="" class="subtle">—</span></td></tr></tbody></table></div><p t-if="not u['loans']" class="empty">No library loans are recorded for your account.</p><div class="callout section-gap"><i class="fa fa-info-circle" aria-hidden="true"/><div><strong>Renewal rules:</strong> Staff confirm eligibility, reservations and loan limits. Submitting a renewal enquiry does not change your due date.</div></div></section>
        <div class="grid2"><section class="panel"><h2>Before returning a book</h2><ul class="rule-list"><li>Return the exact copy to the designated library desk or return point.</li><li>Keep the return confirmation until the account updates.</li><li>Ask staff to verify any fine, damage fee or disputed due date.</li><li>Wait for library confirmation before treating a renewal as approved.</li></ul></section><section class="panel"><h2>Loan account summary</h2><div class="mini-stat"><span>Active loans</span><b t-esc="u['issued']"/></div><div class="mini-stat"><span>Overdue items</span><b t-esc="u['overdue']"/></div><div class="mini-stat"><span>Recorded fine</span><b t-esc="money(u['fine'])"/></div><div class="mini-stat"><span>Account restrictions</span><b>Check with library staff</b></div></section></div>
      </section>
      <section id="student_library_reservations" data-library-page="reservations" hidden="hidden">
        <div class="pagehead"><div><h1>Reservations &amp; Requests</h1><p>Ask about a title, a reservation or a renewal and follow the library’s response.</p></div><span class="pill">Requests require library approval</span></div>
        <div class="grid2"><section class="panel"><div class="panel-head"><h2>Place a book request</h2></div><p class="small subtle">Search the catalogue first. Enquiries are saved for college staff review; they do not reserve a physical copy or extend a loan.</p>
          <div t-if="u['active_enquiry']" class="callout section-gap"><i class="fa fa-info-circle" aria-hidden="true"/><div><strong>One library enquiry is already open.</strong><p>Review <t t-esc="u['active_enquiry']['reference']"/> in My requests. Add information there when staff ask for it, or wait for completion before submitting another enquiry.</p><a class="btn" t-att-href="student_url_for('requests') + '#student_request_history'">Open My requests</a></div></div>
          <form t-elif="u['request_enabled']" method="post" action="/my/campus/student/action" enctype="multipart/form-data" data-library-enquiry=""><t t-call="ideastone_erp.student_action_fields"/><input type="hidden" name="operation" value="library_enquiry"/><input type="hidden" name="return_to" value="library"/><input type="hidden" name="key" t-att-value="d['submission_key']"/>
            <div class="field section-gap"><label for="library_request_title">Book title *</label><input id="library_request_title" name="book_title" placeholder="Enter exact catalogue title" required="required" maxlength="150"/></div>
            <div class="field section-gap"><label for="library_request_intent">Request type</label><select id="library_request_intent" name="intent"><option value="reserve">Reserve an issued title</option><option value="request">Request an available title</option><option value="missing">Ask about a missing title</option><option value="renew">Request a loan renewal</option></select></div>
            <div class="field section-gap" data-library-loan-field="" hidden="hidden"><label for="library_request_loan">Your active loan *</label><select id="library_request_loan" name="loan_id"><option value="">Choose an active loan</option><option t-foreach="u['current']" t-as="loan" t-att-value="loan['id']" t-att-data-title="loan['name']" t-esc="loan['name'] + ' · due ' + loan['due']"/></select></div>
            <div class="field section-gap"><label for="library_request_note">Note (optional)</label><textarea id="library_request_note" name="note" placeholder="Preferred edition or question" maxlength="4000" rows="3"/></div><div t-if="u['file_required']" class="field section-gap"><label for="library_request_file">Supporting file required by college *</label><input id="library_request_file" type="file" name="file" accept=".pdf,.png,.jpg,.jpeg,.txt" required="required"/><p class="small subtle">PDF, PNG, JPEG or text. Maximum <t t-esc="u['upload_limit']"/> MB.</p></div><button class="btn primary section-gap" type="submit">Submit library enquiry</button>
          </form><p t-else="" class="empty">Online library enquiries are currently disabled. Contact the library desk.</p>
        </section><section class="panel"><h2>My requests</h2><article t-foreach="u['enquiries']" t-as="enquiry" class="library-enquiry"><div class="panel-head"><strong t-esc="enquiry['reference']"/><span t-att-class="'status ' + ('closed' if enquiry['state'] == 'cancelled' else 'overdue' if enquiry['state'] == 'rejected' else 'available' if enquiry['state'] in ['approved','ready','done'] else 'due')" t-esc="enquiry['status']"/></div><h3 t-esc="enquiry['name']"/><p class="small subtle" t-esc="enquiry['date']"/><p t-if="enquiry['reply']" class="library-response" t-esc="enquiry['reply']"/><form t-if="enquiry['can_cancel']" method="post" action="/my/campus/student/action"><t t-call="ideastone_erp.student_action_fields"/><input type="hidden" name="operation" value="cancel"/><input type="hidden" name="return_to" value="library"/><input type="hidden" name="request_id" t-att-value="enquiry['id']"/><button type="submit" class="btn">Cancel enquiry</button></form></article><p t-if="not u['enquiries']" class="empty">No library enquiries have been submitted from your account.</p><a t-att-href="student_url_for('requests') + '#student_request_history'" class="btn">View request history</a></section></div>
        <section t-if="u['reservations']" class="panel"><div class="panel-head"><h2>Recorded reservations</h2><span class="small subtle">Library queue records</span></div><article t-foreach="u['reservations']" t-as="reservation" class="mini-stat"><div><strong t-esc="reservation['name']"/><p class="small subtle"><t t-esc="reservation['reference']"/> · <t t-esc="reservation['from']"/> – <t t-esc="reservation['to']"/></p></div><span t-att-class="'status ' + reservation['tone']" t-esc="reservation['status']"/></article><p class="small subtle">Accepted requests do not confirm a pickup deadline. Contact the library desk for collection instructions.</p></section>
        <section class="panel"><h2>How reservations work</h2><div class="grid3 section-gap"><div><span class="pill">01 · Request</span><h3 class="section-gap">Choose a title</h3><p class="small subtle">Confirm title, edition and copy availability.</p></div><div><span class="pill violet">02 · Review</span><h3 class="section-gap">Library checks</h3><p class="small subtle">Staff confirm eligibility and queue order.</p></div><div><span class="pill green">03 · Pickup</span><h3 class="section-gap">Collect the book</h3><p class="small subtle">Follow the pickup instructions confirmed by staff.</p></div></div></section>
      </section>
      <section id="student_library_digital" data-library-page="digital" hidden="hidden">
        <div class="pagehead"><div><h1>Digital Resources</h1><p>Quick access to approved e-books, journals, course guides and study support.</p></div><span class="pill violet">Approved student resources</span></div>
        <div class="grid2"><section class="panel"><div class="panel-head"><h2>Learning resources</h2><span class="small subtle"><t t-esc="len(u['resources'])"/> <t t-esc="'resource' if len(u['resources']) == 1 else 'resources'"/></span></div><article t-foreach="u['resources']" t-as="resource" class="resource"><div class="resource-icon"><i class="fa fa-file-text-o" aria-hidden="true"/></div><div class="resource-copy"><h3 t-esc="resource['name']"/><p><t t-esc="resource['kind']"/> · <t t-esc="resource['subject']"/> · Author: <t t-esc="resource['author']"/></p><p class="library-response" t-esc="resource['description']"/><div class="book-actions"><a class="btn" t-att-href="'/my/campus/student/download/resource/%s' % resource['id']">Download resource</a><span class="book-meta" t-esc="resource['filename']"/></div></div></article><p t-if="not u['resources']" class="empty">No approved digital resources are currently available for your student access.</p></section><section class="panel"><h2>Using digital resources</h2><div class="mini-stat"><span>Sign-in method</span><b>Your college student account</b></div><div class="mini-stat"><span>Off-campus access</span><b>Use the authorised college portal</b></div><div class="mini-stat"><span>Download / printing</span><b>Follow licence terms</b></div><div class="mini-stat"><span>Need help?</span><b>Ask library staff</b></div><p class="small subtle section-gap">Do not share institutional login credentials. Use only the resources and downloads permitted by the college and publisher.</p><a class="btn" t-att-href="student_url_for('academics') + '#student_materials'">View academic materials</a></section></div>
        <div class="callout"><i class="fa fa-info-circle" aria-hidden="true"/><div><strong>Approved access:</strong> Downloads shown here are published resources available to your college, subjects and batches. Contact the library for subscription platforms and access instructions.</div></div>
      </section>
      <dialog t-foreach="u['books']" t-as="book" t-att-data-library-dialog="book['id']" class="library-dialog" t-att-aria-labelledby="'library_book_title_%s' % book['id']"><div class="panel-head"><div><span class="small subtle">Catalogue details</span><h2 t-att-id="'library_book_title_%s' % book['id']" t-esc="book['name']"/></div><button class="btn light" type="button" data-library-close="" aria-label="Close book details">✕</button></div><dl class="library-book-details"><dt>Author</dt><dd t-esc="book['authors']"/><dt>Edition</dt><dd t-esc="book['edition']"/><dt>ISBN</dt><dd t-esc="book['isbn']"/><dt>Catalogue code</dt><dd t-esc="book['code']"/><dt>Publisher</dt><dd t-esc="book['publishers']"/><dt>Subject</dt><dd t-esc="book['subject']"/><dt>Copies</dt><dd><t t-esc="book['copies']"/> total · <t t-esc="book['available']"/> available</dd><dt>Shelf location</dt><dd>Ask library desk</dd></dl><p class="library-response subtle" t-esc="book['description']"/><span t-att-class="'status ' + book['status']" t-esc="book['availability']"/><div class="book-actions"><button type="button" class="btn primary" t-att-data-library-title="book['name']" t-att-data-library-intent="'request' if book['available'] else 'reserve'">Ask about this title</button><a t-if="book['own']" class="btn" href="#student_library_loans">My loan</a></div></dialog>
    </div>
  </template>
</odoo>
