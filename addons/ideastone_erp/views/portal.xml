<odoo>
  <template id="portal_home_campus" inherit_id="portal.portal_my_home" name="Campus portal entry">
    <xpath expr="//div[@id='portal_common_category']" position="inside">
      <t t-call="portal.portal_docs_entry">
        <t t-set="title">My campus</t>
        <t t-set="text">Attendance, published results, fees and college notices</t>
        <t t-set="url" t-value="'/my/campus'"/>
        <t t-set="config_card" t-value="True"/>
      </t>
    </xpath>
  </template>
  <template id="portal_campus" name="My campus">
    <t t-call="portal.portal_layout">
      <t t-set="title">My campus</t>
      <main class="container campus_portal">
        <img src="/ideastone_campus/static/src/img/vcet-tab-icon.png" class="img-fluid mb-4" style="max-height:65px" alt="VCET shield"/>
        <header class="campus_portal_heading"><div><span class="vcet_eyebrow">YOUR CONNECTED CAMPUS</span><h1><t t-esc="workspace_role"/> workspace</h1><p>Academic progress, notices and service requests for your linked records.</p></div><a href="/my/campus/library" class="btn btn-outline-primary mb-3">Library catalogue and digital resources</a></header>
        <nav t-if="selected" class="campus_portal_nav" aria-label="My campus sections"><a href="#campus_timetable">Timetable</a><a href="#campus_attendance">Attendance</a><a href="#campus_results">Published results</a><a href="#campus_fees">Fees</a><a href="#campus_notices">Notices</a></nav>
        <div t-if="success" class="alert alert-success" role="status">Your submission was saved.</div>
        <div t-if="error" class="alert alert-danger" role="alert"><t t-if="error == 'duplicate_feedback'">Feedback has already been submitted for this period.</t><t t-else="">Check the required fields and try again.</t></div>
        <form t-if="students" method="get" action="/my/campus" class="mb-4"><label for="campus_student">Student</label><select name="student" id="campus_student" class="form-select"><t t-foreach="students" t-as="s"><option t-att-value="s.id" t-att-selected="s == selected"><t t-esc="s.name"/></option></t></select><button type="submit" class="btn btn-primary mt-2">View progress</button></form>
        <div t-if="not selected" class="alert alert-info">Your account has no linked student record. Contact the college office to link your account.</div>
        <t t-if="selected">
          <div class="card p-4" id="campus_timetable"><h2 class="h5">Upcoming timetable</h2><t t-foreach="timetable" t-as="session"><p><strong t-esc="session.subject_id.name"/> · <span t-field="session.start_datetime"/> · <span t-esc="session.classroom_id.name or 'Room not assigned'"/></p></t><p t-if="not timetable">No confirmed upcoming classes for the linked enrollment.</p></div>
          <div class="card p-4" id="campus_attendance"><h2 class="h5">Attendance</h2><p><strong t-esc="attendance_present"/> present out of <strong t-esc="attendance_count"/> completed recorded periods <t t-if="attendance_count">(<t t-esc="round(attendance_present * 100 / attendance_count, 1)"/>%)</t></p></div>
          <div class="card p-4" id="campus_results"><h2 class="h5">Published results</h2><div class="table-responsive"><table class="table"><thead><tr><th>Examination</th><th>Subject</th><th>Marks</th><th>Grade</th><th>Result</th></tr></thead><tbody><t t-foreach="marks" t-as="mark"><tr><td t-esc="mark.exam_id.name"/><td t-esc="mark.exam_id.subject_id.name"/><td t-esc="mark.marks"/><td t-esc="mark.grade"/><td t-esc="mark.status"/></tr></t><tr t-if="not marks"><td colspan="5">No published results.</td></tr></tbody></table></div><div class="d-flex gap-3"><a t-if="page > 1" t-att-href="'/my/campus?student=%s&amp;page=%s' % (selected.id, page - 1)">Previous results</a><a t-if="next_page" t-att-href="next_page">Next results</a></div></div>
          <div class="card p-4" id="campus_fees"><h2 class="h5">Fees and balances</h2><div class="table-responsive"><table class="table"><thead><tr><th>Invoice</th><th>Date</th><th>Total</th><th>Balance</th></tr></thead><tbody><t t-foreach="invoices" t-as="invoice"><tr><td t-esc="invoice.name"/><td t-esc="invoice.invoice_date"/><td><span t-field="invoice.amount_total"/></td><td><span t-field="invoice.amount_residual"/></td></tr></t><tr t-if="not invoices"><td colspan="4">No posted invoices.</td></tr></tbody></table></div><a href="/my/invoices">Open my billing portal</a></div>
          <div class="card p-4"><h2 class="h5">Lesson information</h2><t t-foreach="lessons" t-as="lesson"><article class="border-bottom py-2"><strong t-esc="lesson.subject_id.name"/><span class="ms-2" t-esc="lesson.planned_date"/><p t-esc="lesson.topic"/><p t-esc="lesson.notes"/></article></t><p t-if="not lessons">No lesson information for your batch.</p></div>
          <div class="card p-4"><h2 class="h5">Mentor remarks</h2><t t-foreach="mentoring" t-as="meeting"><p><span t-esc="meeting.date"/> — <span t-esc="meeting.shared_remarks or 'No shared remarks'"/></p></t><p t-if="not mentoring">No shared mentor remarks.</p></div>
          <div class="card p-4"><h2 class="h5">Feedback</h2><form method="post" action="/my/campus/feedback"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="student" t-att-value="selected.id"/><label for="feedback_period">Academic period</label><input id="feedback_period" name="period" class="form-control mb-3" required="required" maxlength="80"/><label for="feedback_score">Rating</label><select id="feedback_score" name="score" class="form-select mb-3"><option value="1">1 — Needs improvement</option><option value="2">2 — Fair</option><option value="3">3 — Good</option><option value="4">4 — Very good</option><option value="5">5 — Excellent</option></select><label for="feedback_comments">Comments</label><textarea id="feedback_comments" name="comments" class="form-control mb-3" maxlength="5000"/><button type="submit" class="btn btn-primary">Submit feedback</button></form></div>
          <div class="card p-4"><h2 class="h5">Service requests</h2><t t-foreach="requests" t-as="rec"><p><strong t-esc="rec.name"/> — <span t-esc="rec.state"/><span t-if="rec.resolution"> — <t t-esc="rec.resolution"/></span></p></t><form method="post" action="/my/campus/request"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="student" t-att-value="selected.id"/><label for="request_kind">Request type</label><select id="request_kind" name="kind" class="form-select mb-3"><option value="grievance">Grievance</option><option value="certificate">Certificate</option><option value="training">Training</option></select><label for="request_title">Title</label><input id="request_title" name="title" class="form-control mb-3" required="required" maxlength="200"/><label for="request_description">Details</label><textarea id="request_description" name="description" class="form-control mb-3" required="required" maxlength="5000"/><button type="submit" class="btn btn-primary">Submit request</button></form></div>
        </t>
        <div class="card p-4" id="campus_notices"><h2 class="h5">Circulars</h2><t t-foreach="circulars" t-as="circular"><article class="border-bottom py-3"><h3 class="h6" t-esc="circular.name"/><span t-esc="circular.date_from"/><div t-field="circular.body"/></article></t><p t-if="not circulars">No current circulars.</p></div>
      </main>
    </t>
  </template>
  <template id="portal_library" name="Campus library"><t t-call="portal.portal_layout"><t t-set="title">Campus library</t><main class="container campus_portal"><h1>Campus library</h1><a href="/my/campus">Back to my campus</a><form action="/my/campus/library" method="get" class="my-4"><label for="library_search">Search by title</label><input id="library_search" type="search" name="search" class="form-control" t-att-value="search"/><button type="submit" class="btn btn-primary mt-2">Search</button></form><div class="card p-4"><h2 class="h5">Catalogue</h2><div class="table-responsive"><table class="table"><thead><tr><th>Title</th><th>Code</th><th>Type</th></tr></thead><tbody><t t-foreach="books" t-as="book"><tr><td t-esc="book.name"/><td t-esc="book.internal_code"/><td t-esc="book.media_type_id.name"/></tr></t><tr t-if="not books"><td colspan="3">No matching library resources.</td></tr></tbody></table></div><div class="d-flex gap-3"><a t-if="page > 1" t-att-href="'/my/campus/library?page=%s' % (page - 1)">Previous</a><a t-if="next_page" t-att-href="next_page">Next</a></div></div><div class="card p-4"><h2 class="h5">Digital resources</h2><t t-foreach="resources" t-as="resource"><article class="border-bottom py-3"><h3 class="h6" t-esc="resource.name"/><p t-esc="resource.description"/><a t-att-href="'/my/campus/resource/%s' % resource.id">Download <t t-esc="resource.filename"/></a></article></t><p t-if="not resources">No resources are published for your account.</p></div></main></t></template>
</odoo>
