<odoo>
  <template id="student_od_workspace" inherit_id="ideastone_erp.student_workspace" name="Student On Duty Management">
    <xpath expr="//nav[hasclass('student_subnav')]" position="attributes">
      <attribute name="t-if">d and section != 'on-duty'</attribute>
    </xpath>
    <xpath expr="//t[@t-elif=&quot;section == 'requests'&quot;][@t-call]" position="before">
      <t t-elif="section == 'on-duty'" t-call="ideastone_erp.student_od_content"/>
    </xpath>
  </template>

  <template id="student_od_content" name="Student On Duty content">
    <t t-set="od" t-value="d['od']"/>
    <div class="student_od_view">
      <header class="od_page_intro">
        <span class="od_page_icon"><i class="fa fa-clipboard" aria-hidden="true"/></span>
        <div><h1>On Duty (OD) Request</h1><p>Submit your OD request for academic, co-curricular or other official purposes.</p></div>
        <small>Semester: <t t-esc="od['term']"/></small>
      </header>

      <section id="student_od_summary" class="od_token_grid" aria-label="Semester OD token summary">
        <div class="od_token od_total"><span class="od_token_icon"><i class="fa fa-ticket" aria-hidden="true"/></span><div><span>Total OD Tokens</span><strong t-esc="od['total']"/><small>Per semester</small></div></div>
        <div class="od_token od_used"><span class="od_token_icon"><i class="fa fa-check" aria-hidden="true"/></span><div><span>Used Tokens</span><strong t-esc="od['used']"/><small>Consumed</small></div></div>
        <div class="od_token od_pending"><span class="od_token_icon"><i class="fa fa-clock-o" aria-hidden="true"/></span><div><span>Pending Requests</span><strong t-esc="od['pending']"/><small><t t-esc="od['reserved']"/> token(s) reserved</small></div></div>
        <div class="od_token od_remaining"><span class="od_token_icon"><i class="fa fa-check" aria-hidden="true"/></span><div><span>Remaining Tokens</span><strong t-esc="od['remaining']"/><small>Available</small></div></div>
      </section>
      <p t-if="not od['route']" class="od_alert">Your mentor and HOD approval route has not been assigned. Contact the college office before submitting.</p>
      <p t-elif="od['total'] == 0" class="od_alert">Your semester OD allowance has not been configured. Contact the college office.</p>

      <div class="od_upper_grid">
        <section id="student_od_apply" class="student_panel od_request_panel">
          <h3 class="od_widget_title"><i class="fa fa-file-text" aria-hidden="true"/> Initiate OD Request</h3>
          <div class="od_info_note"><i class="fa fa-info-circle" aria-hidden="true"/><span>OD type will be determined by Mentor / HOD during review.</span></div>
          <form action="/my/campus/student/action" method="post" enctype="multipart/form-data" class="od_form">
            <t t-call="ideastone_erp.student_action_fields"/>
            <input type="hidden" name="return_to" value="on-duty"/>
            <input type="hidden" name="key" t-att-value="od['submission_key']"/>
            <label for="od_event">Request Title / Purpose <b>*</b><input id="od_event" name="name" type="text" maxlength="160" required="required" placeholder="Enter purpose (e.g., Conference, Workshop, Sports Event, etc.)"/></label>
            <div class="od_date_fields">
              <div class="od_date_pair">
                <label for="od_from">From Date <b>*</b><input id="od_from" name="od_date_from" type="date" required="required"/></label>
                <label for="od_from_session">From Session <b>*</b><select id="od_from_session" name="od_from_session" required="required"><option value="" selected="selected" disabled="disabled">Select</option><option value="forenoon">Forenoon</option><option value="afternoon">Afternoon</option></select></label>
              </div>
              <div class="od_date_pair">
                <label for="od_to">To Date <b>*</b><input id="od_to" name="od_date_to" type="date" required="required"/></label>
                <label for="od_to_session">To Session <b>*</b><select id="od_to_session" name="od_to_session" required="required"><option value="" selected="selected" disabled="disabled">Select</option><option value="forenoon">Forenoon</option><option value="afternoon">Afternoon</option></select></label>
              </div>
            </div>
            <label for="od_venue">Destination / Venue <b>*</b><input id="od_venue" name="venue" type="text" maxlength="200" required="required" placeholder="Enter destination / venue (e.g., City, College, Organization)"/></label>
            <label for="od_purpose">Reason / Description <b>*</b><textarea id="od_purpose" name="purpose" maxlength="5000" rows="4" required="required" placeholder="Provide a brief and clear reason for your OD request..."/></label>
            <label for="od_support" class="od_file_label">Attachment <span>(Optional)</span><input id="od_support" type="file" name="file" accept=".pdf,.png,.jpg,.jpeg"/><small>You can attach an event brochure, invitation letter, or relevant document (PDF/JPG/PNG).</small></label>
            <div class="od_form_actions">
              <button type="submit" name="operation" value="od_draft" class="od_outline_button" t-att-disabled="None if od['can_submit'] else 'disabled'"><i class="fa fa-file-text-o" aria-hidden="true"/> Save Draft</button>
              <button type="submit" name="operation" value="od_submit" class="od_primary_button" t-att-disabled="None if od['can_submit'] else 'disabled'"><i class="fa fa-paper-plane" aria-hidden="true"/> Submit for Mentor Review</button>
            </div>
            <p t-if="not od['can_submit']" class="od_form_hint">An active semester, assigned mentor and HOD, and available tokens are required.</p>
          </form>
        </section>

        <div class="od_right_column">
          <section class="student_panel od_assistant">
            <h3 class="od_widget_title"><i class="fa fa-magic" aria-hidden="true"/> OD Request Assistant</h3>
            <div class="od_assistant_body"><strong><i class="fa fa-check-circle" aria-hidden="true"/> Before submitting, please check the following:</strong>
              <ul><li>Provide a clear and specific purpose for your request.</li><li>Mention the correct date(s) and destination / venue.</li><li>Attach supporting documents if available (e.g., invitation, event brochure).</li></ul>
              <p><i class="fa fa-info-circle" aria-hidden="true"/> Your request will be reviewed by your Mentor and HOD. The OD type and further processing will be decided by them.</p>
            </div>
          </section>
          <section class="student_panel od_proof_panel" id="student_od_proof">
            <h3 class="od_widget_title"><i class="fa fa-file-text" aria-hidden="true"/> Proof Submission (If Requested)</h3>
            <div class="od_proof_note"><i class="fa fa-exclamation-circle" aria-hidden="true"/><span>Proof submission is only required if your request is approved and specifically requested by Mentor / HOD.</span></div>
            <p class="od_proof_disabled"><i class="fa fa-upload" aria-hidden="true"/> Submit Proof (If Required)</p>
            <p class="od_proof_hint">Enabled only after HOD approval and a proof request</p>
            <t t-foreach="od['rows']" t-as="proof_row"><form t-if="proof_row['can_upload']" t-att-data-od-id="proof_row['id']" class="od_proof_form" action="/my/campus/student/action" method="post" enctype="multipart/form-data" hidden="hidden">
              <t t-call="ideastone_erp.student_action_fields"/><input type="hidden" name="operation" value="od_proof"/><input type="hidden" name="return_to" value="on-duty"/><input type="hidden" name="od_id" t-att-value="proof_row['id']"/>
              <strong><t t-esc="proof_row['reference']"/> · <t t-esc="proof_row['name']"/></strong>
              <small t-if="proof_row['proof_requirements']">Required: <t t-esc="proof_row['proof_requirements']"/></small>
              <small t-if="proof_row['proof_deadline']">Due by <t t-esc="proof_row['proof_deadline']"/></small>
              <label t-att-for="'od_widget_proof_' + str(proof_row['id'])">Evidence file<input t-att-id="'od_widget_proof_' + str(proof_row['id'])" type="file" name="file" accept=".pdf,.png,.jpg,.jpeg" required="required"/></label>
              <button type="submit" class="od_primary_button"><i class="fa fa-upload" aria-hidden="true"/> Submit Proof to HOD</button>
            </form></t>
            <details class="od_guidelines"><summary>View Guidelines</summary><p>When your Special OD is withheld pending proof, upload the evidence listed by the HOD here before the stated deadline. General OD needs no post-event proof.</p></details>
          </section>
        </div>
      </div>

      <section id="student_od_workflow" class="student_panel od_workflow">
        <h3 class="od_widget_title"><i class="fa fa-sitemap" aria-hidden="true"/> Approval Workflow</h3>
        <p class="od_tracking_label" role="status" aria-live="polite">Select a request in My OD Requests to follow its progress.</p>
        <div class="od_workflow_track"><ol><li data-step="1"><span>1</span><strong>Student Initiated</strong><small>OD request submitted</small></li><li data-step="2"><span>2</span><strong>Mentor Approval</strong><small>Review by class advisor</small></li><li data-step="3"><span>3</span><strong>HOD Approval</strong><small>Review by HOD</small></li><li data-step="4"><span>4</span><strong>Withheld / Proof Pending</strong><small>Only for Special OD</small></li><li data-step="5"><span>5</span><strong>Completed</strong><small>OD approved and recorded</small></li></ol></div>
        <p class="od_info_note"><i class="fa fa-info-circle" aria-hidden="true"/> General OD requests are completed after HOD approval. Special OD requests require proof submission and verification when requested.</p>
      </section>

      <div class="od_lower_grid">
        <section id="student_od_history" class="student_panel od_history">
          <h3 class="od_widget_title"><i class="fa fa-file-text" aria-hidden="true"/> My OD Requests</h3>
          <div class="od_history_controls"><label for="od_search"><i class="fa fa-search" aria-hidden="true"/><input id="od_search" type="search" placeholder="Search by Request ID or Purpose..."/></label><select id="od_status_filter" aria-label="Filter OD requests by status"><option value="">All Status</option><option value="draft">Draft</option><option value="returned">Returned</option><option value="pending_mentor">Pending Mentor</option><option value="pending_hod">Pending HOD</option><option value="withheld">Withheld</option><option value="proof_review">Proof Under Review</option><option value="completed">Completed</option><option value="rejected">Rejected</option><option value="invalid">Invalid</option><option value="cancelled">Cancelled</option></select></div>
          <div class="od_table_wrap"><table><thead><tr><th scope="col">#</th><th scope="col">Request ID</th><th scope="col">Title / Purpose</th><th scope="col">Date(s)</th><th scope="col">Status</th><th scope="col">Action</th></tr></thead><tbody>
            <tr t-foreach="od['rows']" t-as="row" class="od_history_row" t-att-data-search="(row['reference'] + ' ' + row['name']).lower()" t-att-data-status="row['state']" t-att-data-status-name="row['status']" t-att-data-reference="row['reference']" t-att-data-category="row['category']" t-att-data-proof-enabled="'true' if row['can_upload'] else 'false'" t-att-data-od-id="row['id']"><td t-esc="row_index + 1"/><td t-esc="row['reference']"/><td t-esc="row['name']"/><td><t t-esc="row['date_from']"/><t t-if="row['date_to'] != row['date_from']"> – <t t-esc="row['date_to']"/></t></td><td><span t-att-class="'od_status ' + row['state']" t-esc="row['status']"/></td><td><details class="od_details"><summary><i class="fa fa-eye" aria-hidden="true"/> View</summary><div><p><strong>Category:</strong> <t t-esc="row['category']"/></p><p><strong>Venue:</strong> <t t-esc="row['venue']"/></p><p t-esc="row['purpose']"/><p t-if="row['mentor_note']"><strong>Mentor feedback:</strong> <t t-esc="row['mentor_note']"/></p><p t-if="row['has_support']">Supporting attachment received</p><p t-if="row['proof_requirements']"><strong>Proof required:</strong> <t t-esc="row['proof_requirements']"/></p><p t-if="row['proof_deadline']"><strong>Proof deadline:</strong> <t t-esc="row['proof_deadline']"/></p>
              <form t-if="row['can_submit_draft']" action="/my/campus/student/action" method="post"><t t-call="ideastone_erp.student_action_fields"/><input type="hidden" name="operation" value="od_activate"/><input type="hidden" name="return_to" value="on-duty"/><input type="hidden" name="od_id" t-att-value="row['id']"/><button type="submit" class="od_primary_button"><t t-esc="'Resubmit for Mentor Review' if row['state'] == 'returned' else 'Submit draft for Mentor Review'"/></button></form>
              <form t-if="row['can_cancel']" action="/my/campus/student/action" method="post"><t t-call="ideastone_erp.student_action_fields"/><input type="hidden" name="operation" value="od_cancel"/><input type="hidden" name="return_to" value="on-duty"/><input type="hidden" name="od_id" t-att-value="row['id']"/><button type="submit" class="od_text_button">Cancel request</button></form>
              <div class="od_timeline"><strong>Status history</strong><p t-foreach="row['events']" t-as="event"><t t-esc="event['action']"/> · <t t-esc="event['by']"/> · <t t-esc="event['at']"/></p></div>
            </div></details></td></tr>
          </tbody></table></div>
          <p t-if="not od['rows']" class="od_empty">No OD requests yet. Submitted requests and drafts will appear here.</p>
          <p t-if="od['rows']" id="od_history_count" class="od_table_count"><t t-esc="len(od['rows'])"/> request(s)</p>
        </section>

        <section class="student_panel od_actions">
          <div class="od_actions_heading"><h3 class="od_widget_title"><i class="fa fa-bell" aria-hidden="true"/> Pending Actions &amp; Deadlines</h3><a href="#student_od_history">View All</a></div>
          <div t-if="od['actions']" class="od_action_list"><article t-foreach="od['actions']" t-as="action"><span t-att-class="'od_action_icon ' + action['state']"><i t-att-class="'fa fa-' + ('file-text' if action['state'] == 'withheld' else 'clock-o' if action['state'] in ('draft', 'returned', 'proof_review') else 'user-plus')" aria-hidden="true"/></span><div><strong t-esc="action['title']"/><small><t t-esc="action['reference']"/> - <t t-esc="action['name']"/></small><p t-esc="'Upload requested proof before the deadline.' if action['state'] == 'withheld' else 'Review mentor feedback and resubmit, or start a new request with corrected details.' if action['state'] == 'returned' else 'Submit this draft when ready.' if action['state'] == 'draft' else 'Your proof is awaiting HOD verification.' if action['state'] == 'proof_review' else 'Your request is under review.'"/></div><em t-if="action['deadline']">Due by <t t-esc="action['deadline']"/></em></article></div>
          <p t-if="not od['actions']" class="od_empty">No pending OD actions or deadlines.</p>
        </section>
      </div>
    </div>
  </template>
</odoo>
