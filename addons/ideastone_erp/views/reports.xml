<odoo>
  <record id="report_payslip" model="ir.actions.report"><field name="name">Campus payslip</field><field name="model">campus.payslip</field><field name="report_type">qweb-pdf</field><field name="report_name">ideastone_erp.payslip_document</field><field name="binding_model_id" ref="model_campus_payslip"/><field name="binding_type">report</field></record>
  <template id="payslip_document"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2>Salary statement</h2><p t-field="o.employee_id.name"/><p><span t-field="o.date_from"/> — <span t-field="o.date_to"/></p><table class="table"><tbody><tr><th>Working days</th><td t-field="o.working_days"/></tr><tr><th>Worked days</th><td t-field="o.worked_days"/></tr><tr><th>Paid leave</th><td t-field="o.paid_leave_days"/></tr><tr><th>Gross earnings</th><td t-field="o.gross"/></tr><tr><th>PF</th><td t-field="o.pf"/></tr><tr><th>ESI</th><td t-field="o.esi"/></tr><tr><th>TDS</th><td t-field="o.tds"/></tr><tr><th>Total deductions</th><td t-field="o.deductions"/></tr><tr><th>Net salary</th><td t-field="o.net"/></tr></tbody></table><p>Payroll status: <span t-field="o.state"/></p><p>Payment reference: <span t-field="o.payment_reference"/></p></div></t></t></t></template>
</odoo>
