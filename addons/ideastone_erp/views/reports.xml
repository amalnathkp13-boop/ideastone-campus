<odoo>
  <record id="report_hod_salary_agreement" model="ir.actions.report">
    <field name="name">Salary agreement</field>
    <field name="model">campus.salary.agreement</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">ideastone_erp.hod_salary_agreement</field>
  </record>
  <template id="hod_salary_agreement">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <t t-call="web.external_layout">
          <div class="page">
            <h2>Salary agreement</h2>
            <p t-field="o.name"/>
            <p t-field="o.employee_id.name"/>
            <p><span t-field="o.date_from"/> – <span t-if="o.date_to" t-field="o.date_to"/><t t-else="">Current</t></p>
            <table class="table">
              <tbody>
                <tr t-foreach="[('basic', 'Basic monthly pay'), ('allowance', 'Monthly allowances'), ('fixed_deduction', 'Fixed deduction'), ('tds', 'Monthly TDS')]" t-as="item">
                  <th t-out="item[1]"/>
                  <td><span t-out="hod_amounts[o.id][item[0]]" t-options="{'widget': 'monetary', 'display_currency': rupees}"/></td>
                </tr>
              </tbody>
            </table>
            <p>Approved by <span t-field="o.approved_by"/> · <span t-field="o.approved_on"/></p>
          </div>
        </t>
      </t>
    </t>
  </template>
  <record id="report_payslip" model="ir.actions.report"><field name="name">Campus payslip</field><field name="model">campus.payslip</field><field name="report_type">qweb-pdf</field><field name="report_name">ideastone_erp.payslip_document</field><field name="binding_model_id" ref="model_campus_payslip"/><field name="binding_type">report</field></record>
  <record id="report_hod_payslip" model="ir.actions.report">
    <field name="name">HOD payslip</field>
    <field name="model">campus.payslip</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">ideastone_erp.hod_payslip_document</field>
  </record>
  <template id="hod_payslip_document"><t t-call="ideastone_erp.payslip_document"/></template>
  <template id="payslip_document">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <t t-call="web.external_layout">
          <div class="page">
            <h2>Salary statement</h2>
            <p t-field="o.employee_id.name"/>
            <p><span t-field="o.date_from"/> — <span t-field="o.date_to"/></p>
            <table class="table">
              <tbody>
                <tr><th>Working days</th><td><span t-field="o.working_days"/></td></tr>
                <tr><th>Worked days</th><td><span t-field="o.worked_days"/></td></tr>
                <tr><th>Paid leave</th><td><span t-field="o.paid_leave_days"/></td></tr>
                <tr t-foreach="[('gross', 'Gross earnings'), ('pf', 'PF'), ('esi', 'ESI'), ('tds', 'TDS'), ('deductions', 'Total deductions'), ('net', 'Net salary')]" t-as="item">
                  <th t-out="item[1]"/>
                  <td><span t-out="hod_amounts[o.id][item[0]] if hod_amounts else o[item[0]]"
                      t-options="{'widget': 'monetary', 'display_currency': rupees if hod_amounts else o.currency_id}"/></td>
                </tr>
              </tbody>
            </table>
            <p>Payroll status: <span t-field="o.state"/></p>
            <p>Payment reference: <span t-field="o.payment_reference"/></p>
          </div>
        </t>
      </t>
    </t>
  </template>
</odoo>
