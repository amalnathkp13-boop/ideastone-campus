<templates xml:space="preserve">
 <t t-name="ideastone_erp.GreenCard">
  <main class="green_card">
   <p t-if="state.loading" role="status">Loading your saved Green Cards…</p>
   <div t-if="state.error" class="alert alert-danger" role="alert"><t t-esc="state.error"/><button class="btn" t-on-click="load">Retry</button></div>
   <t t-if="state.data and !state.error">
    <header class="page-head"><div><h1 t-esc="title"/><p t-esc="subtitle"/></div><span class="date-tag"><t t-esc="state.data.today"/> · Saved college records</span></header>
    <div class="gc_metrics" role="region" aria-label="Green Card summary"><article class="card metric" t-foreach="metrics" t-as="m" t-key="m[0]"><span t-att-class="'metric-icon '+m[3]"><i t-att-class="'fa fa-'+m[2]"/></span><div><span class="metric-label" t-esc="m[0]"/><strong class="metric-val" t-esc="m[1]"/><small t-esc="m[4]"/></div></article></div>
    <div t-if="student" class="main-grid student-grid">
     <section class="card panel"><div class="panel-head"><div><h2><i class="fa fa-file-text-o"/>Apply for Leave</h2><p>Submit an advance request or explain an existing absence</p></div><span class="chip blue">Mentor → HOD</span></div>
      <div t-if="!state.data.route" class="notice">Your college must configure your assigned mentor and HOD before you can submit.</div>
      <form t-on-submit.stop.prevent="submit">
       <label class="field">Leave Type<select t-model="state.form.type" required="required"><option value="announced">Announced Leave — in advance</option><option value="unannounced">Unannounced Leave — after absence</option></select></label>
       <div class="form-row"><div class="date-session-pair"><label class="field">From Date<input type="date" t-model="state.form.from" required="required"/></label><label class="field">Session<select t-model="state.form.fromSession"><option value="FN">Morning (FN)</option><option value="AN">Afternoon (AN)</option></select></label></div><div class="date-session-pair"><label class="field">To Date<input type="date" t-model="state.form.to" required="required"/></label><label class="field">Session<select t-model="state.form.toSession"><option value="FN">Morning (FN)</option><option value="AN">Afternoon (AN)</option></select></label></div></div>
       <label class="field">Reason for Leave<textarea t-model="state.form.reason" minlength="8" maxlength="500" required="required" placeholder="Clearly explain the reason for absence…"/><small class="counter"><t t-esc="state.form.reason.length"/>/500</small></label>
       <label class="field">Supporting proof (optional)<input type="file" accept=".pdf,.png,.jpg,.jpeg" t-on-change="file"/><small>PDF, PNG or JPEG · up to 2 MB · stored privately in your college ERP</small></label>
       <div class="actionbar"><button type="submit" class="btn blue" t-att-disabled="state.busy || state.reading || !state.data.route"><i class="fa fa-paper-plane-o"/>Submit for Mentor Review</button><button type="button" class="btn ghost" t-att-disabled="state.busy" t-on-click="clear">Clear Form</button></div>
      </form>
     </section>
     <section class="card panel"><div class="panel-head"><div><h2><i class="fa fa-exclamation-circle"/>Pending Actions</h2><p>Proof requests and applications requiring correction</p></div></div><div class="queue"><article t-foreach="attention" t-as="r" t-key="r.id" class="focus-item"><div><strong t-esc="r.reference"/><small><t t-esc="label(r)"/> · <t t-esc="r.from"/></small></div><button class="btn compact" t-on-click="() => this.open(r)">Respond</button></article><p t-if="!attention.length" class="empty">No actions required</p></div><div class="info-note">A leave approval authorizes an absence; it does not convert attendance to Present or OD.</div></section>
    </div>
    <div t-att-class="student ? 'main-grid student-history' : 'main-grid'">
     <section class="card panel"><div class="panel-head"><div><h2><i class="fa fa-clipboard"/><t t-esc="student ? 'My Leave Requests' : hod ? 'Department Green Card Status' : 'Requests Awaiting Mentor Review'"/></h2><p t-esc="student ? 'Track mentor and HOD decisions' : hod ? 'Only applications approved and forwarded by the mentor' : 'Assigned mentorship students only · review the detailed application'"/></div></div>
      <div class="filters"><input t-if="!student" class="input" type="search" t-model="state.search" aria-label="Search student or request" placeholder="Search student / request…"/><select t-if="!student" class="select" t-model="state.type" aria-label="Filter leave type"><option value="all">All leave types</option><option value="announced">Announced</option><option value="unannounced">Unannounced</option></select><select t-if="student || hod" class="select" t-model="state.status" aria-label="Filter application status"><option value="all">All statuses</option><option t-if="student" value="pending">Under review</option><option t-if="hod" value="hod">Awaiting HOD decision</option><option t-if="hod" value="hod_proof">HOD proof requested</option><option value="approved">Approved</option><option value="rejected">Rejected</option><option t-if="hod" value="returned">Returned</option></select></div>
      <div class="tablewrap"><table t-att-class="'data-table '+(hod ? 'hod-table' : '')"><thead><tr><th t-esc="student ? 'Request ID' : 'Student'"/><th>Leave Period</th><th>Type</th><th t-esc="hod ? 'Mentor Status' : 'Days'"/><th t-esc="student ? 'Status' : hod ? 'Application Status' : 'Stage'"/><th>Action</th></tr></thead><tbody><tr t-foreach="rows" t-as="r" t-key="r.id"><td><strong t-esc="student ? r.reference : r.student"/><small t-if="!student"><t t-esc="r.register"/> · <t t-esc="r.class"/></small></td><td class="dates"><t t-esc="r.from"/> <b t-esc="r.fromSession"/><br/><t t-esc="r.to"/> <b t-esc="r.toSession"/></td><td class="capitalize" t-esc="r.type"/><td><span t-if="hod" class="chip green">Forwarded to HOD</span><t t-else="" t-esc="r.days"/></td><td><span t-att-class="'chip '+tone(r)" t-att-title="label(r)" t-esc="label(r)"/></td><td><button t-att-class="'btn compact '+(hod and r.state === 'hod' ? 'blue' : '')" t-on-click="() => this.open(r)" t-esc="student ? 'View' : hod ? (r.state === 'hod' ? 'Decide' : 'View') : (r.stage === 'advisor' ? 'Review' : 'View')"/></td></tr><tr t-if="!rows.length"><td colspan="6" class="empty">No applications match this scope.</td></tr></tbody></table></div><div class="table-foot"><span>Open an application to view its reason and decision history</span><span><t t-esc="rows.length"/> requests</span></div>
     </section>
     <section t-if="student" class="card panel journey"><div class="panel-head"><div><h2><i class="fa fa-random"/>Approval Journey</h2><p>How your leave is processed</p></div></div><article t-foreach="[['01','Student Submission','Announced or unannounced leave with reason','Submit'],['02','Mentor Review','May request proof or verify with parent','1st sign'],['03','HOD Final Review','Final approval after optional verification','2nd sign'],['04','Digital Leave Sheet','Available after all required approvals','Complete']]" t-as="step" t-key="step[0]"><span class="step" t-esc="step[0]"/><div><strong t-esc="step[1]"/><small t-esc="step[2]"/></div><span class="chip blue" t-esc="step[3]"/></article><div class="info-note">A principal review remains required where it is configured by your college.</div></section>
     <section t-else="" class="card panel"><div class="panel-head"><div><h2><i class="fa fa-exclamation-triangle"/><t t-esc="hod ? 'HOD Action Required' : 'Needs Attention'"/></h2><p t-esc="hod ? 'Mentor-forwarded applications awaiting your action' : 'Verification and pending decisions'"/></div><span class="chip amber"><t t-esc="attention.length"/> open</span></div><div class="queue"><article t-foreach="attention.slice(0,5)" t-as="r" t-key="r.id" class="issue"><span t-att-class="'issue-icon '+(/proof|return/.test(r.state) ? 'amber' : 'blue')"><i class="fa fa-clock-o"/></span><div><strong><t t-esc="r.student"/> · <t t-esc="r.reference"/></strong><small t-esc="label(r)"/></div><button class="btn compact" t-on-click="() => this.open(r)">Review</button></article><p t-if="!attention.length" class="empty">No outstanding reviews</p></div><div class="info-note" t-esc="hod ? 'Applications enter HOD review only after mentor approval and forwarding.' : 'Parent verification and proof requests are optional. They never replace formal approval.'"/></section>
    </div>
    <t t-if="!student">
     <div class="secondary-grid"><section class="card panel"><div class="panel-head"><div><h2><i class="fa fa-bar-chart"/><t t-esc="hod ? 'Green Card Status Breakdown' : 'Mentor Leave Request Trend'"/></h2><p>Saved application counts · announced vs unannounced</p></div><div class="head-actions"><div class="trendbar"><button t-att-class="state.period === 'weekly' ? 'active' : ''" t-att-aria-pressed="state.period === 'weekly' ? 'true' : 'false'" t-on-click="() => this.state.period = 'weekly'" t-esc="hod ? state.data.today.slice(0,7) : 'Weekly'"/><button t-att-class="state.period === 'monthly' ? 'active' : ''" t-att-aria-pressed="state.period === 'monthly' ? 'true' : 'false'" t-on-click="() => this.state.period = 'monthly'" t-esc="hod ? 'All Requests' : 'Monthly'"/></div><button class="btn compact" aria-label="Export chart" t-on-click="exportChart"><i class="fa fa-download"/></button></div></div>
       <figure class="chart-frame"><svg class="chart-svg" viewBox="0 0 736 228" role="img" aria-label="Green Card counts by status and leave type"><t t-foreach="chart.ticks" t-as="tick" t-key="tick"><line x1="56" x2="710" t-att-y1="chartY(tick)" t-att-y2="chartY(tick)" stroke="#e7eef7"/><text x="42" t-att-y="chartY(tick)+4" text-anchor="end" t-esc="tick"/></t><t t-foreach="chart.rows" t-as="c" t-key="c.label"><rect t-att-x="64+c_index*chart.width+chart.width/2-28" t-att-y="chartY(c.announced)" width="24" t-att-height="172-chartY(c.announced)" rx="3" fill="#267be9"/><rect t-att-x="64+c_index*chart.width+chart.width/2+4" t-att-y="chartY(c.unannounced)" width="24" t-att-height="172-chartY(c.unannounced)" rx="3" fill="#9db8d3"/><text t-att-x="64+c_index*chart.width+chart.width/2-16" t-att-y="chartY(c.announced)-7" text-anchor="middle" t-esc="c.announced"/><text t-att-x="64+c_index*chart.width+chart.width/2+16" t-att-y="chartY(c.unannounced)-7" text-anchor="middle" t-esc="c.unannounced"/><text t-att-x="64+c_index*chart.width+chart.width/2" y="199" text-anchor="middle" t-esc="c.label"/></t></svg></figure><div class="small-key"><span><i/>Announced</span><span><i class="unannounced"/>Unannounced</span></div>
      </section><section class="card panel"><div class="panel-head"><div><h2><i class="fa fa-check-circle-o"/><t t-esc="hod ? 'Recent Final Decisions' : 'Forwarded to HOD'"/></h2><p>Latest recorded decisions and verification</p></div><button class="btn compact" t-on-click="exportRequests">Export CSV</button></div><div class="follow-table"><article t-foreach="decisions" t-as="r" t-key="r.id" class="follow-row"><div><strong><t t-esc="r.student"/> · <t t-esc="r.reference"/></strong><small><t t-esc="label(r)"/> · <t t-esc="r.from"/></small></div><button class="btn compact" t-on-click="() => this.open(r)">View</button></article><p t-if="!decisions.length" class="empty">No decisions recorded yet</p></div></section></div>
     <div class="bottom-grid"><section class="card panel"><div class="panel-head"><div><h2><i class="fa fa-magic"/><t t-esc="hod ? 'AI Green Card Insights' : 'AI Leave Insights'"/></h2><p>Rule-based observations from your assigned records</p></div><span class="chip muted">Advisory only</span></div><div class="insight-strip"><article class="insight" t-foreach="insights" t-as="item" t-key="item[0]"><i class="fa fa-magic"/><div><strong t-esc="item[0]"/><p t-esc="item[1]"/></div></article></div></section><section class="card panel"><div class="panel-head"><div><h2><i class="fa fa-history"/><t t-esc="hod ? 'Application Activity' : 'Recent Decision Audit'"/></h2><p>Recorded status changes and actions</p></div></div><article class="audit-event" t-foreach="audit" t-as="entry" t-key="entry.reference+entry.at+entry_index"><strong><t t-esc="entry.reference"/> · <t t-esc="entry.student"/></strong> — <t t-esc="entry.action"/><small><t t-esc="entry.by"/> · <t t-esc="entry.at"/></small></article><p t-if="!audit.length" class="empty">No application activity yet</p></section></div>
    </t>
    <p class="footnote">Requests and decision history are saved in your college database. Access follows your authenticated login and assigned approval route.</p>
   </t>
  </main>
 </t>
 <t t-name="ideastone_erp.GreenCardDialog">
  <Dialog title="'Green Card · '+row.reference" size="'lg'" contentClass="'green_card_dialog'">
   <div class="green_card dialog-workarea"><div class="request-details"><div><small>Student / Register No.</small><strong><t t-esc="row.student"/> · <t t-esc="row.register"/></strong></div><div><small>Class / Department</small><strong><t t-esc="row.class"/> · <t t-esc="row.department"/></strong></div><div><small>Leave Type</small><strong class="capitalize" t-esc="row.type"/></div><div><small>Leave Period</small><strong><t t-esc="row.from"/> <t t-esc="row.fromSession"/> → <t t-esc="row.to"/> <t t-esc="row.toSession"/> (<t t-esc="row.days"/> days)</strong></div></div><h3>Reason for Leave</h3><p class="panel-flat" t-esc="row.reason"/><div class="notice">Current status: <strong t-esc="owner.label(row)"/><br/>Parent contact: <t t-esc="row.parent ? 'Confirmed in review history' : 'Not recorded'"/><br/>Supporting proof: <t t-esc="row.proof || row.support || 'Not submitted'"/><div class="actionbar"><a t-if="row.support" t-att-href="'/my/campus/green-card/file/'+row.id+'?kind=support'" class="btn compact" target="_blank">View supporting file</a><a t-if="row.proof" t-att-href="'/my/campus/green-card/file/'+row.id+'?kind=proof'" class="btn compact" target="_blank">View requested proof</a></div></div>
    <h3>Approval &amp; verification history</h3><div class="history-row" t-foreach="row.history" t-as="entry" t-key="entry_index"><i class="fa fa-check-circle-o"/><div><strong t-esc="entry.action"/><p t-if="entry.note" t-esc="entry.note"/><small><t t-esc="entry.by"/> · <t t-esc="entry.at"/></small></div></div>
    <t t-if="owner.student and /proof|return/.test(row.state)"><h3>Respond to your reviewer</h3><label t-if="row.state.endsWith('proof')" class="field">Upload Requested Proof<input type="file" accept=".pdf,.jpg,.jpeg,.png" t-on-change="(event) => this.owner.file(event, this.state)"/><small>PDF, PNG or JPEG · maximum 2 MB</small></label><label t-else="" class="field">Correct / Clarify Reason<textarea maxlength="500" t-model="state.reason"/></label></t>
    <t t-if="canReview"><h3 t-esc="owner.hod ? 'HOD Decision' : 'Verification and decision'"/><div t-if="/proof|return/.test(row.state)" class="notice">A student response is outstanding. Approval is unavailable until it is received.</div><label class="field">Review remarks / decision reason<textarea maxlength="500" t-model="state.note" placeholder="Decision reason, requested evidence or parent-call outcome…"/></label><label class="parent-check"><input type="checkbox" t-model="state.parent"/>Spoken to parent / guardian (confirmed)</label></t>
    <p t-if="row.stage === 'principal'" class="notice">HOD approval is recorded. Your configured route requires principal approval before the leave sheet can be issued.</p>
   </div>
   <t t-set-slot="footer"><a t-if="row.state === 'approved'" class="btn btn-primary" t-att-href="'/my/campus/green-card/sheet/'+row.id" target="_blank">Open Approved Leave Sheet</a><button t-if="owner.student and /proof|return/.test(row.state)" class="btn btn-primary" t-att-disabled="state.busy || state.reading" t-on-click="() => this.act('respond')">Submit Response</button><t t-if="canReview"><button class="btn btn-primary" t-att-disabled="state.busy || /proof|return/.test(row.state)" t-on-click="() => this.act('approve')" t-esc="owner.hod ? 'Approve Green Card' : 'Forward to HOD'"/><button class="btn btn-outline-primary" t-att-disabled="state.busy || /proof|return/.test(row.state)" t-on-click="() => this.act('proof')">Request Proof</button><button class="btn btn-outline-secondary" t-att-disabled="state.busy || !state.parent" t-on-click="() => this.act('parent')">Save Parent Contact</button><button class="btn btn-outline-secondary" t-att-disabled="state.busy || /proof|return/.test(row.state)" t-on-click="() => this.act('return')">Return</button><button class="btn btn-outline-danger" t-att-disabled="state.busy" t-on-click="() => this.act('reject')">Reject</button></t><button class="btn btn-light" t-att-disabled="state.busy" t-on-click="props.close">Close</button></t>
  </Dialog>
 </t>
</templates>
