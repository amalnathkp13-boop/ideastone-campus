<templates xml:space="preserve">
  <t t-name="ideastone_erp.FacultyTaskList">
    <main class="campus_task_list" t-ref="root">
      <p t-if="state.loading" class="task_loading" role="status">Loading your assigned responsibilities…</p>
      <div t-if="state.error" class="task_error" role="alert"><span t-esc="state.error"/><button t-on-click="load">Retry</button></div>
      <t t-if="d">
        <header class="task_title"><div><p>VCET Campus <span>/</span> My Task List <span>/</span> <t t-esc="title"/></p><h1 t-esc="title"/><p class="task_subtitle" t-esc="mentor ? 'Monitor your class, review student performance and follow up on attendance shortages.' : 'Select your teaching session, record attendance and review before submitting.'"/></div><span class="task_workspace"><i class="fa fa-user-o"/> <t t-esc="d.user"/><small t-esc="d.is_hod ? 'HOD · Teaching responsibilities' : 'Faculty Workspace'"/></span></header>

        <t t-if="mentor">
          <section class="task_card task_intro"><div class="task_intro_copy"><span class="task_icon"><i class="fa fa-users"/></span><div><small>MY ASSIGNED MENTORSHIP CLASS</small><h2><t t-esc="d.class_label"/><span class="task_pill">Class Mentor</span></h2><p><t t-esc="d.students.length"/> students · <t t-esc="d.semester || 'No active semester'"/> · Class-wide monitoring across subjects</p></div></div><label class="task_class_choice">Mentorship class<select aria-label="Mentorship class" t-model="state.classKey" t-on-change="(event) => this.change(event, 'classKey')"><option t-if="!d.classes.length" value="">No assigned class</option><option t-foreach="d.classes" t-as="row" t-key="row.key" t-att-value="row.key"><t t-esc="row.label"/> · <t t-esc="row.semester"/></option></select></label></section>
          <section class="task_kpis" aria-label="Mentorship summary">
            <article class="task_card"><span class="task_kpi_icon blue"><i class="fa fa-users"/></span><div><small>My Class Students</small><strong t-esc="d.students.length"/><p>Assigned mentorship class</p></div></article>
            <article class="task_card"><span class="task_kpi_icon green"><i class="fa fa-book"/></span><div><small>Subjects Monitored</small><strong t-esc="d.subjects.length"/><p>Across submitted attendance</p></div></article>
            <article class="task_card"><span class="task_kpi_icon amber"><i class="fa fa-line-chart"/></span><div><small>Below <t t-esc="d.threshold"/>%</small><strong t-esc="riskRows.length"/><p>Students requiring review</p></div></article>
            <article class="task_card"><span class="task_kpi_icon purple"><i class="fa fa-file-text-o"/></span><div><small>Open Follow-ups</small><strong t-esc="d.students.filter(row => row.followup).length"/><p>Upcoming counseling reviews</p></div></article>
          </section>
          <div class="task_mentor_grid">
            <section class="task_card task_panel"><div class="task_panel_top"><div><h2><i class="fa fa-list-alt"/> Student Attendance Performance</h2><p>View class students across subjects. Attendance changes require teaching authorization.</p></div><button class="task_outline" t-on-click="() => this.download('students')"><i class="fa fa-download"/> Download</button></div>
              <div class="task_toolbar"><label class="task_search"><i class="fa fa-search"/><input type="search" aria-label="Search mentorship students" placeholder="Search student name or roll number..." t-att-value="state.search" t-on-input="search"/></label><select aria-label="Mentor student filter" t-model="state.filter" t-on-change="filter"><option value="all">All Students</option><option value="risk">Below <t t-esc="d.threshold"/>%</option><option value="followup">Follow-up Open</option></select></div>
              <div class="task_tablebox"><table><thead><tr><th>#</th><th>Roll No.</th><th>Student</th><th>Attended / Held</th><th>Overall</th><th>Shortage</th><th>Actions</th></tr></thead><tbody><tr t-foreach="rows" t-as="row" t-key="row.id"><td t-esc="(state.page - 1) * 8 + row_index + 1"/><td t-esc="row.roll"/><td t-esc="row.name"/><td><t t-esc="row.present"/> / <t t-esc="row.held"/></td><td><strong t-att-class="row.shortage ? 'task_rate low' : 'task_rate'" t-esc="rate(row.rate)"/></td><td><span t-att-class="row.shortage ? 'task_status warning' : 'task_status present'" t-esc="row.held ? row.shortage ? 'Review' : 'On track' : 'No records'"/></td><td><div class="task_row_actions"><button class="task_outline" t-on-click="() => this.showProfile(row)">View</button><button class="task_quiet" t-on-click="() => this.showFollowup(row)">Follow-up</button></div></td></tr><tr t-if="!rows.length"><td colspan="7" class="task_empty">No students match this class and filter.</td></tr></tbody></table></div>
              <t t-call="ideastone_erp.TaskListPager"/>
            </section>
            <aside class="task_side_stack"><section class="task_card task_panel"><div class="task_panel_top"><div><h2><i class="fa fa-bell-o"/> Students Needing Attention</h2><p>Using the college's <t t-esc="d.threshold"/>% attendance threshold</p></div></div><article class="task_attention" t-foreach="riskRows.slice(0, 4)" t-as="row" t-key="row.id"><div><strong t-esc="row.name"/><p><t t-esc="row.roll"/> · <t t-esc="rate(row.rate)"/></p></div><button class="task_quiet" t-on-click="() => this.showFollowup(row)">Follow-up</button></article><p t-if="!riskRows.length" class="task_empty">No recorded attendance shortages.</p><button class="task_link" t-on-click="() => {this.state.filter = 'risk'; this.state.page = 1;}">See all students below limit →</button></section>
              <section class="task_card task_panel"><div class="task_panel_top"><div><h2><i class="fa fa-bar-chart"/> Subject Attendance Overview</h2><p>Aggregated attendance for your mentorship class</p></div></div><div t-foreach="d.subjects" t-as="row" t-key="row.id" class="task_subject_bar"><div><strong t-esc="row.name"/><span t-esc="rate(row.rate)"/></div><div class="task_progress"><span t-att-style="'width:' + Math.min(100, row.rate || 0) + '%'"/></div></div><p t-if="!d.subjects.length" class="task_empty">Subject rates appear after attendance is submitted.</p></section>
            </aside>
          </div>
          <div class="task_bottom_grid"><section class="task_card task_panel"><div class="task_panel_top"><div><h2><i class="fa fa-clock-o"/> Recent Class Attendance</h2><p>Read-only teaching-hour submissions for your mentorship class</p></div><button class="task_quiet" t-on-click="load">Refresh</button></div><t t-call="ideastone_erp.TaskListHistory"/></section><section class="task_card task_panel"><div class="task_panel_top"><div><h2><i class="fa fa-file-text-o"/> My Follow-ups</h2><p>Mentor counseling notes — attendance is not modified</p></div></div><article t-foreach="d.followups.slice(0, 6)" t-as="row" t-key="row.id" class="task_followup"><strong t-esc="row.student"/><p t-esc="row.note"/><small><t t-esc="row.date"/><t t-if="row.due"> · Next review <t t-esc="row.due"/></t></small></article><p t-if="!d.followups.length" class="task_empty">Follow-up notes you save appear here.</p></section></div>
          <section class="task_card task_insight"><span class="task_icon purple"><i class="fa fa-magic"/></span><div><h2>Attendance Insights for My Class</h2><p><t t-esc="riskRows.length"/> student(s) need a shortage review. Review individual performance and recent subject submissions.</p></div><button class="task_outline" t-on-click="() => {this.state.filter = 'risk'; this.state.page = 1;}">Review Shortages</button></section>
        </t>

        <t t-else="">
          <section class="task_card task_intro"><div><small>MY TEACHING RESPONSIBILITIES</small><h2>Select an assigned teaching hour, then record attendance</h2><p>Choose subject → mark exceptions → validate and submit.</p></div><span class="task_status present" t-esc="d.can_save ? 'Can mark assigned session' : d.sheet_state === 'done' ? 'Submitted · Locked' : 'View assigned sessions'"/></section>
          <nav class="task_card task_stages" aria-label="Attendance workflow steps"><button t-foreach="[{id: 1, name: 'Select Class &amp; Hour', note: 'Schedule preselected'}, {id: 2, name: 'Mark Attendance', note: 'Mark all, then exceptions'}, {id: 3, name: 'Review &amp; Submit', note: 'Validate before confirming'}]" t-as="stage" t-key="stage.id" t-att-class="{active: state.step === stage.id, done: state.step &gt; stage.id}" t-on-click="() => this.setStep(stage.id)"><b t-esc="stage.id"/><span><strong t-esc="stage.name"/><small t-esc="stage.note"/></span></button></nav>
          <section class="task_card task_panel task_selection" id="task-step-1"><div class="task_panel_top"><div><h2><i class="fa fa-calendar"/> Select Class &amp; Session <span class="task_step_tag">STEP 01</span></h2><p>Your assigned timetable supplies the subject, class and teaching hour.</p></div><span class="task_status" t-esc="d.sheet_state === 'done' ? 'Submitted' : d.sheet_state === 'unrecorded' ? 'Not recorded' : 'Draft'"/></div>
            <div class="task_select_grid"><label>Assigned Subject / Class<select aria-label="Assigned subject" t-model="state.subjectKey" t-on-change="(event) => this.change(event, 'subjectKey')"><option t-if="!d.subjects.length" value="">No assigned subjects</option><option t-foreach="d.subjects" t-as="row" t-key="row.key" t-att-value="row.key"><t t-esc="row.code"/> — <t t-esc="row.name"/> · <t t-esc="row.class"/></option></select></label><label>Semester<select aria-label="Teaching semester" t-model="state.termId" t-on-change="(event) => this.change(event, 'termId')"><option t-foreach="d.terms" t-as="row" t-key="row.id" t-att-value="row.id.toString()" t-esc="row.name"/></select></label><label>Hour / Session<select aria-label="Teaching hour" t-model="state.sessionId" t-on-change="(event) => this.change(event, 'sessionId')"><option t-if="!d.hours.length" value="">No session on this date</option><option t-foreach="d.hours" t-as="row" t-key="row.id" t-att-value="row.id.toString()"><t t-esc="row.number"/> · <t t-esc="row.time"/></option></select></label><label>Attendance Date<input type="date" aria-label="Attendance date" t-att-value="state.date" t-on-change="(event) => this.change(event, 'date')"/></label></div>
            <div class="task_selection_footer"><p><i class="fa fa-check-circle"/> <t t-esc="subject ? subject.name + ' · ' + subject.class : 'Your teaching allocations will appear here.'"/></p><button class="task_primary" t-on-click="() => this.setStep(2)" t-att-disabled="!state.sessionId">Continue to Attendance <i class="fa fa-arrow-right"/></button></div>
          </section>
          <div class="task_register_grid"><section class="task_card task_panel" id="task-step-2"><div class="task_panel_top"><div><h2><i class="fa fa-list-alt"/> Student Attendance Register <span class="task_step_tag">STEP 02</span></h2><p>Mark present, record exceptions, or view individual performance.</p></div><span><t t-esc="d.students.length"/> enrolled</span></div>
            <div class="task_toolbar"><label class="task_search"><i class="fa fa-search"/><input type="search" aria-label="Search teaching students" placeholder="Search student name or roll number..." t-att-value="state.search" t-on-input="search"/></label><select aria-label="Filter attendance" t-model="state.filter" t-on-change="filter"><option value="all">All Students</option><option value="unmarked">Unmarked</option><option value="present">Present</option><option value="absent">Absent</option><option value="excused">OD / Leave</option></select><button class="task_primary" t-att-disabled="!editable" t-on-click="markAll"><i class="fa fa-check"/> Mark All Present</button><button class="task_outline" t-att-disabled="state.saving || !state.dirty" t-on-click="load">Discard Unsaved</button></div>
            <div class="task_tablebox"><table><thead><tr><th>#</th><th>Roll No.</th><th>Student Name</th><th>Current Status</th><th>Mark Attendance</th><th>Student Performance</th></tr></thead><tbody><tr t-foreach="rows" t-as="row" t-key="row.id"><td t-esc="(state.page - 1) * 8 + row_index + 1"/><td t-esc="row.roll"/><td t-esc="row.name"/><td><span t-att-class="'task_status ' + state.statuses[row.id]" t-esc="status(state.statuses[row.id])"/></td><td><div class="task_row_actions"><button t-att-disabled="!editable || row.status === 'excused'" t-att-class="{task_mark: true, selected: state.statuses[row.id] === 'present'}" t-att-aria-label="'Mark ' + row.name + ' present'" t-on-click="() => this.mark(row, 'present')">P</button><button t-att-disabled="!editable || row.status === 'excused'" t-att-class="{task_mark: true, absent: true, selected: state.statuses[row.id] === 'absent'}" t-att-aria-label="'Mark ' + row.name + ' absent'" t-on-click="() => this.mark(row, 'absent')">A</button></div></td><td><button class="task_outline" t-on-click="() => this.showProfile(row)">View Performance</button></td></tr><tr t-if="!rows.length"><td colspan="6" class="task_empty">No students match this session and filter.</td></tr></tbody></table></div><t t-call="ideastone_erp.TaskListPager"/><div class="task_end_actions"><button class="task_outline" t-att-disabled="!editable || counts.unmarked &gt; 0 || !counts.total" t-on-click="() => this.save(false)"><i class="fa fa-save"/> Save Draft</button></div>
          </section>
          <aside class="task_card task_panel task_live"><div class="task_panel_top"><div><h2><i class="fa fa-bar-chart"/> Live Attendance Summary</h2><p>Updates instantly as you mark the register.</p></div></div><div class="task_summary"><div>Total Students<strong t-esc="counts.total"/></div><div class="good">Present<strong t-esc="counts.present"/></div><div class="warning">Absent<strong t-esc="counts.absent"/></div><div>Approved OD / Leave<strong t-esc="counts.protected"/></div><div>Unmarked<strong t-esc="counts.unmarked"/></div></div><p class="task_notice"><strong>Smart validation</strong><br/>Existing approved exemptions are protected. Mark the complete roster before submission. Submitted attendance uses the authorized correction workflow.</p><button class="task_primary" t-on-click="() => this.setStep(3)">Review Attendance <i class="fa fa-arrow-right"/></button></aside></div>
          <section class="task_card task_panel task_review" id="task-step-3"><div class="task_panel_top"><div><h2><i class="fa fa-check-circle-o"/> Review &amp; Submit <span class="task_step_tag">STEP 03</span></h2><p>Check session totals, lesson notes and missing attendance before submitting.</p></div><span t-att-class="ready ? 'task_status present' : 'task_status unmarked'" t-esc="d.sheet_state === 'done' ? 'Submitted' : ready ? 'Ready to submit' : 'Not ready'"/></div><div class="task_review_grid"><div><div class="task_review_metrics"><article><strong t-esc="counts.present"/><small>Present</small></article><article><strong t-esc="counts.absent"/><small>Absent</small></article><article><strong t-esc="counts.protected"/><small>Approved OD / Leave</small></article></div><p class="task_validation"><i t-att-class="state.sessionId ? 'fa fa-check-circle' : 'fa fa-exclamation-circle'"/> <t t-esc="state.sessionId ? 'Class and hour match your assigned timetable.' : 'Select an assigned teaching hour.'"/></p><p class="task_validation"><i t-att-class="counts.total &amp;&amp; !counts.unmarked ? 'fa fa-check-circle' : 'fa fa-exclamation-circle'"/> <t t-esc="counts.unmarked ? counts.unmarked + ' student(s) are still unmarked.' : counts.total ? 'Every student has an attendance status.' : 'No class roster is available.'"/></p><p class="task_validation"><i t-att-class="state.notes.trim() ? 'fa fa-check-circle' : 'fa fa-exclamation-circle'"/> <t t-esc="state.notes.trim() ? 'Lesson notes are ready.' : 'Enter the topic taught before final submission.'"/></p></div><div><label class="task_note_label">Lesson Notes / Topic Taught<textarea t-att-disabled="!editable" maxlength="500" rows="4" placeholder="Enter lesson notes..." t-att-value="state.notes" t-on-input="notes"/></label><p class="task_hint">Saved with the attendance record. <t t-esc="state.notes.length"/>/500</p><div class="task_end_actions"><span t-esc="state.dirty ? 'Unsaved changes' : d.sheet_state === 'done' ? 'Submitted · Locked' : 'No unsaved changes'"/><button class="task_outline" t-att-disabled="!editable || counts.unmarked &gt; 0 || !counts.total" t-on-click="() => this.save(false)">Save Draft</button><button class="task_primary" t-att-disabled="!ready" t-on-click="() => this.state.confirm = true">Submit Attendance <i class="fa fa-check"/></button></div></div></div></section>
          <div class="task_bottom_grid"><section class="task_card task_panel"><div class="task_panel_top"><div><h2><i class="fa fa-clock-o"/> Attendance History</h2><p>Submitted teaching sessions from the selected semester.</p></div><button class="task_outline" t-on-click="() => this.download('history')"><i class="fa fa-download"/> Download</button></div><t t-call="ideastone_erp.TaskListHistory"/></section><section class="task_card task_panel"><div class="task_panel_top"><div><h2><i class="fa fa-magic"/> Attendance Insights</h2><p>Based on your submitted teaching records.</p></div></div><div class="task_teaching_insights"><article><i class="fa fa-bell-o"/><div><strong>Attendance Shortage Alert</strong><p t-esc="d.insights.low ? d.insights.low.name + ' · ' + rate(d.insights.low.rate) : 'Rates appear after attendance is submitted.'"/></div></article><article><i class="fa fa-check-circle-o"/><div><strong>Missing Submissions</strong><p t-esc="d.sheet_state === 'done' ? 'The selected session has been submitted.' : state.sessionId ? 'The selected session is awaiting attendance submission.' : 'Choose a scheduled teaching session to begin.'"/></div></article></div></section></div>
        </t>
      </t>
      <div t-if="state.profile" class="task_drawer_backdrop" t-on-click.self="() => this.state.profile = null"><aside class="task_drawer" role="dialog" aria-modal="true" aria-label="Individual Student Attendance"><header><div><h2>Individual Student Attendance</h2><p><t t-esc="state.profile.name"/> · <t t-esc="state.profile.roll"/></p></div><button class="task_outline" aria-label="Close student performance" t-on-click="() => this.state.profile = null">×</button></header><div class="task_drawer_body"><div class="task_review_metrics"><article><strong t-esc="state.profile.present"/><small>Attended</small></article><article><strong t-esc="state.profile.held"/><small>Held</small></article><article><strong t-esc="rate(state.profile.rate)"/><small>Overall</small></article></div><div class="task_tablebox"><table><thead><tr><th>Subject</th><th>Attended / Held</th><th>Attendance</th></tr></thead><tbody><tr t-foreach="state.profile.subjects" t-as="row" t-key="row_index"><td t-esc="row.subject"/><td><t t-esc="row.present"/> / <t t-esc="row.sessions"/></td><td t-esc="rate(row.rate)"/></tr><tr t-if="!state.profile.subjects.length"><td colspan="3" class="task_empty">No submitted attendance in your permitted scope.</td></tr></tbody></table></div></div></aside></div>
      <div t-if="state.followup" class="task_modal_backdrop"><form class="task_modal" role="dialog" aria-modal="true" aria-label="Mentor follow-up" t-on-submit.prevent="saveFollowup"><h2>Attendance Follow-up</h2><p t-esc="state.followup.name"/><label>Mentor note<textarea required="required" maxlength="2000" rows="5" t-model="state.followup.note" placeholder="Record the discussion and next steps..."/></label><p class="task_hint">This note is saved in Mentor Counseling with a review date in seven days.</p><div class="task_end_actions"><button type="button" class="task_outline" t-on-click="() => this.state.followup = null">Cancel</button><button type="submit" class="task_primary" t-att-disabled="state.saving">Save Follow-up</button></div></form></div>
      <div t-if="state.confirm" class="task_modal_backdrop"><section class="task_modal" role="dialog" aria-modal="true" aria-label="Confirm attendance submission"><h2>Confirm Attendance Submission</h2><p><t t-esc="counts.present"/> present · <t t-esc="counts.absent"/> absent · <t t-esc="counts.protected"/> approved OD / leave.</p><p>Submitting locks this teaching-hour attendance. Future changes require the authorized correction workflow.</p><div class="task_end_actions"><button class="task_outline" t-on-click="() => this.state.confirm = false">Cancel</button><button class="task_primary" t-att-disabled="state.saving" t-on-click="() => this.save(true)">Confirm Submission</button></div></section></div>
    </main>
  </t>
  <t t-name="ideastone_erp.TaskListPager"><div class="task_pager"><span>Showing <t t-esc="filteredRows.length ? (state.page - 1) * 8 + 1 : 0"/>–<t t-esc="Math.min(state.page * 8, filteredRows.length)"/> of <t t-esc="filteredRows.length"/> students</span><div><button aria-label="Previous student page" t-att-disabled="state.page === 1" t-on-click="() => this.setPage(state.page - 1)">‹</button><b t-esc="state.page"/><button aria-label="Next student page" t-att-disabled="state.page === pageCount" t-on-click="() => this.setPage(state.page + 1)">›</button></div></div></t>
  <t t-name="ideastone_erp.TaskListHistory"><div class="task_tablebox"><table><thead><tr><th>Date</th><th>Subject / Class</th><th>Session</th><th>Present</th><th>Absent</th><th>Status</th></tr></thead><tbody><tr t-foreach="d.history" t-as="row" t-key="row.id"><td t-esc="row.date"/><td><t t-esc="row.subject"/><small class="task_cell_hint" t-esc="row.class"/></td><td t-esc="row.hour"/><td t-esc="row.present"/><td t-esc="row.absent"/><td><span class="task_status present" t-esc="row.status"/></td></tr><tr t-if="!d.history.length"><td colspan="6" class="task_empty">Submitted attendance will appear here.</td></tr></tbody></table></div></t>
</templates>
