<templates xml:space="preserve">
  <t t-name="ideastone_erp.FacultyTaskList">
    <main class="campus_task_list task_sop_layout" t-att-class="{'hod-task-sop': d?.is_hod}" t-ref="root">
      <p t-if="state.loading" class="task_loading" role="status">Loading your assigned responsibilities…</p>
      <div t-if="state.error" class="task_error" role="alert"><span t-esc="state.error"/><button t-on-click="load">Retry</button></div>
      <t t-if="d">
        <header class="task_title"><div><p>VCET Campus <span>/</span> My Task List <span>/</span> <t t-esc="title"/></p><h1 t-esc="title"/><p class="task_subtitle">Select your teaching session, record attendance and review before submitting.</p></div><span class="task_workspace"><i class="fa fa-user-o"/> <t t-esc="d.user"/><small t-esc="d.is_hod ? 'HOD · Teaching responsibilities' : 'Faculty Workspace'"/></span></header>

          <section class="task_card task_intro"><div><small>MY TEACHING RESPONSIBILITIES</small><h2>Select an assigned teaching hour, then record attendance</h2><p>Choose subject → mark exceptions → validate and submit.</p></div><span class="task_status present" t-esc="d.can_save ? 'Can mark assigned session' : d.sheet_state === 'done' ? 'Submitted · Locked' : 'View assigned sessions'"/></section>
          <nav class="task_card task_stages" aria-label="Attendance workflow steps"><button t-foreach="[{id: 1, name: 'Select Class &amp; Hour', note: 'Schedule preselected'}, {id: 2, name: 'Mark Attendance', note: 'Mark all, then exceptions'}, {id: 3, name: 'Review &amp; Submit', note: 'Validate before confirming'}]" t-as="stage" t-key="stage.id" t-att-class="{active: state.step === stage.id, done: state.step &gt; stage.id}" t-on-click="() => this.setStep(stage.id)"><b t-esc="stage.id"/><span><strong t-esc="stage.name"/><small t-esc="stage.note"/></span></button></nav>
          <section class="task_card task_panel task_selection" id="task-step-1"><div class="task_panel_top"><div><h2><i class="fa fa-calendar"/> Select Class &amp; Session <span class="task_step_tag">STEP 01</span></h2><p>Your assigned timetable supplies the subject, class and teaching hour.</p></div><span class="task_status" t-esc="d.sheet_state === 'done' ? 'Submitted' : d.sheet_state === 'unrecorded' ? 'Not recorded' : 'Draft'"/></div>
            <div class="task_select_grid"><label>Assigned Subject / Class<select aria-label="Assigned subject" t-model="state.subjectKey" t-on-change="(event) => this.change(event, 'subjectKey')"><option t-if="!d.subjects.length" value="">No assigned subjects</option><option t-foreach="d.subjects" t-as="row" t-key="row.key" t-att-value="row.key"><t t-esc="row.code"/> — <t t-esc="row.name"/> · <t t-esc="row.class"/></option></select></label><label>Semester<select aria-label="Teaching semester" t-model="state.termId" t-on-change="(event) => this.change(event, 'termId')"><option t-foreach="d.terms" t-as="row" t-key="row.id" t-att-value="row.id.toString()" t-esc="row.name"/></select></label><label>Hour / Session<select aria-label="Teaching hour" t-model="state.sessionId" t-on-change="(event) => this.change(event, 'sessionId')"><option t-if="!d.hours.length" value="">No session on this date</option><option t-foreach="d.hours" t-as="row" t-key="row.id" t-att-value="row.id.toString()"><t t-esc="row.number"/> · <t t-esc="row.time"/></option></select></label><label>Attendance Date<input type="date" aria-label="Attendance date" t-att-value="state.date" t-on-change="(event) => this.change(event, 'date')"/></label></div>
            <div class="task_selection_footer"><p><i class="fa fa-check-circle"/> <t t-esc="subject ? subject.name + ' · ' + subject.class : 'Your teaching allocations will appear here.'"/></p><button class="task_primary" t-on-click="() => this.setStep(2)" t-att-disabled="!state.sessionId">Continue to Attendance <i class="fa fa-arrow-right"/></button></div>
          </section>
          <div class="task_register_grid"><section class="task_card task_panel" id="task-step-2"><div class="task_panel_top"><div><h2><i class="fa fa-list-alt"/> Student Attendance Register <span class="task_step_tag">STEP 02</span></h2><p>Mark present, record exceptions, or view individual performance.</p></div><span><t t-esc="d.students.length"/> enrolled</span></div>
            <div class="task_toolbar"><label class="task_search"><i class="fa fa-search"/><input type="search" aria-label="Search teaching students" placeholder="Search student name or roll number..." t-att-value="state.search" t-on-input="search"/></label><select aria-label="Filter attendance" t-model="state.filter" t-on-change="filter"><option value="all">All Students</option><option value="unmarked">Unmarked</option><option value="present">Present</option><option value="absent">Absent</option><option value="excused">OD / Leave</option></select><button class="task_primary" t-att-disabled="!editable" t-on-click="markAll"><i class="fa fa-check"/> Mark All Present</button><button class="task_outline" t-att-disabled="state.saving || !state.dirty" t-on-click="load">Discard Unsaved</button></div>
            <div class="task_tablebox"><table><thead><tr><th>#</th><th>Roll No.</th><th>Student Name</th><th>Current Status</th><th>Mark Attendance</th><th>Student Performance</th></tr></thead><tbody><tr t-foreach="rows" t-as="row" t-key="row.id"><td t-esc="(state.page - 1) * 8 + row_index + 1"/><td t-esc="row.roll"/><td t-esc="row.name"/><td><span t-att-class="'task_status ' + state.statuses[row.id]" t-esc="status(state.statuses[row.id])"/></td><td><div class="task_row_actions"><button t-att-disabled="!editable || row.status === 'excused'" t-att-class="{task_mark: true, selected: state.statuses[row.id] === 'present'}" t-att-aria-label="'Mark ' + row.name + ' present'" t-on-click="() => this.mark(row, 'present')"><t t-esc="d.is_hod ? 'Present' : 'P'"/></button><button t-att-disabled="!editable || row.status === 'excused'" t-att-class="{task_mark: true, absent: true, selected: state.statuses[row.id] === 'absent'}" t-att-aria-label="'Mark ' + row.name + ' absent'" t-on-click="() => this.mark(row, 'absent')"><t t-esc="d.is_hod ? 'Absent' : 'A'"/></button></div></td><td><button class="task_outline" t-on-click="() => this.showProfile(row)">View Performance</button></td></tr><tr t-if="!rows.length"><td colspan="6" class="task_empty">No students match this session and filter.</td></tr></tbody></table></div><t t-call="ideastone_erp.TaskListPager"/><div class="task_end_actions"><button class="task_outline" t-att-disabled="!editable || counts.unmarked &gt; 0 || !counts.total" t-on-click="() => this.save(false)"><i class="fa fa-save"/> Save Draft</button></div>
          </section>
          <aside class="task_card task_panel task_live"><div class="task_panel_top"><div><h2><i class="fa fa-bar-chart"/> Live Attendance Summary</h2><p>Updates instantly as you mark the register.</p></div></div><div class="task_summary"><div>Total Students<strong t-esc="counts.total"/></div><div class="good">Present<strong t-esc="counts.present"/></div><div class="warning">Absent<strong t-esc="counts.absent"/></div><div>Approved OD / Leave<strong t-esc="counts.protected"/></div><div>Unmarked<strong t-esc="counts.unmarked"/></div></div><p class="task_notice"><strong>Smart validation</strong><br/>Existing approved exemptions are protected. Mark the complete roster before submission. Submitted attendance uses the authorized correction workflow.</p><button class="task_primary" t-on-click="() => this.setStep(3)">Review Attendance <i class="fa fa-arrow-right"/></button></aside></div>
          <section class="task_card task_panel task_review" id="task-step-3"><div class="task_panel_top"><div><h2><i class="fa fa-check-circle-o"/> Review &amp; Submit <span class="task_step_tag">STEP 03</span></h2><p>Check session totals, lesson notes and missing attendance before submitting.</p></div><span t-att-class="ready ? 'task_status present' : 'task_status unmarked'" t-esc="d.sheet_state === 'done' ? 'Submitted' : ready ? 'Ready to submit' : 'Not ready'"/></div><div class="task_review_grid"><div><div class="task_review_metrics"><article><strong t-esc="counts.present"/><small>Present</small></article><article><strong t-esc="counts.absent"/><small>Absent</small></article><article><strong t-esc="counts.protected"/><small>Approved OD / Leave</small></article></div><p class="task_validation"><i t-att-class="state.sessionId ? 'fa fa-check-circle' : 'fa fa-exclamation-circle'"/> <t t-esc="state.sessionId ? 'Class and hour match your assigned timetable.' : 'Select an assigned teaching hour.'"/></p><p class="task_validation"><i t-att-class="counts.total &amp;&amp; !counts.unmarked ? 'fa fa-check-circle' : 'fa fa-exclamation-circle'"/> <t t-esc="counts.unmarked ? counts.unmarked + ' student(s) are still unmarked.' : counts.total ? 'Every student has an attendance status.' : 'No class roster is available.'"/></p><p class="task_validation"><i t-att-class="state.notes.trim() ? 'fa fa-check-circle' : 'fa fa-exclamation-circle'"/> <t t-esc="state.notes.trim() ? 'Lesson notes are ready.' : 'Enter the topic taught before final submission.'"/></p></div><div><label class="task_note_label">Lesson Notes / Topic Taught<textarea t-att-disabled="!editable" maxlength="500" rows="4" placeholder="Enter lesson notes..." t-att-value="state.notes" t-on-input="notes"/></label><p class="task_hint">Saved with the attendance record. <t t-esc="state.notes.length"/>/500</p><div class="task_end_actions"><span t-esc="state.dirty ? 'Unsaved changes' : d.sheet_state === 'done' ? 'Submitted · Locked' : 'No unsaved changes'"/><button class="task_outline" t-att-disabled="!editable || counts.unmarked &gt; 0 || !counts.total" t-on-click="() => this.save(false)">Save Draft</button><button class="task_primary" t-att-disabled="!ready" t-on-click="() => this.state.confirm = true">Submit Attendance <i class="fa fa-check"/></button></div></div></div></section>
          <div class="task_bottom_grid"><section class="task_card task_panel"><div class="task_panel_top"><div><h2><i class="fa fa-clock-o"/> Attendance History</h2><p>Submitted teaching sessions from the selected semester.</p></div><button class="task_outline" t-on-click="() => this.download('history')"><i class="fa fa-download"/> Download</button></div><t t-call="ideastone_erp.TaskListHistory"/></section><section class="task_card task_panel"><div class="task_panel_top"><div><h2><i class="fa fa-magic"/> Attendance Insights</h2><p>Based on your submitted teaching records.</p></div></div><div class="task_teaching_insights"><article><i class="fa fa-bell-o"/><div><strong>Attendance Shortage Alert</strong><p t-esc="d.insights.low ? d.insights.low.name + ' · ' + rate(d.insights.low.rate) : 'Rates appear after attendance is submitted.'"/></div></article><article><i class="fa fa-check-circle-o"/><div><strong>Missing Submissions</strong><p t-esc="d.sheet_state === 'done' ? 'The selected session has been submitted.' : state.sessionId ? 'The selected session is awaiting attendance submission.' : 'Choose a scheduled teaching session to begin.'"/></div></article></div></section></div>
      </t>
      <div t-if="state.profile" class="task_drawer_backdrop" t-on-click.self="() => this.state.profile = null"><aside class="task_drawer" role="dialog" aria-modal="true" aria-label="Individual Student Attendance"><header><div><h2>Individual Student Attendance</h2><p><t t-esc="state.profile.name"/> · <t t-esc="state.profile.roll"/></p></div><button class="task_outline" aria-label="Close student performance" t-on-click="() => this.state.profile = null">×</button></header><div class="task_drawer_body"><div class="task_review_metrics"><article><strong t-esc="state.profile.present"/><small>Attended</small></article><article><strong t-esc="state.profile.held"/><small>Held</small></article><article><strong t-esc="rate(state.profile.rate)"/><small>Overall</small></article></div><div class="task_tablebox"><table><thead><tr><th>Subject</th><th>Attended / Held</th><th>Attendance</th></tr></thead><tbody><tr t-foreach="state.profile.subjects" t-as="row" t-key="row_index"><td t-esc="row.subject"/><td><t t-esc="row.present"/> / <t t-esc="row.sessions"/></td><td t-esc="rate(row.rate)"/></tr><tr t-if="!state.profile.subjects.length"><td colspan="3" class="task_empty">No submitted attendance in your permitted scope.</td></tr></tbody></table></div></div></aside></div>
      <div t-if="state.confirm" class="task_modal_backdrop"><section class="task_modal" role="dialog" aria-modal="true" aria-label="Confirm attendance submission"><h2>Confirm Attendance Submission</h2><p><t t-esc="counts.present"/> present · <t t-esc="counts.absent"/> absent · <t t-esc="counts.protected"/> approved OD / leave.</p><p>Submitting locks this teaching-hour attendance. Future changes require the authorized correction workflow.</p><div class="task_end_actions"><button class="task_outline" t-on-click="() => this.state.confirm = false">Cancel</button><button class="task_primary" t-att-disabled="state.saving" t-on-click="() => this.save(true)">Confirm Submission</button></div></section></div>
    </main>
  </t>
  <t t-name="ideastone_erp.FacultyMentorshipClass">
    <main class="campus_faculty_sop campus_mentorship_class" t-ref="root">
      <div class="notice" t-if="state.loading" role="status">Loading your assigned mentorship class…</div>
      <div class="notice warn between" t-if="state.error" role="alert">
        <span t-esc="state.error"/><button class="btn" type="button" t-on-click="load">Retry</button>
      </div>
      <t t-if="d">
        <t t-call="ideastone_erp.FacultySopHeader">
          <t t-set="description" t-value="'Monitor your class, review student performance and follow up on attendance shortages.'"/>
        </t>
        <section class="intro">
          <div class="intro-line">
            <div class="row mentor-intro">
              <span class="intro-icon">
                <t t-call="ideastone_erp.FacultySopIcon"><t t-set="iconName" t-value="'users'"/><t t-set="iconSize" t-value="'lg'"/></t>
              </span>
              <div>
                <div class="eyebrow">My assigned mentorship class</div>
                <strong><t t-esc="d.class_label"/> <span class="status blue" t-if="d.class_key">Class Mentor</span></strong>
                <p><t t-esc="d.students.length"/> students · <t t-esc="d.semester || 'No active semester'"/> · Class-wide monitoring across subjects</p>
              </div>
            </div>
            <div class="field mentor-class-select">
              <label for="mentor-class">Mentorship class</label>
              <select id="mentor-class" t-model="state.classKey" t-on-change="(event) => this.change(event, 'classKey')"
                      t-att-disabled="!d.classes.length || state.loading || state.saving">
                <option t-if="!d.classes.length" value="">No assigned class</option>
                <option t-foreach="d.classes" t-as="row" t-key="row.key" t-att-value="row.key">
                  <t t-esc="row.label"/> <t t-if="d.classes.length &gt; 1">· <t t-esc="row.semester"/> </t>(Assigned)
                </option>
              </select>
            </div>
          </div>
        </section>
        <t t-call="ideastone_erp.FacultySopKpis"><t t-set="metrics" t-value="mentorKpis"/></t>
        <div class="grid wide">
          <t t-call="ideastone_erp.FacultySopPanel">
            <t t-set="panelTitle" t-value="'Student Attendance Performance'"/>
            <t t-set="panelHelp" t-value="'View class students across subjects. Attendance changes require teaching authorization.'"/>
            <t t-set="panelIcon" t-value="'chart'"/>
            <t t-set="panelAction">
              <button class="btn" type="button" t-on-click="() => this.download('students')">
                <t t-call="ideastone_erp.FacultySopIcon"><t t-set="iconName" t-value="'download'"/><t t-set="iconSize" t-value="'sm'"/></t> Download
              </button>
            </t>
            <div class="searchbar">
              <input type="search" t-ref="mentorSearch" aria-label="Search mentees" placeholder="Search student name or roll number..."
                     t-att-value="state.search" t-on-input="search"/>
              <select aria-label="Attendance filter" t-model="state.filter" t-on-change="filter">
                <option value="all">All Students</option>
                <option value="risk">Below <t t-esc="d.threshold"/>%</option>
                <option value="within"><t t-esc="d.threshold"/>% and above</option>
              </select>
            </div>
            <div class="tablewrap" tabindex="0" aria-label="Student attendance performance">
              <table>
                <t t-call="ideastone_erp.FacultySopTableHead"><t t-set="columns" t-value="['#','Roll No.','Student','Attended / Held','Overall','Shortage','Actions']"/></t>
                <tbody>
                  <tr t-foreach="filteredRows" t-as="row" t-key="row.id">
                    <td t-esc="row_index + 1"/><td t-esc="row.roll"/><td><strong t-esc="row.name"/></td>
                    <td><t t-esc="row.present"/> / <t t-esc="row.held"/></td><td><strong t-esc="mentorRate(row.rate)"/></td>
                    <td><span t-att-class="'status ' + (row.shortage ? 'red' : row.held ? 'green' : '')">
                      <t t-esc="row.shortage ? 'Below ' + d.threshold + '%' : row.held ? 'Within limit' : 'No records'"/>
                    </span></td>
                    <td><button class="btn sm" type="button" t-on-click="() => this.showProfile(row)">View</button></td>
                  </tr>
                  <tr t-if="!filteredRows.length"><td colspan="7" class="empty">No students match this class and filter.</td></tr>
                </tbody>
              </table>
            </div>
            <p class="caption">Showing <t t-esc="filteredRows.length"/> <t t-esc="filteredRows.length === 1 ? 'record' : 'records'"/><t t-if="d.demo"> · Sample data only</t></p>
          </t>
          <div class="stack">
            <t t-call="ideastone_erp.FacultySopPanel">
              <t t-set="panelTitle" t-value="'Students Needing Attention'"/>
              <t t-set="panelHelp" t-value="`Using the college's ${d.threshold}% attendance threshold`"/>
              <div class="item-list">
                <div class="item" t-foreach="riskRows" t-as="row" t-key="row.id">
                  <div class="between"><strong class="item-title"><t t-esc="row.name"/> · <t t-esc="row.roll"/></strong>
                    <span class="status red" t-esc="mentorRate(row.rate)"/>
                  </div>
                  <p>Review individual attendance and arrange follow-up.</p>
                </div>
                <p class="empty" t-if="!riskRows.length">No recorded attendance shortages.</p>
              </div>
              <div class="sop-actions"><button class="btn text" type="button" t-on-click="reviewShortages">See all students below limit →</button></div>
            </t>
            <t t-call="ideastone_erp.FacultySopPanel">
              <t t-set="panelTitle" t-value="'Subject Attendance Overview'"/>
              <t t-set="panelHelp" t-value="'Aggregated attendance for your mentorship class'"/>
              <t t-set="panelIcon" t-value="'chart'"/>
              <div class="item-list">
                <div class="progress-row" t-foreach="d.subjects" t-as="row" t-key="row.id">
                  <div class="between mentor-progress-label"><strong t-esc="row.name"/><span class="fine" t-esc="rate(row.rate)"/></div>
                  <div class="meter"><span t-att-style="'width:' + (row.rate || 0) + '%'"/></div>
                </div>
                <p class="empty" t-if="!d.subjects.length">Subject rates appear after attendance is submitted.</p>
              </div>
              <p class="caption" t-if="d.subjects.length">Aggregated subject rates from submitted attendance records.</p>
            </t>
          </div>
        </div>
        <div class="grid equal section">
          <t t-call="ideastone_erp.FacultySopPanel">
            <t t-set="panelTitle" t-value="'Recent Class Attendance'"/>
            <t t-set="panelHelp" t-value="'Read-only teaching-hour submissions for your mentorship class'"/>
            <t t-set="panelIcon" t-value="'chart'"/>
            <t t-set="panelAction">
              <button class="btn" type="button" t-on-click="load" t-att-disabled="state.loading || state.saving">
                <t t-call="ideastone_erp.FacultySopIcon"><t t-set="iconName" t-value="'refresh'"/><t t-set="iconSize" t-value="'sm'"/></t> Refresh
              </button>
            </t>
            <div class="tablewrap" tabindex="0" aria-label="Recent class attendance">
              <table>
                <t t-call="ideastone_erp.FacultySopTableHead"><t t-set="columns" t-value="['Date','Subject / Class','Session','Present','Absent','Status']"/></t>
                <tbody>
                  <tr t-foreach="d.history" t-as="row" t-key="row.id">
                    <td t-esc="displayDate(row.date)"/><td><t t-esc="row.subject"/> / <t t-esc="row.class"/></td>
                    <td t-esc="row.period ? 'Period ' + row.period : row.hour"/><td t-esc="row.present"/><td t-esc="row.absent"/>
                    <td><span class="status green" t-esc="row.status"/></td>
                  </tr>
                  <tr t-if="!d.history.length"><td colspan="6" class="empty">Submitted attendance will appear here.</td></tr>
                </tbody>
              </table>
            </div>
            <p class="caption">Showing <t t-esc="d.history.length"/> <t t-esc="d.history.length === 1 ? 'record' : 'records'"/><t t-if="d.demo"> · Sample data only</t></p>
          </t>
          <t t-call="ideastone_erp.FacultySopPanel">
            <t t-set="panelTitle" t-value="'My Follow-ups'"/>
            <t t-set="panelHelp" t-value="'Mentor counseling notes — attendance is not modified'"/>
            <t t-set="panelIcon" t-value="'clipboard'"/>
            <div class="item-list">
              <div class="item" t-foreach="d.followups" t-as="row" t-key="row.id">
                <div class="between">
                  <strong t-esc="row.student"/><span t-att-class="'status ' + (row.completed ? 'green' : 'amber')" t-esc="row.completed ? 'Completed' : 'Open'"/>
                </div>
                <p class="sop-notice-body" t-esc="row.note"/>
                <div class="between mentor-follow-meta">
                  <span class="fine" t-esc="displayDate(row.due)"/>
                  <button t-if="!row.completed" class="btn sm" type="button" t-att-disabled="state.saving" t-on-click="() => this.resolveFollowup(row)">Mark resolved</button>
                </div>
              </div>
              <div class="empty" t-if="!d.followups.length">No open follow-ups.</div>
            </div>
            <div class="divider"/>
            <form t-on-submit.prevent="saveFollowup">
              <div class="fields two">
                <div class="field">
                  <label for="mentor-follow-student">Student</label>
                  <select id="mentor-follow-student" t-model="state.followStudent" required="required" t-att-disabled="!d.students.length || state.saving">
                    <option t-if="!d.students.length" value="">No assigned students</option>
                    <option t-foreach="d.students" t-as="row" t-key="row.id" t-att-value="row.id + ''"><t t-esc="row.name"/> · <t t-esc="row.roll"/></option>
                  </select>
                </div>
                <div class="field">
                  <label for="mentor-follow-date">Follow-up date</label>
                  <input id="mentor-follow-date" type="date" required="required" t-model="state.followDate" t-att-disabled="state.saving"/>
                </div>
              </div>
              <div class="field sop-actions">
                <label for="mentor-follow-note">Counseling note</label>
                <textarea id="mentor-follow-note" placeholder="Record action taken or next steps..." required="required"
                          maxlength="2000" t-model="state.followNote" t-att-disabled="state.saving"/>
              </div>
              <div class="right mentor-follow-meta">
                <button class="btn primary" type="submit" t-att-disabled="!state.followStudent || state.saving">
                  <t t-call="ideastone_erp.FacultySopIcon"><t t-set="iconName" t-value="'plus'"/><t t-set="iconSize" t-value="'sm'"/></t> Add follow-up
                </button>
              </div>
            </form>
          </t>
        </div>
        <section class="intro section mentor-insights">
          <div class="intro-line">
            <div class="row">
              <t t-call="ideastone_erp.FacultySopIcon"><t t-set="iconName" t-value="'trend'"/><t t-set="iconSize" t-value="'lg'"/></t>
              <div><strong>Attendance Insights for My Class</strong>
                <p><t t-esc="riskRows.length"/> <t t-esc="riskRows.length === 1 ? 'student needs' : 'students need'"/> a shortage review. Review individual performance and recent subject submissions.</p>
              </div>
            </div>
            <button class="btn" type="button" t-on-click="reviewShortages">Review Shortages</button>
          </div>
        </section>
        <p class="footer-note">VCET Faculty Workspace · <t t-esc="d.demo ? 'Sample college records' : 'Saved campus records'"/></p>
        <dialog class="drawer mentor-drawer" aria-label="Student Performance" t-ref="mentorDialog"
                t-on-close="() => this.state.profile = null" t-on-keydown="mentorDrawerKey">
          <t t-if="state.profile">
            <t t-set="row" t-value="state.profile"/>
            <div class="between"><h2>Student Performance</h2>
              <button type="button" class="btn sm" aria-label="Close student performance" t-on-click="() => this.mentorDialog.el.close()">
                <t t-call="ideastone_erp.FacultySopIcon"><t t-set="iconName" t-value="'x'"/></t>
              </button>
            </div>
            <div class="divider"/>
            <div class="eyebrow">Individual attendance review</div>
            <h2 class="mentor-student-name" t-esc="row.name"/><p class="muted"><t t-esc="row.roll"/> · <t t-esc="d.class_label"/></p>
            <div class="kpis">
              <div class="kpi"><div class="kpi-label">Attendance</div><div class="kpi-value" t-esc="mentorRate(row.rate)"/>
                <div class="kpi-foot"><t t-esc="row.present"/> of <t t-esc="row.held"/> hours attended</div>
              </div>
              <div class="kpi"><div class="kpi-label">Threshold Status</div>
                <div class="sop-actions"><span t-att-class="'status ' + (row.shortage ? 'red' : row.held ? 'green' : '')"
                  t-esc="row.shortage ? 'Below ' + d.threshold + '%' : row.held ? 'Within ' + d.threshold + '%' : 'No records'"/></div>
              </div>
            </div>
            <h3>Attendance detail</h3>
            <div class="read-lines"><span>Attended / Held</span><strong><t t-esc="row.present"/> / <t t-esc="row.held"/></strong></div>
            <div class="read-lines"><span>Shortage to <t t-esc="d.threshold"/>% threshold</span>
              <strong t-esc="row.shortage ? shortageHours(row) + ' attended hours at current total' : 'None'"/>
            </div>
            <div class="read-lines"><span>Approved OD / Leave</span><strong t-esc="row.excused ? row.excused + ' excused hours' : 'None recorded'"/></div>
            <div t-foreach="row.subjects" t-as="subjectRow" t-key="subjectRow_index" class="read-lines">
              <span t-esc="subjectRow.subject"/><strong t-esc="mentorRate(subjectRow.rate)"/>
            </div>
            <div class="notice section">This is a read-only performance drill-down. Counseling follow-ups do not edit attendance; authorized teaching faculty manage corrections.</div>
          </t>
        </dialog>
      </t>
    </main>
  </t>

  <t t-name="ideastone_erp.TaskListPager"><div class="task_pager"><span>Showing <t t-esc="filteredRows.length ? (state.page - 1) * 8 + 1 : 0"/>–<t t-esc="Math.min(state.page * 8, filteredRows.length)"/> of <t t-esc="filteredRows.length"/> students</span><div><button aria-label="Previous student page" t-att-disabled="state.page === 1" t-on-click="() => this.setPage(state.page - 1)">‹</button><b t-esc="state.page"/><button aria-label="Next student page" t-att-disabled="state.page === pageCount" t-on-click="() => this.setPage(state.page + 1)">›</button></div></div></t>
  <t t-name="ideastone_erp.TaskListHistory"><div class="task_tablebox"><table><thead><tr><th>Date</th><th>Subject / Class</th><th>Session</th><th>Present</th><th>Absent</th><th>Status</th></tr></thead><tbody><tr t-foreach="d.history" t-as="row" t-key="row.id"><td t-esc="row.date"/><td><t t-esc="row.subject"/><small class="task_cell_hint" t-esc="row.class"/></td><td t-esc="row.hour"/><td t-esc="row.present"/><td t-esc="row.absent"/><td><span class="task_status present" t-esc="row.status"/></td></tr><tr t-if="!d.history.length"><td colspan="6" class="task_empty">Submitted attendance will appear here.</td></tr></tbody></table></div></t>
</templates>
