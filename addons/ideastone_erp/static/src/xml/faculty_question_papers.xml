<templates xml:space="preserve">
<t t-name="ideastone_erp.FacultyQuestionPapers">
<div class="qp-faculty">
 <section class="content">
  <div t-if="state.error" class="notice" role="alert"><t t-esc="state.error"/><button class="btn" t-on-click="load">Retry</button></div>
  <t t-if="state.data">
   <div class="breadcrumb">Campus home / <b>My task list</b> / <b>Examinations</b></div>
   <div class="heading-row"><div><h1>Examinations</h1><div class="subtitle">Prepare and submit question-paper sets for upcoming examinations.</div></div><div class="actions"><button class="btn subtle" t-on-click="guide">ⓘ Submission guide</button><button class="btn primary" t-on-click="newPaper">＋ New question paper</button></div></div>
   <div class="stats">
    <div class="stat"><div class="stat-icon">▤</div><div><div class="stat-num" t-esc="count('upcoming')"/><div class="stat-label">Upcoming exams</div><div class="stat-foot">Across assigned subjects</div></div></div>
    <div class="stat"><div class="stat-icon amber">◷</div><div><div class="stat-num" t-esc="count('submitted')"/><div class="stat-label">Awaiting HOD review</div><div class="stat-foot">Submitted for approval</div></div></div>
    <div class="stat"><div class="stat-icon green">✓</div><div><div class="stat-num" t-esc="count('approved')"/><div class="stat-label">Approved sets</div><div class="stat-foot">Ready for exam control</div></div></div>
    <div class="stat"><div class="stat-icon slate">↻</div><div><div class="stat-num" t-esc="count('returned')"/><div class="stat-label">Needs revision</div><div class="stat-foot">HOD feedback received</div></div></div>
   </div>
   <div class="layout">
    <section class="panel"><div class="panel-head"><div><h2>Submit question-paper set</h2><p>Upload PDF sets for the subject and examination assigned to you.</p></div><span class="pill draft">STAFF WORKSPACE</span></div>
     <div class="panel-body"><form t-ref="paperForm" t-on-submit.prevent="() => this.save(true)">
      <div t-if="state.id" class="notice">Editing saved submission QP-<t t-esc="state.id"/>. Existing PDF sets stay attached until replaced.</div>
      <div class="form-grid">
       <div class="field"><label for="qp-department">Department</label><select id="qp-department" t-model="state.form.department_id" t-on-change="departmentChanged" required="required"><option value="">Select department</option><option t-foreach="state.data.departments" t-as="d" t-key="d.id" t-att-value="&apos;&apos;+d.id" t-esc="d.name"/></select></div>
       <div class="field"><label for="qp-subject">Assigned subject</label><select id="qp-subject" t-model="state.form.subject_id" t-on-change="subjectChanged" required="required"><option value="">Select subject</option><option t-foreach="subjects" t-as="s" t-key="s.id" t-att-value="&apos;&apos;+s.id" t-esc="s.name"/></select></div>
       <div class="field"><label for="qp-exam">Examination type</label><select id="qp-exam" t-model="state.form.exam_type" required="required"><option value="">Select examination</option><option t-foreach="examTypes" t-as="e" t-key="e" t-esc="e"/></select></div>
       <div class="field"><label for="qp-date">Upcoming exam date</label><input id="qp-date" type="date" t-model="state.form.exam_date" required="required"/></div>
       <div class="field"><label for="qp-code">Paper / course code</label><input id="qp-code" placeholder="e.g. EC3402" t-model="state.form.paper_code" maxlength="60" required="required"/></div>
       <div class="field"><label for="qp-duration">Duration</label><select id="qp-duration" t-model="state.form.duration"><option>3 hours</option><option>2 hours</option><option>90 minutes</option><option>1 hour</option></select></div>
       <div class="field full"><label>Question-paper difficulty sets</label><div class="difficulty"><label class="level" t-foreach="levels" t-as="level" t-key="level.key"><input type="checkbox" t-model="state.levels[level.key]"/><span><strong t-esc="level.label"/><small t-esc="level.hint"/></span></label></div><div class="hint">Upload one PDF for each selected set. The HOD chooses one set for approval.</div></div>
       <t t-foreach="levels" t-as="level" t-key="level.key"><div t-if="state.levels[level.key]" class="field full"><label t-att-for="'qp-file-'+level.key">Question paper PDF · <t t-esc="level.label"/></label><label class="upload-zone" t-att-for="'qp-file-'+level.key" t-on-dragover.prevent="() => {}" t-on-drop="ev => this.drop(level.key, ev)"><div class="upload-icon">↑</div><div><strong>Choose PDF or drag it here</strong><span>PDF only · maximum 20 MB per file · use a clear version name</span><div t-if="state.files[level.key] || existing(level.key)" class="file-name" style="display:block" t-esc="state.files[level.key]?.filename || existing(level.key)?.filename"/></div></label><input type="file" t-att-id="'qp-file-'+level.key" accept=".pdf,application/pdf" style="display:none" t-on-change="ev => this.upload(level.key, ev)"/></div></t>
       <div class="field full"><label for="qp-notes">Notes for HOD <span style="font-weight:400;color:#8195aa">(optional)</span></label><textarea id="qp-notes" maxlength="4000" placeholder="Add syllabus coverage, blueprint notes, or anything the HOD should know." t-model="state.form.notes"/></div>
      </div>
      <div class="form-actions"><div class="left-note">🔒 Question papers are confidential and visible only to authorised reviewers.</div><div style="display:flex;gap:8px;flex-wrap:wrap"><button type="button" class="btn" t-att-disabled="state.busy" t-on-click="() => this.save(false)">Save draft</button><button type="submit" class="btn primary" t-att-disabled="state.busy">Submit to HOD →</button></div></div>
     </form></div>
    </section>
    <aside>
     <section class="ai-card"><div class="ai-title"><span class="spark">✦</span> AI paper readiness check <span class="pill draft">ASSISTED</span></div><p>Run checks before submitting. PDF validation is available; academic checks require HOD review.</p><div class="ai-list">
      <div class="ai-item"><span class="check">✓</span><span><b>Syllabus coverage</b><br/>Check questions against the selected syllabus and learning outcomes.</span></div>
      <div class="ai-item"><span class="check">✓</span><span><b>Marks &amp; blueprint</b><br/>Flag total-mark mismatches and missing sections.</span></div>
      <div class="ai-item"><span class="check">✓</span><span><b>Difficulty balance</b><br/>Estimate the distribution of basic, moderate and advanced questions.</span></div>
      <div class="ai-item"><span class="check">✓</span><span><b>Duplicate &amp; PDF quality</b><br/>Review repeated questions and unreadable or blank pages.</span></div>
     </div><button class="btn primary" style="width:100%;margin-top:15px" t-att-disabled="state.busy" t-on-click="() => this.save(false,true)">Run readiness check</button><div class="warning">PDF format, size, encryption and page count are checked. AI academic analysis is not configured; these checks do not replace HOD review.</div></section>
     <section class="panel"><div class="panel-head"><div><h2>Submission workflow</h2><p>What happens after you submit</p></div></div><div class="panel-body"><div class="activity-list">
      <div class="activity"><span class="activity-dot"/><div><strong>1. Staff submits PDF set</strong><p>Upload the question paper and select the examination details.</p></div></div>
      <div class="activity"><span class="activity-dot" style="background:#d99419;box-shadow:0 0 0 4px #fff2d8"/><div><strong>2. Department HOD reviews</strong><p>HOD approves one set or returns it with revision comments.</p></div></div>
      <div class="activity"><span class="activity-dot" style="background:#15956f;box-shadow:0 0 0 4px #e4f7f0"/><div><strong>3. Approved set is forwarded</strong><p>The selected paper is sent to COE / Exam Control and the main admin workflow.</p></div></div>
     </div><div class="divider"/><div class="notice"><span>ⓘ</span><span><b>Keep the paper confidential.</b> Do not include student names or share question-paper files outside the approved workflow.</span></div></div></section>
    </aside>
   </div>
   <section class="panel queue"><div class="panel-head"><div><h2>My question-paper submissions</h2><p>Track the status of your current and previous submissions.</p></div><div class="table-tools"><input class="search" placeholder="Search subject or exam…" t-model="state.search"/><select aria-label="Filter by status" style="width:145px" t-model="state.filter"><option value="">All statuses</option><option value="submitted">Awaiting HOD</option><option value="approved">Approved</option><option value="forwarded">Forwarded to COE</option><option value="returned">Revision required</option><option value="draft">Draft</option></select><button class="btn" t-on-click="load" aria-label="Refresh submissions">↻</button></div></div>
    <div class="table-wrap"><table><thead><tr><th>EXAMINATION / SUBJECT</th><th>EXAM DATE</th><th>DIFFICULTY SET</th><th>UPDATED</th><th>STATUS</th><th>ACTION</th></tr></thead><tbody><tr t-foreach="rows" t-as="r" t-key="r.id"><td><div class="exam-title"><t t-esc="r.exam_type"/> · <t t-esc="r.subject"/></div><div class="subline"><t t-esc="r.paper_code"/> · <t t-esc="r.department_code"/></div></td><td t-esc="date(r.exam_date)"/><td><span class="file-chip" t-foreach="r.sets" t-as="s" t-key="s.id">PDF · <t t-esc="s.label"/></span><span t-if="!r.sets.length">No PDF yet</span></td><td t-esc="date(r.updated,true)"/><td><span t-att-class="'pill '+tone(r.state)" t-esc="r.status"/></td><td><button class="row-link" t-on-click="() => this.view(r)"><t t-esc="['draft','returned'].includes(r.state) ? 'View / edit ↗' : 'View details ↗'"/></button></td></tr><tr t-if="!rows.length"><td colspan="6">No submissions match this view. Start a new question paper above.</td></tr></tbody></table></div><div class="queue-foot"><span>Showing <t t-esc="rows.length"/> submissions</span><span>Saved records · authorised access only</span></div>
   </section>
  </t>
 </section>
 <div t-if="state.modal" class="qp-modal-back" t-on-keydown="modalKey"><section t-ref="paperDialog" class="qp-modal" role="dialog" aria-modal="true" aria-label="Question-paper submission"><div class="panel-head"><div><h2 t-esc="state.modal.subject"/><p><t t-esc="state.modal.status"/> · Revision <t t-esc="state.modal.revision"/></p></div><button class="btn" t-on-click="closeModal" aria-label="Close submission">✕</button></div><div class="panel-body"><p t-if="state.modal.review_note"><b>HOD feedback:</b> <t t-esc="state.modal.review_note"/></p><p t-esc="state.modal.notes"/><button class="btn" t-foreach="state.modal.sets" t-as="s" t-key="s.id" t-on-click="() => this.download(s)">PDF · <t t-esc="s.label"/> · <t t-esc="s.pages"/> pages ↗</button><div class="divider"/><div class="activity-list"><div class="activity" t-foreach="state.modal.history" t-as="e" t-key="e_index"><span class="activity-dot"/><div><strong t-esc="e.action"/><p><t t-esc="e.by"/> · <t t-esc="date(e.at,true)"/></p><p t-esc="e.note"/></div></div></div><button t-if="['draft','returned'].includes(state.modal.state)" class="btn primary" style="margin-top:18px" t-on-click="() => this.edit(state.modal)">Continue editing</button></div></section></div>
</div>
</t>
</templates>
