<templates xml:space="preserve">
  <t t-name="ideastone_erp.OwnerCommunication">
    <main class="owner-communication"><div class="oc-content">
      <div class="oc-crumb">VCET Campus / Communication / <strong t-esc="label"/></div>
      <p t-if="state.loading" class="oc-loading" role="status">Loading communication records…</p>
      <div t-if="state.error" class="oc-note" role="alert"><span t-esc="state.error"/> <button class="oc-btn" t-on-click="load">Retry</button></div>
      <t t-if="state.data &amp;&amp; !state.error">
        <div class="oc-title-row">
          <div><h1 t-esc="view === 'overview' ? 'Communication' : label"/><div class="oc-subtitle" t-esc="view === 'overview' ? 'Coordinate campus announcements, target the right audience and track student requests from one workspace.' : view === 'notices' ? 'Create, schedule and publish campus updates to the right students, faculty, staff or departments.' : 'Manage student queries, route them to the right office and keep response commitments visible.'"/></div>
          <div class="oc-toolbar">
            <select t-if="view === 'overview'" class="oc-select" aria-label="Reporting period" t-model="state.period" t-on-change="load"><option value="month">This month</option><option value="term">This term</option><option value="year">Academic year</option></select>
            <button t-if="view === 'overview'" class="oc-btn" t-on-click="load"><i class="fa fa-refresh" aria-hidden="true"/> Refresh</button>
            <button t-if="view === 'notices'" class="oc-btn" t-on-click="() => this.exportRows('notices')">Export register</button>
            <button t-if="view === 'requests'" class="oc-btn" t-on-click="() => this.exportRows('requests')">Export queue</button>
            <button class="oc-btn oc-primary" t-on-click="view === 'overview' ? () => this.show('notices', true) : view === 'notices' ? newNotice : newRequest"><span aria-hidden="true">＋ </span><t t-esc="view === 'overview' ? 'Create notice' : view === 'notices' ? 'New notice' : 'Log request'"/></button>
          </div>
        </div>
        <div class="oc-grid oc-kpis">
          <article t-foreach="view === 'overview' ? [
              ['Published notices', c.published, c.scheduled + ' scheduled for release', '▤'],
              ['Audience reach', c.reads, 'Portal read acknowledgements', '◎'],
              ['Requests awaiting action', c.open, c.high + ' high priority', '◷'],
              ['Avg. first response', c.avg_response === false ? '—' : c.avg_response + ' hrs', 'From recorded student-visible replies', '↗']
            ] : view === 'notices' ? [
              ['Published', c.published, 'Visible to selected audiences', '✓'],
              ['Scheduled', c.scheduled, 'Queued for a future release', '◷'],
              ['Drafts', c.drafts, 'Not yet submitted', '✎'],
              ['Needs attention', c.attention, 'Awaiting approval', '!']
            ] : [
              ['Open requests', c.open, 'Across all support categories', '◷'],
              ['High priority', c.high, 'Requires prompt staff review', '!'],
              ['Due today', c.due, 'Open cases with a saved response target', '▣'],
              ['Resolved this period', c.resolved, 'Completed saved cases', '✓']
            ]" t-as="item" t-key="item[0]" class="oc-kpi">
            <div class="oc-kpi-top"><span t-esc="item[0]"/><span class="oc-kpi-icon" aria-hidden="true" t-esc="item[3]"/></div><div class="oc-value" t-esc="item[1]"/><div class="oc-foot" t-esc="item[2]"/>
          </article>
        </div>

        <t t-if="view === 'overview'">
          <div class="oc-grid oc-two-col">
            <section class="oc-panel"><div class="oc-panel-head"><div><h2>Communication schedule</h2><div class="oc-panel-desc">Upcoming notices and important campus communication deadlines.</div></div><button class="oc-btn oc-lightblue" t-on-click="() => this.show('notices')">View all notices →</button></div>
              <div t-foreach="schedule" t-as="row" t-key="row.id" class="oc-notice-row"><div class="oc-notice-icon" aria-hidden="true">▣</div><div><h3 t-esc="row.name"/><p><t t-esc="row.audience"/> · <t t-esc="row.publish_at ? dateTime(row.publish_at) : date(row.date)"/></p></div><span class="oc-pill" t-att-class="statusTone(row.status_code)" t-esc="row.status"/></div>
              <div t-if="!schedule.length" class="oc-empty">No upcoming notices in this college.</div>
            </section>
            <section class="oc-panel"><div class="oc-panel-head"><div><h2>Student requests queue</h2><div class="oc-panel-desc">Prioritise open cases and assign an owner.</div></div><span class="oc-pill amber"><t t-esc="c.open"/> open</span></div>
              <div class="oc-mini-list"><div t-foreach="queue" t-as="row" t-key="row.id" class="oc-mini-row"><div class="oc-row-left"><div class="oc-small-icon" aria-hidden="true" t-esc="row.priority_code === 'time_sensitive' ? '!' : '▤'"/><div><div class="oc-row-title" t-esc="row.name"/><div class="oc-row-sub"><t t-esc="row.reference"/> · <t t-esc="row.office"/></div></div></div><span class="oc-pill" t-att-class="statusTone(row.priority_code)" t-esc="row.priority"/></div><div t-if="!queue.length" class="oc-empty">No open student requests.</div></div>
              <div class="oc-panel-end"><button class="oc-btn oc-lightblue" t-on-click="() => this.show('requests')">Open support queue →</button></div>
            </section>
          </div>
          <div class="oc-grid oc-two-col">
            <section class="oc-panel oc-ai-panel"><div class="oc-panel-head"><div><h2>✦ AI communication insights</h2><div class="oc-panel-desc">Planning guidance for authorised staff.</div></div><span class="oc-pill violet">Planning assistant</span></div><div class="oc-grid oc-ai-grid">
              <div class="oc-ai-card"><div class="oc-ai-label">01 · Audience targeting</div><h3>Reduce broad announcements</h3><p>Send fee reminders only to students with a pending balance, and timetable updates to the affected classes and faculty. This reduces noise and improves relevance.</p></div>
              <div class="oc-ai-card"><div class="oc-ai-label">02 · Support operations</div><h3>Route requests by category</h3><p>Assign certificate requests to student affairs, fee questions to finance, and portal issues to IT. Escalate high-priority cases that approach the response target.</p></div>
            </div><div class="oc-note oc-ai-note"><strong>Suggested weekly routine:</strong> Monday — approve the communication calendar; midweek — review unresolved requests; Friday — close resolved cases and plan next week’s notices. Staff should review suggestions before acting.</div></section>
            <section class="oc-panel"><div class="oc-panel-head"><div><h2>Channel delivery health</h2><div class="oc-panel-desc">Available communication channel information.</div></div><span class="oc-pill">Provider data unavailable</span></div><div class="oc-mini-list">
              <div t-foreach="[['✉','Email','Delivery success'],['▣','Campus portal','Notice availability'],['▤','SMS / mobile alerts','Gateway confirmation']]" t-as="channel" t-key="channel[1]" class="oc-mini-row"><div class="oc-row-left"><div class="oc-small-icon" t-esc="channel[0]"/><div><div class="oc-row-title" t-esc="channel[1]"/><div class="oc-row-sub" t-esc="channel[2]"/></div></div><span class="oc-unavailable">Not connected</span></div>
            </div><div class="oc-note">Connect channel providers to display delivery and read receipts. Portal notice reads are counted above from saved acknowledgements.</div></section>
          </div>
          <section class="oc-panel"><div class="oc-panel-head"><div><h2>Recent communication activity</h2><div class="oc-panel-desc">Latest notices and support actions across the campus.</div></div><button class="oc-btn" t-on-click="() => this.show('notices')">Manage notices</button></div><div class="oc-table-wrap"><table class="oc-table"><thead><tr><th>Reference</th><th>Communication</th><th>Audience</th><th>Owner</th><th>Updated</th><th>Status</th></tr></thead><tbody><tr t-foreach="recent" t-as="row" t-key="row.id"><td t-esc="row.reference"/><td><strong t-esc="row.name"/></td><td t-esc="row.audience"/><td t-esc="row.owner"/><td t-esc="date(row.updated)"/><td><span class="oc-pill" t-att-class="statusTone(row.status_code)" t-esc="row.status"/></td></tr><tr t-if="!recent.length"><td colspan="6" class="oc-empty">No notice activity yet.</td></tr></tbody></table></div></section>
          <div class="oc-note"><strong>Saved college records:</strong> Counts and lists come from notices and student requests visible to this Owner admin. Email and SMS delivery rates are not available without a connected provider.</div>
        </t>

        <t t-if="view === 'notices'">
          <section t-if="state.editor" class="oc-panel oc-composer"><div class="oc-panel-head"><div><h2 t-esc="state.noticeId ? 'Edit notice' : 'Create notice'"/><div class="oc-panel-desc">Drafts and submitted notices stay in this workspace.</div></div><button class="oc-btn" t-on-click="() => this.state.editor = null">Close</button></div>
            <div class="oc-form-grid"><label>Notice title<input class="oc-search" placeholder="Enter a clear title" maxlength="200" t-model="state.editor.name"/></label><label>Notice category<select class="oc-select" t-model="state.editor.category"><option>Academic</option><option>Examination</option><option>Finance</option><option>Events</option><option>General</option></select></label>
              <label>Audience<select class="oc-select" t-model="state.editor.audience"><option value="student">All students</option><option value="department">Selected department / class</option><option value="faculty">Faculty &amp; staff</option><option value="group">Specific student group</option><option value="all">All campus</option></select></label>
              <label>Publish date and time<input class="oc-search" type="datetime-local" t-model="state.editor.publish_at"/></label>
              <label t-if="state.editor.audience === 'department'">Programme<select class="oc-select" t-model="state.editor.course_id"><option value="">Select programme</option><option t-foreach="state.data.courses" t-as="course" t-key="course.id" t-att-value="course.id" t-esc="course.name"/></select></label>
              <label t-if="state.editor.audience === 'department'">Class / section<select class="oc-select" t-model="state.editor.batch_id"><option value="">All classes</option><option t-foreach="selectedBatches" t-as="batch" t-key="batch.id" t-att-value="batch.id" t-esc="batch.name"/></select></label>
              <label t-if="state.editor.audience === 'group'">Recipient group<select class="oc-select" t-model="state.editor.group_id"><option value="">Select group</option><option t-foreach="state.data.groups" t-as="group" t-key="group.id" t-att-value="group.id" t-esc="group.name"/></select></label>
              <label class="oc-span">Message<textarea class="oc-search oc-textarea" placeholder="Write the notice content…" maxlength="10000" t-model="state.editor.body"/></label>
            </div><div class="oc-composer-actions"><button class="oc-btn" t-att-disabled="state.busy" t-on-click="() => this.saveNotice(false)">Save draft</button><button class="oc-btn oc-primary" t-att-disabled="state.busy" t-on-click="() => this.saveNotice(true)">Submit for approval</button></div>
          </section>
          <section class="oc-panel"><div class="oc-panel-head"><div><h2>Notice register</h2><div class="oc-panel-desc">Track audience, schedule, owner and publication state.</div></div><input class="oc-search" type="search" aria-label="Search notices" placeholder="Search notice…" t-model="state.search"/></div>
            <div class="oc-toolbar-line"><select class="oc-select" aria-label="Notice category" t-model="state.category"><option value="">All categories</option><option t-foreach="noticeCategories" t-as="category" t-key="category" t-att-value="category" t-esc="category"/></select><select class="oc-select" aria-label="Notice status" t-model="state.status"><option value="">All statuses</option><option value="published">Published</option><option value="scheduled">Scheduled</option><option value="draft">Draft</option><option value="attention">Needs approval</option></select><select class="oc-select" aria-label="Notice audience" t-model="state.audience"><option value="">All audiences</option><option value="student">Students</option><option value="faculty">Faculty &amp; staff</option><option value="all">All campus</option></select></div>
            <div class="oc-table-wrap"><table class="oc-table"><thead><tr><th>Reference</th><th>Notice title</th><th>Audience</th><th>Publish / schedule</th><th>Owner</th><th>Reach</th><th>Status</th><th>Action</th></tr></thead><tbody><tr t-foreach="noticeRows" t-as="row" t-key="row.id"><td t-esc="row.reference"/><td><strong t-esc="row.name"/></td><td t-esc="row.audience"/><td t-esc="row.publish_at ? dateTime(row.publish_at) : date(row.date)"/><td t-esc="row.owner"/><td t-esc="row.reach"/><td><span class="oc-pill" t-att-class="statusTone(row.status_code)" t-esc="row.status"/></td><td><button t-if="row.status_code === 'draft'" class="oc-text-btn" t-on-click="() => this.editNotice(row)">Edit</button><button t-if="row.status_code === 'attention'" class="oc-text-btn" t-att-disabled="state.busy" t-on-click="() => this.publish(row)">Approve</button></td></tr><tr t-if="!noticeRows.length"><td colspan="8" class="oc-empty">No notices match these filters.</td></tr></tbody></table></div></section>
          <div class="oc-note"><strong>Workflow:</strong> draft → select audience → submit for approval → schedule or publish in the campus portal → archive. In-app publication does not send email or SMS.</div>
        </t>

        <t t-if="view === 'requests'">
          <section t-if="state.requestEditor" class="oc-panel oc-composer"><div class="oc-panel-head"><div><h2>Log student request</h2><div class="oc-panel-desc">Create a saved request for a student with a portal account.</div></div><button class="oc-btn" t-on-click="() => this.state.requestEditor = null">Close</button></div><div class="oc-form-grid">
            <label>Student<select class="oc-select" t-model="state.requestEditor.student_id"><option value="">Select student</option><option t-foreach="state.data.students" t-as="student" t-key="student.id" t-att-value="student.id"><t t-esc="student.name"/> · <t t-esc="student.number"/></option></select></label>
            <label>Request type<select class="oc-select" t-model="state.requestEditor.type_id"><option value="">Select request type</option><option t-foreach="state.data.types" t-as="type" t-key="type.id" t-att-value="type.id" t-esc="type.name"/></select></label>
            <label>Support category<select class="oc-select" t-model="state.requestEditor.category"><option value="documents">Certificates &amp; documents</option><option value="fees">Fees &amp; scholarships</option><option value="it">Portal / IT support</option><option value="affairs">Student affairs</option><option value="other">Other support</option></select></label>
            <label>Assigned office<select class="oc-select" t-model="state.requestEditor.office"><option value="auto">Route automatically</option><option value="department">Class advisor / department</option><option value="academic">Academic office</option><option value="examinations">Examination cell</option><option value="accounts">Accounts office</option><option value="affairs">Student affairs</option><option value="library">Library</option><option value="it">IT / ERP support</option></select></label>
            <label>Priority<select class="oc-select" t-model="state.requestEditor.priority"><option value="normal">Normal</option><option value="deadline">Deadline approaching</option><option value="time_sensitive">Time-sensitive</option></select></label>
            <label>Target response date and time<input class="oc-search" type="datetime-local" t-model="state.requestEditor.due_at"/></label>
            <label class="oc-span">Subject<input class="oc-search" maxlength="200" placeholder="Brief request subject" t-model="state.requestEditor.name"/></label>
            <label class="oc-span">Details<textarea class="oc-search oc-textarea" maxlength="10000" placeholder="Describe the request…" t-model="state.requestEditor.description"/></label>
          </div><div class="oc-composer-actions"><button class="oc-btn oc-primary" t-att-disabled="state.busy" t-on-click="logRequest">Log request</button></div></section>
          <section t-if="selectedRequest" class="oc-panel oc-composer"><div class="oc-panel-head"><div><h2><t t-esc="selectedRequest.reference"/> · <t t-esc="selectedRequest.name"/></h2><div class="oc-panel-desc"><t t-esc="selectedRequest.student"/> · <t t-esc="selectedRequest.category"/></div></div><button class="oc-btn" t-on-click="() => this.state.requestId = 0">Close</button></div><p class="oc-request-description" t-esc="selectedRequest.description"/><div class="oc-form-grid"><label class="oc-span">Response shared with student<textarea class="oc-search oc-textarea" maxlength="10000" t-model="state.reply"/></label><label>Next status<select class="oc-select" t-model="state.nextState"><option t-att-value="selectedRequest.state_code" t-esc="selectedRequest.state"/><option t-if="selectedRequest.state_code === 'submitted'" value="information">Waiting for student</option><option t-if="selectedRequest.state_code === 'submitted'" value="approved">Approved</option><option t-if="selectedRequest.state_code === 'submitted'" value="rejected">Rejected</option><option t-if="selectedRequest.state_code === 'approved'" value="ready">Ready for collection</option><option t-if="['approved','ready'].includes(selectedRequest.state_code)" value="done">Resolved</option></select></label></div><div class="oc-composer-actions"><button class="oc-btn oc-primary" t-att-disabled="state.busy" t-on-click="respond">Save update</button></div></section>
          <section class="oc-panel"><div class="oc-panel-head"><div><h2>Support request queue</h2><div class="oc-panel-desc">Filter by priority, state and responsible office.</div></div><input class="oc-search" type="search" aria-label="Search request or student" placeholder="Search request / student…" t-model="state.search"/></div><div class="oc-toolbar-line"><select class="oc-select" aria-label="Request category" t-model="state.category"><option value="">All categories</option><option t-foreach="requestCategories" t-as="category" t-key="category" t-att-value="category" t-esc="category"/></select><select class="oc-select" aria-label="Request priority" t-model="state.priority"><option value="">All priorities</option><option value="time_sensitive">High</option><option value="deadline">Deadline approaching</option><option value="normal">Normal</option></select><select class="oc-select" aria-label="Request status" t-model="state.status"><option value="">All states</option><option value="submitted">New</option><option value="information">Waiting for student</option><option value="approved">Approved</option><option value="ready">Ready for collection</option><option value="done">Resolved</option></select></div><div class="oc-table-wrap"><table class="oc-table"><thead><tr><th>Request ID</th><th>Student</th><th>Category</th><th>Subject</th><th>Assigned office</th><th>Updated</th><th>Priority</th><th>State</th><th>Action</th></tr></thead><tbody><tr t-foreach="requestRows" t-as="row" t-key="row.id"><td t-esc="row.reference"/><td><t t-esc="row.student"/><small t-esc="row.student_number"/></td><td t-esc="row.category"/><td><strong t-esc="row.name"/></td><td t-esc="row.office"/><td t-esc="date(row.updated)"/><td><span class="oc-pill" t-att-class="statusTone(row.priority_code)" t-esc="row.priority"/></td><td><span class="oc-pill" t-att-class="statusTone(row.state_code)" t-esc="row.state"/></td><td><button t-if="row.type_id" class="oc-text-btn" t-on-click="() => this.inspectRequest(row)">Review</button></td></tr><tr t-if="!requestRows.length"><td colspan="9" class="oc-empty">No student requests match these filters.</td></tr></tbody></table></div></section>
          <div class="oc-note"><strong>Support standards:</strong> requests retain a unique reference and a timestamped history of status changes. Student-visible responses are saved in the existing request workflow.</div>
        </t>
        <div class="oc-footer"><t t-esc="state.data.company"/> · Communication workspace</div>
      </t>
    </div></main>
  </t>
</templates>
