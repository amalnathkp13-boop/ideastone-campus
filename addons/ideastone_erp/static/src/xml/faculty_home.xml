<templates xml:space="preserve">
  <t t-name="ideastone_erp.FacultyHome">
    <div class="campus_faculty_home"><div class="content">
      <p t-if="state.loading" class="home-loading" role="status">Refreshing your teaching records…</p>
      <div t-if="state.error" class="home-error" role="alert"><span t-esc="state.error"/><button class="directory-back" type="button" t-on-click="load">Retry</button></div>
      <t t-if="d">
        <div class="breadcrumb"><span>VCET Campus / Faculty workspace</span><span t-esc="date(d.today,true)"/></div>
        <div class="heading-row"><div><h1>Faculty overview</h1><div class="subtitle">Your teaching schedule, student progress and pending responsibilities.</div></div><div class="home-heading-tools"><span class="pill" t-esc="d.demo ? '▣ Sample data · Faculty view' : '▣ Saved records · Faculty view'"/><button class="home-refresh" type="button" aria-label="Refresh faculty dashboard" title="Refresh faculty dashboard" t-on-click="load" t-att-disabled="state.loading">⟳</button></div></div>
        <section class="welcome"><div><div class="eyebrow">YOUR CAMPUS, CONNECTED · FACULTY WORKSPACE</div><h2>Welcome back, <t t-esc="d.user"/></h2><p>See what is scheduled, what needs action, and where students may need support.</p></div><div class="welcome-date">Department · <t t-esc="d.department"/><br/><strong t-esc="d.semesters.join(' &amp; ') || 'Semester mapping not recorded'"/></div></section>
        <section class="stats" aria-label="Faculty summary"><article class="stat" t-foreach="stats" t-as="stat" t-key="stat.label"><div class="stat-top"><span class="stat-icon" t-esc="stat.icon"/><span class="pill" t-esc="stat.tag"/></div><div class="stat-label" t-esc="stat.label"/><div class="stat-value" t-esc="number(stat.value)"/><div class="stat-foot" t-att-class="stat.tone" t-esc="stat.foot"/></article></section>
        <div class="dashboard-grid"><div class="left-stack">
          <section class="panel"><div class="panel-head"><div class="panel-title" role="heading" aria-level="2"><span class="head-icon">▦</span>Today’s teaching schedule</div><button class="text-link" type="button" t-on-click="() => this.open('timetable')">Full timetable →</button></div><div class="table-wrap" tabindex="0" aria-label="Today's teaching schedule"><table><thead><tr><th>Time</th><th>Subject / activity</th><th>Class &amp; room</th><th>Status</th></tr></thead><tbody><tr t-foreach="d.schedule" t-as="session" t-key="session.id" t-att-class="session.status === 'next' ? 'next-row' : ''"><td class="time"><span class="dot" t-att-class="session.status === 'done' ? 'green' : session.status === 'next' ? 'blue' : ''"/> &#160;<t t-esc="session.time"/></td><td t-esc="session.subject"/><td><t t-esc="session.class"/> · <t t-esc="session.room"/></td><td><button class="status" type="button" t-att-class="session.status" t-att-title="session.attendance ? 'View submitted attendance' : 'Open attendance for this class'" t-on-click="() => this.open('take_attendance',session.id)" t-esc="statusLabels[session.status]"/></td></tr><tr t-if="!d.schedule.length"><td colspan="4" class="home-empty">No confirmed teaching sessions scheduled today.</td></tr></tbody></table></div></section>
          <div class="two-panels"><section class="panel"><div class="panel-head"><div class="panel-title" role="heading" aria-level="2"><span class="head-icon">♧</span>Subject attendance</div><button class="text-link" type="button" t-on-click="() => this.open('attendance')">Details →</button></div><div class="attendance-list"><div class="att-row" t-foreach="d.attendance" t-as="subject" t-key="subject.id"><span class="att-subject" t-att-title="subject.name" t-esc="subject.name"/><span class="att-percent" t-esc="percent(subject.rate)"/><div class="bar"><span t-att-class="subject.rate !== null &amp;&amp; subject.rate &lt; d.threshold + 5 ? 'mid' : ''" t-att-style="'width:' + width(subject.rate)"/></div></div><p t-if="!d.attendance.length" class="home-empty">No subjects in your confirmed teaching allocations.</p></div><div class="insight-card support" style="margin-top:16px"><div class="insight-title">↗ Student support signal</div><p class="insight-copy" t-if="lowestAttendance"><t t-esc="lowestAttendance.name"/> has the lowest recorded attendance at <t t-esc="percent(lowestAttendance.rate)"/>. <t t-esc="lowestAttendance.shortage"/> students are below the <t t-esc="d.threshold"/>% threshold. Check the completed attendance report.</p><p t-else="" class="insight-copy">Attendance signals will appear after completed class registers are submitted.</p></div></section>
            <section class="panel"><div class="panel-head"><div class="panel-title" role="heading" aria-level="2"><span class="head-icon">▤</span>Recent assessment results</div><button class="text-link" type="button" t-on-click="() => this.open('results')">View all →</button></div><div class="table-wrap" tabindex="0" aria-label="Recent published assessment averages"><table class="marks-table"><thead><tr><th>Assessment</th><th>Class</th><th>Average</th></tr></thead><tbody><tr t-foreach="d.assessments" t-as="exam" t-key="exam.id"><td t-esc="exam.name"/><td t-esc="exam.class"/><td t-esc="percent(exam.average)"/></tr><tr t-if="!d.assessments.length"><td colspan="3" class="home-empty">No published assessment results in your assigned classes.</td></tr></tbody></table></div><div class="stat-foot" style="margin-top:10px">Recorded marks summary · Published assessments</div></section></div>
          <section class="panel"><div class="panel-head"><div class="panel-title" role="heading" aria-level="2"><span class="head-icon">▤</span>Examination updates</div><button class="text-link" type="button" t-on-click="() => this.open('papers')">Open examinations →</button></div><div class="notice-list"><div class="notice" t-foreach="d.updates" t-as="update" t-key="update_index"><span class="dot" t-att-class="update.kind === 'papers' ? 'orange' : update.kind === 'notices' ? 'green' : 'blue'"/><span class="notice-date" t-esc="date(update.date)"/><span class="notice-title" t-esc="update.name"/><span class="tag" t-att-class="update.kind === 'papers' ? 'academic' : update.kind === 'notices' ? 'event' : ''" t-esc="update.status"/></div><p t-if="!d.updates.length" class="home-empty">No recent question-paper updates, upcoming examinations or published notices in your scope.</p></div></section>
        </div><div class="right-stack">
          <section class="panel"><div class="panel-head"><div class="panel-title" role="heading" aria-level="2"><span class="head-icon">⚑</span>Priority actions</div><span class="pill"><t t-esc="c.tasks"/> open</span></div><div class="action-list"><button class="action" type="button" t-on-click="() => this.open('attendance')"><span class="action-icon">☑</span><span><strong>Submit class attendance</strong><small><t t-esc="c.pending"/> elapsed sessions awaiting submission in your allocated classes.</small></span></button><button class="action" type="button" t-on-click="() => this.open('papers')"><span class="action-icon">▤</span><span><strong>Upload examination question sets</strong><small><t t-esc="c.papers"/> draft or returned submissions. Prepare balanced difficulty sets for HOD review.</small></span></button><button class="action" type="button" t-on-click="() => this.open('results')"><span class="action-icon">✎</span><span><strong>Finish assessment marks</strong><small><t t-esc="c.marks_pending"/> assessments await marks entry. Review and submit the remaining assessment marks.</small></span></button></div></section>
          <section class="panel insight-panel"><div class="panel-head"><div class="panel-title" role="heading" aria-level="2"><span class="head-icon">✧</span>Teaching insights</div><span class="pill">Record-based</span></div><div class="insight-card priority"><div class="insight-title">◈ Needs attention</div><p class="insight-copy" t-if="lowestAttendance"><t t-esc="lowestAttendance.name"/> has the lowest recorded subject attendance at <t t-esc="percent(lowestAttendance.rate)"/>. Review individual attendance and follow up using college policy.</p><p class="insight-copy" t-else="">Completed attendance is needed before comparing your assigned subjects.</p></div><div class="insight-card trend"><div class="insight-title">▦ Assessment trend</div><p class="insight-copy" t-if="recentAssessment">The recorded class average is <t t-esc="percent(recentAssessment.average)"/> for <t t-esc="recentAssessment.name"/>. Review the assessed topics before the next internal assessment.</p><p class="insight-copy" t-else="">Published marks are needed to show an assessment trend.</p></div><div class="insight-card support"><div class="insight-title">✓ Suggested next step</div><ul class="mini-list"><li>Review <t t-esc="c.pending"/> outstanding attendance sessions.</li><li>Prepare easy, moderate and challenging question-paper sets.</li><li>Review students below the attendance threshold.</li></ul></div><div class="stat-foot" style="margin-top:12px">Explainable signals from saved teaching records. Faculty review is required; these are not live AI predictions.</div></section>
          <section class="panel"><div class="panel-head"><div class="panel-title" role="heading" aria-level="2"><span class="head-icon">◷</span>Recent activity</div><button class="text-link" type="button" t-on-click="() => state.history = !state.history" t-esc="state.history ? 'Show less' : 'History →'"/></div><div class="notice-list"><div class="notice" t-foreach="state.history ? d.activity : d.activity.slice(0,3)" t-as="activity" t-key="activity_index"><span class="dot" t-att-class="activity.tone"/><span class="notice-date" t-esc="date(activity.date)"/><span class="notice-title" t-esc="activity.name"/></div><p t-if="!d.activity.length" class="home-empty">Your saved attendance, question-paper and task activity will appear here.</p></div></section>
        </div></div><footer class="footer"><t t-esc="d.company"/> · Faculty workspace · <t t-esc="d.demo ? 'Sample records' : 'Saved teaching records'"/></footer>
      </t>
    </div></div>
  </t>
  <t t-name="ideastone_erp.FacultyDepartments">
    <div class="campus_faculty_home faculty-departments"><div class="content"><p t-if="state.loading" class="home-loading" role="status">Refreshing your allocated classes…</p><div t-if="state.error" class="home-error" role="alert"><span t-esc="state.error"/><button class="directory-back" type="button" t-on-click="() => this.load()">Retry</button></div><t t-if="d">
      <div class="breadcrumb"><span>VCET Campus / Faculty workspace / My departments</span><span t-esc="d.academic_year"/></div><div class="directory-intro"><div><h1>My departments</h1><div class="subtitle">Browse allocated departments, then choose a year of study and section to view student details.</div></div><div class="home-heading-tools"><span class="pill">▣ Faculty access · Assigned teaching scope</span><button class="home-refresh" type="button" aria-label="Refresh allocated classes" title="Refresh allocated classes" t-on-click="() => this.load()" t-att-disabled="state.loading">⟳</button></div></div>
      <div t-if="state.department" class="directory-crumbs"><button type="button" t-on-click="() => this.load(0,0,0)">My departments</button><span>›</span><button type="button" t-on-click="() => this.load(state.department,0,0)" t-esc="d.selected.department"/><t t-if="state.year"><span>›</span><button type="button" t-on-click="() => this.load(state.department,state.year,0)" t-esc="yearLabel"/></t><t t-if="state.section"><span>›</span><span t-esc="d.selected.section"/></t></div>
      <section class="panel"><div class="panel-head"><div><div class="panel-title" role="heading" aria-level="2"><span class="head-icon">▦</span><span t-esc="title"/></div><div class="subtitle" style="margin-top:6px" t-esc="description"/></div><button t-if="state.department" type="button" class="directory-back" t-on-click="back" t-att-disabled="state.loading">← Back</button></div>
        <div t-if="!state.department" class="directory-grid"><button class="directory-card" type="button" t-foreach="d.departments" t-as="department" t-key="department.id" t-on-click="() => this.load(department.id,0,0)" t-att-disabled="state.loading"><div class="directory-card-top"><span class="directory-icon" t-esc="departmentIcon(department.code)"/><span class="directory-count"><t t-esc="department.years"/> years · <t t-esc="department.sections"/> sections</span></div><h3 t-esc="department.name"/><p><t t-esc="department.code"/> · Assigned subjects, labs and assessments.</p><div class="directory-card-foot"><span>View classes</span><span>→</span></div></button><p t-if="!d.departments.length" class="home-empty">No departments in your confirmed timetable allocations. Ask the academic office to confirm your class assignments.</p></div>
        <div t-elif="!state.year" class="directory-year-grid"><button class="directory-year" type="button" t-foreach="d.years" t-as="year" t-key="year.id" t-on-click="() => this.load(state.department,year.id,0)" t-att-disabled="state.loading"><strong t-esc="year.label"/><span><t t-esc="year.sections"/> allocated sections</span></button></div>
        <div t-elif="!state.section" class="directory-year-grid"><button class="directory-year" type="button" t-foreach="d.sections" t-as="section" t-key="section.id" t-on-click="() => this.load(state.department,state.year,section.id)" t-att-disabled="state.loading"><strong t-esc="section.name"/><span><t t-esc="section.students"/> students · <t t-esc="section.programme"/></span></button></div>
        <div t-else=""><div class="directory-table-wrap" tabindex="0" aria-label="Allocated section students"><table class="directory-table"><thead><tr><th>Student</th><th>Register number</th><th>Programme</th><th>Year / Section</th><th>College email</th><th>Status</th></tr></thead><tbody><tr t-foreach="d.students" t-as="student" t-key="student.id"><td><span class="student-initial" t-esc="initials(student.name)"/><t t-esc="student.name"/></td><td t-esc="student.register"/><td t-esc="student.programme"/><td><t t-esc="yearLabel"/> · <t t-esc="student.section"/></td><td t-esc="student.email"/><td><span class="status" t-att-class="student.status === 'Active' ? 'done' : 'pending'" t-esc="student.status"/></td></tr><tr t-if="!d.students.length"><td colspan="6" class="home-empty">No active students currently enrolled in this allocated section.</td></tr></tbody></table></div><div class="directory-empty-note">Student details are restricted to your confirmed department, year and section allocations in the active college. New saved enrolments appear after refresh.</div></div>
      </section><footer class="footer"><t t-esc="d.company"/> · Faculty workspace · Assigned teaching records</footer>
    </t></div></div>
  </t>
</templates>
