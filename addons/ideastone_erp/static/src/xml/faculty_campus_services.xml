<templates xml:space="preserve">
  <t t-name="ideastone_erp.FacultyCampusServices">
    <div class="faculty_services">
      <div class="fs_crumb"><span>VCET Campus / Campus services</span><span><t t-esc="state.today"/> · <b>Faculty</b></span></div>
      <div class="fs_title"><div><h1 t-esc="config.title"/><p t-esc="config.sub"/></div><button class="fs_btn" t-on-click="refresh" t-att-disabled="state.busy"><i class="fa fa-refresh"/> Refresh</button></div>
      <div t-if="state.error" class="fs_error" role="alert" t-esc="state.error"/>
      <section class="fs_hero"><div><div class="fs_hero_tag">VCET CAMPUS SERVICES</div><h2 style="color:#fff !important" t-esc="config.hero"/><p style="color:#e0efff !important" t-esc="config.text"/></div><i class="fa fa-building-o" aria-hidden="true"/></section>
      <section class="fs_stats" aria-label="Campus service summary"><article t-foreach="stats" t-as="s" t-key="s.label" class="fs_stat"><div class="fs_stat_top"><span t-att-class="'fs_stat_icon ' + s.tone"><i t-att-class="'fa ' + s.icon"/></span><span t-att-class="'fs_pill ' + s.tone">Current</span></div><div class="fs_stat_label" t-esc="s.label"/><strong t-esc="s.value"/><small t-esc="s.note"/></article></section>
      <div t-if="state.page !== 'leave' &amp;&amp; state.page !== 'complaint' &amp;&amp; !state.form" class="fs_subnav" aria-label="Request status"><button t-att-class="{active: state.quickFilter === 'all'}" t-on-click="() => state.quickFilter = 'all'">All requests</button><button t-att-class="{active: state.quickFilter === 'open'}" t-on-click="() => state.quickFilter = 'open'">Open</button><button t-att-class="{active: state.quickFilter === 'progress'}" t-on-click="() => state.quickFilter = 'progress'">In progress</button><button t-att-class="{active: state.quickFilter === 'closed'}" t-on-click="() => state.quickFilter = 'closed'">Resolved</button></div>
      <div class="fs_grid"><div class="fs_stack">
        <section t-if="state.form" class="fs_panel"><div class="fs_panel_head"><h3><i class="fa fa-plus"/> <t t-esc="state.page === 'maintenance' ? 'Log maintenance issue' : state.page === 'complaint' ? 'Register student complaint' : 'Create service request'"/></h3><button class="fs_btn" t-on-click="closeForm">✕ Close</button></div><p class="fs_desc">Provide enough detail for the campus team to route and resolve your request.</p>
          <form t-on-submit.prevent="submit"><div class="fs_form">
            <label>Request subject *<input required="required" maxlength="200" t-model="state.subject" placeholder="e.g., Projector not working in Room 204"/></label>
            <t t-if="state.page === 'complaint'"><label>Student register number *<input required="required" t-model="state.student_number" placeholder="College register number"/></label><label>Concern category *<input required="required" t-model="state.complaint_category" placeholder="e.g., Classroom conduct"/></label></t>
            <t t-else=""><label>Category *<select required="required" t-model="state.category"><option value="">Select category</option><option value="it">IT &amp; network</option><option value="facilities">Facilities</option><option value="transport">Transport</option><option value="housekeeping">Housekeeping</option><option value="electrical">Electrical</option></select></label><label>Priority *<select t-model="state.priority"><option value="normal">Normal</option><option value="low">Low</option><option value="high">High</option><option value="urgent">Urgent</option></select></label><label>Location / department *<input required="required" t-model="state.location" placeholder="Building, room, or department"/></label><label>Required by<input type="date" t-model="state.needed_by"/></label><label>Contact extension / phone<input t-model="state.contact" placeholder="Optional contact details"/></label></t>
            <label class="full">Description *<textarea required="required" t-model="state.description" placeholder="Describe the issue, impact, and any steps already taken."/></label>
          </div><div class="fs_form_actions"><button type="button" class="fs_btn" t-on-click="closeForm">Cancel</button><button class="fs_btn primary" t-att-disabled="state.busy">Submit request</button></div></form></section>
        <section t-else="" class="fs_panel"><div class="fs_panel_head"><h3><i class="fa fa-list-alt"/> <t t-esc="config.table"/></h3><button t-if="state.page !== 'leave'" class="fs_btn primary" t-on-click="openForm">＋ New request</button></div><p class="fs_desc" t-esc="config.desc"/><div class="fs_filters"><input type="search" t-model="state.query" placeholder="Search request ID, subject, requester…"/><select t-if="state.page === 'service' || state.page === 'maintenance'" t-model="state.categoryFilter"><option value="all">All categories</option><option t-foreach="categories" t-as="category" t-key="category" t-att-value="category" t-esc="category"/></select><select t-model="state.statusFilter"><option value="all">All statuses</option><option t-foreach="statuses" t-as="status" t-key="status" t-att-value="status" t-esc="status"/></select></div>
          <div class="fs_table_wrap"><table><thead><tr><th t-foreach="config.columns" t-as="column" t-key="column" t-esc="column"/></tr></thead><tbody>
            <tr t-foreach="rows" t-as="row" t-key="row.id"><td class="fs_record" t-esc="row.code"/><td t-esc="state.page === 'leave' ? row.subject : state.page === 'complaint' ? (row.student || row.subject) : row.subject"/><td t-esc="state.page === 'maintenance' ? row.location : row.category"/><td t-esc="state.page === 'leave' ? row.date : state.page === 'maintenance' ? row.team : row.date"/><td t-esc="state.page === 'leave' ? row.due : state.page === 'maintenance' ? row.date : state.page === 'service' ? row.team : row.requester"/><td><span t-if="state.page !== 'leave'" t-att-class="'fs_pill ' + priorityTone(row.priority)" t-esc="row.priority"/><span t-else="" t-esc="row.team"/></td><td><span t-att-class="'fs_pill ' + statusTone(row.status)" t-esc="row.status"/></td><td t-if="state.page === 'leave'"><button t-if="row.can_decide" class="fs_action" t-on-click="() => this.review(row)">Review</button><span t-else="">—</span></td><td t-else="" t-esc="row.due"/></tr>
            <tr t-if="!rows.length"><td t-att-colspan="config.columns.length" class="fs_empty"><strong>No matching records</strong>Try changing your search or filters.</td></tr>
          </tbody></table></div><div class="fs_notice">Records come from your college's live request and approval workflows.</div></section>
        <section t-if="state.page === 'leave' &amp;&amp; state.decisionId" class="fs_panel"><div class="fs_panel_head"><h3><i class="fa fa-check-square-o"/> Leave decision</h3><button class="fs_btn" t-on-click="() => state.decisionId = 0">✕ Close</button></div><p class="fs_desc" t-esc="state.rows.find(r => r.id === state.decisionId)?.reason || ''"/><label class="fs_decision_label">Decision reason <span>(required for rejection)</span><textarea t-model="state.decisionReason" placeholder="Record a factual reason for this decision."/></label><div class="fs_form_actions"><button class="fs_btn" t-on-click="() => this.decide('reject')" t-att-disabled="state.busy || !state.decisionReason.trim()">Reject</button><button class="fs_btn primary" t-on-click="() => this.decide('approve')" t-att-disabled="state.busy">Approve stage</button></div></section>
        <section class="fs_panel"><div class="fs_panel_head"><h3><i class="fa fa-long-arrow-right"/> Request workflow</h3><span class="fs_pill blue">Standard process</span></div><div class="fs_progress"><div><strong>1. Submitted</strong><span>Request logged</span><i style="width:100%"/></div><div><strong>2. Assigned</strong><span>Campus team accepts ownership</span><i style="width:72%"/></div><div><strong>3. In progress</strong><span>Work or review underway</span><i style="width:48%"/></div><div><strong>4. Resolved</strong><span>Requester can confirm completion</span><i style="width:100%"/></div></div></section>
      </div><div class="fs_stack"><section class="fs_panel"><div class="fs_panel_head"><h3><i class="fa fa-magic"/> Campus service insights</h3><span class="fs_pill violet">Live</span></div><p class="fs_desc">A quick view of your service workload and suggested next actions.</p><div class="fs_metric"><div><span>Requests assigned to a team</span><strong><t t-esc="assignedPct"/>%</strong></div><div class="fs_track"><i t-att-style="'width:' + assignedPct + '%'"/></div></div><div class="fs_metric"><div><span>Requests resolved</span><strong><t t-esc="resolvedPct"/>%</strong></div><div class="fs_track green"><i t-att-style="'width:' + resolvedPct + '%'"/></div></div><div class="fs_insight"><strong>Prioritise urgent facilities issues</strong>Escalate safety, electrical, and network outages to the responsible team promptly.</div><div class="fs_insight"><strong>Keep request details complete</strong>Include location, access instructions, and a preferred completion date to reduce follow-up.</div></section>
        <section class="fs_panel"><div class="fs_panel_head"><h3><i class="fa fa-bolt"/> Quick actions</h3></div><div class="fs_quick"><button t-on-click="openForm" t-att-disabled="state.page === 'leave'">＋ Raise a request<span>Report a campus issue</span></button><button t-on-click="() => this.go('leave')">✓ Review student leave<span>View pending approvals</span></button><button t-on-click="() => this.go('maintenance')">⚒ Maintenance tracker<span>Track work orders</span></button><button t-on-click="() => this.go('complaint')">⚑ Student complaint<span>Record a concern</span></button></div></section>
        <section class="fs_panel"><div class="fs_panel_head"><h3><i class="fa fa-phone"/> Service desk &amp; guidance</h3></div><div class="fs_insight"><strong>Campus administration</strong>General service requests and follow-up</div><div class="fs_insight"><strong>IT support</strong>Network, account, projector, and classroom technology issues</div><div class="fs_insight"><strong>Facilities team</strong>Electrical, plumbing, furniture, and maintenance issues</div><div class="fs_notice">For an immediate safety risk, contact campus administration directly rather than relying only on a standard request.</div></section></div></div>
    </div>
  </t>
</templates>
