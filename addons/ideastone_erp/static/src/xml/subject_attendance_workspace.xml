<templates xml:space="preserve">
  <t t-name="ideastone_erp.SubjectAttendanceWorkspace">
    <main class="campus_subject_attendance">
      <div t-if="state.error" class="swa_error" role="alert"><t t-esc="state.error"/><button type="button" t-on-click="load">Retry</button></div>
      <div t-elif="state.loading" class="swa_loading" role="status">Loading subject attendance…</div>
      <t t-elif="state.data">
        <section class="swa_heading">
          <span class="swa_heading_icon"><i class="fa fa-users" aria-hidden="true"/></span>
          <div><h1>Subject wise Attendance</h1><p>View subject list, allocate hours and manage student attendance</p></div>
          <small t-if="state.data.last_login">Last Login: <t t-esc="state.data.last_login"/></small>
        </section>
        <section class="swa_stats" aria-label="Subject attendance summary">
          <article class="swa_stat"><span class="swa_stat_icon blue"><i class="fa fa-book" aria-hidden="true"/></span><div><h2>Total Subjects</h2><strong t-esc="state.data.summary.subjects"/><small>This Semester</small></div></article>
          <article class="swa_stat"><span class="swa_stat_icon green"><i class="fa fa-users" aria-hidden="true"/></span><div><h2>Total Students</h2><strong t-esc="state.data.summary.students"/><small>In My Classes</small></div></article>
          <article class="swa_stat"><span class="swa_stat_icon orange"><i class="fa fa-clock-o" aria-hidden="true"/></span><div><h2>Allocated Classes</h2><strong t-esc="state.data.summary.classes"/><small>This Semester</small></div></article>
          <article class="swa_stat"><span class="swa_stat_icon purple"><i class="fa fa-pie-chart" aria-hidden="true"/></span><div><h2>Average Attendance</h2><strong t-esc="state.data.summary.rate === null ? '—' : state.data.summary.rate + '%'"/><small>This Semester</small></div></article>
        </section>
        <div class="swa_main_grid">
          <section class="swa_panel swa_subjects">
            <header class="swa_panel_header"><h2><i class="fa fa-file-text" aria-hidden="true"/> Subject List <span t-if="state.data.term_id">for <t t-esc="state.data.terms.find((item) => item.id === state.data.term_id)?.name"/></span></h2></header>
            <div class="swa_subject_toolbar">
              <label>Institution <select aria-label="Institution"><option t-esc="state.data.company"/></select></label>
              <label>Sem Period <select aria-label="Semester period" t-on-change="changeTerm"><t t-foreach="state.data.terms" t-as="term" t-key="term.id"><option t-att-value="term.id" t-att-selected="term.id.toString() === state.termId" t-esc="term.name"/></t></select></label>
              <div class="swa_export_buttons">
                <button type="button" class="swa_icon_button pdf" aria-label="Print subject list as PDF" title="Print or save as PDF" t-on-click="printSubjects"><i class="fa fa-file-pdf-o" aria-hidden="true"/></button>
                <button type="button" class="swa_icon_button excel" aria-label="Export subject list as CSV" title="Export CSV for Excel" t-on-click="exportSubjects"><i class="fa fa-file-excel-o" aria-hidden="true"/></button>
                <button type="button" class="swa_icon_button" aria-label="Print subject list" title="Print subject list" t-on-click="printSubjects"><i class="fa fa-print" aria-hidden="true"/></button>
              </div>
            </div>
            <label class="swa_search"><i class="fa fa-search" aria-hidden="true"/><input type="search" placeholder="Search subject by code or name…" aria-label="Search subjects" t-att-value="state.subjectSearch" t-on-input="searchSubjects"/></label>
            <div class="swa_table_wrap"><table><thead><tr><th>#</th><th>Category</th><th>Subject Code</th><th>Subject Name</th><th>Students</th><th>Actions</th></tr></thead><tbody>
              <tr t-foreach="visibleSubjects" t-as="subject" t-key="subject.key" t-att-class="subject.key === state.subjectKey ? 'swa_selected' : ''"><td t-esc="(state.subjectPage - 1) * state.subjectPageSize + subject_index + 1"/><td><span t-att-class="subject.kind.toLowerCase() === 'elective' ? 'swa_badge elective' : 'swa_badge'" t-esc="subject.kind"/></td><td t-esc="subject.code"/><td class="swa_subject_name" t-esc="subject.name"/><td class="swa_count" t-esc="subject.students"/><td><button type="button" class="swa_outline" t-on-click="() => this.chooseSubject(subject.key)">View</button></td></tr>
              <tr t-if="!filteredSubjects.length"><td colspan="6" class="swa_empty">No allocated subjects match your search.</td></tr>
            </tbody></table></div>
            <footer><span>Showing <t t-esc="filteredSubjects.length ? (state.subjectPage - 1) * state.subjectPageSize + 1 : 0"/> to <t t-esc="(state.subjectPage * state.subjectPageSize &lt; filteredSubjects.length ? state.subjectPage * state.subjectPageSize : filteredSubjects.length)"/> of <t t-esc="filteredSubjects.length"/> records</span><div class="swa_footer_controls"><nav class="swa_pagination" aria-label="Subject pages"><button type="button" t-att-disabled="state.subjectPage === 1" t-on-click="() => this.setSubjectPage(state.subjectPage - 1)">‹</button><button type="button" class="active" t-esc="state.subjectPage"/><button type="button" t-att-disabled="state.subjectPage === subjectPageCount" t-on-click="() => this.setSubjectPage(state.subjectPage + 1)">›</button></nav><label>Show <select aria-label="Subjects per page" t-on-change="changeSubjectPageSize"><option value="10" t-att-selected="state.subjectPageSize === 10">10 per page</option><option value="20" t-att-selected="state.subjectPageSize === 20">20 per page</option><option value="50" t-att-selected="state.subjectPageSize === 50">50 per page</option></select></label></div></footer>
          </section>
          <section class="swa_panel swa_students">
            <header class="swa_panel_header"><h2><i class="fa fa-users" aria-hidden="true"/> Student(s) Info <span t-if="selectedSubject">- <t t-esc="selectedSubject.name"/></span></h2></header>
            <div class="swa_student_toolbar"><label>Status <select aria-label="Filter student status" t-on-change="filterStudents"><option value="all">All Students</option><option value="present">Present</option><option value="absent">Absent</option><option value="late">Late</option><option value="excused">OD / Excused</option></select></label><label class="swa_check"><input type="checkbox" t-att-checked="state.showRoll" t-on-change="toggleRoll"/> Show Roll No</label><button type="button" class="swa_primary" t-att-disabled="!state.data.can_save || state.saving" t-on-click="save"><i class="fa fa-floppy-o" aria-hidden="true"/> <t t-esc="state.saving ? 'Saving…' : 'Save'"/></button></div>
            <label class="swa_search"><i class="fa fa-search" aria-hidden="true"/><input type="search" placeholder="Search by roll no or student name…" aria-label="Search students" t-att-value="state.studentSearch" t-on-input="searchStudents"/></label>
            <div class="swa_table_wrap"><table><thead><tr><th>#</th><th><input type="checkbox" aria-label="Select visible students" t-on-change="toggleVisibleStudents"/></th><th t-if="state.showRoll">Roll No</th><th>Student Name</th><th>Class</th><th>Today's Status</th></tr></thead><tbody>
              <tr t-foreach="visibleStudents" t-as="student" t-key="student.id"><td t-esc="(state.page - 1) * 8 + student_index + 1"/><td><input type="checkbox" t-att-checked="state.selectedStudents.includes(student.id)" t-on-change="(event) => this.toggleStudent(student.id, event)" t-att-aria-label="'Select ' + student.name"/></td><td t-if="state.showRoll" t-esc="student.roll"/><td t-esc="student.name"/><td t-esc="student.class"/><td><select t-att-class="'swa_status ' + student.status" t-att-disabled="!state.data.can_save" t-on-change="(event) => this.changeStatus(student.id, event)" t-att-aria-label="'Attendance status for ' + student.name"><option value="present" t-att-selected="student.status === 'present'">Present</option><option value="absent" t-att-selected="student.status === 'absent'">Absent</option><option value="late" t-att-selected="student.status === 'late'">Late</option><option value="excused" t-att-selected="student.status === 'excused'">OD / Excused</option></select></td></tr>
              <tr t-if="!filteredStudents.length"><td t-att-colspan="state.showRoll ? 6 : 5" class="swa_empty">No students match the selected subject and filter.</td></tr>
            </tbody></table></div>
            <footer><span t-esc="studentRange"/><nav class="swa_pagination" aria-label="Student pages"><button type="button" t-att-disabled="state.page === 1" t-on-click="() => this.setPage(1)">«</button><button type="button" t-att-disabled="state.page === 1" t-on-click="() => this.setPage(state.page - 1)">‹</button><t t-foreach="pageNumbers" t-as="page" t-key="page"><button type="button" t-att-class="page === state.page ? 'active' : ''" t-on-click="() => this.setPage(page)" t-esc="page"/></t><button type="button" t-att-disabled="state.page === pageCount" t-on-click="() => this.setPage(state.page + 1)">›</button><button type="button" t-att-disabled="state.page === pageCount" t-on-click="() => this.setPage(pageCount)">»</button></nav></footer>
          </section>
        </div>
        <div class="swa_secondary_grid">
          <section class="swa_panel swa_hours"><header class="swa_panel_header"><h2><i class="fa fa-clock-o" aria-hidden="true"/> Allocated Hour(s)</h2><button type="button" class="swa_primary" t-att-disabled="!state.data.can_manage_allocations" title="Manage hours in the timetable" t-on-click="openAllocations"><i class="fa fa-plus" aria-hidden="true"/> Add Hour</button></header><div class="swa_table_wrap"><table><thead><tr><th>#</th><th>Date</th><th>Hour</th><th>From</th><th>To</th><th>Subject</th><th>Actions</th></tr></thead><tbody><tr t-foreach="visibleAllocations" t-as="hour" t-key="hour.id"><td t-esc="(state.allocationPage - 1) * 5 + hour_index + 1"/><td t-esc="this.displayDate(hour.date)"/><td t-esc="hour.hour"/><td t-esc="hour.from"/><td t-esc="hour.to"/><td t-esc="hour.subject"/><td><div class="swa_row_actions"><button type="button" class="swa_row_action" title="Select this teaching hour" t-on-click="() => this.chooseAllocation(hour)"><i class="fa fa-pencil" aria-hidden="true"/></button><button type="button" class="swa_row_action danger" title="Open timetable record to review removal" t-att-disabled="!state.data.can_manage_allocations" t-on-click="() => this.openRecord('op.session', hour.id, 'Teaching hour')"><i class="fa fa-trash" aria-hidden="true"/></button></div></td></tr><tr t-if="!state.data.allocations.length"><td colspan="7" class="swa_empty">No teaching hours are allocated for this subject.</td></tr></tbody></table></div><footer><span>Showing <t t-esc="state.data.allocations.length ? (state.allocationPage - 1) * 5 + 1 : 0"/> to <t t-esc="(state.allocationPage * 5 &lt; state.data.allocations.length ? state.allocationPage * 5 : state.data.allocations.length)"/> of <t t-esc="state.data.allocations.length"/> records</span><nav class="swa_pagination" aria-label="Hour pages"><button type="button" t-att-disabled="state.allocationPage === 1" t-on-click="() => this.setAllocationPage(state.allocationPage - 1)">«</button><button type="button" t-att-disabled="state.allocationPage === 1" t-on-click="() => this.setAllocationPage(state.allocationPage - 1)">‹</button><button type="button" class="active" t-esc="state.allocationPage"/><button type="button" t-att-disabled="state.allocationPage === allocationPageCount" t-on-click="() => this.setAllocationPage(state.allocationPage + 1)">›</button><button type="button" t-att-disabled="state.allocationPage === allocationPageCount" t-on-click="() => this.setAllocationPage(allocationPageCount)">»</button></nav></footer></section>
          <section class="swa_panel swa_classes"><header class="swa_panel_header"><h2><i class="fa fa-users" aria-hidden="true"/> Allocated Class</h2><button type="button" class="swa_primary" t-att-disabled="!state.data.can_manage_allocations" title="Manage classes" t-on-click="openClasses"><i class="fa fa-plus" aria-hidden="true"/> Add Class</button></header><div class="swa_table_wrap"><table><thead><tr><th>#</th><th>Class</th><th>Sem</th><th>Total Students</th><th>Actions</th></tr></thead><tbody><tr t-foreach="visibleClasses" t-as="item" t-key="item.id"><td t-esc="(state.classPage - 1) * 4 + item_index + 1"/><td t-esc="item.name"/><td t-esc="item.semester"/><td t-esc="item.total"/><td><div class="swa_row_actions"><button type="button" class="swa_row_action" title="Open class" t-on-click="() => this.openRecord('op.batch', item.id, 'Allocated class')"><i class="fa fa-pencil" aria-hidden="true"/></button><button type="button" class="swa_row_action danger" title="Open class record to review removal" t-att-disabled="!state.data.can_manage_allocations" t-on-click="() => this.openRecord('op.batch', item.id, 'Allocated class')"><i class="fa fa-trash" aria-hidden="true"/></button></div></td></tr><tr t-if="!state.data.classes.length"><td colspan="5" class="swa_empty">No classes allocated for this semester.</td></tr></tbody></table></div><footer><span>Showing <t t-esc="state.data.classes.length ? (state.classPage - 1) * 4 + 1 : 0"/> to <t t-esc="(state.classPage * 4 &lt; state.data.classes.length ? state.classPage * 4 : state.data.classes.length)"/> of <t t-esc="state.data.classes.length"/> records</span><nav class="swa_pagination" aria-label="Class pages"><button type="button" t-att-disabled="state.classPage === 1" t-on-click="() => this.setClassPage(state.classPage - 1)">‹</button><button type="button" class="active" t-esc="state.classPage"/><button type="button" t-att-disabled="state.classPage === classPageCount" t-on-click="() => this.setClassPage(state.classPage + 1)">›</button></nav></footer></section>
          <section class="swa_panel swa_trend"><header class="swa_panel_header"><h2><i class="fa fa-bar-chart" aria-hidden="true"/> Attendance Trend</h2><select class="swa_month" aria-label="Trend month" t-on-change="changeTrendMonth"><option t-foreach="trendMonths" t-as="month" t-key="month.value" t-att-value="month.value" t-att-selected="month.value === state.date.slice(0, 7)" t-esc="month.label"/></select></header><div t-if="state.data.trend.some((week) => week.present || week.absent || week.excused)" class="swa_chart_frame"><span class="swa_chart_axis">Attendance marks</span><div class="swa_y_ticks"><span t-foreach="trendTicks" t-as="tick" t-key="tick" t-esc="tick"/></div><div class="swa_chart" role="img" aria-label="Weekly attendance marks by status"><div t-foreach="state.data.trend" t-as="week" t-key="week.label" class="swa_chart_week"><div class="swa_chart_bars"><span class="swa_bar present" t-att-style="'height:' + this.chartHeight(week.present)" t-att-title="week.present + ' present'"><b t-if="week.present" t-esc="week.present"/></span><span class="swa_bar absent" t-att-style="'height:' + this.chartHeight(week.absent)" t-att-title="week.absent + ' absent'"><b t-if="week.absent" t-esc="week.absent"/></span><span class="swa_bar excused" t-att-style="'height:' + this.chartHeight(week.excused)" t-att-title="week.excused + ' OD / excused'"><b t-if="week.excused" t-esc="week.excused"/></span></div><small t-esc="week.label"/><small class="swa_week_range" t-esc="week.range"/></div></div></div><p t-else="" class="swa_empty">The trend will appear after attendance is submitted.</p><div class="swa_legend"><span><i class="present"/> Present</span><span><i class="absent"/> Absent</span><span><i class="excused"/> OD / Excused</span></div></section>
        </div>
        <div class="swa_insight_grid">
          <section class="swa_panel swa_notes"><header class="swa_panel_header"><h2><i class="fa fa-file-text" aria-hidden="true"/> Enter Notes of Lesson</h2></header><textarea maxlength="500" placeholder="Enter notes of lesson here…" t-att-value="state.notes" t-att-disabled="!state.data.can_save" t-on-input="changeNotes"/><div class="swa_notes_actions"><small><t t-esc="state.notes.length"/>/500 · Saved with attendance</small><div><button type="button" class="swa_primary" t-on-click="openHistory"><i class="fa fa-clock-o" aria-hidden="true"/> View Attendance History</button><button type="button" class="swa_outline_action" t-on-click="openLessonPlanner"><i class="fa fa-calendar" aria-hidden="true"/> Select Hour &amp; Enter Notes for Lesson planner</button></div></div><p t-if="state.data.sheet_state === 'done'" class="swa_notice">Submitted attendance is read only. Use the authorized correction flow to edit it.</p></section>
          <section class="swa_panel swa_insights"><header class="swa_panel_header"><h2><i class="fa fa-magic" aria-hidden="true"/> AI Attendance Insights</h2></header><div class="swa_insight_cards"><article class="low"><i class="fa fa-arrow-down" aria-hidden="true"/><div><strong>Low Attendance</strong><span t-esc="state.data.insights.low?.name || 'No recorded data'"/><b t-esc="state.data.insights.low ? state.data.insights.low.rate + '%' : '—'"/></div></article><article class="suggestion"><i class="fa fa-lightbulb-o" aria-hidden="true"/><div><strong>Suggestion</strong><span t-esc="state.data.insights.suggestion"/></div></article><article class="high"><i class="fa fa-arrow-up" aria-hidden="true"/><div><strong>Good Performance</strong><span t-esc="state.data.insights.high?.name || 'No recorded data'"/><b t-esc="state.data.insights.high ? state.data.insights.high.rate + '%' : '—'"/></div></article></div></section>
        </div>
      </t>
    </main>
  </t>
</templates>
