<templates xml:space="preserve">
  <t t-name="ideastone_erp.OwnerAttendance">
    <main class="owner_attendance">
      <div class="eyebrow">VCET Campus / <strong>Owner Workspace</strong></div>
      <header class="page-head"><div><h1>Attendance Overview</h1><p>Monitor institutional attendance, review exceptions, and track assigned actions.</p></div><span class="date-tag" t-if="d"><t t-esc="d.today"/> · Saved college records</span></header>
      <section class="controls card"><div class="switch" role="tablist" aria-label="Attendance category"><button role="tab" t-att-class="staff ? 'active' : ''" t-att-aria-selected="staff" t-on-click="() => this.mode('staff')">Staff Attendance</button><button role="tab" t-att-class="!staff ? 'active' : ''" t-att-aria-selected="!staff" t-on-click="() => this.mode('student')">Student Attendance</button></div><div class="filterbar"><label for="oao_department">Department</label><select id="oao_department" class="select" t-model="state.department" t-on-change="(event) => this.filter(event, 'department')"><option value="">All departments</option><option t-foreach="d ? d.choices : []" t-as="row" t-key="row.key" t-att-value="row.key" t-esc="row.name"/></select><label for="oao_month">Trend Month</label><input id="oao_month" class="select" type="month" min="2000-01" t-att-max="d ? d.today.slice(0,7) : ''" t-model="state.month" t-on-change="(event) => this.filter(event, 'month')"/><button class="btn" t-att-disabled="state.loading || !d || !!state.error" t-on-click="exportOverview"><i class="fa fa-download"/> Export</button></div></section>
      <p t-if="state.loading" role="status">Loading saved attendance records…</p><div t-if="state.error" role="alert" class="alert alert-danger"><t t-esc="state.error"/><button class="btn" t-on-click="load">Retry</button></div>
      <t t-if="d &amp;&amp; !state.error">
        <section t-att-class="'kpi' + (staff ? ' staff-six' : '')" aria-label="Attendance key metrics"><article class="card metric" t-foreach="metrics" t-as="metric" t-key="metric[0]"><span t-att-class="'metric-icon ' + metric[3]"><i t-att-class="'fa fa-' + metric[4]"/></span><div><div class="metric-label" t-esc="metric[0]"/><div class="metric-val" t-esc="metric[1]"/><div class="metric-caption" t-esc="metric[2]"/></div></article></section>
        <div class="main-grid">
          <section class="card panel"><div class="panel-head"><div><h3 class="panel-title"><i class="fa fa-building-o"/><t t-esc="staff ? 'Department-wise Staff Attendance' : 'Department-wise Student Attendance'"/></h3><div class="panel-sub" t-esc="staff ? 'Staff scheduled, present, approved leave and exceptions' : 'Attendance rate, shortage count and pending sessions'"/></div><span class="demo-label">SAVED RECORDS</span></div><div class="searchline"><input class="input" type="search" placeholder="Search department…" aria-label="Search departments" t-model="state.search"/><span class="demo-label"><t t-esc="rows.length"/> departments</span></div>
            <div class="tablewrap"><table class="data-table"><thead><tr><th>Department</th><t t-if="staff"><th>Scheduled</th><th>Present</th><th>Leave</th><th>Delayed</th><th>Missing Punch</th></t><t t-else=""><th>Students</th><th>Attendance</th><th>Below Limit</th><th>Pending</th></t><th>Action</th></tr></thead><tbody><tr t-foreach="rows" t-as="row" t-key="row.key"><td class="strong" t-esc="row.name"/><t t-if="staff"><td class="num" t-esc="row.scheduled"/><td class="num" t-esc="row.present"/><td class="num" t-esc="row.leave"/><td class="num" t-esc="row.late"/><td><span t-att-class="'chip ' + (row.missing ? 'amber' : 'muted')" t-esc="row.missing"/></td></t><t t-else=""><td class="num" t-esc="row.students"/><td><div class="rate"><strong t-esc="rate(row.rate)"/><span class="rate-meter"><i t-att-style="'width:' + Math.min(100, row.rate || 0) + '%'"/></span></div></td><td><span class="chip amber" t-esc="row.below"/></td><td><span t-att-class="'chip ' + (row.pending ? 'amber' : 'green')" t-esc="row.pending"/></td></t><td><button class="btn compact" t-on-click="() => this.department(row)"><i class="fa fa-eye"/> View</button></td></tr><tr t-if="!rows.length"><td t-att-colspan="staff ? 7 : 6" class="empty">No departments match this scope.</td></tr></tbody></table></div><div class="table-foot"><span t-esc="staff ? 'Delayed and missing-punch counts can overlap with presence.' : 'Pending sessions are not automatically student absences.'"/><button class="btn compact" t-on-click="clear">Clear Filters</button></div>
          </section>
          <section class="card panel"><div class="panel-head"><div><h3 class="panel-title"><i class="fa fa-exclamation-triangle"/>Needs Attention</h3><div class="panel-sub">Issues requiring a delegated review</div></div><span class="chip amber"><t t-esc="d.issues.length"/> issues</span></div><div class="queue"><article class="issue" t-foreach="d.issues" t-as="issue" t-key="issue.id"><span class="issue-icon amber"><i class="fa fa-exclamation-triangle"/></span><div><div class="issue-title" t-esc="issue.title"/><div class="issue-desc" t-esc="issue.description"/></div><button class="issue-btn" t-att-disabled="state.busy" t-on-click="() => this.assign(issue)" t-esc="reviewFor(issue) ? 'Review' : 'Assign'"/></article><div t-if="!d.issues.length" class="empty">No recorded exceptions in this scope.</div></div><div class="info-note"><i class="fa fa-info-circle"/> The owner assigns reviews, not attendance edits. HR/HOD verifies source records before corrections.</div></section>
        </div>
        <div class="secondary-grid">
          <section class="card panel"><div class="panel-head"><div><h3 class="panel-title"><i class="fa fa-bar-chart"/><t t-esc="staff ? 'Staff Attendance Trend' : 'Student Attendance Trend'"/></h3><div class="panel-sub">Recorded attendance · selected period</div></div><div class="trendbar" role="group" aria-label="Trend period"><button t-att-class="state.chart === 'weekly' ? 'active' : ''" t-on-click="() => this.state.chart = 'weekly'">Weekly</button><button t-att-class="state.chart === 'monthly' ? 'active' : ''" t-on-click="() => this.state.chart = 'monthly'">Monthly</button></div></div>
            <figure class="chart-frame"><svg t-if="trend.length" class="chart-svg" viewBox="0 0 700 210" role="img" aria-label="Recorded attendance percentage trend"><t t-foreach="[0,25,50,75,100]" t-as="value" t-key="value"><line x1="48" x2="685" t-att-y1="170 - value * 1.4" t-att-y2="170 - value * 1.4" stroke="#e5edf5"/><text x="36" t-att-y="174 - value * 1.4" text-anchor="end" font-size="11" fill="#8095aa" t-esc="value"/></t><t t-foreach="trend" t-as="row" t-key="row.label"><rect t-att-x="60 + row_index * 620 / trend.length" t-att-y="170 - Math.min(100, row.rate || 0) * 1.4" t-att-width="Math.min(62, 460 / trend.length)" t-att-height="Math.min(100, row.rate || 0) * 1.4" rx="4" fill="#3184e8"/><text t-att-x="60 + row_index * 620 / trend.length + Math.min(62, 460 / trend.length) / 2" t-att-y="160 - Math.min(100, row.rate || 0) * 1.4" text-anchor="middle" font-size="11" fill="#1b528f" t-esc="rate(row.rate)"/><text t-att-x="60 + row_index * 620 / trend.length + Math.min(62, 460 / trend.length) / 2" y="198" text-anchor="middle" font-size="11" fill="#6c829a" t-esc="row.label"/></t></svg><div t-else="" class="empty">No recorded attendance for this period.</div></figure><div class="small-key"><span><i/>Attendance rate (%)</span></div>
          </section>
          <section class="card panel"><div class="panel-head"><div><h3 class="panel-title"><i class="fa fa-clipboard"/>Assigned Reviews</h3><div class="panel-sub">Open review requests delegated by the owner</div></div><button class="btn compact" t-on-click="() => this.state.modal = {type: 'reviews'}">View All</button></div><div class="follow-table"><article class="follow-row" t-foreach="d.reviews.slice(0,4)" t-as="review" t-key="review.id"><div class="follow-copy"><strong t-esc="review.name"/><span><t t-esc="review.assignee"/> · Due <t t-esc="review.due"/></span></div><div class="follow-actions"><span t-att-class="'chip ' + (review.status === 'Escalated' ? 'amber' : review.status === 'Closed' ? 'green' : 'blue')" t-esc="review.status"/><button class="btn compact" t-on-click="() => this.state.modal = {type: 'track', review}">Track</button></div></article><div t-if="!d.reviews.length" class="empty">No reviews assigned yet.<br/>Select Assign in Needs Attention.</div></div></section>
        </div>
        <div class="bottom-grid"><section class="card panel"><div class="panel-head"><div><h3 class="panel-title"><i class="fa fa-magic"/>AI Attendance Insights</h3><div class="panel-sub">Rule-based observations from saved records</div></div><span class="chip muted">Advisory only</span></div><div class="insight-strip"><article class="insight" t-foreach="insights" t-as="item" t-key="item[0]"><i class="fa fa-magic"/><div><strong t-esc="item[0]"/><p t-esc="item[1]"/></div></article></div></section><section class="card panel"><div class="panel-head"><div><h3 class="panel-title"><i class="fa fa-history"/>Recent Decisions &amp; Audit</h3><div class="panel-sub">Review assignment and escalation history</div></div><button class="btn compact" t-on-click="() => this.state.modal = {type: 'audit'}">View Audit Log</button></div><t t-call="ideastone_erp.OwnerAttendanceAudit"/></section></div>
        <p class="oao_footnote">Attendance is read-only here. Review assignments and audit events are saved in the college database.</p>
      </t>

    </main>
  </t>
  <t t-name="ideastone_erp.OwnerAttendancePopup">
      <Dialog t-if="detail" title="detail.title" close="props.close" contentClass="'oao_drawer'" size="'lg'">
        <p class="panel-sub">Read-only attendance · <t t-esc="state.month"/></p><div class="breadcrumb-actions"><button t-if="detail.type === 'staff' || detail.type === 'class'" class="btn compact" t-on-click="backDepartment">← Back to department</button><button t-if="detail.type === 'student'" class="btn compact" t-on-click="backClass">← Back to class</button></div>
        <t t-if="detail.type === 'department'"><div class="drawer-metrics"><div class="drawer-metric" t-foreach="staff ? [['Scheduled', detail.department.scheduled], ['Present', detail.department.present], ['Approved Leave', detail.department.leave]] : [['Enrolled', detail.department.students], ['Attendance', rate(detail.department.rate)], ['Below Limit', detail.department.below]]" t-as="metric" t-key="metric[0]"><div class="value" t-esc="metric[1]"/><div class="lab" t-esc="metric[0]"/></div></div><div class="drawer-card"><h3 t-esc="staff ? 'Staff Attendance Records' : 'Class Attendance Overview'"/><div class="tablewrap"><table class="data-table"><thead><tr><th t-esc="staff ? 'Staff Member' : 'Class'"/><th t-esc="staff ? 'Status' : 'Attendance'"/><th>Action</th></tr></thead><tbody><tr t-foreach="staff ? detail.department.staff : detail.department.classes" t-as="row" t-key="row.id"><td t-esc="row.name"/><td><span class="chip blue" t-esc="staff ? row.status : rate(row.rate)"/></td><td><button class="btn compact" t-on-click="() => this.staff ? this.staffDetail(row) : this.classDetail(row)" t-esc="staff ? 'View' : 'View Class'"/></td></tr></tbody></table></div></div><div class="info-note" t-if="!staff"><t t-esc="detail.department.pending"/> sessions await submission. Missing sessions are not treated as student absences.</div></t>
        <t t-if="detail.type === 'staff'"><div class="drawer-card"><h3>Monthly Punch History</h3><p>Current status: <span class="chip blue" t-esc="detail.person.status"/></p><div class="tablewrap"><table class="data-table"><thead><tr><th>Date</th><th>First Punch</th><th>Last Punch</th><th>Record</th></tr></thead><tbody><tr t-foreach="detail.person.history" t-as="row" t-key="row.date"><td t-esc="row.date"/><td t-esc="row.check_in"/><td t-esc="row.check_out"/><td t-esc="row.status"/></tr></tbody></table></div></div><div class="info-note">Punch corrections require HR authorization and the existing attendance workflow.</div></t>
        <t t-if="detail.type === 'class'"><div class="drawer-card"><h3>Students in Selected Class</h3><div class="tablewrap"><table class="data-table"><thead><tr><th>Student</th><th>Roll No.</th><th>Overall</th><th>Action</th></tr></thead><tbody><tr t-foreach="detail.class.students" t-as="person" t-key="person.id"><td t-esc="person.name"/><td t-esc="person.roll"/><td><span t-att-class="'chip ' + (person.below ? 'red' : 'green')" t-esc="rate(person.rate)"/></td><td><button class="btn compact" t-on-click="() => this.studentDetail(person)">Performance</button></td></tr></tbody></table></div></div></t>
        <t t-if="detail.type === 'student'"><div class="drawer-metrics"><div class="drawer-metric"><div class="value" t-esc="detail.person.held"/><div class="lab">Sessions Held</div></div><div class="drawer-metric"><div class="value" t-esc="detail.person.present"/><div class="lab">Sessions Attended</div></div><div class="drawer-metric"><div class="value" t-esc="rate(detail.person.rate)"/><div class="lab">Overall Attendance</div></div></div><div class="drawer-card"><h3>Subject-wise Attendance Performance</h3><div class="tablewrap"><table class="data-table"><thead><tr><th>Subject</th><th>Attended / Held</th><th>Rate</th></tr></thead><tbody><tr t-foreach="detail.person.subjects" t-as="row" t-key="row_index"><td t-esc="row.subject || 'Recorded subject'"/><td><t t-esc="row.present"/> / <t t-esc="row.sessions"/></td><td><span t-att-class="'chip ' + (row.shortage ? 'red' : 'green')" t-esc="rate(row.rate)"/></td></tr><tr t-if="!detail.person.subjects.length"><td colspan="3" class="empty">No submitted attendance in this month.</td></tr></tbody></table></div></div><div class="info-note" t-esc="detail.person.below ? 'Recorded attendance is below the college threshold. Coordinate a mentor/HOD review.' : 'Only submitted sessions and the existing college attendance policy are included.'"/><button class="btn" t-on-click="exportStudent"><i class="fa fa-download"/> Download Performance</button></t>
        <t t-set-slot="footer"><button class="btn" t-on-click="() => this.state.detail = null">Close</button></t>
      </Dialog>

      <Dialog t-if="state.modal" title="state.modal.type === 'assign' ? 'Assign Attendance Review' : state.modal.type === 'track' ? 'Review Tracking' : state.modal.type === 'reviews' ? 'Assigned Attendance Reviews' : 'Attendance Audit Log'" close="props.close" contentClass="'oao_dialog'" size="'md'">
        <t t-if="state.modal.type === 'assign'"><p><strong t-esc="state.modal.issue.title"/><br/><t t-esc="state.modal.issue.description"/></p><label class="formfield">Assign to<select t-model="state.assignee" aria-label="Assign to"><option value="">Select an authorized reviewer</option><option t-foreach="state.assignees" t-as="person" t-key="person.id" t-att-value="person.id.toString()" t-esc="person.name"/></select></label><p t-if="!state.assignees.length" class="info-note">No authorized reviewer is configured for this department. Assign an HR manager, HOD or class mentor using the existing role setup.</p><label class="formfield">Review due date<input type="date" t-att-min="d.today" t-model="state.due"/></label><label class="formfield">Review instruction<textarea maxlength="350" t-model="state.note"/></label><div class="info-note">Assigns a saved review task. It does not change attendance.</div></t>
        <t t-if="state.modal.type === 'track'"><h3 t-esc="state.modal.review.name"/><p><span class="chip blue" t-esc="state.modal.review.status"/></p><p>Assigned to <strong t-esc="state.modal.review.assignee"/> · Due <t t-esc="state.modal.review.due"/></p><div class="info-note" t-esc="state.modal.review.note"/><p class="panel-sub">HR/HOD verifies original records; corrections use the existing authorized workflow.</p><button class="btn" t-on-click="() => this.openReview(state.modal.review)">Open saved review</button></t>
        <t t-if="state.modal.type === 'reviews'"><div class="follow-table"><div class="follow-row" t-foreach="d.reviews" t-as="review" t-key="review.id"><div class="follow-copy"><strong t-esc="review.name"/><span><t t-esc="review.assignee"/> · <t t-esc="review.status"/></span></div><button class="btn compact" t-on-click="() => this.state.modal = {type: 'track', review}">Track</button></div><p t-if="!d.reviews.length">No saved reviews in this scope.</p></div></t>
        <t t-if="state.modal.type === 'audit'"><t t-call="ideastone_erp.OwnerAttendanceAudit"/></t>
        <t t-set-slot="footer"><button class="btn ghost" t-att-disabled="state.busy" t-on-click="() => this.state.modal = null">Close</button><button t-if="state.modal.type === 'assign'" class="btn blue" t-att-disabled="state.busy || !state.assignee || !state.due || !state.note.trim()" t-on-click="saveReview">Assign Review</button><button t-if="state.modal.type === 'track' &amp;&amp; state.modal.review.status === 'Assigned'" class="btn warn" t-att-disabled="state.busy" t-on-click="escalate">Escalate Review</button></t>
      </Dialog>
  </t>
  <t t-name="ideastone_erp.OwnerAttendanceAudit"><div class="auditlist"><div class="audit-event" t-foreach="d.audit.slice(0, state.modal &amp;&amp; state.modal.type === 'audit' ? 100 : 4)" t-as="row" t-key="row.id"><t t-esc="row.name"/><span><t t-esc="row.subject"/> · <t t-esc="row.actor"/> · <t t-esc="row.at"/></span></div><div t-if="!d.audit.length" class="empty">No attendance review decisions recorded yet.</div></div></t>
</templates>
