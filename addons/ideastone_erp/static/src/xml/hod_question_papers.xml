<templates xml:space="preserve">
<t t-name="ideastone_erp.HODQuestionPapers">
<div class="qp-hod"><section class="content">
 <div t-if="state.error" class="notice" role="alert"><t t-esc="state.error"/><button class="btn" t-on-click="load">Retry</button></div>
 <t t-if="state.data">
  <div class="crumb">Campus home / <b>My task list</b> / <b>Examinations</b> / <t t-esc="state.data.role === 'coe' ? 'Exam control receipts' : 'HOD review workspace'"/></div>
  <div class="heading"><div><h1>Examinations</h1><div class="subtitle" t-esc="state.data.role === 'coe' ? 'Exam Control workspace · received official question papers.' : 'Department HOD workspace · review, approve and forward question papers.'"/></div><div class="actions"><button class="btn" t-on-click="openHistory">◷ Approval history</button><button class="btn primary" t-on-click="load">↻ Refresh queue</button></div></div>
  <div class="stats">
   <div class="stat"><div class="sicon amber">◷</div><div><div class="num" t-esc="count('submitted')"/><div class="label">Papers awaiting review</div><div class="foot">Across your department</div></div></div>
   <div class="stat"><div class="sicon">▤</div><div><div class="num" t-esc="count('received')"/><div class="label">Sets received this cycle</div><div class="foot">Across assigned subjects</div></div></div>
   <div class="stat"><div class="sicon green">✓</div><div><div class="num" t-esc="count('approved')"/><div class="label">Approved by HOD</div><div class="foot">Ready to forward or forwarded</div></div></div>
   <div class="stat"><div class="sicon purple">➜</div><div><div class="num" t-esc="count('forwarded')"/><div class="label">Forwarded to COE</div><div class="foot">Delivered to exam-control inbox</div></div></div>
  </div>
  <div class="grid">
   <section class="panel"><div class="panelhead"><div><h2 t-esc="state.data.role === 'coe' ? 'Official question papers received' : 'Question papers requiring review'"/><p>Compare the submitted difficulty sets and select one paper for approval.</p></div><span class="pill review" t-esc="state.data.role === 'coe' ? 'OFFICIAL PAPERS' : 'HOD ACTION REQUIRED'"/></div>
    <div class="panelbody"><div class="filterrow"><select aria-label="Department filter" t-model="state.department"><option value="">All assigned departments</option><option t-foreach="state.data.departments" t-as="d" t-key="d.id" t-att-value="&apos;&apos;+d.id" t-esc="d.name"/></select><select aria-label="Examination type filter" t-model="state.examType"><option value="">All exam types</option><option t-foreach="types" t-as="type" t-key="type" t-esc="type"/></select><input aria-label="Search subject or staff" placeholder="Search subject or staff…" t-model="state.search"/></div>
     <div class="tablewrap"><table><thead><tr><th>SUBJECT / STAFF</th><th>EXAM DATE</th><th>SETS RECEIVED</th><th>LAST UPDATED</th><th>STATUS</th><th>ACTION</th></tr></thead><tbody><tr t-foreach="reviewRows" t-as="r" t-key="r.id"><td><div class="strong" t-esc="r.subject"/><div class="sub"><t t-esc="r.paper_code"/> · <t t-esc="r.staff"/></div><div class="sub" t-esc="cohort(r)"/></td><td t-esc="date(r.exam_date)"/><td><t t-esc="r.sets.length"/> PDFs<div class="sub" t-esc="r.sets.map(s => s.label).join(' · ')"/></td><td t-esc="date(r.updated,true)"/><td><span t-att-class="'pill '+tone(r.state)" t-esc="r.state === 'submitted' ? 'Awaiting review' : r.status"/></td><td><button class="smallbtn" t-on-click="() => this.view(r)" t-esc="state.data.role === 'coe' ? 'View official paper' : 'Review sets'"/></td></tr><tr t-if="!reviewRows.length"><td colspan="6">No question papers match this review queue. Approved papers and previous decisions are in Approval history.</td></tr></tbody></table></div>
    </div><div class="queuefoot"><span>Showing <t t-esc="reviewRows.length"/> matching submissions</span><span>Saved records · assigned department only</span></div>
   </section>
   <aside>
    <section class="panel"><div class="panelhead"><div><h2>HOD review checklist</h2><p>Before approving a set</p></div></div><div class="panelbody"><div class="steps">
     <div class="step"><div class="stepnum">1</div><div><strong>Confirm syllabus and blueprint</strong><p>Verify unit coverage, learning outcomes, marks distribution and exam duration.</p></div></div>
     <div class="step"><div class="stepnum">2</div><div><strong>Compare the submitted sets</strong><p>Review Balanced, Moderate and Advanced versions; check fairness and academic standard.</p></div></div>
     <div class="step"><div class="stepnum">3</div><div><strong>Approve one official paper</strong><p>Select a single version. The other versions remain restricted alternatives.</p></div></div>
     <div class="step"><div class="stepnum">4</div><div><strong>Forward to COE / Exam Control</strong><p>Record approval and transmit the selected PDF with the approval timestamp.</p></div></div>
    </div><div class="notice"><span>ⓘ</span><span><b>Confidentiality:</b> Approval actions are audited. Every version is restricted and the final approval records its reviewer.</span></div></div></section>
    <section class="panel" style="margin-top:16px"><div class="panelhead"><div><h2>Recent activity</h2><p>Department question-paper workflow</p></div></div><div class="panelbody"><div class="activity"><div class="event" t-foreach="events.slice(0,3)" t-as="e" t-key="e.key"><span class="dot"/><div><strong><t t-esc="e.action"/> · <t t-esc="e.subject"/></strong><p><t t-esc="e.by"/> · <t t-esc="date(e.at,true)"/></p></div></div><p t-if="!events.length">No recorded activity yet.</p></div></div></section>
   </aside>
  </div>
  <section class="panel" style="margin-top:18px"><div class="panelhead"><div><h2>Department question-paper status</h2><p>Quick overview of submissions, reviews and approval readiness.</p></div><button class="btn" t-on-click="exportCSV">Export status CSV</button></div><div class="panelbody"><div class="deptcards"><article class="dept" t-foreach="departmentCards" t-as="d" t-key="d.id"><div class="depthead"><h3 t-esc="d.name"/><span t-att-class="'pill '+(d.pending ? 'review' : 'approved')"><t t-esc="d.pending ? d.pending+' pending' : 'Up to date'"/></span></div><p><t t-esc="d.code"/> · <t t-esc="d.total"/> submissions in this cycle</p><div class="progress"><span t-att-style="'width:'+d.percent+'%'"/></div><div class="deptfoot"><span><t t-esc="d.reviewed"/> / <t t-esc="d.total"/> reviewed</span><button class="rowlink" t-on-click="() => this.filterDepartment(d.id)">View queue →</button></div></article></div></div></section>
 </t>
</section>
 <div t-if="state.modal || state.history" class="modalback" t-on-keydown="modalKey"><section t-ref="paperDialog" class="modal" role="dialog" aria-modal="true" aria-label="Question-paper review">
  <div class="modalhead"><div><h3 t-esc="state.history ? 'Question-paper approval history' : 'Review sets · '+state.modal.subject"/><div class="subtitle" style="font-size:12px" t-esc="state.history ? 'Recorded decisions, revisions and forwarding receipts.' : 'Compare PDF versions and select one official set.'"/></div><button class="btn" t-on-click="closeModal" aria-label="Close review">✕</button></div>
  <div class="modalbody" t-if="state.history"><div class="tablewrap"><table><thead><tr><th>SUBJECT / STAFF</th><th>STATUS</th><th>ACTION</th></tr></thead><tbody><tr t-foreach="state.data.rows" t-as="r" t-key="r.id"><td><div class="strong" t-esc="r.subject"/><div class="sub" t-esc="r.staff"/><div class="sub"><t t-esc="r.paper_code"/> · <t t-esc="cohort(r)"/></div></td><td><span t-att-class="'pill '+tone(r.state)" t-esc="r.status"/></td><td><button class="smallbtn" t-on-click="() => this.view(r)" t-esc="r.state === 'approved' ? 'Forward to COE' : 'View history'"/></td></tr></tbody></table></div></div>
  <t t-elif="state.modal"><div class="modalbody">
   <div class="notice" style="margin-top:0;margin-bottom:15px"><span>✦</span><span><b>Paper readiness summary:</b> PDF format, size, encryption and page count were validated. Syllabus coverage, marks, difficulty and duplicate questions require your academic review. AI analysis is not configured.</span></div>
   <p><b><t t-esc="state.modal.exam_type"/></b> · <t t-esc="date(state.modal.exam_date)"/> · <t t-esc="state.modal.duration"/></p>
   <p class="sub"><t t-esc="state.modal.paper_code"/> · <t t-esc="cohort(state.modal)"/></p><div class="set-choices"><label class="set-choice" t-foreach="state.modal.sets" t-as="s" t-key="s.id"><input type="radio" name="officialSet" t-att-value="&apos;&apos;+s.id" t-model="state.selectedSet" t-att-disabled="state.modal.state !== 'submitted' || state.data.role === 'coe'"/><span><b><t t-esc="s.label"/> set</b><div class="sub"><t t-esc="s.filename"/> · <t t-esc="s.pages"/> pages</div><button type="button" class="rowlink" t-on-click.prevent="() => this.download(s)">Download PDF ↓</button></span></label></div>
   <div style="margin-top:16px"><label for="hod-review-note">Review notes / return reason</label><textarea t-if="state.modal.state === 'submitted' || state.modal.state === 'approved'" id="hod-review-note" t-model="state.note" maxlength="4000" placeholder="Optional approval note or required corrections…"/><p t-else="" id="hod-review-note" t-esc="state.modal.review_note || 'No review note recorded.'"/></div>
   <div class="notice" t-if="state.modal.notes"><span>ⓘ</span><span><b>Faculty note:</b> <t t-esc="state.modal.notes"/></span></div>
   <div class="activity" style="margin-top:18px"><div class="event" t-foreach="state.modal.history" t-as="e" t-key="e_index"><span class="dot"/><div><strong t-esc="e.action"/><p><t t-esc="e.by"/> · <t t-esc="date(e.at,true)"/></p><p t-if="e.note" t-esc="e.note"/></div></div></div>
  </div><div class="modalfoot"><t t-if="state.data.role === 'hod' &amp;&amp; state.modal.state === 'submitted'"><button class="btn danger" t-att-disabled="state.busy" t-on-click="() => this.decide('return')">Return for revision</button><button class="btn green" t-att-disabled="state.busy" t-on-click="() => this.decide('approve')">Approve selected set</button></t><button t-elif="state.data.role === 'hod' &amp;&amp; state.modal.state === 'approved'" class="btn primary" t-att-disabled="state.busy" t-on-click="() => this.decide('forward')">Forward to COE →</button><span t-elif="state.modal.state === 'forwarded'" class="pill forwarded">Official selected paper delivered to COE</span><button t-else="" class="btn" t-on-click="closeModal">Close</button></div></t>
 </section></div>
</div>
</t>
</templates>
