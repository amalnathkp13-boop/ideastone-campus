<templates xml:space="preserve">
<t t-name="ideastone_erp.COEWorkspace">
<main class="coe-workspace">
 <div t-if="state.error" class="coe-alert" role="alert"><t t-esc="state.error"/><button class="coe-btn" t-on-click="load">Retry</button></div>
 <t t-if="state.data">
 <div class="coe-crumb">Campus home / COE administration / <b t-esc="heading"/></div>
 <header class="coe-heading"><div><div class="coe-eyebrow">CONTROLLER OF EXAMINATIONS</div><h1 t-esc="heading"/><p t-esc="subtitle"/></div><div class="coe-actions"><button class="coe-btn" t-att-disabled="state.loading" t-on-click="load"><i class="fa fa-refresh"/> Refresh</button><button t-if="view === 'overview'" class="coe-btn primary" t-on-click="() => this.navigate('papers')">Open question papers <i class="fa fa-arrow-right"/></button><button t-elif="isExamView" class="coe-btn primary" t-on-click="newExam">＋ New examination</button><button t-elif="view === 'cases'" class="coe-btn primary" t-on-click="newCase">＋ Register case</button></div></header>
 <section class="coe-filters" aria-label="COE examination filters">
  <label>Academic year<select aria-label="Academic year" t-model="state.year" t-on-change="load"><option t-foreach="state.data.years" t-as="y" t-key="y.id" t-att-value="&apos;&apos;+y.id" t-esc="y.name"/></select></label>
  <label>Department<select aria-label="Department" t-model="state.department" t-on-change="load"><option value="">All departments</option><option t-foreach="state.data.departments" t-as="d" t-key="d.id" t-att-value="&apos;&apos;+d.id"><t t-esc="d.name"/> · <t t-esc="d.code"/></option></select></label>
  <label>Year of study<select aria-label="Year of study" t-model="state.study" t-on-change="load"><option value="">All years · I to IV</option><option value="1">Year I</option><option value="2">Year II</option><option value="3">Year III</option><option value="4">Year IV</option></select></label>
  <div class="coe-scope"><span class="coe-live"/> College-wide scope<small>Filters apply across this workspace</small></div>
 </section>
 <section class="coe-stats" aria-label="COE summary">
  <button class="coe-stat" t-on-click="() => this.navigate('records')"><i class="fa fa-calendar"/><span><b t-esc="state.data.counts.exams"/>Examination records<small t-esc="state.data.year"/></span></button>
  <button class="coe-stat" t-on-click="() => this.navigate('upcoming')"><i class="fa fa-clock-o amber"/><span><b t-esc="state.data.counts.upcoming"/>Upcoming examinations<small>Scheduled after the current time</small></span></button>
  <button class="coe-stat" t-on-click="() => this.navigate('papers')"><i class="fa fa-file-text-o green"/><span><b t-esc="state.data.counts.papers"/>HOD-approved papers<small>Selected official versions only</small></span></button>
  <button class="coe-stat" t-on-click="() => this.navigate('cases')"><i class="fa fa-flag-o purple"/><span><b t-esc="state.data.counts.cases"/>Open examination cases<small>Revaluation, corrections &amp; incidents</small></span></button>
 </section>
 <t t-if="view === 'overview'">
  <div class="coe-overview-grid"><section class="coe-panel"><div class="coe-panel-head"><div><h2>Examination cell action queue</h2><p>Work that needs your attention</p></div><span class="coe-badge amber">COE ACTION</span></div><div class="coe-panel-body"><button class="coe-task" t-foreach="tasks" t-as="task" t-key="task.view" t-on-click="() => this.navigate(task.view)"><i t-att-class="'fa fa-'+task.icon"/><span t-esc="task.label"/><b t-esc="task.count"/><i class="fa fa-angle-right"/></button><div class="coe-note">Approved sets appear as soon as the HOD selects them. Acknowledge receipt after the HOD forwards the official paper.</div></div></section>
  <section class="coe-panel"><div class="coe-panel-head"><div><h2>Upcoming examinations</h2><p>Next dates across the selected scope</p></div><button class="coe-link" t-on-click="() => this.navigate('timetable')">View timetable →</button></div><div class="coe-panel-body"><button class="coe-next" t-foreach="nextExams" t-as="e" t-key="e.id" t-on-click="() => this.open({kind:'exam',id:e.id,raw:e})"><span class="coe-date" t-esc="date(e.start,true)"/><span><b t-esc="e.subject"/><small><t t-esc="e.department"/> · Year <t t-esc="e.study_year"/></small></span><span t-att-class="'coe-badge '+(e.hall &amp;&amp; e.invigilator?'green':'amber')" t-esc="e.hall &amp;&amp; e.invigilator ? 'Allocated' : 'Needs allocation'"/></button><p t-if="!nextExams.length" class="coe-empty">No upcoming examinations in this scope.</p></div></section></div>
  <section class="coe-panel"><div class="coe-panel-head"><div><h2>Department &amp; year coverage</h2><p>Examination records across Years I–IV in the selected academic year</p></div><button class="coe-link" t-on-click="() => this.navigate('departments')">Open report →</button></div><div class="coe-table-wrap"><table><thead><tr><th>DEPARTMENT</th><th>YEAR I</th><th>YEAR II</th><th>YEAR III</th><th>YEAR IV</th><th>UPCOMING</th><th>APPROVED PAPERS</th></tr></thead><tbody><tr t-foreach="state.data.summaries" t-as="d" t-key="d.id"><td><b t-esc="d.name"/><small t-esc="d.code"/></td><td t-foreach="d.years" t-as="value" t-key="value_index"><span class="coe-year-cell" t-esc="value"/></td><td t-esc="d.upcoming"/><td t-esc="d.papers"/></tr></tbody></table></div></section>
  <section class="coe-panel"><div class="coe-panel-head"><div><h2>COE workflow</h2><p>The first working structure for examination-cell administration</p></div><span class="coe-badge">INITIAL WORKSPACE</span></div><div class="coe-workflow"><div><b>01 · Plan</b><small>Academic year, department, Years I–IV and examination session</small></div><div><b>02 · Review</b><small>Faculty uploads sets; HOD selects and approves one version</small></div><div><b>03 · Receive &amp; dispatch</b><small>COE receipt, hall allocation and a recorded dispatch reference</small></div><div><b>04 · Evaluate</b><small>Marks entry, checking, approval and existing result publication</small></div><div><b>05 · Retain</b><small>Revaluation, corrections, reports and traceable history</small></div></div></section>
 </t>
 <section t-else="" class="coe-panel">
  <div class="coe-panel-head"><div><h2 t-esc="heading"/><p t-if="isPaperView">Unselected question sets stay confidential. Papers without an examination link are labelled “Year not linked”.</p><p t-elif="view === 'results' || view === 'evaluation'">Counts use the existing marks roster. Result publication follows the ERP’s approval workflow.</p><p t-elif="view === 'routes'">Configured department reviewers; changes require college-administrator access.</p><p t-else="">Search, inspect and export the current records.</p></div><div class="coe-actions"><input aria-label="Search COE records" type="search" placeholder="Search this register…" t-model="state.search"/><button class="coe-btn" t-on-click="exportCSV"><i class="fa fa-download"/> Export CSV</button></div></div>
  <div t-if="view === 'attendance'" class="coe-inline-note">Candidate counts are recorded by COE. Use the case register for examination incidents. <button class="coe-link" t-on-click="newCase">Register incident →</button></div>
  <div class="coe-table-wrap"><table><thead><tr><th t-foreach="table.columns" t-as="column" t-key="column.key" t-esc="column.label"/><th>ACTION</th></tr></thead><tbody><tr t-foreach="table.rows" t-as="row" t-key="row.id"><td t-foreach="table.columns" t-as="column" t-key="column.key"><span t-if="column.key === 'status'" class="coe-badge" t-esc="row[column.key]"/><t t-else="" t-esc="row[column.key] ?? '—'"/></td><td><button t-if="actionable(row)" class="coe-link" t-on-click="() => this.open(row)" t-esc="row.kind === 'paper' ? 'Open official paper' : row.kind === 'exam' ? 'View / manage' : 'Open record'"/><span t-else="">—</span></td></tr><tr t-if="!table.rows.length"><td t-att-colspan="table.columns.length+1" class="coe-empty">No records match this view. Change the filters or refresh after records are added.</td></tr></tbody></table></div>
  <div class="coe-register-foot"><span><t t-esc="table.rows.length"/> matching records</span><span>Saved records · active college only</span></div>
 </section>
 <footer class="coe-footer">VCET Campus ERP · Controller of Examinations · Confidential examination records</footer>
 </t><p t-elif="state.loading" role="status">Loading the COE workspace…</p>
 <div t-if="state.modal" class="coe-modal-back" t-on-keydown="modalKey"><section class="coe-modal" t-ref="coeDialog" role="dialog" aria-modal="true" aria-label="COE record">
  <header><div><h2 t-esc="state.modal.kind === 'paper' ? 'Official question paper' : state.modal.kind === 'exam' ? 'Examination operations' : 'Examination case'"/><p t-esc="state.modal.raw?.subject || state.modal.raw?.name || 'Create a new examination-cell case'"/></div><button class="coe-btn" t-on-click="close" aria-label="Close COE record">✕</button></header>
  <div t-if="state.modal.kind === 'paper'" class="coe-modal-body">
   <p><b t-esc="state.modal.raw.paper_code"/> · <t t-esc="state.modal.raw.department"/> · <t t-esc="date(state.modal.raw.exam_date)"/></p>
   <p>Author: <t t-esc="state.modal.raw.staff"/> · Approved by: <t t-esc="state.modal.raw.hod"/> <t t-if="state.modal.raw.approved_at"> · <t t-esc="date(state.modal.raw.approved_at,true)"/></t></p>
   <div class="coe-official" t-foreach="state.modal.raw.sets" t-as="set" t-key="set.id"><i class="fa fa-file-pdf-o"/><div><b><t t-esc="set.label"/> · HOD-selected official set</b><small><t t-esc="set.filename"/> · <t t-esc="set.pages"/> pages</small></div><button class="coe-btn" t-on-click="() => this.download(set)">Download PDF</button></div>
   <div class="coe-note" t-if="state.modal.raw.state === 'approved'">Approved by the HOD. The HOD must forward this paper before COE can acknowledge receipt.</div>
   <div class="coe-note" t-if="state.modal.raw.received_at">Receipt recorded: <t t-esc="date(state.modal.raw.received_at,true)"/></div>
   <div class="coe-note" t-if="state.modal.raw.dispatched_at">Dispatched: <t t-esc="date(state.modal.raw.dispatched_at,true)"/> · <t t-esc="state.modal.raw.dispatch_note"/></div>
   <div class="coe-form-grid" t-if="state.modal.raw.received_at &amp;&amp; !state.modal.raw.dispatched_at"><label>Link upcoming examination<select aria-label="Link upcoming examination" t-model="state.form.exam_id"><option value="">Select matching subject / examination</option><option t-foreach="dispatchExams" t-as="e" t-key="e.id" t-att-value="&apos;&apos;+e.id"><t t-esc="e.code"/> · Year <t t-esc="e.study_year"/> · <t t-esc="date(e.start,true)"/></option></select></label><label>Dispatch reference<input aria-label="Dispatch reference" t-model="state.form.note" maxlength="2000" placeholder="Sealed packet / handover reference"/></label></div>
   <p t-if="state.modal.raw.received_at &amp;&amp; !state.modal.raw.dispatched_at &amp;&amp; !dispatchExams.length" class="coe-note">No matching examination is scheduled on the approved paper’s date. Create or update its subject, date and department in Examination records before dispatch.</p>
   <h3>Approval &amp; custody history</h3><div class="coe-history" t-foreach="state.modal.raw.history" t-as="event" t-key="event_index"><b t-esc="event.action"/><small><t t-esc="event.by"/> · <t t-esc="date(event.at,true)"/></small><p t-if="event.note" t-esc="event.note"/></div>
  </div>
  <form t-else="" t-ref="coeForm" class="coe-modal-body" t-on-submit.prevent="save">
   <div t-if="state.modal.kind === 'exam'" class="coe-form-grid">
    <label>Year of study<select aria-label="Record year of study" t-model="state.form.coe_study_year"><option value="1">Year I</option><option value="2">Year II</option><option value="3">Year III</option><option value="4">Year IV</option></select></label>
    <label>Hall allocation<input aria-label="Hall allocation" t-model="state.form.coe_hall" maxlength="2000" placeholder="e.g. Main block · A201"/></label>
    <label>Invigilator / superintendent<input aria-label="Invigilator" t-model="state.form.coe_invigilator" maxlength="2000"/></label>
    <label>Expected candidates<input aria-label="Expected candidates" type="number" min="0" max="10000" t-model="state.form.coe_expected" required="required"/></label>
    <label>Present candidates<input aria-label="Present candidates" type="number" min="0" max="10000" t-model="state.form.coe_present" required="required"/></label>
    <label>Evaluation deadline<input aria-label="Evaluation deadline" type="date" t-model="state.form.coe_evaluation_due"/></label>
    <label class="wide">COE notes<textarea aria-label="COE notes" t-model="state.form.note" maxlength="2000"/></label>
   </div>
   <div t-else="" class="coe-form-grid">
    <label class="wide">Case title<input aria-label="Case title" t-model="state.form.name" required="required" maxlength="200"/></label>
    <label class="wide">Examination<select aria-label="Case examination" t-model="state.form.exam_id" required="required"><option value="">Choose an examination</option><option t-foreach="exams" t-as="e" t-key="e.id" t-att-value="&apos;&apos;+e.id"><t t-esc="e.code"/> · <t t-esc="e.subject"/> · Year <t t-esc="e.study_year"/></option></select></label>
    <label>Case type<select aria-label="Case type" t-model="state.form.kind"><option value="revaluation">Revaluation</option><option value="correction">Result correction</option><option value="incident">Examination incident</option></select></label>
    <label>Reference<input aria-label="Case reference" t-model="state.form.reference" maxlength="200"/></label>
    <label>Status<select aria-label="Case status" t-model="state.form.state"><option value="open">Open</option><option value="review">Under review</option><option value="resolved">Resolved</option></select></label>
    <label class="wide">Case details / resolution<textarea aria-label="Case details" t-model="state.form.note" required="required" maxlength="4000"/></label>
   </div>
  </form>
  <footer><button class="coe-btn" t-on-click="close">Close</button><t t-if="state.modal.kind === 'paper'"><button t-if="state.modal.raw.state === 'forwarded' &amp;&amp; !state.modal.raw.received_at" class="coe-btn primary" t-att-disabled="state.busy" t-on-click="() => this.paperAction('receive')">Acknowledge receipt</button><button t-if="state.modal.raw.received_at &amp;&amp; !state.modal.raw.dispatched_at" class="coe-btn primary" t-att-disabled="state.busy || !state.form.exam_id || !state.form.note.trim()" t-on-click="() => this.paperAction('dispatch')">Record dispatch</button></t><t t-else=""><button t-if="state.modal.kind === 'exam'" class="coe-btn" t-on-click="marks">Open marks workflow</button><button class="coe-btn primary" t-att-disabled="state.busy" t-on-click="save">Save record</button></t></footer>
 </section></div>
</main>
</t>
</templates>
