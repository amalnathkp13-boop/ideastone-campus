<templates xml:space="preserve">
  <t t-name="ideastone_erp.StaffODManagement">
    <main class="campus_staff_od_management" t-att-class="{'campus_faculty_od_reference': !state.data || state.data.role !== 'hod'}">
      <div t-if="state.error" class="mentor_error" role="alert"><span t-esc="state.error"/><button type="button" t-on-click="load">Retry</button></div>
      <div t-if="state.loading" class="mentor_loading" role="status">Loading assigned OD requests…</div>
      <t t-elif="state.data">
        <t t-if="state.data.role === 'hod'"><t t-call="ideastone_erp.HodODManagement"/></t>
        <div t-else="" class="od-content">
          <div class="od-breadcrumb">Campus home / My task list / OD Management</div>
          <header class="od-page-heading">
            <div><h1>On Duty (OD) Management</h1><p>Review and manage student OD requests for your assigned mentorship class.</p></div>
            <button type="button" class="od-btn" t-on-click="load" t-att-disabled="state.saving"><i class="fa fa-refresh" aria-hidden="true"/> Refresh</button>
          </header>
          <section class="od-hero mentor_hero"><div><h2>Student On Duty Requests</h2><p>Review applications, track approvals and monitor OD activity for the current semester.</p></div></section>
          <section class="od-stats" aria-label="Mentorship OD summary">
            <article class="od-stat"><span class="od-stat-icon"><i class="fa fa-users" aria-hidden="true"/></span><div><div class="od-stat-label">My Mentorship Class</div><strong class="od-class-value" t-att-title="state.data.class_label + ' · ' + state.data.semester" t-esc="state.data.class_label"/><p>Assigned mentorship class</p></div></article>
            <article class="od-stat"><span class="od-stat-icon"><i class="fa fa-user" aria-hidden="true"/></span><div><div class="od-stat-label">Total Students</div><strong class="stat-value" t-esc="state.data.total_students"/><p>Under mentorship</p></div></article>
            <article class="od-stat"><span class="od-stat-icon"><i class="fa fa-clock-o" aria-hidden="true"/></span><div><div class="od-stat-label">Pending OD Requests</div><strong class="stat-value" t-esc="state.data.pending"/><p>Awaiting your review</p></div></article>
            <article class="od-stat"><span class="od-stat-icon"><i class="fa fa-check-circle" aria-hidden="true"/></span><div><div class="od-stat-label">Approved ODs</div><strong class="stat-value" t-esc="state.data.approved"/><p>This semester</p></div></article>
            <article class="od-stat"><span class="od-stat-icon"><i class="fa fa-calendar-check-o" aria-hidden="true"/></span><div><div class="od-stat-label">Students on OD</div><strong class="stat-value" t-esc="state.data.students_on_od"/><p>Today</p></div></article>
          </section>
          <div class="od-layout">
            <div class="od-left-stack">
              <section class="od-panel" aria-labelledby="mentor_requests_heading">
                <div class="od-panel-head"><h2 id="mentor_requests_heading"><i class="fa fa-file-text-o" aria-hidden="true"/> Requests Awaiting Mentor Review</h2></div>
                <div class="od-filters">
                  <label class="od-search"><i class="fa fa-search" aria-hidden="true"/><input type="search" aria-label="Search OD requests" placeholder="Search by Request ID, Student Name or Purpose..." t-att-value="state.search" t-on-input="changeSearch"/></label>
                  <select aria-label="Mentorship class" t-on-change="changeClass"><t t-foreach="state.data.classes" t-as="classItem" t-key="classItem.key"><option t-att-value="classItem.key" t-att-selected="classItem.key === state.classKey" t-esc="classItem.label + ' · ' + classItem.semester"/></t><option t-if="!state.data.classes.length" value="">No assigned class</option></select>
                </div>
                <div class="od-table-wrap" tabindex="0" role="region" aria-label="OD request table, scroll horizontally on small screens"><table><thead><tr><th scope="col">#</th><th scope="col">Request ID</th><th scope="col">Student Name</th><th scope="col">Date(s)</th><th scope="col">Purpose</th><th scope="col">Status</th><th scope="col">Action</th></tr></thead><tbody>
                  <tr t-foreach="pageRows" t-as="requestRow" t-key="requestRow.id"><td t-esc="(state.page - 1) * 5 + requestRow_index + 1"/><td t-esc="requestRow.reference"/><td t-esc="requestRow.student"/><td><t t-esc="formatDate(requestRow.date_from)"/><t t-if="requestRow.date_to !== requestRow.date_from"> – <t t-esc="formatDate(requestRow.date_to)"/></t></td><td t-esc="requestRow.name"/><td><span t-att-class="'status ' + requestRow.state + (requestRow.can_review ? ' pending' : '')" t-esc="mentorStatus(requestRow)"/></td><td><button type="button" class="od-btn od-review" t-att-class="{'primary': requestRow.can_review}" t-att-aria-label="(requestRow.can_review ? 'Review ' : 'View ') + requestRow.reference" t-on-click="() => this.openMentorRequest(requestRow)"><t t-esc="requestRow.can_review ? 'Review' : 'View'"/></button></td></tr>
                  <tr t-if="!pageRows.length"><td colspan="7" class="od-empty">No OD requests match this class and search.</td></tr>
                </tbody></table></div>
                <div class="od-table-foot"><span><t t-esc="filteredRows.length"/> request(s)</span><nav class="od-pagination" aria-label="Request pages"><button type="button" aria-label="First page" t-att-disabled="state.page === 1" t-on-click="() => this.setPage(1)">«</button><button type="button" aria-label="Previous page" t-att-disabled="state.page === 1" t-on-click="() => this.setPage(state.page - 1)">‹</button><span aria-current="page" t-esc="state.page"/><button type="button" aria-label="Next page" t-att-disabled="state.page === pageCount" t-on-click="() => this.setPage(state.page + 1)">›</button><button type="button" aria-label="Last page" t-att-disabled="state.page === pageCount" t-on-click="() => this.setPage(pageCount)">»</button></nav></div>
              </section>
              <section class="od-panel od-note"><div class="od-panel-head"><div><h2><i class="fa fa-pencil-square-o" aria-hidden="true"/> Quick Comment / Review Note</h2><p>Optional when forwarding</p></div></div><label for="mentor_quick_note" class="od-note-context"><t t-if="selectedRow">For <t t-esc="selectedRow.reference"/> · <t t-esc="selectedRow.student"/></t><t t-else="">Select a request to add a review note.</t></label><textarea id="mentor_quick_note" t-model="state.note" t-att-disabled="!selectedRow || !selectedRow.can_review || state.saving" maxlength="250" rows="2" placeholder="Add a comment or review note (e.g., reason for return, clarification needed, etc.)"/><div class="od-note-count"><t t-esc="state.note.length"/>/250</div></section>
              <section class="od-panel od-workflow"><h2><i class="fa fa-sitemap" aria-hidden="true"/> Approval Workflow</h2><ol><li t-att-class="{'done': workflowStep &gt; 1, 'current': workflowStep === 1}"><span>1</span><strong>Student Initiated</strong><small>OD request submitted</small></li><li t-att-class="{'done': workflowStep &gt; 2, 'current': workflowStep === 2}"><span>2</span><strong>Mentor Approval</strong><small>Review by class advisor</small></li><li t-att-class="{'done': workflowStep &gt; 3, 'current': workflowStep === 3}"><span>3</span><strong>HOD Approval</strong><small>Review by HOD</small></li><li t-att-class="{'done': workflowStep &gt; 4, 'current': workflowStep === 4}"><span>4</span><strong>Withheld / Proof Pending</strong><small>Only for Special OD</small></li><li t-att-class="{'done': workflowStep === 5, 'current': workflowStep === 5}"><span>5</span><strong>Completed</strong><small>OD approved and recorded</small></li></ol><p class="od-info"><i class="fa fa-info-circle" aria-hidden="true"/> General OD requests complete after HOD approval. Special OD requests may require proof verification.</p></section>
            </div>
            <div class="od-right-stack">
              <section class="od-panel od-ai-panel"><div class="od-ai-banner"><span class="od-ai-badge">✦ AI MENTOR INSIGHTS</span><h2>Suggested review priorities</h2><p>Rule-based suggestions from saved OD records for your mentorship class. Use these signals to support your review.</p></div><div class="od-ai-list"><article t-foreach="insights" t-as="insight" t-key="insight.key" class="od-ai-item"><div class="od-ai-item-title"><span t-att-class="'od-ai-dot ' + insight.tone"/><strong t-esc="insight.title"/><span class="od-ai-value" t-esc="insight.value"/></div><p t-esc="insight.note"/></article></div></section>
              <section class="od-panel od-analytics"><div class="od-panel-head"><h2><i class="fa fa-bar-chart" aria-hidden="true"/> Class OD Activity Analytics</h2><div class="od-chart-controls"><button type="button" t-att-class="{'active': state.period === 'week'}" t-att-aria-pressed="state.period === 'week'" t-on-click="() => this.state.period = 'week'">Week</button><button type="button" t-att-class="{'active': state.period === 'month'}" t-att-aria-pressed="state.period === 'month'" t-on-click="() => this.state.period = 'month'">Month</button><button type="button" title="Download activity CSV" aria-label="Download activity CSV" t-on-click="exportActivity"><i class="fa fa-download" aria-hidden="true"/></button></div></div><div class="od-chart" t-att-class="{'od-chart-empty': !hasActivity}"><t t-if="hasActivity"><div t-foreach="chartRows" t-as="chartPoint" t-key="chartPoint_index" class="od-chart-column" t-att-aria-label="chartPoint.label + ' ' + chartPoint.sub + ': ' + chartPoint.count + ' requests'"><span class="od-chart-value" t-esc="chartPoint.count"/><div class="od-chart-bar-area"><span class="od-chart-bar" t-att-style="'height:' + chartHeight(chartPoint.count)"/></div><strong t-esc="chartPoint.label"/><small t-esc="chartPoint.sub"/></div></t><p t-else="">No OD requests submitted during this period.</p></div><p class="od-chart-caption">Requests submitted by your mentorship class · <t t-esc="state.period === 'week' ? 'This week' : 'Last four weeks'"/></p></section>
              <section class="od-panel od-pending"><div class="od-panel-head"><h2><i class="fa fa-calendar" aria-hidden="true"/> Pending Actions &amp; Dates</h2><button type="button" class="od-text-btn" t-if="pendingRows.length" t-on-click="() => this.state.pendingAll = !this.state.pendingAll" t-att-aria-expanded="state.pendingAll"><t t-esc="state.pendingAll ? 'Show Less' : 'View All'"/></button></div><div><article t-foreach="pendingActions" t-as="pendingItem" t-key="pendingItem.id" class="od-pending-row"><span class="od-pending-date"><t t-esc="datePart(pendingItem.date_from, 'day')"/><small t-esc="datePart(pendingItem.date_from, 'month')"/></span><div class="od-pending-copy"><button type="button" class="od-text-btn" t-on-click="() => this.openMentorRequest(pendingItem)"><t t-esc="pendingItem.reference"/> · <t t-esc="pendingItem.student"/></button><span><t t-esc="pendingItem.name"/> · Awaiting mentor review</span></div><span t-att-class="'status ' + dueStatus(pendingItem).tone" t-esc="dueStatus(pendingItem).label"/></article><p t-if="!pendingRows.length" class="od-empty">No pending actions for this class.</p></div><p class="od-pending-footer"><t t-esc="pendingRows.length"/> request(s) require mentor review.<t t-if="pendingRows.length"> Next event: <t t-esc="formatDate(pendingRows[0].date_from)"/>.</t></p></section>
            </div>
          </div>
          <footer class="od-footer">VCET Campus ERP · Faculty workspace · OD Management</footer>
        </div>
      </t>

    </main>
  </t>
  <t t-name="ideastone_erp.MentorODReview">
    <t t-set="workspace" t-value="props.workspace"/>
      <Dialog title="workspace.selectedRow.reference + ' · ' + workspace.selectedRow.student" size="'lg'">
        <div class="od-review-details"><h3 t-esc="workspace.selectedRow.name"/><p t-esc="workspace.selectedRow.purpose"/><dl><div><dt>Venue</dt><dd t-esc="workspace.selectedRow.venue"/></div><div><dt>Event dates</dt><dd><t t-esc="workspace.formatDate(workspace.selectedRow.date_from)"/> – <t t-esc="workspace.formatDate(workspace.selectedRow.date_to)"/></dd></div><div><dt>Sessions</dt><dd><t t-esc="workspace.selectedRow.session_from === 'forenoon' ? 'Forenoon' : 'Afternoon'"/> – <t t-esc="workspace.selectedRow.session_to === 'forenoon' ? 'Forenoon' : 'Afternoon'"/></dd></div><div><dt>Status</dt><dd t-esc="workspace.mentorStatus(workspace.selectedRow)"/></div></dl><p t-if="workspace.selectedRow.mentor_note"><strong>Saved mentor note:</strong> <t t-esc="workspace.selectedRow.mentor_note"/></p><label t-if="workspace.selectedRow.can_review" for="mentor_dialog_note">Review note (required when returning)</label><textarea t-if="workspace.selectedRow.can_review" id="mentor_dialog_note" t-model="workspace.state.note" maxlength="250" rows="3" t-att-disabled="workspace.state.saving"/><small t-if="workspace.selectedRow.can_review"><t t-esc="workspace.state.note.length"/>/250</small><details><summary>Decision history</summary><p t-foreach="workspace.selectedRow.events" t-as="historyItem" t-key="historyItem_index"><t t-esc="historyItem.action"/> · <t t-esc="historyItem.by"/> · <t t-esc="workspace.formatTimestamp(historyItem.at)"/></p></details></div>
        <t t-set-slot="footer"><div class="od-review-actions"><button type="button" class="btn btn-secondary" t-att-disabled="workspace.state.saving" t-on-click="() => workspace.closeMentorDialog()">Close</button><t t-if="workspace.selectedRow.can_review"><button type="button" class="btn btn-secondary" t-att-disabled="workspace.state.saving" t-on-click="() => workspace.review(workspace.selectedRow, 'return')">Return to student</button><button type="button" class="btn btn-primary" t-att-disabled="workspace.state.saving" t-on-click="() => workspace.review(workspace.selectedRow, 'forward')">Forward to HOD</button></t></div></t>
      </Dialog>
  </t>
</templates>
