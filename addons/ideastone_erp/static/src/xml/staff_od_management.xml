<templates xml:space="preserve">
  <t t-name="ideastone_erp.StaffODManagement">
    <main class="campus_staff_od_management">
      <div t-if="state.error" class="mentor_error" role="alert"><span t-esc="state.error"/><button type="button" t-on-click="load">Retry</button></div>
      <div t-if="state.loading" class="mentor_loading" role="status">Loading assigned OD requests…</div>
      <t t-elif="state.data">
        <t t-if="state.data.role === 'hod'"><t t-call="ideastone_erp.HodODManagement"/></t>
        <t t-else="">
        <header class="mentor_hero">
          <div><small>YOUR CAMPUS, CONNECTED</small><h1>Welcome back, <t t-esc="state.data.mentor_name"/></h1><p>Review and manage student On Duty (OD) requests for your mentorship class.</p><span class="mentor_term"><t t-esc="state.data.company_name"/> · <t t-esc="state.data.semester || 'Current semester'"/></span></div>
          <i class="fa fa-university" aria-hidden="true"/>
        </header>

        <section class="mentor_title"><i class="fa fa-clipboard" aria-hidden="true"/><div><h2>On Duty (OD) Management</h2><p>Review, monitor and manage student OD requests under your mentorship.</p></div></section>

        <section class="mentor_kpis" aria-label="Mentorship OD summary">
          <article class="mentor_kpi class"><span><i class="fa fa-users" aria-hidden="true"/></span><div><small>My Mentorship Class</small><strong t-esc="state.data.class_label"/><p t-esc="state.data.class_programme || 'Assigned students'"/></div></article>
          <article class="mentor_kpi students"><span><i class="fa fa-user" aria-hidden="true"/></span><div><small>Total Students</small><strong t-esc="state.data.total_students"/><p>Under mentorship</p></div></article>
          <article class="mentor_kpi pending"><span><i class="fa fa-clock-o" aria-hidden="true"/></span><div><small>Pending OD Requests</small><strong t-esc="state.data.pending"/><p>Awaiting your review</p></div></article>
          <article class="mentor_kpi approved"><span><i class="fa fa-check" aria-hidden="true"/></span><div><small>Approved ODs</small><strong t-esc="state.data.approved"/><p>This semester</p></div></article>
          <article class="mentor_kpi on_duty"><span><i class="fa fa-users" aria-hidden="true"/></span><div><small>Students on OD</small><strong t-esc="state.data.students_on_od"/><p>Today</p></div></article>
        </section>

        <div class="mentor_grid">
          <div class="mentor_left">
            <section class="mentor_panel mentor_requests" aria-labelledby="mentor_requests_heading">
              <h3 id="mentor_requests_heading"><i class="fa fa-file-text" aria-hidden="true"/> Requests Awaiting Mentor Review</h3>
              <div class="mentor_request_filters"><label><i class="fa fa-search" aria-hidden="true"/><input type="search" placeholder="Search by Request ID, Student Name or Purpose..." t-att-value="state.search" t-on-input="changeSearch"/></label><select aria-label="Mentorship class" t-att-value="state.classKey" t-on-change="changeClass"><t t-foreach="state.data.classes" t-as="item" t-key="item.key"><option t-att-value="item.key"><t t-esc="item.label"/> · <t t-esc="item.semester"/></option></t><option t-if="!state.data.classes.length" value="">No assigned class</option></select></div>
              <div class="mentor_table_wrap"><table><thead><tr><th>#</th><th>Request ID</th><th>Student Name</th><th>Date(s)</th><th>Purpose</th><th>Status</th><th>Action</th></tr></thead><tbody>
                <tr t-foreach="pageRows" t-as="row" t-key="row.id" t-att-class="{'selected': state.selectedId === row.id}"><td t-esc="(state.page - 1) * 5 + row_index + 1"/><td t-esc="row.reference"/><td t-esc="row.student"/><td><t t-esc="formatDate(row.date_from)"/><t t-if="row.date_to !== row.date_from"> – <t t-esc="formatDate(row.date_to)"/></t></td><td t-esc="row.name"/><td><span t-att-class="'mentor_status ' + row.state" t-esc="row.status"/></td><td><div class="mentor_row_actions"><button type="button" class="mentor_view" title="View request" t-on-click="() => this.selectRow(row)"><i class="fa fa-eye" aria-hidden="true"/><span class="visually-hidden">View request</span></button><t t-if="row.can_review"><button type="button" class="mentor_return" t-att-disabled="state.saving" t-on-click="() => this.review(row, 'return')">Return</button><button type="button" class="mentor_forward" t-att-disabled="state.saving" t-on-click="() => this.review(row, 'forward')"><i class="fa fa-paper-plane-o" aria-hidden="true"/> Forward to HOD</button></t></div></td></tr>
                <tr t-if="!pageRows.length"><td colspan="7" class="mentor_empty">No OD requests match this class and search.</td></tr>
              </tbody></table></div>
              <div class="mentor_table_footer"><span><t t-esc="filteredRows.length"/> request(s)</span><div><button type="button" t-att-disabled="state.page === 1" t-on-click="() => this.setPage(1)">«</button><button type="button" t-att-disabled="state.page === 1" t-on-click="() => this.setPage(state.page - 1)">‹</button><span t-esc="state.page"/><button type="button" t-att-disabled="state.page === pageCount" t-on-click="() => this.setPage(state.page + 1)">›</button><button type="button" t-att-disabled="state.page === pageCount" t-on-click="() => this.setPage(pageCount)">»</button></div></div>
              <div t-if="selectedRow" class="mentor_detail"><strong><t t-esc="selectedRow.reference"/> · <t t-esc="selectedRow.student"/></strong><p><t t-esc="selectedRow.name"/> · <t t-esc="selectedRow.venue"/></p><p t-esc="selectedRow.purpose"/><small><t t-esc="selectedRow.category"/> · <t t-esc="selectedRow.status"/></small><p t-if="selectedRow.mentor_note"><strong>Mentor note:</strong> <t t-esc="selectedRow.mentor_note"/></p><details><summary>Decision history</summary><p t-foreach="selectedRow.events" t-as="event" t-key="event_index"><t t-esc="event.action"/> · <t t-esc="event.by"/> · <t t-esc="event.at"/></p></details></div>
            </section>

            <section class="mentor_panel mentor_note"><h3><i class="fa fa-pencil" aria-hidden="true"/> Quick Comment / Review Note <small>(Optional when forwarding)</small></h3><textarea t-model="state.note" maxlength="250" rows="2" placeholder="Add a comment or review note (e.g., reason for return, clarification needed, etc.)"/><span><t t-esc="state.note.length"/>/250</span></section>

            <section class="mentor_panel mentor_workflow"><h3><i class="fa fa-sitemap" aria-hidden="true"/> Approval Workflow</h3><ol><li t-att-class="{'done': workflowStep &gt; 1, 'current': workflowStep === 1}"><span>1</span><strong>Student Initiated</strong><small>OD request submitted</small></li><li t-att-class="{'done': workflowStep &gt; 2, 'current': workflowStep === 2}"><span>2</span><strong>Mentor Approval</strong><small>Review by class advisor</small></li><li t-att-class="{'done': workflowStep &gt; 3, 'current': workflowStep === 3}"><span>3</span><strong>HOD Approval</strong><small>Review by HOD</small></li><li t-att-class="{'done': workflowStep &gt; 4, 'current': workflowStep === 4}"><span>4</span><strong>Withheld / Proof Pending</strong><small>Only for Special OD</small></li><li t-att-class="{'done': workflowStep === 5, 'current': workflowStep === 5}"><span>5</span><strong>Completed</strong><small>OD approved and recorded</small></li></ol><p><i class="fa fa-info-circle" aria-hidden="true"/> General OD requests complete after HOD approval. Special OD requests may require proof verification.</p></section>
          </div>

          <div class="mentor_right">
            <section class="mentor_panel mentor_insights"><h3><i class="fa fa-magic" aria-hidden="true"/> AI Mentor Insights <small>Based on current OD records</small></h3><div class="mentor_insight_grid"><article><i class="fa fa-users" aria-hidden="true"/><div><strong>Repeated OD Asking Students</strong><b t-esc="state.data.repeated_students"/><small>This semester</small></div></article><article><i class="fa fa-calendar" aria-hidden="true"/><div><strong>Overlapping Date Students</strong><b t-esc="state.data.overlapping_students"/><small>This semester</small></div></article><article><i class="fa fa-bell" aria-hidden="true"/><div><strong>Urgent Reviews</strong><b t-esc="state.data.urgent_reviews"/><small>Event within 2 days</small></div></article></div></section>
            <section class="mentor_panel mentor_analytics"><div class="mentor_panel_header"><h3><i class="fa fa-bar-chart" aria-hidden="true"/> Class OD Activity Analytics</h3><div><button type="button" t-att-class="{'active': state.period === 'week'}" t-on-click="() => this.state.period = 'week'">Week</button><button type="button" t-att-class="{'active': state.period === 'month'}" t-on-click="() => this.state.period = 'month'">Month</button><button type="button" class="mentor_export" title="Download activity CSV" t-on-click="exportActivity"><i class="fa fa-download" aria-hidden="true"/></button></div></div><div class="mentor_chart"><div t-foreach="chartRows" t-as="point" t-key="point_index" class="mentor_chart_column"><span class="mentor_chart_value" t-esc="point.count"/><div class="mentor_chart_bar_area"><span class="mentor_chart_bar" t-att-style="'height:' + chartHeight(point.count)"/></div><strong t-esc="point.label"/><small t-esc="point.sub"/></div></div><p class="mentor_chart_caption">Requests submitted by your mentorship class</p></section>
            <section class="mentor_panel mentor_actions"><div class="mentor_panel_header"><h3><i class="fa fa-bell" aria-hidden="true"/> Pending Actions &amp; Dates</h3><a href="#mentor_requests_heading">View All</a></div><article t-foreach="state.data.actions" t-as="action" t-key="action.id"><span><i class="fa fa-file-text" aria-hidden="true"/></span><div><strong>Review Pending Request</strong><small><t t-esc="action.reference"/> · <t t-esc="action.student"/></small><p t-esc="action.name"/></div><em>Event on<br/><t t-esc="formatDate(action.date_from)"/></em></article><p t-if="!state.data.actions.length" class="mentor_empty">No requests are waiting for your review.</p></section>
          </div>
        </div>
        </t>
      </t>
    </main>
  </t>
</templates>
