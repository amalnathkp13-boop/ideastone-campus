<templates xml:space="preserve">
  <t t-name="ideastone_erp.FacultyLibrary">
    <main id="faculty-library-page" class="campus_faculty_library">
      <div class="content">
        <div t-if="state.loading" class="notice" role="status">Loading library records…</div>
        <div t-if="state.error" class="notice error" role="alert"><t t-esc="state.error"/> <button class="btn" t-on-click="load">Retry</button></div>
        <t t-if="state.data">
          <div class="crumbrow"><span>VCET Campus / Faculty workspace / <strong t-esc="page[0]"/></span><span><t t-esc="date(state.data.today)"/> · <strong>Faculty</strong></span></div>
          <div class="page-heading"><div><h1 t-esc="page[0]"/><p t-esc="page[1]"/></div><button class="btn" t-on-click="refresh" t-att-disabled="state.loading">↻ Refresh</button></div>
          <section class="banner"><div><h2 t-esc="page[2]"/><p t-esc="page[3]"/></div><div class="banner-badge">Staff access · <t t-esc="state.data.demo ? 'Sample records' : 'College records'"/></div></section>
          <div class="staff-strip"><div class="staff-chip"><span>Staff member</span><strong t-esc="state.data.staff.name"/></div><div class="staff-chip"><span>Staff ID</span><strong t-esc="state.data.staff.code"/></div><div class="staff-chip"><span>Department</span><strong t-esc="state.data.staff.department"/></div><div class="staff-chip"><span>Library access</span><strong><span class="status" t-att-class="state.data.staff.active ? 'available' : 'pending'" t-esc="state.data.staff.active ? 'Active' : 'Registration required'"/></strong></div></div>

          <div t-if="view === 'opac' || view === 'circulation'" class="kpis"><article t-foreach="stats" t-as="stat" t-key="stat.label" class="kpi"><div class="kicon" t-att-class="stat.tone" aria-hidden="true" t-esc="stat.icon"/><div><div class="kpi-label" t-esc="stat.label"/><strong t-esc="stat.value"/><small t-esc="stat.detail"/></div></article></div>

          <t t-if="view === 'opac' || view === 'catalogue'">
            <section class="panel"><div class="panel-head"><h2 t-esc="view === 'opac' ? 'Online Public Access Catalogue (OPAC)' : 'Library catalogue'"/><span class="subtle" t-esc="view === 'opac' ? 'Search books and check availability' : 'Collection details and shelf locations'"/></div>
              <div class="toolbar"><div class="field"><label for="faculty-lib-query" t-esc="view === 'opac' ? 'Search catalogue' : 'Search titles'"/><input id="faculty-lib-query" type="search" t-att-placeholder="view === 'opac' ? 'Title, author, accession no. or subject' : 'Search by title, author or code'" maxlength="200" t-model="state.query" t-on-input="filter"/></div>
                <div t-if="view === 'opac'" class="field"><label for="faculty-lib-searchby">Search by</label><select id="faculty-lib-searchby" t-model="state.searchBy" t-on-change="filter"><option value="all">All fields</option><option value="title">Title</option><option value="author">Author</option><option value="code">Accession no.</option><option value="subject">Department / subject</option></select></div>
                <div t-else="" class="field"><label for="faculty-lib-department">Department</label><select id="faculty-lib-department" t-model="state.department" t-on-change="filter"><option value="all">All departments</option><option t-foreach="departments" t-as="department" t-key="department" t-att-value="department" t-esc="department"/></select></div>
                <div class="field"><label for="faculty-lib-availability">Availability</label><select id="faculty-lib-availability" t-model="state.availability" t-on-change="filter"><option value="all" t-esc="view === 'opac' ? 'All records' : 'All statuses'"/><option value="Available">Available</option><option value="Issued">Issued</option></select></div>
                <button t-if="view === 'opac'" class="btn primary" t-on-click="filter">⌕ Search</button><button class="btn" t-on-click="reset" t-esc="view === 'opac' ? 'Reset' : 'Reset filters'"/>
              </div>
              <div class="table-wrap" tabindex="0" aria-label="Library catalogue records"><table>
                <thead><tr t-if="view === 'opac'"><th>Acc. No.</th><th>Title</th><th>Author</th><th>Publisher</th><th>Year</th><th>Department</th><th>Status</th><th>Location</th><th>Call no.</th><th>Rack</th></tr><tr t-else=""><th>Title / Author</th><th>Accession no.</th><th>Subject</th><th>Publisher</th><th>Edition</th><th>Call no.</th><th>Rack</th><th>Status</th></tr></thead>
                <tbody><t t-foreach="rows" t-as="book" t-key="book.id"><tr t-if="view === 'opac'"><td t-esc="book.code"/><td><div class="book-title" t-esc="book.title"/></td><td t-esc="book.author"/><td t-esc="book.publisher"/><td t-esc="book.year"/><td t-esc="book.department"/><td><span class="status" t-att-class="statusClass(book.status)" t-esc="book.status"/></td><td t-esc="book.location"/><td t-esc="book.call"/><td t-esc="book.rack"/></tr><tr t-else=""><td><div class="book-title" t-esc="book.title"/><div class="book-meta" t-esc="book.author"/></td><td t-esc="book.code"/><td t-esc="book.department"/><td t-esc="book.publisher"/><td t-esc="book.edition"/><td t-esc="book.call"/><td t-esc="book.rack"/><td><span class="status" t-att-class="statusClass(book.status)" t-esc="book.status"/></td></tr></t>
                  <tr t-if="!rows.length"><td t-att-colspan="view === 'opac' ? 10 : 8" class="empty">No catalogue records match your search.</td></tr>
                </tbody>
              </table></div>
              <div class="table-foot"><span>Showing <t t-esc="start"/>–<t t-esc="end"/> of <t t-esc="filteredRows.length"/> catalogue records</span><div t-if="filteredRows.length &gt; 20" class="pager"><button t-att-disabled="!state.page" t-on-click="() => this.paginate(-1)">Previous</button><button class="active" disabled="disabled" t-esc="state.page + 1"/><button t-att-disabled="end &gt;= filteredRows.length" t-on-click="() => this.paginate(1)">Next</button></div><span class="subtle">Confirm final availability with library staff</span></div>
            </section>
            <div t-if="view === 'opac'" class="two-col"><section class="panel"><div class="panel-head"><h2>Your library account</h2><span class="status" t-att-class="state.data.staff.active ? 'available' : 'pending'" t-esc="state.data.staff.active ? 'Access active' : 'Contact library desk'"/></div><div class="info-list"><div class="info-row"><span>Borrowing limit</span><strong t-esc="state.data.staff.active ? state.data.staff.limit + ' items' : 'Registration required'"/></div><div class="info-row"><span>Currently issued</span><strong><t t-esc="counts.own"/> items</strong></div><div class="info-row"><span>Outstanding fine</span><strong t-esc="money(counts.fine)"/></div><div class="info-row"><span>Renewal eligibility</span><strong><t t-esc="counts.eligible"/> items eligible to request</strong></div></div></section><section class="panel"><div class="panel-head"><h2>Library access notes</h2></div><div class="callout">Use your staff ID when contacting the library desk. Availability reflects recorded library copies. Borrowing limits and loan periods follow your library card policy. Renewals require library approval.</div></section></div>
            <section t-else="" class="panel"><div class="panel-head"><h2>Collection guidance</h2></div><div class="resource-grid"><article class="resource"><div class="resource-icon" aria-hidden="true">▤</div><strong>Reference books</strong><p>Use call number and rack information to locate reference material. Library desk may confirm restricted-use items.</p><span class="status neutral">In-library use may apply</span></article><article class="resource"><div class="resource-icon" aria-hidden="true">▧</div><strong>Periodicals &amp; journals</strong><p>Ask the library team about current issues, back volumes and access to subscribed journals.</p><span class="status neutral">Check subscription access</span></article><article class="resource"><div class="resource-icon" aria-hidden="true">⌕</div><strong>Request assistance</strong><p>If a record is missing or a shelf location is unclear, provide the title or accession number to the library desk.</p><button class="btn" t-on-click="assistance">Contact library desk</button></article></div></section>
          </t>

          <t t-if="view === 'circulation'">
            <section class="panel"><div class="panel-head"><h2>My circulation history</h2><span class="subtle">Issue, due and return dates</span></div><div class="toolbar"><div class="field"><label for="faculty-loan-query">Search loan records</label><input id="faculty-loan-query" type="search" placeholder="Book title or accession no." t-model="state.query" t-on-input="filter"/></div><div class="field"><label for="faculty-loan-status">Status</label><select id="faculty-loan-status" t-model="state.status" t-on-change="filter"><option value="all">All records</option><option>Issued</option><option>Returned</option><option>Renewal pending</option></select></div><button class="btn" t-on-click="reset">Reset</button></div>
              <div class="table-wrap" tabindex="0" aria-label="Your circulation records"><table><thead><tr><th>Acc. No.</th><th>Book title</th><th>Issue date</th><th>Due date</th><th>Return date</th><th>Status</th><th>Action</th></tr></thead><tbody><tr t-foreach="rows" t-as="loan" t-key="loan.id"><td t-esc="loan.code"/><td><div class="book-title" t-esc="loan.title"/></td><td t-esc="date(loan.issue)"/><td><t t-esc="date(loan.due)"/><div t-if="loan.overdue" class="book-meta overdue">Overdue · contact library desk</div></td><td t-esc="date(loan.returned)"/><td><span class="status" t-att-class="statusClass(loan.status)" t-esc="loan.status"/></td><td><button t-if="loan.can_renew" class="btn" t-on-click="() => this.renew(loan)" t-att-disabled="!!state.busy" t-esc="state.busy === loan.id ? 'Saving…' : 'Request renewal'"/><span t-else="">—</span></td></tr><tr t-if="!rows.length"><td colspan="7" class="empty">No circulation records match your filters.</td></tr></tbody></table></div>
              <div class="table-foot"><span><t t-esc="filteredRows.length"/> loan records</span><div t-if="filteredRows.length &gt; 20" class="pager"><button t-att-disabled="!state.page" t-on-click="() => this.paginate(-1)">Previous</button><button t-att-disabled="end &gt;= filteredRows.length" t-on-click="() => this.paginate(1)">Next</button></div><button t-if="state.data.desk_allowed" class="btn" t-on-click="openDesk">Open circulation desk</button></div>
              <div class="notice">Renewal requests are sent for library review. Your current due date remains in effect until a renewal is approved.</div>
            </section>
            <section class="panel"><div class="panel-head"><h2>Circulation policy</h2></div><div class="info-list"><div class="info-row"><span>Standard staff loan period</span><strong t-esc="state.data.staff.duration ? state.data.staff.duration + ' days' : 'Contact library desk'"/></div><div class="info-row"><span>Renewal</span><strong>Subject to holds and library rules</strong></div><div class="info-row"><span>Lost or damaged item</span><strong>Contact circulation desk</strong></div></div></section>
          </t>

          <t t-if="view === 'learning'">
            <section class="panel"><div class="panel-head"><h2>Learning platform</h2><span class="status available">Staff account</span></div><p class="subtle learning-intro">Access learning resources and faculty development materials using your institutional sign-in where available.</p><div class="resource-grid"><article class="resource"><div class="resource-icon" aria-hidden="true">▣</div><strong>OpenOlat learning platform</strong><p>Open the institution’s learning environment for available courses, learning materials and course activities.</p><a class="btn primary" t-att-href="state.data.lms_url" target="_blank" rel="noopener noreferrer">Open learning platform ↗</a></article><article class="resource"><div class="resource-icon" aria-hidden="true">▤</div><strong>Digital library resources</strong><p>Explore e-books, journals and research resources included in the college’s active subscriptions.</p><button class="btn" t-on-click="opac">Browse OPAC</button></article><article class="resource"><div class="resource-icon" aria-hidden="true">♧</div><strong>Faculty development materials</strong><p>Find training references, professional learning materials and research support resources.</p><button class="btn" t-on-click="() => state.materials = !state.materials" t-att-aria-expanded="state.materials">View materials</button></article></div><div class="notice">Use your institutional account for the learning platform. Contact college IT support if sign-in or access to a course is unavailable.</div></section>
            <section t-if="state.materials" class="panel"><div class="panel-head"><h2>Approved learning materials</h2><span class="subtle"><t t-esc="state.data.resources.length"/> resources</span></div><div class="resource-grid"><article t-foreach="state.data.resources" t-as="resource" t-key="resource.id" class="resource"><div class="resource-icon" aria-hidden="true">▧</div><strong t-esc="resource.name"/><span class="subtle"><t t-esc="resource.type"/><t t-if="resource.author"> · <t t-esc="resource.author"/></t></span><p t-esc="resource.description"/><a class="btn" t-att-href="resource.url" target="_blank" rel="noopener noreferrer">Download material ↗</a></article></div><div t-if="!state.data.resources.length" class="empty">No approved learning materials are available yet.</div></section>
            <div class="two-col"><section class="panel"><div class="panel-head"><h2>Staff access details</h2></div><div class="info-list"><div class="info-row"><span>Account</span><strong><t t-esc="state.data.staff.name"/> · <t t-esc="state.data.staff.code"/></strong></div><div class="info-row"><span>Institutional email</span><strong t-esc="state.data.staff.email"/></div><div class="info-row"><span>Access status</span><strong><span class="status available">Active</span></strong></div><div class="info-row"><span>Sign-in method</span><strong t-esc="state.data.sso ? 'Institutional SSO' : 'College account'"/></div></div></section><section class="panel"><div class="panel-head"><h2>Before opening a resource</h2></div><div class="callout">Use only resources licensed or approved by the college. If a journal or course prompts for a sign-in, use your institutional account and contact IT support if access is denied.</div></section></div>
          </t>
        </t>
      </div>
      <footer t-if="state.data" class="footer"><t t-esc="state.data.company"/> · Faculty workspace · Library &amp; learning</footer>
    </main>
  </t>

  <t t-name="ideastone_erp.LibraryAssistance">
    <Dialog title="'Contact library desk'" size="'md'">
      <form id="faculty-library-assistance" class="campus_faculty_library_form" t-on-submit="save"><div t-if="state.error" class="notice error" role="alert" t-esc="state.error"/><label for="library-assistance-note">Book title / accession number and enquiry</label><textarea id="library-assistance-note" t-model="state.note" required="required" maxlength="4000" placeholder="Describe the book or library assistance you need…" t-att-disabled="state.busy"/></form>
      <t t-set-slot="footer"><button type="submit" form="faculty-library-assistance" class="btn btn-primary" t-att-disabled="state.busy" t-esc="state.busy ? 'Saving…' : 'Send enquiry'"/><button class="btn btn-secondary" t-on-click="props.close" t-att-disabled="state.busy">Cancel</button></t>
    </Dialog>
  </t>
</templates>
