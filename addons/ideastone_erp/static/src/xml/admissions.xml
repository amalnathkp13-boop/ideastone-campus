<templates xml:space="preserve">
  <t t-name="ideastone_erp.AdmissionsWorkspace">
    <main class="campus_admissions_workspace">
      <p t-if="state.loading" class="loading-note" role="status">Loading admissions records…</p>
      <div t-if="state.error" class="alert alert-danger" role="alert"><t t-esc="state.error"/><button type="button" class="btn" t-on-click="refresh">Retry</button></div>
      <t t-if="state.data &amp;&amp; !state.error">
        <div class="crumb"><span>VCET Campus / Admissions / <t t-esc="view === 'overview' ? 'Overview' : meta.title"/></span><span><t t-esc="state.data.today"/> · <t t-esc="scope"/></span></div>
        <p t-if="state.data.is_demo" class="demo-note">Demonstration college · Sample records for preview</p>
        <div class="heading"><div><h1 t-esc="meta.title"/><p t-esc="meta.description"/></div><div class="actions">
          <button class="btn icon-button" type="button" aria-label="Filters" title="Filter academic year and programme" t-on-click="filters" t-att-disabled="state.loading"><i class="fa fa-filter" aria-hidden="true"/></button>
          <button class="btn icon-button" type="button" aria-label="Refresh admissions" title="Refresh admissions" t-on-click="refresh" t-att-disabled="state.loading"><i class="fa fa-refresh" aria-hidden="true"/></button>
          <t t-if="view === 'overview'"><button class="btn admissions-light-action" type="button" t-on-click="print"><i class="fa fa-download" aria-hidden="true"/> Export report</button><button class="btn primary admissions-light-action" type="button" t-att-disabled="!state.data.create.enquiries" t-on-click="() => this.open('enquiries',null,true)">＋ Add enquiry</button></t>
          <t t-elif="view === 'enquiries'"><button class="btn" type="button" title="Open the enquiry register, then choose Import records from its Actions menu" t-on-click="() => this.open('enquiries')"><i class="fa fa-upload" aria-hidden="true"/> Import leads</button><button class="btn primary" type="button" t-att-disabled="!state.data.create.enquiries" t-on-click="() => this.open('enquiries',null,true)">＋ New enquiry</button></t>
          <t t-elif="view === 'applications'"><button class="btn" type="button" title="Open the application register to select records and use the available actions" t-on-click="() => this.open('applications')"><i class="fa fa-list" aria-hidden="true"/> Bulk actions</button><button class="btn primary" type="button" t-att-disabled="!state.data.create.applications" t-on-click="() => this.open('applications',null,true)">＋ Create application</button></t>
          <t t-elif="view === 'documents'"><button class="btn" type="button" t-on-click="print"><i class="fa fa-download" aria-hidden="true"/> Verification report</button><button class="btn primary" type="button" t-att-disabled="!state.data.create.documents" t-on-click="() => this.open('documents',null,true)">＋ Upload document</button></t>
          <t t-elif="view === 'register'"><button class="btn" type="button" title="Export the displayed page of admission cycles" t-on-click="exportRows"><i class="fa fa-download" aria-hidden="true"/> Export register</button><button class="btn primary" type="button" t-att-disabled="!state.data.create.register" t-on-click="() => this.open('register',null,true)">＋ New admission cycle</button></t>
        </div></div>
        <t t-if="view === 'overview'">
          <section class="hero"><div><div class="tag">✦ Your admissions, in sync</div><h2>Build the next great batch.</h2><p>Track every prospective student from first enquiry to confirmed enrolment. Saved-record signals surface the cases that need attention.</p></div><div class="hero-metrics"><div class="hero-metric"><small>Application conversion</small><strong t-esc="percent(state.data.conversion)"/><em>Confirmed / managed applications</em></div><div class="hero-metric"><small>Seat capacity filled</small><strong t-esc="percent(state.data.fill)"/><em><t t-esc="number(c.enrolled)"/> of <t t-esc="number(c.capacity)"/> configured seats</em></div><div class="hero-metric"><small>Response SLA</small><strong class="not-tracked">Not tracked</strong><em>First-contact timing is not recorded</em></div></div></section>
          <div class="ai-strip"><div class="ai-icon">✦</div><div><b>Admissions assistant · Priority brief</b><p t-esc="brief"/></div><button class="btn" type="button" t-on-click="() => this.go('applications')">View action plan ↗</button></div>
          <div class="section-head"><div><h3>Cycle at a glance</h3><p>Live operational indicators · <t t-esc="scope"/></p></div><button class="textlink" type="button" t-on-click="print">View analytics ↗</button></div>
          <section class="stats" aria-label="Admissions indicators"><button type="button" class="stat" t-foreach="stats" t-as="stat" t-key="stat.label" t-att-disabled="!state.data.allowed[stat.view]" t-on-click="() => this.go(stat.view)"><div class="stat-top"><span t-esc="stat.label"/><span class="stat-icon" t-att-class="stat.view === 'applications' &amp;&amp; stat.icon === 'clock-o' ? 'amber' : ''"><i t-att-class="'fa fa-' + stat.icon" aria-hidden="true"/></span></div><strong t-esc="state.data.allowed[stat.view] ? number(stat.value) : '—'"/><div class="stat-foot"><span t-esc="stat.detail"/></div></button></section>
          <section class="panel department-panel"><div class="panel-head"><div><h3>Department-wise admission status</h3><p>Applications received, confirmed admissions and waiting-list movement</p></div><span class="pill" t-esc="scope"/></div>
            <div class="department-summary"><div class="ds-chip">Applications received <strong t-esc="number(c.applications)"/></div><div class="ds-chip">Admitted <strong t-esc="number(c.enrolled)"/></div><div class="ds-chip">Reported / present <strong>—</strong></div><div class="ds-chip">Waiting list <strong t-esc="number(c.waiting)"/></div></div>
            <div class="dept-snapshot"><article class="dept-snapshot-card" t-foreach="state.data.department_cards" t-as="dept" t-key="dept.id"><div class="dept-snapshot-top"><div class="dept-mark" t-esc="dept.code"/><div><b t-esc="dept.name"/><small t-esc="dept.no_intake ? 'No intake in this scope' : 'Department intake'"/></div></div><div class="dept-snapshot-fill"><strong><t t-esc="number(dept.confirmed)"/> / <t t-esc="dept.capacity ? number(dept.capacity) : '—'"/></strong><span><t t-esc="percent(dept.fill)"/> filled</span></div><div class="dept-snapshot-bar"><span t-att-style="'width:' + width(dept.confirmed,dept.capacity)"/></div><div class="dept-snapshot-stats"><div><small>Present</small><strong>—</strong></div><div><small>Seats left</small><strong t-esc="number(dept.remaining)"/></div></div></article></div>
            <div class="table-wrap" tabindex="0" aria-label="Department admissions table"><table class="dept-table"><thead><tr><th>Department</th><th>Applications</th><th>Admitted</th><th>Reported / present</th><th>Waiting list</th><th>Seats filled / capacity</th><th>Seats remaining</th><th>Seat fill</th></tr></thead><tbody><tr t-foreach="state.data.departments" t-as="dept" t-key="dept.id"><td><div class="dept-name"><div class="dept-mark" t-esc="dept.code"/><div><b t-esc="dept.name"/><small>Managed admissions</small></div></div></td><td class="dept-apps" t-esc="number(dept.applications)"/><td><span class="dept-state good"><t t-esc="number(dept.confirmed)"/> confirmed</span></td><td>—</td><td><span class="dept-state wait"><t t-esc="number(dept.waiting)"/> waiting</span></td><td><strong><t t-esc="number(dept.confirmed)"/> / <t t-esc="number(dept.capacity)"/></strong><div class="dept-progress-line"><span t-att-style="'width:' + width(dept.confirmed,dept.capacity)"/></div></td><td><span class="dept-state good"><t t-esc="number(dept.remaining)"/> left</span></td><td><strong t-esc="percent(dept.fill)"/></td></tr><tr t-if="!state.data.departments.length"><td colspan="8" class="empty">No departments have admission cycles or applications in this scope.</td></tr></tbody><tfoot><tr><td>Total across listed departments</td><td t-esc="number(c.applications)"/><td t-esc="number(c.enrolled)"/><td>—</td><td t-esc="number(c.waiting)"/><td><t t-esc="number(c.enrolled)"/> / <t t-esc="number(c.capacity)"/></td><td t-esc="c.capacity ? number(Math.max(0,c.capacity-c.enrolled)) : '—'"/><td t-esc="percent(state.data.fill)"/></tr></tfoot></table></div>
            <p class="data-note">Confirmed counts use managed enrolments. Reporting / physical check-in is not recorded in Admissions. A dash means the measurement is unavailable.</p><div class="dept-insight"><b>✦ Admission insight</b><span t-esc="departmentInsight"/></div>
          </section>
          <div class="dashboard-grid"><section class="panel"><div class="panel-head"><div><h3>Applicant conversion journey</h3><p>Current scoped counts across the admissions journey</p></div><span class="pill">Saved records</span></div><div class="funnel"><div class="funnel-row" t-foreach="state.data.journey" t-as="step" t-key="step.label"><span t-esc="step.label"/><div class="funnel-track"><div class="funnel-fill" t-att-class="step.tone" t-att-style="'width:' + width(step.count,Math.max(1,...state.data.journey.map(r => r.count)))"/></div><strong t-esc="number(step.count)"/></div></div><div class="legend"><span>Lead progression</span><span>Review milestones</span><span>Confirmed</span></div><p class="data-note">Applications may be created directly. Stage counts describe saved records and are not a forecast.</p></section>
            <section class="panel"><div class="panel-head"><div><h3>Admissions pipeline</h3><p>Managed candidates by their current recorded stage</p></div><button class="textlink" type="button" t-on-click="() => this.go('applications')">Open pipeline ↗</button></div><div class="pipeline"><div class="pipe-col" t-foreach="state.data.pipeline" t-as="column" t-key="column.label"><header><span t-esc="column.label"/><span class="pipe-count" t-esc="number(column.count)"/></header><button type="button" class="lead" t-foreach="column.rows" t-as="row" t-key="row.id" t-on-click="() => this.open('applications',row.id)"><b t-esc="row.name"/><small t-esc="row.programme"/><div class="lead-foot"><span t-esc="row.updated"/><span t-att-class="'status-badge ' + row.tone" t-esc="row.status"/></div></button><p t-if="!column.rows.length" class="empty small-empty">No candidates</p></div></div></section>
          </div>
          <div class="lower-grid"><section class="panel"><div class="panel-head"><div><h3>Enquiry sources</h3><p>Where applicants first discover the college</p></div><span class="pill"><t t-esc="number(c.enquiries)"/> leads</span></div><div class="source-list"><div class="source" t-foreach="state.data.sources" t-as="source" t-key="source.name"><span t-esc="source.name"/><div class="source-track"><span t-att-style="'width:' + width(source.count,c.enquiries)"/></div><strong t-esc="number(source.count)"/></div></div><p t-if="!state.data.sources.length" class="empty">No enquiry sources recorded in this scope.</p></section>
            <section class="panel"><div class="panel-head"><div><h3>Today's action queue</h3><p>Saved operational follow-ups for admissions staff</p></div><span class="pill"><t t-esc="tasks.filter(r => r.value).length"/> priorities</span></div><div class="task-list"><button class="task" type="button" t-foreach="tasks" t-as="task" t-key="task.title" t-on-click="() => this.go(task.view)"><span class="task-ico"><i t-att-class="'fa fa-' + task.icon" aria-hidden="true"/></span><span><b t-esc="task.title"/><small t-esc="task.detail"/></span><span class="status" t-esc="task.label"/></button></div></section>
            <section class="panel"><div class="panel-head"><div><h3>Admissions opportunity signals</h3><p>Recommendations from current saved records</p></div><span class="pill">Rule based</span></div><article class="insight-card"><div class="insight-label">Follow-up signal</div><b>Keep scheduled conversations moving</b><p><t t-esc="number(c.follow_up)"/> unconverted enquiries have a scheduled activity due today or earlier. Review their history before contacting them.</p><button class="textlink" type="button" t-att-disabled="!state.data.allowed.enquiries" t-on-click="() => this.go('enquiries')">Review enquiries ↗</button></article><article class="insight-card"><div class="insight-label">Capacity signal</div><b>Plan with confirmed seat counts</b><p t-esc="departmentInsight"/><button class="textlink" type="button" t-att-disabled="!state.data.allowed.register" t-on-click="() => this.go('register')">Review seat plan ↗</button></article></section>
          </div>
        </t>
        <t t-else="">
          <div class="workspace-summary"><article class="summary-box" t-foreach="state.data.summary" t-as="item" t-key="item[0]"><small t-esc="item[0]"/><strong t-esc="number(item[1])"/></article></div>
          <div class="ai-strip"><div class="ai-icon">✦</div><div><b t-esc="strip.title"/><p t-esc="strip.text"/></div><button class="btn" type="button" t-on-click="() => this.open(strip.kind)"><t t-esc="strip.button"/> ↗</button></div>
          <form class="toolbar" t-on-submit.prevent="search"><label class="search"><span aria-hidden="true"><i class="fa fa-search"/></span><input type="search" aria-label="Search admissions records" maxlength="200" placeholder="Search applicant, programme, document or cycle…" t-model="state.query"/></label><select class="select" aria-label="Filter status" t-model="state.status" t-on-change="search"><option value="">All statuses</option><option t-foreach="state.data.statuses" t-as="status" t-key="status" t-att-value="status" t-esc="status"/></select><button class="btn" type="submit">Search</button><button class="btn" type="button" title="Download the displayed page as CSV" t-on-click="exportRows"><i class="fa fa-download" aria-hidden="true"/> Export page</button></form>
        </t>
        <section class="panel table-panel"><div class="panel-head" t-if="view === 'overview'"><div><h3>Applicants needing attention</h3><p>Applications with a submitted, document or review action pending</p></div><button class="textlink" type="button" t-on-click="() => this.go('applications')">View all applicants ↗</button></div><div class="table-wrap" tabindex="0" aria-label="Admissions records"><table><thead><tr><th t-foreach="columns" t-as="column" t-key="column" t-esc="column"/></tr></thead><tbody><tr t-foreach="state.data.rows" t-as="row" t-key="row.id">
          <t t-if="view === 'register'"><td><button class="record-link" type="button" t-on-click="() => this.open('register',row.id)" t-esc="row.name"/></td><td t-esc="row.programme"/><td t-esc="row.year"/><td t-esc="row.window"/><td t-esc="number(row.capacity)"/><td><strong t-esc="number(row.confirmed)"/> <span class="muted">(<t t-esc="percent(row.fill)"/>)</span><div class="mini-bar"><span t-att-style="'width:' + width(row.confirmed,row.capacity)"/></div></td><td><span t-att-class="'status-badge ' + row.tone" t-esc="row.status"/></td><td><button class="textlink" type="button" t-on-click="() => this.open('register',row.id)">Manage ↗</button></td></t>
          <t t-else=""><td><div class="person"><div class="person-avatar" t-esc="initials(row.name)"/><div><button type="button" class="record-link" t-on-click="() => this.open(row.kind,row.id)" t-esc="view === 'applications' ? row.reference : row.name"/><small class="person-detail" t-esc="view === 'applications' ? row.name : row.reference"/></div></div></td>
            <t t-if="view === 'enquiries'"><td t-esc="row.programme"/><td t-esc="row.source"/><td class="muted" title="Automated lead scoring is not configured">—</td><td><span t-att-class="'status-badge ' + row.tone" t-esc="row.status"/></td><td t-esc="row.follow_up"/><td t-esc="row.owner"/></t>
            <t t-elif="view === 'applications'"><td t-esc="row.programme"/><td t-esc="row.submitted"/><td title="Verified required documents and matching intake placement"><strong><t t-esc="number(row.completeness)"/>%</strong><div class="mini-bar"><span t-att-class="row.completeness === 100 ? 'green' : 'amber'" t-att-style="'width:' + width(row.completeness,100)"/></div></td><td><span t-att-class="'status-badge ' + row.tone" t-esc="row.status"/></td><td t-esc="row.owner"/><td><button class="textlink" type="button" t-on-click="() => this.open('applications',row.id)">Review ↗</button></td></t>
            <t t-elif="view === 'documents'"><td t-esc="row.document"/><td t-esc="row.uploaded"/><td><span class="status-badge new" t-esc="row.file_status"/></td><td><span t-att-class="'status-badge ' + row.tone" t-esc="row.status"/></td><td t-esc="row.owner"/><td><button class="textlink" type="button" t-on-click="() => this.open('documents',row.id)">Preview ↗</button></td></t>
            <t t-else=""><td t-esc="row.programme"/><td><span t-att-class="'status-badge ' + row.tone" t-esc="row.status"/></td><td t-esc="row.updated"/><td t-esc="row.owner"/><td><button class="textlink" type="button" t-on-click="() => this.open('applications',row.id)">Review ↗</button></td></t>
          </t>
        </tr><tr t-if="!state.data.rows.length"><td t-att-colspan="columns.length" class="empty">No records match this admissions scope. Create a record or adjust the filters.</td></tr></tbody></table></div><div t-if="view !== 'overview'" class="pagination"><span><t t-esc="state.data.total_rows ? state.page*30+1 : 0"/>–<t t-esc="Math.min((state.page+1)*30,state.data.total_rows)"/> of <t t-esc="number(state.data.total_rows)"/> records</span><div><button class="btn" type="button" t-att-disabled="!state.page || state.loading" t-on-click="() => this.paginate(-1)">Previous</button><button class="btn" type="button" t-att-disabled="!state.data.has_next || state.loading" t-on-click="() => this.paginate(1)">Next</button></div></div></section>
        <footer class="footer">VCET Campus ERP · Admissions Intelligence · Powered by Ideastone · Saved college records</footer>
      </t>
    </main>
  </t>
  <t t-name="ideastone_erp.AdmissionsFilters"><Dialog title="'Admissions filters'" size="'md'" contentClass="'campus_admissions_filter_dialog'"><form id="campus_admissions_filter_form" t-on-submit.prevent="apply"><label>Academic year<select t-model="state.year_id"><option value="">All academic years</option><option t-foreach="props.years" t-as="year" t-key="year.id" t-att-value="year.id" t-esc="year.name"/></select></label><label>Programme<select t-model="state.course_id"><option value="">All programmes</option><option t-foreach="props.programmes" t-as="course" t-key="course.id" t-att-value="course.id" t-esc="course.name"/></select></label><p t-if="state.error" class="alert alert-danger" role="alert" t-esc="state.error"/></form><t t-set-slot="footer"><button type="submit" form="campus_admissions_filter_form" class="btn btn-primary" t-att-disabled="state.busy">Apply filters</button><button type="button" class="btn btn-secondary" t-att-disabled="state.busy" t-on-click="props.close">Cancel</button></t></Dialog></t>
</templates>
