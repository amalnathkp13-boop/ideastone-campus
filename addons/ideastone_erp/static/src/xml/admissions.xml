<templates xml:space="preserve">
  <t t-name="ideastone_erp.AdmissionsWorkspace">
    <main class="campus_admissions_workspace">
      <p t-if="state.loading" class="loading-note" role="status">Loading admissions records…</p>
      <div t-if="state.error" class="alert alert-danger" role="alert"><t t-esc="state.error"/><button type="button" class="btn" t-on-click="refresh">Retry</button></div>
      <t t-if="state.data &amp;&amp; !state.error">
        <div class="crumb"><span>VCET Campus / Admissions / <t t-esc="view === 'overview' ? 'Overview' : meta.title"/></span><span><t t-esc="state.data.today"/> · <t t-esc="scope"/></span></div>
        <p t-if="state.data.is_demo" class="demo-note">Demonstration college · Sample records for preview</p>
        <div class="heading"><div><h1 t-esc="meta.title"/><p t-esc="meta.description"/></div><div class="actions">
          <button class="btn icon-button" type="button" aria-label="Filters" title="Filter academic year and programme" t-on-click="filters" t-att-disabled="state.loading"><i class="fa fa-filter" aria-hidden="true"/></button>
          <button class="btn icon-button" type="button" aria-label="Refresh admissions" title="Refresh admissions" t-on-click="refresh" t-att-disabled="state.loading"><i class="fa fa-refresh" aria-hidden="true"/></button>
          <t t-if="view === 'overview'"><button class="btn admissions-light-action" type="button" t-on-click="print"><i class="fa fa-download" aria-hidden="true"/> Export report</button><button class="btn primary admissions-light-action" type="button" t-att-disabled="!state.data.create.enquiries" t-on-click="() => this.open('enquiries',null,true)">＋ Add enquiry</button></t>
          <t t-elif="view === 'enquiries'"><button class="btn" type="button" title="Open the enquiry register, then choose Import records from its Actions menu" t-on-click="() => this.open('enquiries')"><i class="fa fa-upload" aria-hidden="true"/> Import leads</button><button class="btn primary" type="button" t-att-disabled="!state.data.create.enquiries" t-on-click="() => this.open('enquiries',null,true)">＋ New enquiry</button></t>
          <t t-elif="view === 'applications'"><button class="btn" type="button" title="Open the application register to select records and use the available actions" t-on-click="() => this.open('applications')"><i class="fa fa-list" aria-hidden="true"/> Bulk actions</button><button class="btn primary" type="button" t-att-disabled="!state.data.create.applications" t-on-click="() => this.open('applications',null,true)">＋ Create application</button></t>
          <t t-elif="view === 'documents'"><button class="btn" type="button" t-on-click="print"><i class="fa fa-download" aria-hidden="true"/> Verification report</button><button class="btn primary" type="button" t-att-disabled="!state.data.create.documents" t-on-click="() => this.open('documents',null,true)">＋ Upload document</button></t>
          <t t-elif="view === 'register'"><button class="btn" type="button" title="Export the displayed page of admission cycles" t-on-click="exportRows"><i class="fa fa-download" aria-hidden="true"/> Export register</button><button class="btn primary" type="button" t-att-disabled="!state.data.create.register" t-on-click="() => this.open('register',null,true)">＋ New admission cycle</button></t>
        </div></div>
        <t t-if="view === 'overview'">
          <section class="stats admissions_reference_stats" aria-label="Admissions indicators"><button type="button" class="stat" t-foreach="stats" t-as="stat" t-key="stat.label" t-att-disabled="!state.data.allowed[stat.view]" t-on-click="() => this.go(stat.view)"><div class="stat-top"><span t-esc="stat.label"/><span class="stat-icon" t-att-class="stat.view === 'applications' &amp;&amp; stat.icon === 'clock-o' ? 'amber' : ''"><i t-att-class="'fa fa-' + stat.icon" aria-hidden="true"/></span></div><strong t-esc="state.data.allowed[stat.view] ? number(stat.value) : '—'"/><div class="stat-foot"><span t-esc="stat.detail"/></div></button></section>
          <div class="admissions_pair">
            <section class="panel"><div class="panel-head"><div><h3>Department intake summary</h3><p>Admitted seats and intake status by department.</p></div><button class="textlink" type="button" t-on-click="() => this.go('register')">View all departments ↗</button></div>
              <div class="dept-snapshot"><article class="dept-snapshot-card" t-foreach="state.data.department_cards" t-as="dept" t-key="dept.id"><div class="dept-snapshot-top"><div class="dept-mark" t-esc="dept.code"/><div><b t-esc="dept.name"/><small t-esc="dept.no_intake ? 'No intake in this scope' : 'Department intake'"/></div></div><div class="dept-snapshot-fill"><strong><t t-esc="number(dept.confirmed)"/> / <t t-esc="dept.capacity ? number(dept.capacity) : '—'"/></strong><span t-esc="percent(dept.fill)"/></div><div class="dept-snapshot-bar"><span t-att-style="'width:' + width(dept.confirmed,dept.capacity)"/></div><small><t t-esc="number(dept.remaining)"/> seats remaining</small></article></div>
            </section>
            <section class="panel"><div class="panel-head"><div><h3>Admission cycle summary</h3><p>Applications, admissions and seat utilisation by department.</p></div></div><div class="table-wrap" tabindex="0"><table class="dept-table"><thead><tr><th>Department</th><th>Applications</th><th>Admitted</th><th>Waiting list</th><th>Seats filled / capacity</th><th>Seats remaining</th><th>Seat fill</th></tr></thead><tbody><tr t-foreach="state.data.departments" t-as="dept" t-key="dept.id"><td t-esc="dept.name"/><td t-esc="number(dept.applications)"/><td t-esc="number(dept.confirmed)"/><td t-esc="number(dept.waiting)"/><td><t t-esc="number(dept.confirmed)"/> / <t t-esc="dept.capacity ? number(dept.capacity) : '—'"/></td><td t-esc="number(dept.remaining)"/><td t-esc="percent(dept.fill)"/></tr><tr t-if="!state.data.departments.length"><td colspan="7" class="empty">No configured intake in this scope.</td></tr></tbody></table></div></section>
          </div>
          <div class="admissions_pair admissions_action_pair">
            <section class="panel"><div class="panel-head"><div><h3>Today's action queue</h3><p>Key follow-ups for admissions staff.</p></div></div><div class="task-list"><button class="task" type="button" t-foreach="tasks" t-as="task" t-key="task.title" t-on-click="() => this.go(task.view)"><span class="task-ico"><i t-att-class="'fa fa-' + task.icon" aria-hidden="true"/></span><span><b t-esc="task.title"/><small t-esc="task.detail"/></span><span class="status" t-esc="task.label"/></button></div><p t-if="!tasks.length" class="empty">No open actions in this admissions scope.</p></section>
            <section class="panel"><div class="panel-head"><div><h3>Applicants needing attention</h3><p>Applications with pending actions or missing information.</p></div><button class="textlink" type="button" t-on-click="() => this.go('applications')">View all applicants ↗</button></div><div class="table-wrap" tabindex="0"><table><thead><tr><th>Applicant</th><th>Programme</th><th>Issue</th><th>Status</th></tr></thead><tbody><tr t-foreach="state.data.rows" t-as="row" t-key="row.id"><td><button type="button" class="record-link" t-on-click="() => this.open('applications',row.id)" t-esc="row.name"/></td><td t-esc="row.programme"/><td t-esc="row.issue"/><td><span t-att-class="'status-badge ' + row.tone" t-esc="row.status"/></td></tr><tr t-if="!state.data.rows.length"><td colspan="4" class="empty">No applicants need review in this scope.</td></tr></tbody></table></div></section>
          </div>
          <div class="admissions_pair admissions_extra_pair">
            <section class="panel"><div class="panel-head"><div><h3>Scholarship mix</h3><p>Approved and pending fee concessions among enrolled applicants.</p></div><span class="pill">Saved fee records</span></div><t t-if="state.data.scholarship_mix"><div class="source-list"><div class="source" t-foreach="state.data.scholarship_mix.filter(item => item.count)" t-as="item" t-key="item.label"><span t-esc="item.label"/><div class="source-track"><span t-att-style="'width:' + width(item.count,c.enrolled)"/></div><strong t-esc="number(item.count)"/></div></div><p t-if="!c.enrolled" class="empty">No enrolled applicants in this scope.</p><p class="data-note">Concessions are fee aid records; a separate scholarship award is not tracked here.</p></t><p t-else="" class="empty">Fee concession data is unavailable to this account.</p></section>
            <section class="panel"><div class="panel-head"><div><h3>Seat forecast</h3><p>Scenario if all current offers become enrolments.</p></div><button class="textlink" type="button" t-on-click="() => this.go('register')">Open admission register ↗</button></div><div class="seat-forecast"><div t-foreach="state.data.seat_forecast" t-as="row" t-key="row.name"><span t-esc="row.name"/><div class="dept-snapshot-bar"><span t-att-style="'width:' + width(row.if_offers_convert,row.capacity)"/></div><strong><t t-esc="number(row.if_offers_convert)"/> / <t t-esc="row.capacity ? number(row.capacity) : '—'"/></strong><small><t t-esc="number(row.offers)"/> open offers</small></div></div><p t-if="!state.data.seat_forecast.length" class="empty">No admission cycles are configured in this scope.</p><p class="data-note">This is an offer-conversion scenario capped at configured seats, not a statistical prediction.</p></section>
          </div>
          <div class="admissions_pair admissions_insights_pair"><section class="panel"><div class="panel-head"><div><h3>Admissions pipeline</h3><p>Managed candidates by their current recorded stage.</p></div><button class="textlink" type="button" t-on-click="() => this.go('applications')">Open pipeline ↗</button></div><div class="pipeline"><div class="pipe-col" t-foreach="state.data.pipeline" t-as="column" t-key="column.label"><header><span t-esc="column.label"/><span class="pipe-count" t-esc="number(column.count)"/></header><button type="button" class="lead" t-foreach="column.rows" t-as="row" t-key="row.id" t-on-click="() => this.open('applications',row.id)"><b t-esc="row.name"/><small t-esc="row.programme"/></button></div></div></section><section class="panel"><div class="panel-head"><div><h3>Enquiry sources</h3><p>Recorded sources for prospective students.</p></div></div><div class="source-list"><div class="source" t-foreach="state.data.sources" t-as="source" t-key="source.name"><span t-esc="source.name"/><div class="source-track"><span t-att-style="'width:' + width(source.count,c.enquiries)"/></div><strong t-esc="number(source.count)"/></div></div><p t-if="!state.data.sources.length" class="empty">No enquiry sources recorded in this scope.</p></section></div>
        </t>
        <t t-else="">
          <div class="workspace-summary"><article class="summary-box" t-foreach="state.data.summary" t-as="item" t-key="item[0]"><small t-esc="item[0]"/><strong t-esc="number(item[1])"/></article></div>
          <div class="ai-strip"><div class="ai-icon">✦</div><div><b t-esc="strip.title"/><p t-esc="strip.text"/></div><button class="btn" type="button" t-on-click="() => this.open(strip.kind)"><t t-esc="strip.button"/> ↗</button></div>
          <form class="toolbar" t-on-submit.prevent="search"><label class="search"><span aria-hidden="true"><i class="fa fa-search"/></span><input type="search" aria-label="Search admissions records" maxlength="200" placeholder="Search applicant, programme, document or cycle…" t-model="state.query"/></label><select class="select" aria-label="Filter status" t-model="state.status" t-on-change="search"><option value="">All statuses</option><option t-foreach="state.data.statuses" t-as="status" t-key="status" t-att-value="status" t-esc="status"/></select><button class="btn" type="submit">Search</button><button class="btn" type="button" title="Download the displayed page as CSV" t-on-click="exportRows"><i class="fa fa-download" aria-hidden="true"/> Export page</button></form>
        </t>
        <section t-if="view !== 'overview'" class="panel table-panel"><div class="panel-head" t-if="view === 'overview'"><div><h3>Applicants needing attention</h3><p>Applications with a submitted, document or review action pending</p></div><button class="textlink" type="button" t-on-click="() => this.go('applications')">View all applicants ↗</button></div><div class="table-wrap" tabindex="0" aria-label="Admissions records"><table><thead><tr><th t-foreach="columns" t-as="column" t-key="column" t-esc="column"/></tr></thead><tbody><tr t-foreach="state.data.rows" t-as="row" t-key="row.id">
          <t t-if="view === 'register'"><td><button class="record-link" type="button" t-on-click="() => this.open('register',row.id)" t-esc="row.name"/></td><td t-esc="row.programme"/><td t-esc="row.year"/><td t-esc="row.window"/><td t-esc="number(row.capacity)"/><td><strong t-esc="number(row.confirmed)"/> <span class="muted">(<t t-esc="percent(row.fill)"/>)</span><div class="mini-bar"><span t-att-style="'width:' + width(row.confirmed,row.capacity)"/></div></td><td><span t-att-class="'status-badge ' + row.tone" t-esc="row.status"/></td><td><button class="textlink" type="button" t-on-click="() => this.open('register',row.id)">Manage ↗</button></td></t>
          <t t-else=""><td><div class="person"><div class="person-avatar" t-esc="initials(row.name)"/><div><button type="button" class="record-link" t-on-click="() => this.open(row.kind,row.id)" t-esc="view === 'applications' ? row.reference : row.name"/><small class="person-detail" t-esc="view === 'applications' ? row.name : row.reference"/></div></div></td>
            <t t-if="view === 'enquiries'"><td t-esc="row.programme"/><td t-esc="row.source"/><td class="muted" title="Automated lead scoring is not configured">—</td><td><span t-att-class="'status-badge ' + row.tone" t-esc="row.status"/></td><td t-esc="row.follow_up"/><td t-esc="row.owner"/></t>
            <t t-elif="view === 'applications'"><td t-esc="row.programme"/><td t-esc="row.submitted"/><td title="Verified required documents and matching intake placement"><strong><t t-esc="number(row.completeness)"/>%</strong><div class="mini-bar"><span t-att-class="row.completeness === 100 ? 'green' : 'amber'" t-att-style="'width:' + width(row.completeness,100)"/></div></td><td><span t-att-class="'status-badge ' + row.tone" t-esc="row.status"/></td><td t-esc="row.owner"/><td><button class="textlink" type="button" t-on-click="() => this.open('applications',row.id)">Review ↗</button></td></t>
            <t t-elif="view === 'documents'"><td t-esc="row.document"/><td t-esc="row.uploaded"/><td><span class="status-badge new" t-esc="row.file_status"/></td><td><span t-att-class="'status-badge ' + row.tone" t-esc="row.status"/></td><td t-esc="row.owner"/><td><button class="textlink" type="button" t-on-click="() => this.open('documents',row.id)">Preview ↗</button></td></t>
            <t t-else=""><td t-esc="row.programme"/><td><span t-att-class="'status-badge ' + row.tone" t-esc="row.status"/></td><td t-esc="row.updated"/><td t-esc="row.owner"/><td><button class="textlink" type="button" t-on-click="() => this.open('applications',row.id)">Review ↗</button></td></t>
          </t>
        </tr><tr t-if="!state.data.rows.length"><td t-att-colspan="columns.length" class="empty">No records match this admissions scope. Create a record or adjust the filters.</td></tr></tbody></table></div><div t-if="view !== 'overview'" class="pagination"><span><t t-esc="state.data.total_rows ? state.page*30+1 : 0"/>–<t t-esc="Math.min((state.page+1)*30,state.data.total_rows)"/> of <t t-esc="number(state.data.total_rows)"/> records</span><div><button class="btn" type="button" t-att-disabled="!state.page || state.loading" t-on-click="() => this.paginate(-1)">Previous</button><button class="btn" type="button" t-att-disabled="!state.data.has_next || state.loading" t-on-click="() => this.paginate(1)">Next</button></div></div></section>
        <footer class="footer">VCET Campus ERP · Admissions Intelligence · Powered by Ideastone · Saved college records</footer>
      </t>
    </main>
  </t>
  <t t-name="ideastone_erp.AdmissionsFilters"><Dialog title="'Admissions filters'" size="'md'" contentClass="'campus_admissions_filter_dialog'"><form id="campus_admissions_filter_form" t-on-submit.prevent="apply"><label>Academic year<select t-model="state.year_id"><option value="">All academic years</option><option t-foreach="props.years" t-as="year" t-key="year.id" t-att-value="year.id" t-esc="year.name"/></select></label><label>Programme<select t-model="state.course_id"><option value="">All programmes</option><option t-foreach="props.programmes" t-as="course" t-key="course.id" t-att-value="course.id" t-esc="course.name"/></select></label><p t-if="state.error" class="alert alert-danger" role="alert" t-esc="state.error"/></form><t t-set-slot="footer"><button type="submit" form="campus_admissions_filter_form" class="btn btn-primary" t-att-disabled="state.busy">Apply filters</button><button type="button" class="btn btn-secondary" t-att-disabled="state.busy" t-on-click="props.close">Cancel</button></t></Dialog></t>
</templates>
