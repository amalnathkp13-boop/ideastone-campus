<templates xml:space="preserve">
  <t t-name="ideastone_erp.AcademicsWorkspace">
    <main class="campus_academics_workspace">
      <div class="content">
        <p t-if="state.loading" class="academic-loading" role="status">Refreshing academic records…</p>
        <div t-if="state.error" class="academic-error" role="alert"><span t-esc="state.error"/><button type="button" class="refresh" t-on-click="load">Retry</button></div>
        <t t-if="d">
          <div class="breadcrumb-row"><div class="breadcrumb">VCET Campus / <strong>Academics</strong><t t-if="view !== 'overview'"> / <strong t-esc="title"/></t></div><div class="owner"><t t-esc="d.today"/> · <strong>Owner / Admin</strong></div></div>
          <div class="page-head"><div><h1 t-esc="title"/><p class="subtitle" t-esc="subtitle"/></div>
            <button t-if="view === 'overview'" type="button" class="refresh" t-on-click="load" t-att-disabled="state.loading">⟳ &#160;Refresh</button>
            <div t-else="" class="years-actions"><button type="button" class="filter-icon" aria-label="Show filters" title="Filters" t-att-aria-expanded="state.filtersOpen ? 'true' : 'false'" t-on-click="() => state.filtersOpen = !state.filtersOpen"><t t-call="ideastone_erp.AcademicFilterIcon"/></button><button t-if="d.can_edit &amp;&amp; d.create[view]" type="button" class="primary-btn" t-on-click="() => this.open()">＋ <t t-esc="addLabel"/></button><button type="button" class="academic-reload" aria-label="Refresh academic records" title="Refresh records" t-on-click="load" t-att-disabled="state.loading">⟳</button></div>
          </div>
          <t t-if="view === 'overview'"><t t-call="ideastone_erp.AcademicOverview"/></t>
          <t t-elif="view === 'years'"><t t-call="ideastone_erp.AcademicYears"/></t>
          <t t-else="">
            <section t-att-class="prefix + (['departments','programmes'].includes(view) ? '-summary' : '-kpis')">
              <article t-foreach="summary" t-as="metric" t-key="metric[0]" t-att-class="prefix + '-kpi'"><div t-att-class="prefix + '-kpi-top'"><span t-esc="metric[0]"/><span t-att-class="prefix + '-kpi-icon'" t-esc="metric[3]"/></div><strong t-esc="typeof metric[1] === 'number' ? number(metric[1]) : metric[1]"/><small t-esc="metric[2]"/></article>
            </section>
            <t t-if="view === 'departments'"><t t-call="ideastone_erp.AcademicDepartments"/></t>
            <t t-elif="view === 'programmes'"><t t-call="ideastone_erp.AcademicProgrammes"/></t>
            <t t-elif="view === 'semesters'"><t t-call="ideastone_erp.AcademicSemesters"/></t>
            <t t-elif="view === 'sections'"><t t-call="ideastone_erp.AcademicSections"/></t>
            <t t-elif="view === 'curriculum'"><t t-call="ideastone_erp.AcademicCurriculum"/></t>
          </t>
          <div class="footer-note">VCET Campus ERP · Owner / Admin workspace · Powered by Ideastone</div>
        </t>
      </div>
    </main>
  </t>
  <t t-name="ideastone_erp.AcademicFilterIcon"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 6h16M7 12h10m-7 6h4"/><path d="M4 6l3 6v6m13-12-3 6v6"/></svg></t>
  <t t-name="ideastone_erp.AcademicOverview">
    <section class="overview-grid"><article class="metric" t-foreach="stats" t-as="metric" t-key="metric.name" t-att-style="'--tint:' + metric.tint + ';--accent:' + metric.accent"><div class="metric-top"><span class="metric-name" t-esc="metric.name"/><span class="metric-icon" t-esc="metric.icon"/></div><div class="metric-value" t-esc="metric.value"/><div class="metric-foot" t-esc="metric.foot"/></article></section>
    <section class="mid-grid">
      <article class="panel"><div class="panel-head"><div><h2 class="panel-title">Academic delivery trend</h2><p class="panel-sub">Syllabus progress by month · current academic year</p></div><select class="select-mini" aria-label="Trend view" t-model="state.trend"><option value="progress">Syllabus progress</option><option value="classes">Classes completed</option></select></div>
        <div class="trend-content"><div class="chart-legend"><span><i class="legend-dot" style="background:#1769e8"/>Current year</span><span><i class="legend-dot" style="background:#b9d5ff"/><t t-esc="state.trend === 'classes' ? 'Scheduled classes' : 'Target pace'"/></span></div>
          <div class="chart" role="img" aria-label="Academic delivery by month"><div t-foreach="chart" t-as="month" t-key="month.month" class="bar-group" t-att-title="month.month + ': ' + (state.trend === 'classes' ? month.classes + ' completed / ' + month.scheduled + ' scheduled' : percent(month.progress) + ' delivered / ' + percent(month.target) + ' planned')"><div class="bar primary" t-att-style="'height:' + width(month.actual)"/><div class="bar secondary" t-att-style="'height:' + width(month.planned)"/></div><p t-if="!chart.length" class="academic-empty">Set a current academic year to view the delivery trend.</p></div>
          <div class="chart-labels"><span t-foreach="chart" t-as="month" t-key="month.month" t-esc="month.month"/></div>
          <div class="trend-note"><strong>Delivery pace: </strong><t t-if="c.coverage === null">No lesson hours are recorded as due. Save teaching plans and execution details to measure progress.</t><t t-else="">Recorded completion is <t t-esc="percent(c.coverage)"/> of lesson hours due. Use department reviews to identify where teaching plans need support.</t></div>
        </div>
      </article>
      <article class="panel ai-panel"><div class="ai-head"><div class="ai-symbol">✧</div><div><h2 class="ai-title">AI academic insights</h2><div class="ai-kicker">Signals to review · based on saved academic records</div></div></div><div class="ai-body"><div class="insight" t-foreach="insights" t-as="insight" t-key="insight.title"><div class="insight-mark" t-att-style="'--tint:' + insight.tint + ';--accent:' + insight.accent" t-esc="insight.icon"/><div><h3 t-esc="insight.title"/><p t-esc="insight.text"/><span class="insight-tag" t-att-style="'background:' + insight.tint + ';color:' + insight.accent" t-esc="insight.tag"/></div></div></div></article>
    </section>
    <section class="lower-grid"><article class="panel"><div class="panel-head"><div><h2 class="panel-title">Academic calendar &amp; milestones</h2><p class="panel-sub">Upcoming dates that may affect academic delivery</p></div><span class="pill">Next 30 days</span></div><div class="calendar-list"><div class="calendar-item" t-foreach="d.milestones" t-as="event" t-key="event_index"><div class="date-chip"><strong t-esc="event.date.slice(8)"/><span t-esc="month(event.date)"/></div><div><div class="event-name" t-esc="event.name"/><div class="event-meta" t-esc="event.detail"/></div><span class="status scheduled" t-esc="event.status"/></div><p t-if="!d.milestones.length" class="academic-empty">No saved semester milestones or examinations in the next 30 days.</p></div></article>
      <article class="panel"><div class="panel-head"><div><h2 class="panel-title">Curriculum readiness</h2><p class="panel-sub">Completion of key academic setup areas</p></div><span class="pill">4 areas</span></div><div class="program-body"><div class="program-row" t-foreach="d.readiness" t-as="area" t-key="area.name"><div class="program-top"><span class="program-name" t-esc="area.name"/><span class="program-percent" t-esc="percent(area.percent)"/></div><div class="track"><div class="fill" t-att-style="'width:' + width(area.percent)"/></div><div class="program-note" t-esc="area.percent === null ? 'No source records yet' : area.note"/></div></div></article>
    </section>
  </t>
  <t t-name="ideastone_erp.AcademicYears">
    <section class="year-metrics"><article class="year-stat current-stat"><div class="year-stat-top"><span>Current academic year</span><span class="stat-icon">✓</span></div><div class="year-stat-value" t-esc="current?.name || 'Not set'"/><div class="year-stat-foot"><span class="current-pill"><i/><t t-esc="current ? 'Active now' : 'Setup required'"/></span><span t-if="current"><t t-esc="date(current.start)"/> – <t t-esc="date(current.end)"/></span></div><div class="year-progress"><div t-att-style="'width:' + width(current?.progress)"/></div><div class="progress-caption"><span>Year progress</span><strong t-esc="percent(current?.progress)"/></div></article><article class="year-stat"><div class="year-stat-top"><span>Academic years recorded</span><span class="stat-icon blue-icon">▤</span></div><div class="year-stat-value" t-esc="number(d.rows.years.length)"/><div class="year-stat-foot">Including the current year</div><div class="year-stat-note">Historical records available</div></article><article class="year-stat"><div class="year-stat-top"><span>Next year setup</span><span class="stat-icon amber-icon">◷</span></div><div class="year-stat-value" t-esc="nextYear?.name || 'Not started'"/><div class="year-stat-foot" t-esc="nextYear ? date(nextYear.start) : 'Upcoming academic planning'"/><div class="year-stat-note">Create the next year when dates are approved</div></article></section>
    <section class="panel year-timeline-panel"><div class="panel-head"><div><h2 class="panel-title">Academic year timeline</h2><p class="panel-sub">A quick view of past, current and upcoming academic periods</p></div><span class="pill"><t t-esc="d.rows.years.length"/> records</span></div><div class="year-timeline"><div class="timeline-line"/><div t-foreach="d.rows.years.slice().reverse()" t-as="year" t-key="year.id" class="timeline-item" t-att-class="year.status === 'current' ? 'active-year' : 'past'"><div class="timeline-dot"/><div class="timeline-copy"><strong><t t-esc="year.name"/><em t-if="year.status === 'current'">Current</em></strong><span><t t-esc="date(year.start)"/> – <t t-esc="date(year.end)"/></span></div><span class="timeline-status" t-esc="year.status === 'current' ? 'In progress' : year.status"/></div><p t-if="!d.rows.years.length" class="academic-empty">No academic years recorded.</p></div></section>
    <section class="panel year-records-panel"><div class="panel-head year-records-head"><div><h2 class="panel-title">Academic year records</h2><p class="panel-sub">Review date ranges and the active-year setting</p></div><div class="record-tools"><label class="year-search"><span>⌕</span><input type="search" placeholder="Search years…" aria-label="Search academic years" t-model="state.query"/></label></div></div><t t-call="ideastone_erp.AcademicFilters"/>
      <div class="table-wrap" tabindex="0" aria-label="Academic year records"><table class="year-table"><thead><tr><th>Academic year</th><th>Start date</th><th>End date</th><th>Duration</th><th>Status</th><th/></tr></thead><tbody><tr t-foreach="rows" t-as="row" t-key="row.id"><td><strong t-esc="row.name"/><span class="table-sub" t-esc="row.status === 'current' ? 'Current academic year' : 'Academic record'"/></td><td t-esc="date(row.start)"/><td t-esc="date(row.end)"/><td><t t-esc="row.duration"/> months</td><td><span class="record-status" t-att-class="row.status === 'current' ? 'live' : ''" t-esc="row.status === 'current' ? '● Active' : row.status"/></td><td><button type="button" class="row-more" t-att-aria-label="'View ' + row.name" t-on-click="() => this.open(row)">•••</button></td></tr><tr t-if="!rows.length"><td colspan="6" class="academic-empty">No academic years match these filters.</td></tr></tbody></table></div><t t-call="ideastone_erp.AcademicFooter"/></section>
  </t>
  <t t-name="ideastone_erp.AcademicDepartments">
    <section class="panel"><div class="dept-toolbar"><div><h2>Department directory</h2><p>Select a department to review its programme and section overview.</p></div><div class="dept-tools"><label class="dept-search"><span>⌕</span><input type="search" placeholder="Search departments…" aria-label="Search departments" t-model="state.query"/></label></div></div><t t-call="ideastone_erp.AcademicFilters"/>
      <div class="dept-grid"><article class="dept-card" t-foreach="rows" t-as="row" t-key="row.id"><div class="dept-card-head"><span class="dept-icon" t-esc="initials(row.name)"/><div class="dept-name-wrap"><div class="dept-name" t-esc="row.name"/><span class="dept-active"><i/><t t-esc="row.active ? 'Active' : 'Archived'"/></span></div><span class="dept-code" t-esc="row.code"/></div><div class="dept-meta"><span><t t-esc="row.sections"/> class sections</span><span>Current academic year</span></div><div class="dept-main-count"><strong t-esc="number(row.students)"/><span>/ <t t-esc="row.capacity ? number(row.capacity) : '—'"/> seats</span></div><div class="dept-progress"><span t-att-style="'width:' + width(row.fill)"/></div><div class="dept-capacity"><span>Capacity used</span><strong t-esc="percent(row.fill)"/></div><div class="dept-card-bottom"><div class="dept-mini-stats"><span><strong t-esc="row.sections"/>Sections</span><span><strong t-esc="row.faculty"/>Faculty</span></div><button type="button" class="dept-view-btn" t-on-click="() => this.open(row)">View department ↗</button></div></article><p t-if="!rows.length" class="dept-empty">No departments match these filters.</p></div><t t-call="ideastone_erp.AcademicFooter"/>
    </section>
  </t>
  <t t-name="ideastone_erp.AcademicProgrammes">
    <section class="programme-directory"><div class="programme-toolbar"><div><h2>Programme directory</h2><p>Search by programme name or code, or narrow the list by department and duration.</p></div><div class="programme-tools"><label class="programme-search"><span>⌕</span><input type="search" placeholder="Search programmes…" aria-label="Search programmes" t-model="state.query"/></label></div></div><t t-call="ideastone_erp.AcademicFilters"/>
      <div class="programme-cards"><article class="programme-card" t-foreach="rows" t-as="row" t-key="row.id"><div class="programme-card-top"><span class="programme-mark" t-esc="initials(row.name)"/><span class="programme-code" t-esc="row.code"/></div><h3 t-esc="row.name"/><div class="programme-dept" t-esc="row.department"/><div class="programme-card-meta"><span>Programme duration</span><span class="programme-duration"><t t-esc="row.duration"/> semesters</span></div><div class="programme-card-bottom"><span class="programme-status" t-esc="row.active ? 'Active record' : 'Archived record'"/><button type="button" class="programme-view" t-on-click="() => this.open(row)">View details ↗</button></div></article><p t-if="!rows.length" class="programme-empty">No programmes match these filters.</p></div><t t-call="ideastone_erp.AcademicFooter"/>
    </section>
  </t>
  <t t-name="ideastone_erp.AcademicSemesters">
    <section class="semester-focus-grid"><article class="semester-panel"><div class="semester-panel-head"><div><h2>Semester cycle</h2><p>Standard eight-semester programme structure</p></div><span class="semester-tag">4-year pathway</span></div><div class="semester-cycle"><div class="cycle-track"><span t-foreach="[1,2,3,4,5,6,7,8]" t-as="sequence" t-key="sequence" class="cycle-step" t-att-title="'Semester ' + sequence"/></div><div class="cycle-labels"><div class="cycle-label" t-foreach="[1,2,3,4]" t-as="year" t-key="year"><span>Year <t t-esc="year"/></span><strong>Semesters <t t-esc="year * 2 - 1"/>–<t t-esc="year * 2"/></strong></div></div></div></article><aside class="semester-insight"><div class="insight-title"><span class="insight-spark">✦</span> AI academic insight</div><p><t t-esc="c.missing_terms"/> semester records have no programme mapping. Confirm each academic period before linking curriculum and section plans.</p><div class="insight-points"><div class="insight-point"><i>→</i><span>Standardise semester names and sequence numbers across programmes.</span></div><div class="insight-point"><i>→</i><span>Verify academic-year dates and programme mapping for every active semester.</span></div></div></aside></section>
    <section class="semester-directory"><div class="semester-toolbar"><div><h2>Semester directory</h2><p>Search and filter academic periods without crowding the page with administrative fields.</p></div><div class="semester-tools"><label class="semester-search"><span>⌕</span><input type="search" placeholder="Search semesters…" aria-label="Search semesters" t-model="state.query"/></label></div></div><t t-call="ideastone_erp.AcademicFilters"/>
      <div class="semester-cards"><article class="semester-card" t-foreach="rows" t-as="row" t-key="row.id"><div class="semester-card-top"><span class="semester-mark" t-esc="row.sequence"/><span class="semester-status" t-att-class="row.status === 'current' ? 'active' : 'historical'" t-esc="row.status"/></div><h3 t-esc="row.name"/><div class="semester-year">Academic year · <t t-esc="row.year"/></div><div class="semester-card-meta"><div><span>Period type</span><strong t-esc="row.period_type === 'quarter' ? 'Quarter' : 'Semester'"/></div><div><span>Semester / year no.</span><strong t-esc="row.sequence"/></div></div><div class="semester-card-bottom"><span class="semester-programme" t-esc="row.programme"/><button type="button" class="semester-view" t-on-click="() => this.open(row)">View details ↗</button></div></article><p t-if="!rows.length" class="semester-empty">No semesters match these filters.</p></div><t t-call="ideastone_erp.AcademicFooter"/>
    </section>
  </t>
  <t t-name="ideastone_erp.AcademicSections">
    <section class="section-overview"><article class="section-panel"><div class="section-panel-head"><div><h2>Section distribution</h2><p>Class sections grouped by their recorded programme</p></div><span class="section-tag">Programme overview</span></div><div class="section-distribution"><div class="section-dist-row" t-foreach="sectionDistribution" t-as="group" t-key="group.name"><span t-esc="group.name"/><div class="section-dist-track"><span t-att-style="'width:' + group.width"/></div><strong t-esc="group.count"/></div><p t-if="!sectionDistribution.length" class="academic-empty">No sections recorded.</p></div></article><aside class="section-insight"><div class="section-insight-title"><span class="section-spark">✦</span>Academic setup insight</div><p><t t-esc="c.missing_sections"/> active sections need academic-year or semester mapping. Validate these before timetable, attendance or assessment allocation.</p><div class="section-insight-list"><div class="section-insight-item"><i>→</i><span>Prioritise mapping the section to its academic year and semester.</span></div><div class="section-insight-item"><i>→</i><span>Confirm each section code is unique before creating additional cohorts.</span></div></div></aside></section>
    <section class="section-directory"><div class="section-toolbar"><div><h2>Section records</h2><p>Search and filter the section directory</p></div><div class="section-tools"><label class="section-search"><span>⌕</span><input type="search" placeholder="Search name, code or course…" aria-label="Search sections" t-model="state.query"/></label></div></div><t t-call="ideastone_erp.AcademicFilters"/>
      <div class="section-cards"><article class="section-card" t-foreach="rows" t-as="row" t-key="row.id"><div class="section-card-top"><span class="section-mark" t-esc="initials(row.name)"/><span class="section-code" t-esc="row.code"/></div><h3 t-esc="row.name"/><div class="section-course" t-esc="row.programme"/><div class="section-card-meta"><div><span>Academic year</span><strong t-esc="row.year"/></div><div><span>Semester</span><strong t-esc="row.semester"/></div></div><div class="section-card-bottom"><span class="section-mapping" t-esc="row.mapped ? 'Mapped' : 'Mapping to verify'"/><button type="button" class="section-view" t-on-click="() => this.open(row)">View details ↗</button></div></article><p t-if="!rows.length" class="section-empty">No section records match these filters.</p></div><t t-call="ideastone_erp.AcademicFooter"/>
    </section>
  </t>
  <t t-name="ideastone_erp.AcademicCurriculum">
    <section class="curriculum-top-grid"><article class="curriculum-panel"><div class="curriculum-panel-head"><div><h2>Subject distribution</h2><p>Active subjects grouped by their recorded department</p></div><span class="curriculum-chip">Curriculum overview</span></div><div class="curriculum-bars"><div class="curriculum-bar-row" t-foreach="distribution" t-as="group" t-key="group.name"><span t-esc="group.name"/><div class="curriculum-track"><span t-att-style="'width:' + group.width"/></div><strong t-esc="group.count"/></div><p t-if="!distribution.length" class="academic-empty">No active subjects recorded.</p></div></article><aside class="curriculum-insight"><div class="curriculum-insight-title"><span class="curriculum-spark">✦</span> AI curriculum insight</div><p><t t-esc="c.missing_credits"/> active subjects have zero credits and <t t-esc="c.missing_subjects"/> lack semester mapping. Treat these as data-quality checks before publishing curriculum information.</p><div class="curriculum-insight-list"><div class="curriculum-insight-item"><i>→</i><span>Confirm credit values against the approved curriculum before publishing.</span></div><div class="curriculum-insight-item"><i>→</i><span>Verify semester and department mappings for every subject.</span></div><div class="curriculum-insight-item"><i>→</i><span>Consider applied projects and interdisciplinary electives during curriculum review.</span></div></div></aside></section>
    <section class="curriculum-directory"><div class="curriculum-toolbar"><div><h2>Subject directory</h2><p>Search the subject catalogue by name, code or department.</p></div><div class="curriculum-tools"><label class="curriculum-search"><span>⌕</span><input type="search" placeholder="Search subjects…" aria-label="Search subjects" t-model="state.query"/></label></div></div><t t-call="ideastone_erp.AcademicFilters"/>
      <div class="curriculum-table-wrap" tabindex="0" aria-label="Subject directory"><table class="curriculum-table"><thead><tr><th>Subject name</th><th>Code</th><th>Department</th><th>Semester</th><th>Credits</th><th/></tr></thead><tbody><tr t-foreach="rows" t-as="row" t-key="row.id"><td class="curriculum-subject-name"><button type="button" class="academic-subject-link" t-on-click="() => this.open(row)" t-esc="row.name"/></td><td><span class="curriculum-code" t-esc="row.code"/></td><td class="curriculum-dept" t-esc="row.department"/><td><span class="curriculum-semester" t-esc="row.semester"/></td><td class="curriculum-credit" t-esc="number(row.credits,2)"/><td><button type="button" class="row-more" t-att-aria-label="'View ' + row.name" t-on-click="() => this.open(row)">•••</button></td></tr></tbody></table><p t-if="!rows.length" class="curriculum-empty">No subjects match the selected filters.</p></div><t t-call="ideastone_erp.AcademicFooter"/>
    </section>
  </t>
  <t t-name="ideastone_erp.AcademicFilters">
    <div t-if="state.filtersOpen" class="academic-filters">
      <t t-if="view === 'years'"><label>Year status<select aria-label="Status" t-model="state.filters.status"><option value="">All statuses</option><option value="current">Current</option><option value="completed">Completed</option><option value="upcoming">Upcoming</option><option value="archived">Archived</option></select></label><label>Start year<input type="number" placeholder="e.g. 2022" t-model="state.filters.from"/></label></t>
      <t t-if="view === 'departments'"><label>Department status<select aria-label="Status" t-model="state.filters.status"><option value="">All departments</option><option value="active">Active only</option></select></label></t>
      <label t-if="['departments','sections'].includes(view)">Academic area<select aria-label="Academic area" t-model="state.filters.area"><option value="">All areas</option><option t-foreach="areas" t-as="area" t-key="area[0]" t-att-value="area[0]" t-esc="area[1]"/></select></label>
      <label t-if="['programmes','curriculum'].includes(view)">Department<select aria-label="Department" t-model="state.filters.department"><option value="">All departments</option><option t-foreach="d.rows.departments" t-as="dept" t-key="dept.id" t-att-value="dept.id" t-esc="dept.name"/></select></label>
      <t t-if="view === 'programmes'"><label>Programme level<select aria-label="Programme level" t-model="state.filters.level"><option value="">All levels</option><option t-foreach="levels" t-as="level" t-key="level[0]" t-att-value="level[0]" t-esc="level[1]"/></select></label><label>Duration<select aria-label="Duration" t-model="state.filters.duration"><option value="">All durations</option><option value="8">4 years · 8 semesters</option><option value="4">2 years · 4 semesters</option><option value="6">3 years · 6 semesters</option></select></label></t>
      <label t-if="['semesters','sections'].includes(view)">Academic year<select aria-label="Academic year" t-model="state.filters.year"><option value="">All academic years</option><option t-foreach="d.rows.years" t-as="year" t-key="year.id" t-att-value="year.id" t-esc="year.name"/><option t-if="view === 'sections'" value="missing">Not specified</option></select></label>
      <label t-if="view === 'semesters'">Period type<select aria-label="Period type" t-model="state.filters.period"><option value="">All period types</option><option value="semester">Semester</option><option value="quarter">Quarter</option></select></label>
      <label t-if="['sections','curriculum'].includes(view)">Semester mapping<select aria-label="Semester mapping" t-model="state.filters.mapping"><option value="">All mappings</option><option value="mapped">Specified</option><option value="missing">Mapping to verify</option></select></label>
      <label t-if="view === 'curriculum'">Credit status<select aria-label="Credit status" t-model="state.filters.credits"><option value="">All credit values</option><option value="zero">0.00 credits</option><option value="positive">Credits above zero</option></select></label>
      <button type="button" class="clear-filters" t-on-click="clearFilters">Clear filters</button>
    </div>
  </t>
  <t t-name="ideastone_erp.AcademicFooter"><div class="table-footer"><span>Showing <t t-esc="rows.length"/> <t t-esc="title.toLowerCase()"/> records</span><span t-esc="d.is_demo ? 'Demonstration college · Sample academic records' : 'Saved academic records · Active college'"/></div></t>
  <t t-name="ideastone_erp.AcademicRecord">
    <Dialog title="title" size="'lg'" contentClass="'campus_academics_record'">
      <div class="academic-record-heading"><p t-esc="props.view === 'departments' ? 'Department overview · Current academic year' : 'Academic record details'"/></div>
      <div t-if="state.error" class="academic-error" role="alert" t-esc="state.error"/>
      <t t-if="props.record &amp;&amp; props.view === 'departments' &amp;&amp; !state.editing"><div class="dept-detail-grid"><div class="dept-detail-stat"><span>Enrolled students</span><strong t-esc="props.record.students"/></div><div class="dept-detail-stat"><span>Class sections</span><strong t-esc="props.record.sections"/></div><div class="dept-detail-stat"><span>Faculty</span><strong t-esc="props.record.faculty"/></div></div><div class="dept-section-list"><div class="dept-section-row" t-foreach="props.record.section_rows" t-as="section" t-key="section.id"><strong t-esc="section.name"/><span><t t-esc="section.students"/> students</span></div><p t-if="!props.record.section_rows.length" class="academic-empty">No sections mapped to the current academic year.</p></div></t>
      <form id="academic-record-form" class="academic-form" t-on-submit.prevent="save">
        <label t-foreach="fields" t-as="field" t-key="field.key" t-att-class="field.type === 'checkbox' ? 'academic-checkbox' : ''"><span t-esc="field.label"/>
          <strong t-if="!state.editing" class="academic-read-value" t-esc="display(field)"/>
          <select t-att-aria-label="field.label" t-elif="field.type === 'select'" t-att-value="state.values[field.key] || ''" t-att-required="field.required" t-on-change="(event) => this.change(field,event)"><option value="">Not specified</option><option t-foreach="field.options" t-as="option" t-key="option[0]" t-att-value="option[0]" t-att-selected="option[0] == state.values[field.key]" t-esc="option[1]"/></select>
          <input t-else="" t-att-aria-label="field.label" t-att-type="field.type" t-att-value="state.values[field.key]" t-att-checked="field.type === 'checkbox' ? state.values[field.key] : undefined" t-att-required="field.required" t-att-min="field.type === 'number' ? (field.key === 'campus_credits' ? 0 : 1) : undefined" t-att-max="field.type === 'number' &amp;&amp; field.key !== 'campus_credits' ? 100 : undefined" t-att-step="field.type === 'number' ? (field.key === 'campus_credits' ? '0.01' : '1') : undefined" t-att-maxlength="field.type === 'text' ? (field.key === 'code' &amp;&amp; ['programmes','sections'].includes(props.view) ? 16 : field.key === 'name' &amp;&amp; props.view === 'sections' ? 32 : 256) : undefined" t-on-input="(event) => this.change(field,event)"/>
        </label>
      </form>
      <t t-set-slot="footer"><button t-if="state.editing" type="submit" form="academic-record-form" class="btn btn-primary" t-att-disabled="state.busy"><t t-esc="state.busy ? 'Saving…' : 'Save record'"/></button><button t-elif="props.data.can_edit" type="button" class="btn btn-primary" t-on-click="() => state.editing = true">Edit record</button><button type="button" class="btn btn-secondary" t-on-click="props.close" t-att-disabled="state.busy">Close</button></t>
    </Dialog>
  </t>
</templates>
