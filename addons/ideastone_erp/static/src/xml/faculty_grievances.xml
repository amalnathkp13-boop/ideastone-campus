<templates xml:space="preserve">
  <t t-name="ideastone_erp.FacultyGrievances">
    <main class="campus_faculty_grievances" id="campus_main">
      <div class="grv_crumb"><span>VCET Campus / Grievances &amp; others</span><span><t t-esc="formatDate(state.today)"/> · Faculty</span></div>
      <header class="grv_head"><div><h1>Grievances &amp; others</h1><p>Submit a concern, track its progress and review responses from the relevant campus team.</p></div><button type="button" class="grv_btn" t-on-click="load" t-att-disabled="state.loading"><i class="fa fa-refresh" aria-hidden="true"/> Refresh</button></header>
      <p t-if="state.error" class="grv_error" role="alert"><t t-esc="state.error"/> <button type="button" t-on-click="load">Retry</button></p>
      <p t-if="state.loading" role="status">Loading your grievances…</p>
      <t t-else="">
        <section class="grv_intro"><span class="grv_intro_icon"><i class="fa fa-comments-o" aria-hidden="true"/></span><div><h2>My grievances</h2><p>Manage staff requests and concerns in one place, with clear status and follow-up details.</p></div><span class="grv_pill">Faculty workspace</span></section>
        <section class="grv_stats" aria-label="Grievance summary">
          <article class="grv_stat"><div><span class="grv_stat_icon"><i class="fa fa-file-text-o" aria-hidden="true"/></span><span>Total submissions</span></div><strong t-esc="counts.total"/><small>All requests on your account</small></article>
          <article class="grv_stat"><div><span class="grv_stat_icon"><i class="fa fa-clock-o" aria-hidden="true"/></span><span>Awaiting review</span></div><strong t-esc="counts.open"/><small>Submitted to campus team</small></article>
          <article class="grv_stat"><div><span class="grv_stat_icon"><i class="fa fa-refresh" aria-hidden="true"/></span><span>In progress</span></div><strong t-esc="counts.progress"/><small>Being reviewed or actioned</small></article>
          <article class="grv_stat"><div><span class="grv_stat_icon"><i class="fa fa-check" aria-hidden="true"/></span><span>Resolved</span></div><strong t-esc="counts.resolved"/><small>Response recorded</small></article>
        </section>
        <div class="grv_workspace"><section class="grv_panel grv_requests" aria-labelledby="grv_requests_title">
          <div class="grv_panel_head"><h2 id="grv_requests_title"><i class="fa fa-file-text-o" aria-hidden="true"/> My grievance requests</h2><button type="button" class="grv_btn grv_primary" t-on-click="openNew"><i class="fa fa-plus" aria-hidden="true"/> New grievance</button></div>
          <div class="grv_filters"><label class="grv_search"><span class="visually-hidden">Search grievances</span><i class="fa fa-search" aria-hidden="true"/><input type="search" placeholder="Search ID, subject or category" t-model="state.search" t-on-input="changeFilter"/></label><label><span class="visually-hidden">Category</span><select t-model="state.category" t-on-change="changeFilter"><option value="all">All categories</option><option t-foreach="categories" t-as="category" t-key="category" t-att-value="category" t-esc="category"/></select></label><label><span class="visually-hidden">Status</span><select t-model="state.status" t-on-change="changeFilter"><option value="all">All statuses</option><option value="Open">Open</option><option value="In progress">In progress</option><option value="Resolved">Resolved</option><option value="Closed">Closed</option></select></label></div>
          <div class="grv_tabs" role="group" aria-label="Request status"><button type="button" t-att-class="{active: state.tab === 'all'}" t-on-click="() => this.setTab('all')">All requests</button><button type="button" t-att-class="{active: state.tab === 'Open'}" t-on-click="() => this.setTab('Open')">Open</button><button type="button" t-att-class="{active: state.tab === 'In progress'}" t-on-click="() => this.setTab('In progress')">In progress</button><button type="button" t-att-class="{active: state.tab === 'Resolved'}" t-on-click="() => this.setTab('Resolved')">Resolved</button></div>
          <div class="grv_table_wrap" tabindex="0" aria-label="Grievance requests; scroll horizontally on small screens"><table><thead><tr><th scope="col">Request ID</th><th scope="col">Subject / category</th><th scope="col">Submitted</th><th scope="col">Priority</th><th scope="col">Status</th><th scope="col">Action</th></tr></thead><tbody><tr t-foreach="pageRows" t-as="row" t-key="row.id"><td><span class="grv_reqid" t-esc="row.reference"/></td><td><strong t-esc="row.subject"/><small t-esc="row.category"/></td><td t-esc="formatDate(row.date)"/><td><span t-att-class="'grv_priority ' + row.priority.toLowerCase()" t-esc="row.priority"/></td><td><span t-att-class="'grv_status ' + row.tone" t-esc="row.status"/></td><td><button type="button" class="grv_row_button" t-on-click="() => this.openDetails(row)">View details</button></td></tr><tr t-if="!pageRows.length"><td colspan="6" class="grv_empty">No requests match the selected filters.</td></tr></tbody></table></div>
          <div class="grv_listfoot"><span><t t-esc="filteredRows.length"/> request(s)</span><div><button type="button" t-att-disabled="state.page === 1" t-on-click="() => this.setPage(state.page - 1)" aria-label="Previous page">‹</button><button type="button" class="active" aria-current="page" t-esc="state.page"/><button type="button" t-att-disabled="state.page === pageCount" t-on-click="() => this.setPage(state.page + 1)" aria-label="Next page">›</button></div></div>
        </section><aside class="grv_side">
          <section class="grv_panel"><h2><i class="fa fa-lightbulb-o" aria-hidden="true"/> Suggested next steps</h2><div class="grv_insight"><span>✦ STAFF ASSISTANT</span><h3>Keep your request moving</h3><p>Use the request details to follow up with the right team. These suggestions are general guidance, not live case analysis.</p><div><strong>1. Add supporting details</strong>Include dates, reference numbers or screenshots when relevant to help the team investigate.</div><div><strong>2. Review pending requests</strong>Check the status and latest response before creating a duplicate request.</div><div><strong>3. Follow up appropriately</strong>For urgent operational issues, contact the responsible campus office directly.</div></div></section>
          <section class="grv_panel"><h2><i class="fa fa-info-circle" aria-hidden="true"/> Help &amp; contact</h2><div class="grv_contact"><span>General administration</span><strong>Campus Office</strong></div><div class="grv_contact"><span>IT-related issues</span><strong>IT Support Desk</strong></div><div class="grv_contact"><span>Salary / payroll</span><strong>HR &amp; Payroll</strong></div><div class="grv_contact"><span>Typical response target</span><strong>2–5 working days</strong></div><p class="grv_contact_note">Contact details and response targets are illustrative. Follow the college's official process for urgent matters.</p></section>
        </aside></div>
        <footer class="grv_footer">VCET Campus ERP · Faculty workspace · Powered by Ideastone</footer>
      </t>
      <div t-if="state.modal" class="grv_modal_back" t-on-click="backdrop"><div class="grv_modal" t-ref="modal" role="dialog" aria-modal="true" t-att-aria-labelledby="state.modal === 'new' ? 'grv_new_title' : 'grv_detail_title'"><div class="grv_modal_head"><h2 t-if="state.modal === 'new'" id="grv_new_title">Submit a grievance</h2><h2 t-else="" id="grv_detail_title">Grievance details</h2><button type="button" aria-label="Close" t-on-click="closeModal">×</button></div>
        <form t-if="state.modal === 'new'" t-on-submit.prevent="submit"><div class="grv_modal_body"><div class="grv_formgrid"><label>Subject *<input required="required" maxlength="200" placeholder="Briefly describe the issue" t-model="state.form.subject"/></label><label>Category *<select required="required" t-model="state.form.category"><option value="">Select category</option><option value="facilities">Facilities</option><option value="it">IT Support</option><option value="payroll">Payroll</option><option value="academic">Academic Administration</option></select></label><label>Priority<select t-model="state.form.priority"><option value="medium">Medium</option><option value="high">High</option><option value="low">Low</option></select></label><label>Date of incident<input type="date" t-att-max="state.today" t-model="state.form.incident_date"/></label><label class="grv_full">Description *<textarea required="required" maxlength="5000" rows="5" placeholder="Provide details that will help the responsible team review your request." t-model="state.form.description"/></label><label class="grv_full">Preferred contact / extension (optional)<input maxlength="200" placeholder="Office extension or campus email" t-model="state.form.contact"/></label></div><p class="grv_hint">Your request is saved in the campus ERP and sent through the existing review workflow.</p></div><div class="grv_modal_foot"><button type="button" class="grv_btn" t-on-click="closeModal">Cancel</button><button type="submit" class="grv_btn grv_primary" t-att-disabled="state.saving"><t t-esc="state.saving ? 'Submitting…' : 'Submit grievance'"/></button></div></form>
        <div t-else="" class="grv_modal_body"><t t-if="state.selected"><p><strong t-esc="state.selected.reference"/> · <t t-esc="state.selected.subject"/></p><div class="grv_detailgrid"><span>Category</span><strong t-esc="state.selected.category"/><span>Submitted</span><strong t-esc="formatDate(state.selected.date)"/><span>Priority</span><strong t-esc="state.selected.priority"/><span>Status</span><strong t-esc="state.selected.status"/><t t-if="state.selected.incident_date"><span>Incident date</span><strong t-esc="formatDate(state.selected.incident_date)"/></t><t t-if="state.selected.contact"><span>Preferred contact</span><strong t-esc="state.selected.contact"/></t></div><h3>Description</h3><p t-esc="state.selected.description"/><h3>Latest response</h3><p t-esc="state.selected.resolution || 'No response recorded yet.'"/></t></div>
      </div></div>
    </main>
  </t>
</templates>
