<templates xml:space="preserve">
  <t t-name="ideastone_erp.FacultyProfileWorkspace">
    <main class="campus_faculty_profile_workspace" tabindex="0"><div class="content">
      <p t-if="state.loading" role="status">Refreshing your staff records…</p>
      <div t-if="state.error" class="error" role="alert"><t t-esc="state.error"/><button type="button" class="link-btn" t-on-click="load">Retry</button></div>
      <t t-if="d">
        <div class="breadcrumb"><span>VCET Campus</span><span>›</span><span>My profile &amp; payroll</span><span>›</span><span t-esc="title"/></div>
        <section class="submodule active" t-att-id="'tab-'+page">
          <div class="page-heading"><div><h1 t-esc="page === 'leave' ? 'Online Leave Apply &amp; Status' : title"/><p t-esc="subtitles[page]"/></div><div class="heading-actions">
            <t t-if="page === 'myprofile'"><button class="btn" t-on-click="() =&gt; this.exportData('myprofile')">↗ Preview profile</button><button class="btn primary" t-att-disabled="!state.editing || state.busy" t-on-click="saveProfile">Save changes</button></t>
            <t t-elif="page === 'qualifications'"><button class="btn primary" t-on-click="() =&gt; this.edit('document')">＋ Upload document</button><button class="btn" t-on-click="() =&gt; this.exportData()">Export checklist</button></t>
            <t t-elif="page === 'development'"><button class="btn" t-on-click="() =&gt; this.exportData()">↓ Export summary</button><button class="btn primary" t-on-click="() =&gt; this.edit('activity')">＋ Add activity</button></t>
            <t t-elif="page === 'agreements'"><button class="btn" t-on-click="() =&gt; this.exportData()">↓ Download summary</button><button class="btn primary" t-on-click="() =&gt; notification.add('Contact your reporting authority or HR to request a review of salary terms.',{type:'info'})">＋ Request review</button></t>
            <t t-elif="page === 'monthly'"><select class="filter" aria-label="Payroll month" t-model="state.slip"><option t-if="!d.payroll.length" value="0">No approved payroll</option><option t-foreach="d.payroll" t-as="row" t-key="row.id" t-att-value="row.id" t-esc="period(row.date_from)"/></select><button class="btn primary" t-att-disabled="!slip" t-on-click="() =&gt; this.recordAction('payslip',slip?.id)">↓ View payslip</button></t>
            <t t-elif="page === 'history'"><span class="pill blue">▣ Your payroll records</span></t>
            <button t-if="page === 'leave'" class="btn" aria-label="Refresh staff records" t-on-click="load" t-att-disabled="state.loading">⟳ <t t-if="page === 'leave'">Refresh</t></button>
          </div></div>
          <t t-if="page === 'history'"><div class="panel" style="margin-bottom:14px"><div class="filters">
            <div class="field"><label for="historyReport">Report options</label><select id="historyReport" t-model="state.report"><option>Complete History</option><option>Salary only</option><option>Deductions only</option><option>Contributions only</option></select></div>
            <div class="field"><label for="historyYear">Year</label><select id="historyYear" t-model="state.year"><option value="">All</option><option t-foreach="years" t-as="year" t-key="year" t-att-value="year" t-esc="year"/></select></div>
            <div class="field"><label for="historyMonth">Month</label><select id="historyMonth" t-model="state.month"><option value="">All</option><option t-foreach="months" t-as="month" t-key="month" t-att-value="month_index+1" t-esc="month"/></select></div>
            <button class="btn primary" t-on-click="() =&gt; this.exportData('history')">↓ Download / Export</button>
          </div></div></t>
          <t t-if="page !== 'development' &amp;&amp; page !== 'leave'" t-call="ideastone_erp.StaffStats"/><t t-if="page === 'myprofile'">
            <div class="grid cols"><div class="panel"><div class="panel-head"><div><h2 class="panel-title">Personal information</h2><p class="panel-desc">Basic identity and contact details associated with your staff account.</p></div><span class="pill green">● Active staff</span></div>
              <div class="profile-summary"><div class="profile-photo" t-esc="initials(p.name)"/><div style="flex:1"><h2 t-esc="p.name"/><p><t t-esc="p.campus_designation || 'Designation not recorded'"/> · <t t-esc="relation(p.main_department_id)"/></p><div style="margin-top:7px"><span class="pill blue">Staff ID · <t t-esc="p.campus_staff_code || 'Not recorded'"/></span></div></div><button class="btn" t-on-click="() =&gt; state.editing = !state.editing" t-esc="state.editing ? 'Cancel editing' : '✎ Edit'"/></div>
              <div class="detail-grid"><div t-foreach="details" t-as="detail" t-key="detail[0]"><div class="detail-label" t-esc="detail[0]"/><input t-if="state.editing &amp;&amp; detail[2]" class="detail-edit" t-att-aria-label="detail[0]" t-att-value="state.profile[detail[2]]" t-on-input="(ev) =&gt; state.profile[detail[2]] = ev.target.value"/><div t-else="" class="detail-value" t-esc="detail[1] || 'Not recorded'"/></div></div>
              <div class="progress-row"><span>Profile completion</span><strong><t t-esc="p.completion"/>%</strong></div><div class="progress"><span t-att-style="'width:'+p.completion+'%'"/></div>
            </div><t t-call="ideastone_erp.StaffGuidance"/></div>
            <div class="panel"><div class="panel-head"><div><h2 class="section-title">Items requiring attention</h2><p class="panel-desc">Complete these to keep your staff record current.</p></div><button class="link-btn" t-on-click="() =&gt; this.go('qualifications')">View documents →</button></div><div class="action-list"><div class="action-row"><span class="action-icon">▤</span><div class="action-copy"><strong>Upload latest qualification / certification record</strong><span>Qualifications and documents · Required for record completeness</span></div><span class="pill amber" t-esc="d.documents.length-verified + ' pending'"/><button class="link-btn" t-on-click="() =&gt; this.go('qualifications')">Open</button></div><div class="action-row"><span class="action-icon">♧</span><div class="action-copy"><strong>Confirm emergency contact</strong><span>Personal information · Keep your contact current</span></div><span class="pill blue">Review</span><button class="link-btn" t-on-click="() =&gt; state.editing = true">Review</button></div></div></div>
          </t>

          <t t-elif="page === 'qualifications'"><div class="grid cols"><div class="panel"><div class="panel-head"><div><h2 class="panel-title">Document register</h2><p class="panel-desc">Saved qualification and document records; review is controlled by HR.</p></div><span class="pill blue"><t t-esc="documents.length"/> records</span></div><div class="table-toolbar"><input class="search" placeholder="Search documents…" aria-label="Search documents" t-model="state.query"/><select class="filter" aria-label="Document status" t-model="state.status"><option value="">All statuses</option><option>Verified</option><option>Pending</option><option>Missing</option><option>Expiring soon</option><option>Expired</option></select></div><div class="table-wrap"><table><thead><tr><th>Document</th><th>Category</th><th>Uploaded</th><th>Status</th><th>Action</th></tr></thead><tbody><tr t-foreach="documents" t-as="row" t-key="row.id"><td><strong t-esc="row.name"/></td><td t-esc="row.campus_category || row.kind"/><td t-esc="date(row.create_date)"/><td><span class="pill" t-att-class="tone(row.status)" t-esc="row.status"/></td><td><button class="link-btn" t-on-click="() =&gt; this.edit('document',row)">View / edit</button><button t-if="row.filename" class="link-btn" t-on-click="() =&gt; this.recordAction('document',row.id)">Download</button></td></tr><tr t-if="!documents.length"><td colspan="5" class="empty">No documents match these filters.</td></tr></tbody></table></div></div><t t-call="ideastone_erp.StaffGuidance"/></div></t>

          <t t-elif="page === 'development'">
            <div class="panel" style="margin-bottom:16px"><div class="panel-head"><div><h2 class="panel-title">Portfolio filters</h2><p class="panel-desc">Your portfolio in the active college.</p></div><span class="pill blue">Staff portfolio</span></div><div class="filters"><div class="field"><label>Institution</label><select aria-label="Institution"><option t-esc="d.company"/></select></div><div class="field"><label>Department</label><select aria-label="Department"><option t-esc="relation(p.main_department_id)"/></select></div><div class="field"><label>Staff</label><select aria-label="Staff"><option t-esc="p.name"/></select></div><button class="btn" t-on-click="() =&gt; this.exportData()">↓ Export</button></div></div>
            <t t-call="ideastone_erp.StaffStats"/><div class="panel dev-portfolio" style="margin-bottom:16px"><div class="panel-head"><div><h2 class="panel-title">Professional portfolio</h2><p class="panel-desc">Choose a category to review or record activities relevant to your appraisal.</p></div><span class="pill blue">Saved development records</span></div><div class="dev-category-grid"><button type="button" class="dev-category" t-att-class="state.category === category.key ? 'active' : ''" t-foreach="categories" t-as="category" t-key="category.key" t-on-click="() =&gt; state.category = category.key"><span class="dev-cat-icon blue" t-esc="category.icon"/><span class="dev-cat-copy"><strong t-esc="category.name"/><small t-esc="category.copy"/></span><span class="dev-count" t-esc="category.count"/></button></div></div>
            <div class="grid cols"><div class="panel"><div class="panel-head"><div><h2 class="panel-title">My development activities</h2><p class="panel-desc">Recorded activities, evidence status and appraisal mapping.</p></div><span class="pill blue"><t t-esc="activities.length"/> records</span></div><div class="table-toolbar"><input class="search" aria-label="Search activities" placeholder="Search records…" t-model="state.query"/><select class="filter" aria-label="Evidence status" t-model="state.status"><option value="">All evidence status</option><option>Verified</option><option>Pending</option><option>Missing</option></select></div><div class="table-wrap"><table><thead><tr><th>Activity / contribution</th><th>Category</th><th>Date</th><th>Evidence</th><th>Appraisal</th><th/></tr></thead><tbody><tr t-foreach="activities" t-as="row" t-key="row.id"><td><strong t-esc="row.name"/><div class="table-sub" t-esc="row.description"/></td><td><span class="pill violet" t-esc="kindName(row.kind)"/></td><td t-esc="date(row.date_from)"/><td><span class="pill" t-att-class="tone(row.state)" t-esc="!row.filename ? 'Missing' : ['approved','done'].includes(row.state) ? 'Verified' : 'Pending'"/></td><td><span class="pill blue" t-esc="stateLabel(row.state)"/></td><td><button class="link-btn" t-on-click="() =&gt; this.edit('activity',row)">View</button><button t-if="row.state === 'draft'" class="link-btn" t-on-click="() =&gt; this.recordAction('submit',row.id)">Submit for review</button><button t-if="row.filename" class="link-btn" t-on-click="() =&gt; this.recordAction('activity',row.id)">File</button></td></tr><tr t-if="!activities.length"><td colspan="6" class="empty">No activities match these filters.</td></tr></tbody></table></div><p class="table-footnote">Submitted activities follow the existing HOD / HR review workflow. Approval scores are maintained by authorised reviewers.</p></div>
              <div class="grid"><div class="panel"><div class="panel-head"><div><h2 class="panel-title">Appraisal cycle</h2><p class="panel-desc">Saved activity review milestones.</p></div><span class="pill blue">In progress</span></div><div class="dev-timeline"><div class="dev-milestone done"><span class="dev-timeline-dot">✓</span><div><strong>Activities recorded</strong><small><t t-esc="d.activities.length"/> saved entries</small></div></div><div class="dev-milestone current"><span class="dev-timeline-dot">2</span><div><strong>Evidence collection</strong><small><t t-esc="evidenced"/> activities have supporting files</small></div></div><div class="dev-milestone"><span class="dev-timeline-dot">3</span><div><strong>HOD / HR review</strong><small><t t-esc="activityVerified"/> approved activities</small></div></div></div><div class="dev-deadline"><span class="dev-deadline-icon">◷</span><div><strong>Next action: complete evidence</strong><small>Attach supporting documents before submitting for review.</small></div></div></div><div class="panel"><h2 class="panel-title">Portfolio snapshot</h2><p class="panel-desc">Current activity coverage and supporting evidence.</p><div class="readiness-layout"><div class="readiness-ring" t-att-style="'--progress:'+readiness+'%'"><div><strong><t t-esc="readiness"/>%</strong><small>ready</small></div></div><div class="readiness-metrics"><div class="readiness-metric"><i class="metric-dot blue"/><span>Activities recorded</span><strong t-esc="d.activities.length"/></div><div class="readiness-metric"><i class="metric-dot green"/><span>Approved activities</span><strong t-esc="activityVerified"/></div><div class="readiness-metric"><i class="metric-dot amber"/><span>Evidence attached</span><strong t-esc="evidenced"/></div></div></div><p class="table-footnote">Readiness is a recorded approval ratio, not an official appraisal result.</p></div></div>
            </div>
            <div class="panel" style="margin-bottom:16px"><div class="panel-head"><div><h2 class="panel-title">Add / edit students register for M.Phil under your supervision</h2><p class="panel-desc">Record supervision progress for your appraisal portfolio.</p></div><span class="pill blue">Supervision record</span></div><form t-on-submit="saveSupervision"><div class="field-grid"><div class="field"><label for="mphilName">Name of the student</label><input id="mphilName" name="student" required="required" maxlength="250"/></div><div class="field"><label for="mphilDate">Date</label><input id="mphilDate" name="date" type="date" t-att-value="d.today" required="required"/></div><div class="field"><label for="mphilRemark">Remark</label><textarea id="mphilRemark" name="remarks" maxlength="5000"/></div></div><div class="form-actions"><button type="reset" class="btn">Clear</button><button type="button" class="btn" t-on-click="load">↻ Refresh</button><button class="btn primary" type="submit" t-att-disabled="state.busy">▣ Save record</button></div></form><h2 class="section-title">Students register for M.Phil under your supervision</h2><div class="table-wrap"><table><thead><tr><th>Name</th><th>Date</th><th>Remarks</th></tr></thead><tbody><tr t-foreach="mphil" t-as="row" t-key="row.id"><td t-esc="row.name"/><td t-esc="date(row.date_from)"/><td t-esc="row.description"/></tr><tr t-if="!mphil.length"><td colspan="3" class="empty">No supervision records for this staff member.</td></tr></tbody></table></div></div><t t-call="ideastone_erp.StaffGuidance"/>
          </t>

          <t t-elif="page === 'agreements'"><div class="grid cols"><div class="panel"><div class="panel-head"><div><h2 class="panel-title">Current salary structure</h2><p class="panel-desc">Approved salary terms for your linked employee record.</p></div><span class="pill green" t-if="agreement">Active</span></div><div class="detail-grid"><div t-foreach="agreementDetails" t-as="detail" t-key="detail[0]"><div class="detail-label" t-esc="detail[0]"/><div class="detail-value" t-esc="detail[1] || 'Not recorded'"/></div></div><div t-if="agreement" class="action-row" style="margin-top:17px"><span class="action-icon">▧</span><div class="action-copy"><strong>Approved salary agreement</strong><span><t t-esc="agreement.name"/> · Approved <t t-esc="date(agreement.approved_on)"/></span></div><button class="btn" t-on-click="() =&gt; this.edit('agreement',agreement)">View record</button></div></div><t t-call="ideastone_erp.StaffGuidance"/></div><div class="panel"><h2 class="panel-title">Agreement history</h2><p class="section-subtitle">Previously recorded compensation terms.</p><div class="table-wrap"><table><thead><tr><th>Agreement ID</th><th>Effective period</th><th>Basic</th><th>Allowances</th><th>State</th><th>Record</th></tr></thead><tbody><tr t-foreach="d.agreements" t-as="row" t-key="row.id"><td t-esc="row.name"/><td><t t-esc="date(row.date_from)"/> – <t t-esc="row.date_to ? date(row.date_to) : 'Current'"/></td><td t-esc="money(row.basic)"/><td t-esc="money(row.allowance)"/><td><span class="pill green" t-esc="stateLabel(row.state)"/></td><td><button class="link-btn" t-on-click="() =&gt; this.edit('agreement',row)">View</button></td></tr><tr t-if="!d.agreements.length"><td colspan="6" class="empty">No approved salary agreements recorded for your employee account.</td></tr></tbody></table></div></div></t>

          <t t-elif="page === 'monthly'"><div class="pay-total"><div class="label">Net pay · <t t-esc="period(slip?.date_from)"/></div><div class="amount" t-esc="slip ? money(slip.net) : '—'"/><div class="sub">Approved campus payroll · <t t-esc="slip ? stateLabel(slip.state) : 'No approved payslip recorded'"/></div><div class="pay-total-grid"><div><span>Gross earnings</span><strong t-esc="slip ? money(slip.gross) : '—'"/></div><div><span>Total deductions</span><strong t-esc="slip ? money(slip.deductions) : '—'"/></div><div><span>Payroll period end</span><strong t-esc="date(slip?.date_to)"/></div><div><span>Payment reference</span><strong t-esc="slip?.payment_reference || 'Not recorded'"/></div></div></div><div class="grid cols"><div class="panel"><div class="panel-head"><div><h2 class="panel-title">Earnings &amp; deductions</h2><p class="panel-desc">Monthly breakdown for the selected payroll period.</p></div><span class="pill green" t-esc="slip ? stateLabel(slip.state) : 'No payroll'"/></div><div class="table-wrap"><table><thead><tr><th>Component</th><th>Type</th><th>Amount</th></tr></thead><tbody><tr t-foreach="breakdown" t-as="row" t-key="row[0]"><td><strong t-esc="row[0]"/></td><td t-esc="row[1]"/><td t-esc="money(row[2])"/></tr></tbody></table></div><div class="action-row" style="margin-top:14px"><span class="action-icon">▧</span><div class="action-copy"><strong>Monthly payslip</strong><span t-esc="period(slip?.date_from)"/></div><button class="btn" t-att-disabled="!slip" t-on-click="() =&gt; this.recordAction('payslip',slip?.id)">Open PDF</button></div></div><t t-call="ideastone_erp.StaffGuidance"/></div><div class="panel"><div class="panel-head"><div><h2 class="panel-title">Recent payroll periods</h2><p class="panel-desc">Choose a month to review its summary.</p></div><button class="link-btn" t-on-click="() =&gt; this.go('history')">Open payroll history →</button></div><div class="table-wrap"><table><thead><tr><th>Month</th><th>Gross</th><th>Deductions</th><th>Net pay</th><th>Period end</th><th>Status</th><th/></tr></thead><tbody><tr t-foreach="d.payroll" t-as="row" t-key="row.id"><td t-esc="period(row.date_from)"/><td t-esc="money(row.gross)"/><td t-esc="money(row.deductions)"/><td><strong t-esc="money(row.net)"/></td><td t-esc="date(row.date_to)"/><td><span class="pill green" t-esc="stateLabel(row.state)"/></td><td><button class="link-btn" t-on-click="() =&gt; this.selectSlip(row.id)">View</button></td></tr><tr t-if="!d.payroll.length"><td colspan="7" class="empty">No approved payroll periods recorded.</td></tr></tbody></table></div></div></t>

          <t t-elif="page === 'history'"><div class="grid cols" style="margin-top:14px"><section class="panel" style="background:#f8fbff"><div class="panel-head"><div><div class="eyebrow">Your records</div><h2 class="panel-title">Payroll History</h2><p class="panel-desc">Monthly take-home pay and deductions, all in one place.</p></div><span class="pill blue" t-esc="d.demo ? 'Sample approved records' : 'Approved payroll'"/></div><div class="panel" style="background:#f8fbff;border-color:#dce8f7;box-shadow:none;margin-bottom:14px"><div class="panel-head"><div><div class="eyebrow">Attendance · Payroll</div><h2 class="panel-title">9:00 AM late punch policy</h2></div><span class="pill blue">2 paid days / month</span></div><p class="panel-desc" style="font-size:12px">The first two late working days are paid. Each later late day deducts one day of salary.</p><p class="panel-desc" style="margin-top:12px">Late-punch totals appear after payroll approval for the selected period.</p><div class="grid" style="grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:12px"><div class="mini-metric"><span>Late punch days</span><strong t-esc="latest?.late_days || 0"/></div><div class="mini-metric"><span>Paid permission used</span><strong><t t-esc="latest?.late_grace_days || 0"/> / 2</strong></div><div class="mini-metric"><span>Days deducted</span><strong t-esc="latest?.late_deducted_days || 0"/></div></div><div style="display:flex;justify-content:space-between;gap:12px;border-top:1px solid var(--line);padding-top:12px;margin-top:12px;font-size:11px;color:var(--muted)"><strong>Late punch deduction</strong><strong style="color:var(--blue)" t-esc="money(latest?.late_deduction || 0)"/></div></div><div class="table-wrap"><table><thead><tr><th>#</th><th>Month</th><th>Year</th><th t-if="state.report !== 'Deductions only' &amp;&amp; state.report !== 'Contributions only'">Net Salary (<t t-esc="d.currency"/>)</th><t t-if="state.report !== 'Salary only' &amp;&amp; state.report !== 'Contributions only'"><th>Late Days</th><th>Late Deduction (<t t-esc="d.currency"/>)</th></t><t t-if="state.report !== 'Salary only' &amp;&amp; state.report !== 'Deductions only'"><th>P.F (<t t-esc="d.currency"/>)</th><th>T.D.S (<t t-esc="d.currency"/>)</th></t><th/></tr></thead><tbody><tr t-foreach="history" t-as="row" t-key="row.id"><td t-esc="row_index+1"/><td t-esc="monthName(row.date_from)"/><td t-esc="row.date_from.slice(0,4)"/><td t-if="state.report !== 'Deductions only' &amp;&amp; state.report !== 'Contributions only'" t-esc="money(row.net)"/><t t-if="state.report !== 'Salary only' &amp;&amp; state.report !== 'Contributions only'"><td t-esc="row.late_days"/><td t-esc="money(row.late_deduction)"/></t><t t-if="state.report !== 'Salary only' &amp;&amp; state.report !== 'Deductions only'"><td t-esc="money(row.pf)"/><td t-esc="money(row.tds)"/></t><td><button class="link-btn" t-on-click="() =&gt; this.recordAction('payslip',row.id)">PDF</button></td></tr><tr t-if="!history.length"><td colspan="9" class="empty">No approved payslips match these filters.</td></tr></tbody></table></div><div class="small-note">◈ Values come from the same approved campus payslips as main-admin payroll history. Showing <t t-esc="history.length"/> of <t t-esc="d.payroll.length"/></div></section><div class="grid"><section class="panel"><div class="panel-head"><h2 class="panel-title">▥ Salary Trend</h2><span class="pill blue">Latest 12 payslips</span></div><div style="display:flex;align-items:flex-end;gap:12px;height:180px;border-bottom:1px solid var(--line);padding:15px 8px"><div t-foreach="trend" t-as="row" t-key="row.id" style="flex:1;text-align:center;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;height:100%;gap:7px;min-width:0"><strong style="font-size:10px" t-esc="money(row.net)"/><div t-att-style="'width:54%;height:'+row.height*0.7+'%;background:#6da6fa;border-radius:6px 6px 0 0'"/><span style="font-size:10px;color:var(--muted)" t-esc="monthName(row.date_from).slice(0,3)"/></div></div><p class="panel-desc" style="margin-top:12px">Recorded net salary for the filtered payroll periods.</p></section><t t-call="ideastone_erp.StaffGuidance"/></div></div></t>

          <t t-elif="page === 'leave'">
            <div class="leave-tabs"><button type="button" t-on-click="() =&gt; state.leaveView = 'apply'" t-att-class="state.leaveView === 'apply' ? 'active' : ''">Online Leave Process</button><button type="button" t-on-click="() =&gt; state.leaveView = 'approval'" t-att-class="state.leaveView === 'approval' ? 'active' : ''">Online Leave Application Approval By HoD</button></div>
            <t t-call="ideastone_erp.StaffStats"/><div class="leave-layout" t-att-style="state.leaveView === 'approval' ? 'grid-template-columns:minmax(0,1fr)' : ''"><section class="panel" t-if="state.leaveView === 'apply'"><div class="panel-head"><h2 class="panel-title">▤ Apply for Leave</h2></div><div class="leave-alert" t-esc="d.leave.can_apply ? 'Requests are submitted through the existing leave approval workflow.' : 'A linked employee and an available leave type are required to apply.'"/><form t-on-submit="submitLeave">
              <div class="leave-field-row"><label for="leaveYear">Academic Year</label><select id="leaveYear"><option t-foreach="d.leave.academic_years.slice(0,1)" t-as="year" t-key="year" t-esc="year"/></select></div><div class="leave-field-row"><label for="leaveType">Leave Type</label><select id="leaveType" required="required" t-model="state.leaveForm.leave_type_id"><option value="">Select leave type</option><option t-foreach="d.leave.leave_types" t-as="type" t-key="type.id" t-att-value="type.id" t-esc="type.name" t-att-selected="type.id == state.leaveForm.leave_type_id"/></select></div><div class="leave-radio-row"><label><input type="radio" name="leaveDuration" value="one" t-model="state.leaveDuration"/>One day</label><label><input type="radio" name="leaveDuration" value="multiple" t-model="state.leaveDuration"/>Multiple days</label></div>
              <div class="leave-field-row"><label for="leaveFrom">From Date</label><input id="leaveFrom" type="date" required="required" t-model="state.leaveForm.date_from"/><label for="leaveFromSession" class="session-label">Session</label><select id="leaveFromSession" t-model="state.leaveForm.from_session"><option>FN</option><option>AN</option></select></div><div class="leave-field-row"><label for="leaveTo">To Date</label><input id="leaveTo" type="date" required="required" t-att-disabled="state.leaveDuration === 'one'" t-att-value="state.leaveDuration === 'one' ? state.leaveForm.date_from : state.leaveForm.date_to" t-on-input="(ev) =&gt; state.leaveForm.date_to=ev.target.value"/><label for="leaveToSession" class="session-label">Session</label><select id="leaveToSession" t-model="state.leaveForm.to_session"><option>AN</option><option>FN</option></select></div><div class="leave-field-row top-align"><label for="leaveReason">Reason</label><textarea id="leaveReason" placeholder="Type reason for applying..." required="required" maxlength="5000" t-model="state.leaveForm.reason"/></div><div class="leave-field-row"><label for="leaveAuthority">Reporting Authority</label><input id="leaveAuthority" t-att-value="d.leave.reporting_authority" readonly="readonly"/></div><div class="leave-balance">ⓘ Current leave balance: <strong><t t-esc="d.leave.balance === null ? '—' : d.leave.balance"/> days</strong></div><div class="leave-actions"><button class="btn primary" type="submit" t-att-disabled="!d.leave.can_apply || state.busy">➤ Submit Request</button><button class="btn" type="button" t-on-click="resetLeave">↶ Reset</button></div></form></section>
              <div class="grid leave-right"><section class="panel"><div class="panel-head"><h2 class="panel-title">▤ Leave Application History</h2><button class="link-btn" t-on-click="() =&gt; this.exportData('leave')">View all ➜</button></div><div class="table-wrap"><table><thead><tr><th>Leave Type</th><th>Date</th><th>Days</th><th>Reason</th><th>Status</th></tr></thead><tbody><tr t-foreach="d.leave.history" t-as="row" t-key="row.id"><td t-esc="row.type"/><td><t t-esc="date(row.from)"/> – <t t-esc="date(row.to)"/></td><td t-esc="row.days"/><td t-esc="row.reason"/><td><span class="pill" t-att-class="tone(row.status)" t-esc="row.status"/></td></tr><tr t-if="!d.leave.history.length"><td colspan="5" class="leave-empty">No leave requests recorded</td></tr></tbody></table></div></section><section class="panel"><div class="panel-head"><h2 class="panel-title">▦ Payroll Attendance Entry</h2></div><div class="table-wrap"><table><thead><tr><th>Date</th><th>Day</th><th>FN</th><th>AN</th></tr></thead><tbody><tr t-foreach="d.leave.attendance" t-as="row" t-key="row.date"><td t-esc="date(row.date)"/><td t-esc="row.day"/><td t-esc="row.fn"/><td t-esc="row.an"/></tr><tr t-if="!d.leave.attendance.length"><td colspan="4" class="leave-empty">No attendance entries recorded</td></tr></tbody></table></div></section><section class="panel"><div class="panel-head"><h2 class="panel-title">✧ AI Insights for Leave Management</h2><span class="pill blue">Recorded data</span></div><div class="leave-insights"><div>↗ Approval Trend<strong t-esc="d.leave.approval_percent === null ? '—' : d.leave.approval_percent+'%'"/></div><div>◕ Most Common Leave<strong t-esc="d.leave.most_common_leave"/></div><div>⚠ Leave Balance<strong t-esc="d.leave.balance === null ? '—' : d.leave.balance"/></div><div>● Payroll Sync<strong>Approved payroll only</strong></div></div><p class="table-footnote">Insights summarise saved leave records. Leave approval and paid-leave classification follow the configured institutional workflow.</p></section></div>
            </div>
          </t>
        </section><div class="footer"><t t-esc="d.company"/> · Faculty workspace · <t t-esc="d.demo ? 'Sample records' : 'Saved staff records'"/></div>
      </t>
    </div></main>
  </t>
  <t t-name="ideastone_erp.StaffGuidance"><aside class="ai-card"><div class="ai-head"><div class="ai-mark">✧</div><div><div class="ai-title" t-esc="guidance[0]"/><div class="ai-label" t-esc="guidance[1]"/></div></div><div class="insight-list"><div class="insight" t-foreach="guidance.slice(2)" t-as="copy" t-key="copy"><span class="dot"/><span t-esc="copy"/></div></div><p style="font-size:9px;margin:13px 0 0">Record-based guidance. No external AI provider is configured; suggestions do not replace HOD / HR decisions.</p></aside></t>
  <t t-name="ideastone_erp.StaffRecordDialog"><Dialog title="title" size="'lg'" contentClass="'campus_faculty_profile_workspace'">
    <div class="content"><div t-if="state.error" class="error" role="alert" t-esc="state.error"/>
      <t t-if="props.kind === 'agreement'"><div class="detail-grid"><div t-foreach="['date_from','date_to','basic','allowance','fixed_deduction','tds','state']" t-as="key" t-key="key"><div class="detail-label" t-esc="key.replaceAll('_',' ')"/><div class="detail-value" t-esc="props.record[key] || 'Not recorded'"/></div></div></t>
      <form t-else="" id="staff-record-form" t-on-submit.prevent="save"><div class="field-grid"><div class="field"><label for="staffRecordName">Record name</label><input id="staffRecordName" required="required" maxlength="250" t-model="state.values.name" t-att-readonly="readOnly"/></div><div class="field"><label for="staffRecordKind">Category</label><select id="staffRecordKind" t-model="state.values.kind" t-att-disabled="readOnly"><t t-if="props.kind === 'document'"><option value="document">Document</option><option value="qualification">Qualification</option><option value="experience">Service history</option><option value="language">Language</option></t><t t-else=""><option t-foreach="props.data.kinds" t-as="kind" t-key="kind.id" t-att-value="kind.id" t-esc="kind.name"/></t></select></div>
        <t t-if="props.kind === 'document'"><div class="field"><label for="staffDocumentCategory">Document group</label><select id="staffDocumentCategory" t-model="state.values.campus_category"><option value="academic">Academic</option><option value="identity">Identity</option><option value="professional">Professional development</option><option value="membership">Membership</option></select></div><div class="field"><label for="staffDocumentExpiry">Valid until</label><input id="staffDocumentExpiry" type="date" t-model="state.values.campus_expiry_date"/></div></t><t t-else=""><div class="field"><label for="staffActivityDate">Activity date</label><input id="staffActivityDate" type="date" required="required" t-model="state.values.date_from" t-att-readonly="readOnly"/></div><div class="field"><label for="staffActivityHours">Duration (hours)</label><input id="staffActivityHours" type="number" min="0" max="10000" step="0.25" t-model="state.values.campus_hours" t-att-readonly="readOnly"/></div><div class="field"><label for="staffActivityDescription">Description / appraisal relevance</label><textarea id="staffActivityDescription" maxlength="5000" t-model="state.values.description" t-att-readonly="readOnly"/></div></t>
        <div t-if="!readOnly" class="field"><label for="staffRecordFile">Supporting file</label><input id="staffRecordFile" type="file" accept="application/pdf,image/png,image/jpeg" t-on-change="file"/><small>PDF, PNG or JPEG · maximum 10 MB</small></div><div t-if="state.values.filename" class="field"><span t-esc="state.values.filename"/><button t-if="props.record" type="button" class="link-btn" t-on-click="attachment">Download saved file</button></div></div></form>
    </div><t t-set-slot="footer"><button t-if="!readOnly" type="submit" form="staff-record-form" class="btn btn-primary" t-att-disabled="state.busy">Save record</button><button type="button" class="btn btn-secondary" t-on-click="props.close">Close</button></t>
  </Dialog></t>
<t t-name="ideastone_erp.StaffStats"><div class="grid stats" t-att-class="page === 'leave' ? 'leave-stats' : ''"><t t-foreach="stats" t-as="stat" t-key="stat[0]"><div class="stat" t-if="page !== 'leave'"><div class="stat-top"><t t-esc="stat[0]"/><span class="stat-icon" t-esc="stat[3]"/></div><div class="stat-value" t-att-style="longStat(stat[1]) || (page === 'myprofile' &amp;&amp; stat_index === 3) ? 'font-size:20px' : ''"><t><t t-if="page === 'myprofile' &amp;&amp; stat_index === 1"><t t-esc="verified"/> <small style="font-size:12px;color:var(--muted);font-weight:600">/ <t t-esc="d.documents.length"/></small></t><t t-elif="page === 'myprofile' &amp;&amp; stat_index === 2"><t t-esc="p.tenure === null ? '—' : p.tenure"/> <small t-if="p.tenure !== null" style="font-size:12px">yrs</small></t><t t-elif="page === 'myprofile' &amp;&amp; stat_index === 3" t-esc="shortDate(p.campus_profile_review_date)"/><t t-else="" t-esc="stat[1]"/></t></div><div class="progress" t-if="page === 'myprofile' &amp;&amp; stat_index === 0"><span t-att-style="'width:'+p.completion+'%'"/></div><div class="stat-foot" t-esc="stat[2]"/></div><div t-else="" class="stat"><div class="leave-stat-head"><span class="leave-icon" t-esc="stat[3]"/><div><div class="stat-top" t-esc="stat[0]"/><div class="stat-value" t-esc="stat[1]"/><div class="stat-foot" t-esc="stat[2]"/></div></div></div></t></div>

          </t></templates>
