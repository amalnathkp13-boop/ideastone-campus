<templates xml:space="preserve">
  <t t-name="ideastone_erp.HodODManagement">
    <div class="hod_od">
      <section class="hod_page_title" aria-labelledby="hod_od_title"><div><p>HOD Workspace / OD Management</p><h1 id="hod_od_title">On Duty (OD) Management</h1><span>Review department requests, approve official duty and verify participation evidence.</span></div><i class="fa fa-clipboard" aria-hidden="true"/></section>
      <header class="mentor_hero"><div><small>YOUR CAMPUS, CONNECTED</small><h1>Welcome back, <t t-esc="state.data.hod_name"/></h1><p>Oversee and manage student OD requests across all classes under your administration.</p><span class="mentor_term" t-esc="state.data.company_name"/></div><i class="fa fa-university" aria-hidden="true"/></header>

      <section class="mentor_kpis" aria-label="HOD OD summary">
        <article class="mentor_kpi class"><span><i class="fa fa-users" aria-hidden="true"/></span><div><small>Total OD Requests</small><strong t-esc="state.data.total"/><p>This semester</p></div></article>
        <article class="mentor_kpi students"><span><i class="fa fa-clock-o" aria-hidden="true"/></span><div><small>Pending</small><strong t-esc="state.data.pending"/><p>Awaiting your review</p></div></article>
        <article class="mentor_kpi approved"><span><i class="fa fa-check" aria-hidden="true"/></span><div><small>Approved ODs</small><strong t-esc="state.data.approved"/><p>This semester</p></div></article>
        <article class="mentor_kpi rejected"><span><i class="fa fa-times" aria-hidden="true"/></span><div><small>Rejected</small><strong t-esc="state.data.rejected"/><p>This semester</p></div></article>
        <article class="mentor_kpi on_duty"><span><i class="fa fa-user" aria-hidden="true"/></span><div><small>Students on OD</small><strong t-esc="state.data.students_on_od"/><p>As of today</p></div></article>
      </section>

      <div class="hod_top_grid">
        <div class="hod_left">
          <section class="mentor_panel mentor_requests" aria-labelledby="hod_requests_heading">
            <h3 id="hod_requests_heading"><i class="fa fa-file-text" aria-hidden="true"/> Requests Awaiting HOD Review</h3>
            <div class="mentor_request_filters"><label><i class="fa fa-search" aria-hidden="true"/><input type="search" placeholder="Search by Request ID, Student Name or Purpose..." t-att-value="state.search" t-on-input="changeSearch"/></label><select aria-label="Class" t-att-value="state.classKey" t-on-change="changeClass"><option value="">All Classes</option><option t-foreach="state.data.classes" t-as="item" t-key="item.key" t-att-value="item.key" t-esc="item.label"/></select></div>
            <div class="mentor_table_wrap"><table><thead><tr><th>#</th><th>Request ID</th><th>Student Name</th><th>Date(s)</th><th>Purpose</th><th>OD Type</th><th>Status</th><th>Action</th></tr></thead><tbody>
              <tr t-foreach="pageRows" t-as="row" t-key="row.id" t-att-class="{'selected': state.selectedId === row.id}"><td t-esc="(state.page - 1) * 5 + row_index + 1"/><td t-esc="row.reference"/><td t-esc="row.student"/><td><t t-esc="formatDate(row.date_from)"/><t t-if="row.date_to !== row.date_from"> – <t t-esc="formatDate(row.date_to)"/></t></td><td t-esc="row.name"/><td><select t-if="row.can_decide" aria-label="OD type" t-att-value="state.types[row.id] || ''" t-on-change="(event) => this.setHodType(row, event)"><option value="">Select</option><option value="general">General</option><option value="special">Special</option></select><span t-else="" t-esc="row.category === 'undetermined' ? 'Pending' : row.category === 'general' ? 'General' : 'Special'"/></td><td><span t-att-class="'mentor_status ' + row.state" t-esc="row.status"/></td><td><div class="mentor_row_actions"><t t-if="row.can_decide"><button type="button" class="mentor_forward" t-on-click="() => this.openHodDecision(row, 'approve')">Approve</button><button type="button" class="hod_reject" t-on-click="() => this.openHodDecision(row, 'reject')">Reject</button></t><button t-elif="row.can_request_proof" type="button" class="hod_outline" t-on-click="() => this.openHodDecision(row, 'request_proof')">Request Proof</button><button t-elif="row.can_verify" type="button" class="mentor_forward" t-on-click="() => this.openHodDecision(row, 'accept_proof')">Verify Proof</button><button t-else="" type="button" class="mentor_view" t-on-click="() => this.selectRow(row)"><i class="fa fa-eye" aria-hidden="true"/> View</button></div></td></tr>
              <tr t-if="!pageRows.length"><td colspan="8" class="mentor_empty">No OD requests match this class and search.</td></tr>
            </tbody></table></div>
            <div class="mentor_table_footer"><span>Showing <t t-esc="pageRows.length"/> of <t t-esc="filteredRows.length"/> requests</span><div><button type="button" t-att-disabled="state.page === 1" t-on-click="() => this.setPage(1)">«</button><button type="button" t-att-disabled="state.page === 1" t-on-click="() => this.setPage(state.page - 1)">‹</button><span t-esc="state.page"/><button type="button" t-att-disabled="state.page === pageCount" t-on-click="() => this.setPage(state.page + 1)">›</button><button type="button" t-att-disabled="state.page === pageCount" t-on-click="() => this.setPage(pageCount)">»</button></div></div>
            <div t-if="selectedRow" class="mentor_detail"><strong><t t-esc="selectedRow.reference"/> · <t t-esc="selectedRow.student"/></strong><p><t t-esc="selectedRow.name"/> · <t t-esc="selectedRow.venue"/></p><p t-esc="selectedRow.purpose"/><p t-if="selectedRow.proof_requirements">Proof: <t t-esc="selectedRow.proof_requirements"/> · Due <t t-esc="formatDate(selectedRow.proof_deadline)"/></p><details><summary>Decision history</summary><p t-foreach="selectedRow.events" t-as="event" t-key="event_index"><t t-esc="event.action"/> · <t t-esc="event.by"/> · <t t-esc="event.at"/></p></details></div>
          </section>

          <section class="mentor_panel mentor_analytics"><div class="mentor_panel_header"><h3><i class="fa fa-bar-chart" aria-hidden="true"/> OD Requests Overview (All Classes)</h3><div><button type="button" t-att-class="{'active': state.period === 'week'}" t-on-click="() => this.state.period = 'week'">Weekly</button><button type="button" t-att-class="{'active': state.period === 'month'}" t-on-click="() => this.state.period = 'month'">Monthly</button><button type="button" class="mentor_export" title="Download activity CSV" t-on-click="exportActivity"><i class="fa fa-download" aria-hidden="true"/></button></div></div><div class="mentor_chart"><div t-foreach="chartRows" t-as="point" t-key="point_index" class="mentor_chart_column"><span class="mentor_chart_value" t-esc="point.count"/><div class="mentor_chart_bar_area"><span class="mentor_chart_bar" t-att-style="'height:' + chartHeight(point.count)"/></div><strong t-esc="point.label"/><small t-esc="point.sub"/></div></div></section>
        </div>

        <div class="hod_right">
          <section class="mentor_panel hod_insights"><h3><i class="fa fa-lightbulb-o" aria-hidden="true"/> AI HOD Insights</h3><div class="hod_insight_grid"><article><i class="fa fa-users" aria-hidden="true"/><div><strong>Repeated OD Asking Students</strong><b t-esc="state.data.repeated_students"/></div></article><article><i class="fa fa-calendar" aria-hidden="true"/><div><strong>Overlapping Date Students</strong><b t-esc="state.data.overlapping_students"/></div></article><article><i class="fa fa-users" aria-hidden="true"/><div><strong>Students with Multiple Upcoming ODs</strong><b t-esc="state.data.upcoming_students"/></div></article><article><i class="fa fa-file-text" aria-hidden="true"/><div><strong>Pending Faculty Submissions</strong><b t-esc="state.data.awaiting_proof"/><small>Approved ODs awaiting proof</small></div></article></div></section>
          <section class="mentor_panel mentor_actions"><div class="mentor_panel_header"><h3><i class="fa fa-bell" aria-hidden="true"/> Pending Actions &amp; Deadlines</h3><a href="#hod_requests_heading">View All</a></div><article t-foreach="state.data.actions" t-as="action" t-key="action.id"><span><i class="fa fa-file-text" aria-hidden="true"/></span><div><strong t-esc="action.state === 'proof_review' ? 'Verify Submitted Proof' : action.state === 'withheld' ? 'Proof Pending' : 'Review Pending Request'"/><small><t t-esc="action.reference"/> · <t t-esc="action.student"/></small><p t-esc="action.name"/></div><em><t t-esc="action.proof_deadline ? 'Due by' : 'Event on'"/><br/><t t-esc="formatDate(action.proof_deadline || action.date_from)"/></em></article><p t-if="!state.data.actions.length" class="mentor_empty">No HOD actions are waiting.</p></section>
        </div>
      </div>

      <div class="hod_bottom_grid">
        <section class="mentor_panel hod_list"><div class="mentor_panel_header"><h3><i class="fa fa-check-circle" aria-hidden="true"/> Approved ODs</h3><button type="button" class="hod_view_all" t-on-click="() => this.toggleListAll('approved')">View All</button></div><div class="mentor_table_wrap"><table><thead><tr><th>#</th><th>Request ID</th><th>Student Name</th><th>Date(s)</th><th>Purpose</th><th>Status</th></tr></thead><tbody><tr t-foreach="approvedRows" t-as="row" t-key="row.id"><td t-esc="(state.approvedPage - 1) * 5 + row_index + 1"/><td t-esc="row.reference"/><td t-esc="row.student"/><td t-esc="formatDate(row.date_from)"/><td t-esc="row.name"/><td><span class="mentor_status completed">Approved</span></td></tr><tr t-if="!approvedRows.length"><td colspan="6" class="mentor_empty">No approved ODs yet.</td></tr></tbody></table></div><div class="mentor_table_footer"><span>Showing <t t-esc="approvedRows.length"/> requests</span><div><button type="button" t-att-disabled="state.approvedPage === 1" t-on-click="() => this.setListPage('approved', state.approvedPage - 1)">‹</button><span t-esc="state.approvedPage"/><button type="button" t-att-disabled="state.approvedPage * 5 &gt;= state.data.approved_rows.length" t-on-click="() => this.setListPage('approved', state.approvedPage + 1)">›</button></div></div></section>
        <section class="mentor_panel hod_list"><div class="mentor_panel_header"><h3><i class="fa fa-clock-o" aria-hidden="true"/> Withheld ODs</h3><button type="button" class="hod_view_all" t-on-click="() => this.toggleListAll('withheld')">View All</button></div><div class="mentor_table_wrap"><table><thead><tr><th>#</th><th>Request ID</th><th>Student Name</th><th>Date(s)</th><th>Purpose</th><th>Status</th><th>Action</th></tr></thead><tbody><tr t-foreach="withheldRows" t-as="row" t-key="row.id"><td t-esc="(state.withheldPage - 1) * 5 + row_index + 1"/><td t-esc="row.reference"/><td t-esc="row.student"/><td t-esc="formatDate(row.date_from)"/><td t-esc="row.name"/><td><span t-att-class="'mentor_status ' + row.state" t-esc="row.status"/></td><td><button type="button" class="mentor_forward" t-on-click="() => this.openHodDecision(row, row.can_verify ? 'accept_proof' : 'request_proof')"><t t-esc="row.can_verify ? 'Verify Proof' : 'Request Proof'"/></button></td></tr><tr t-if="!withheldRows.length"><td colspan="7" class="mentor_empty">No ODs are awaiting proof.</td></tr></tbody></table></div><div class="mentor_table_footer"><span>Showing <t t-esc="withheldRows.length"/> requests</span><div><button type="button" t-att-disabled="state.withheldPage === 1" t-on-click="() => this.setListPage('withheld', state.withheldPage - 1)">‹</button><span t-esc="state.withheldPage"/><button type="button" t-att-disabled="state.withheldPage * 5 &gt;= state.data.withheld_rows.length" t-on-click="() => this.setListPage('withheld', state.withheldPage + 1)">›</button></div></div></section>
      </div>

      <div t-if="state.hodDialog" class="hod_dialog_backdrop"><form class="hod_dialog" role="dialog" aria-modal="true" aria-label="HOD OD decision" t-on-submit.prevent="submitHodDecision"><h3><t t-esc="state.hodDialog.reference"/> · HOD Decision</h3><p t-esc="state.hodDialog.decision === 'approve' ? 'Confirm the OD type and approval.' : state.hodDialog.decision === 'reject' ? 'Record the reason for rejection.' : state.hodDialog.decision === 'request_proof' ? 'Set the required evidence and submission deadline.' : 'Inspect the submitted evidence before deciding.'"/>
        <label t-if="state.hodDialog.decision === 'approve'">OD Type<select t-model="state.hodDialog.category" required="required"><option value="">Select</option><option value="general">General</option><option value="special">Special</option></select></label>
        <t t-if="state.hodDialog.decision === 'request_proof' || state.hodDialog.decision === 'return_proof' || state.hodDialog.decision === 'approve' &amp;&amp; state.hodDialog.category === 'special'"><label>Proof Requirements<textarea t-model="state.hodDialog.requirements" required="required" rows="2" placeholder="Certificate or participation document required"/></label><label>Proof Submission Deadline<input type="date" t-model="state.hodDialog.deadline" required="required"/></label></t>
        <label>Decision Note<textarea t-model="state.hodDialog.note" rows="2" maxlength="500" t-att-required="state.hodDialog.decision === 'reject' || state.hodDialog.decision === 'return_proof'" placeholder="Reason or instructions, if needed"/></label>
        <div t-if="state.hodDialog.decision === 'accept_proof' || state.hodDialog.decision === 'return_proof'" class="hod_dialog_actions"><button type="button" class="hod_outline" t-on-click="downloadHodProof"><i class="fa fa-download" aria-hidden="true"/> Download Submitted Proof</button><button t-if="state.hodDialog.decision === 'accept_proof'" type="button" class="hod_outline" t-on-click="() => this.state.hodDialog.decision = 'return_proof'">Return Proof for Correction</button></div>
        <div class="hod_dialog_actions"><button type="button" class="hod_outline" t-on-click="() => this.state.hodDialog = null">Cancel</button><button type="submit" class="mentor_forward" t-att-disabled="state.saving">Save Decision</button></div>
      </form></div>
    </div>
  </t>
</templates>
