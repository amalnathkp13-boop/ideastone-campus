<templates xml:space="preserve">
  <!-- The upstream timed review advert obscures forms and steals keyboard focus. -->
  <t t-inherit="web.WebClient" t-inherit-mode="extension"><xpath expr="//G2Review" position="replace"/></t>
  <t t-name="ideastone_erp.OwnerOverview">
    <t t-set="ui" t-value="ownerUI"/>
    <div class="admin_overview">
      <section class="hero"><div><div class="hero-kicker">Admin overview · <t t-esc="ownerYearLabel"/></div><h1><t t-esc="ui.greeting"/>, <t t-esc="state.user"/>.</h1><p>Campus performance and follow-ups from saved college records.</p><span t-if="state.is_demo" class="demo-note">Demonstration college · sample records</span></div><div class="hero-right"><div class="ai-status"><small><span class="pulse"/> CAMPUS PULSE</small><strong t-esc="ui.insights.length ? 'Follow-ups to review' : 'Campus operations'"/><small>Updated <t t-esc="ui.updated"/></small></div><i class="fa fa-university hero-illustration" aria-hidden="true"/></div></section>
      <p t-if="state.ownerLoading" class="loading-note" role="status">Loading saved college records…</p><div t-if="state.ownerError" class="alert alert-danger" role="alert"><t t-esc="state.ownerError"/><button class="btn" t-on-click="loadOwnerMetrics">Retry</button></div>
      <t t-if="!state.ownerError &amp;&amp; !state.ownerLoading">
        <div class="section-head owner-performance-head"><div><h3>Campus performance</h3><p>Operational period applies to admissions and receipts; snapshots retain their own dates.</p></div><div class="actions"><div class="period" aria-label="Reporting period"><button type="button" t-att-class="ownerPeriodSelected('today') ? 'selected' : ''" t-att-aria-pressed="ownerPeriodSelected('today')" t-att-disabled="state.ownerLoading" t-on-click="() => this.ownerPeriod('today')">Today</button><button type="button" t-att-class="ownerPeriodSelected('month') ? 'selected' : ''" t-att-aria-pressed="ownerPeriodSelected('month')" t-att-disabled="state.ownerLoading" t-on-click="() => this.ownerPeriod('month')">This month</button><button type="button" t-att-class="ownerPeriodSelected('semester') ? 'selected' : ''" t-att-aria-pressed="!!ownerPeriodSelected('semester')" t-att-disabled="state.ownerLoading || !ui.semester" t-on-click="() => this.ownerPeriod('semester')">Semester</button></div><button class="btn filter-button" type="button" aria-label="Filters" title="Filters" t-on-click="ownerOpenFilters" t-att-disabled="state.ownerLoading"><i class="fa fa-filter" aria-hidden="true"/></button><button class="btn" type="button" t-on-click="loadOwnerMetrics" t-att-disabled="state.ownerLoading"><i class="fa fa-refresh" aria-hidden="true"/> Refresh</button><button class="btn" type="button" title="Print or save this overview as PDF" t-on-click="ownerPrint" t-att-disabled="state.ownerLoading || !!state.ownerError"><i class="fa fa-download" aria-hidden="true"/> Export</button></div></div>
        <section class="kpis" aria-label="College summary"><button type="button" class="kpi campus_owner_stat" t-foreach="ui.kpis" t-as="stat" t-key="stat.kind" t-on-click="() => this.ownerSource(stat)" t-att-disabled="!stat.allowed"><div class="kpi-top"><span class="kpi-label" t-esc="stat.label"/><span t-att-class="'kpi-icon ' + stat.tone"><i t-att-class="'fa fa-' + stat.icon" aria-hidden="true"/></span></div><div class="kpi-value" t-esc="stat.value"/><div class="kpi-meta" t-esc="stat.detail"/></button></section>
        <section class="panel fleet-owner-summary" t-if="ui.fleet" aria-label="Fleet overview">
          <div class="panel-head"><div><h3>Fleet Management Overview</h3><div class="panel-sub">Current college · <t t-esc="ui.fleet.active"/> active buses</div></div><button type="button" class="btn light" t-on-click="() => this.openOwnerFleet()">View Fleet Management ↗</button></div>
          <div class="fleet-owner-grid">
            <article class="fleet-tone-green"><span>Insurance active</span><strong t-esc="ui.fleet.insured"/></article>
            <article class="fleet-tone-amber"><span>Insurance pending</span><strong t-esc="ui.fleet.pending"/></article>
            <article class="fleet-tone-rose"><span>Service due</span><strong t-esc="ui.fleet.service"/></article>
            <article class="fleet-tone-blue"><span>Arrived on time today</span><strong t-esc="ui.fleet.on_time"/></article>
          </div>
        </section>
        <section class="content-grid campus_owner_charts">
          <article class="panel activity-panel"><div class="panel-head"><div><h3>Campus activity trend</h3><div class="panel-sub">Completed attendance and admissions cohort conversion · selected chart range</div></div><label class="owner-chart-range">Range <select t-on-change="ownerChartRange" t-att-disabled="state.ownerLoading"><option value="8" t-att-selected="state.ownerChartMonths === 8">Last 8 months</option><option value="6" t-att-selected="state.ownerChartMonths === 6">Last 6 months</option></select></label></div>
            <svg t-if="ui.activity.length" class="chart" viewBox="0 0 620 235" role="img" aria-label="Monthly campus activity, 0 to 100 percent"><line t-foreach="[30,70,110,150,190]" t-as="y" t-key="y" class="gridline" x1="48" t-att-y1="y" x2="600" t-att-y2="y"/><text x="9" y="33">100%</text><text x="16" y="73">75%</text><text x="16" y="113">50%</text><text x="16" y="153">25%</text><text x="22" y="193">0%</text><polyline t-foreach="ownerActivityPoints('attendance')" t-as="points" t-key="points_index" class="lineblue" t-att-points="points"/><polyline t-foreach="ownerActivityPoints('conversion')" t-as="points" t-key="points_index" class="linegreen" t-att-points="points"/><t t-foreach="ui.activity" t-as="row" t-key="row.label"><circle t-if="row.attendance !== null" t-att-cx="ui.activity.length === 1 ? 320 : 55 + row_index * 530 / (ui.activity.length - 1)" t-att-cy="190 - row.attendance * 1.6" r="3.5" fill="#1769e8"/><circle t-if="row.conversion !== null" t-att-cx="ui.activity.length === 1 ? 320 : 55 + row_index * 530 / (ui.activity.length - 1)" t-att-cy="190 - row.conversion * 1.6" r="3" fill="#25ae8b"/><text t-if="row_index % Math.max(1, Math.ceil(ui.activity.length / 8)) === 0" t-att-x="ui.activity.length === 1 ? 320 : 55 + row_index * 530 / (ui.activity.length - 1)" y="215" text-anchor="middle" t-esc="ownerMonth(row.label)"/></t></svg><p t-else="" class="empty">No completed attendance or applications in this period.</p>
            <div class="chart-legend"><span><i class="legend-dot blue"/>Attendance rate</span><span><i class="legend-dot green"/>Admissions conversion</span></div><details t-if="ui.activity.length" class="chart-data"><summary>View chart data</summary><div class="table-wrap"><table class="data-table"><thead><tr><th>Month</th><th>Attendance</th><th>Admissions converted</th></tr></thead><tbody><tr t-foreach="ui.activity" t-as="row" t-key="row.label"><td t-esc="ownerMonth(row.label)"/><td t-esc="row.attendance === null ? 'Not recorded' : number(row.attendance) + '%'"/><td t-esc="row.conversion === null ? 'Not recorded' : number(row.conversion) + '%'"/></tr></tbody></table></div></details>
          </article>
          <article class="panel"><div class="panel-head"><div><h3>Admissions funnel</h3><div class="panel-sub">Applicant progression by current decision stage</div></div><button class="text-link" t-att-disabled="!ownerCanOpen('ideastone_erp.mvp_applications')" t-on-click="() => this.ownerOpenAction('ideastone_erp.mvp_applications')">Open admissions ↗</button></div><div class="donut-wrap"><svg class="donut" viewBox="0 0 160 160" role="img" aria-label="Admissions stage distribution"><circle cx="80" cy="80" r="56" fill="none" stroke="#edf2f8" stroke-width="17"/><circle t-foreach="ownerFunnel" t-as="row" t-key="row.label" cx="80" cy="80" r="56" fill="none" t-att-stroke="row.color" stroke-width="17" t-att-stroke-dasharray="row.dash" t-att-stroke-dashoffset="row.offset" transform="rotate(-90 80 80)"/><text x="80" y="76" text-anchor="middle" class="donut-total" t-esc="ui.funnel.reduce((sum,row) => sum + row.value,0)"/><text x="80" y="94" text-anchor="middle" class="donut-caption">Applications</text></svg><div class="donut-legend"><div class="legend-row" t-foreach="ownerFunnel" t-as="row" t-key="row.label"><span class="legend-name"><i class="legend-dot" t-att-style="'background:' + row.color"/><t t-esc="row.label"/></span><strong><t t-esc="row.value"/> · <t t-esc="number(row.percent)"/>%</strong></div></div></div><div class="data-note">Counts reconcile to applications in the selected date range and academic year.</div></article>
        </section>
        <section class="content-grid">
          <article class="panel collection-panel owner-annual-fees" id="fees">
            <div class="panel-head"><div><h3>Annual student fee collection</h3><div class="panel-sub">Posted student invoices in the selected academic year</div></div><label class="owner-year-select">Academic year <select t-on-change="ownerFeeYear" t-att-disabled="state.ownerLoading"><option t-foreach="ui.annual_fees.years" t-as="year" t-key="year.id" t-att-value="year.id" t-att-selected="year.id === ui.annual_fees.year_id" t-esc="year.name"/></select></label></div>
            <t t-if="ui.annual_fees.allowed">
              <div class="owner-fee-headline"><div><small>Total collected / settled</small><strong t-esc="ownerMoney(ui.annual_fees.collected)"/><span t-esc="ui.annual_fees.rate === null ? '—' : ui.annual_fees.rate + '% collected'"/></div><div><small>Balance to collect</small><strong t-esc="ownerMoney(ui.annual_fees.balance)"/><span>Annual billed: <t t-esc="ownerMoney(ui.annual_fees.billed)"/></span></div></div>
              <div class="bar-track" role="progressbar" t-att-aria-valuenow="ui.annual_fees.rate || 0" aria-valuemin="0" aria-valuemax="100" aria-label="Annual fee collection rate"><div class="bar-fill green" t-att-style="'width:' + (ui.annual_fees.rate || 0) + '%'"/></div>
              <div class="table-wrap"><table class="data-table"><thead><tr><th>STUDY YEAR</th><th>PAYABLE</th><th>COLLECTED</th><th>UNPAID</th><th>RATE</th></tr></thead><tbody><tr t-foreach="ui.annual_fees.cohorts" t-as="row" t-key="row.label"><td t-esc="row.label"/><td t-esc="ownerMoney(row.billed)"/><td t-esc="ownerMoney(row.collected)"/><td t-esc="ownerMoney(row.balance)"/><td t-esc="row.rate === null ? '—' : row.rate + '%'"/></tr><tr t-if="!ui.annual_fees.cohorts.length"><td colspan="5" class="empty">No posted student charges for this academic year.</td></tr></tbody></table></div>
              <div class="owner-fee-foot"><span><strong t-esc="ui.annual_fees.unpaid_students"/> students with unpaid balances</span><span><strong t-esc="ui.annual_fees.overdue_students"/> students past the payment deadline</span></div>
              <p class="section-note">Collected / settled equals posted invoice value less its current residual, including any posted credits or adjustments.</p>
            </t><p t-else="" class="empty">Fee reporting access is required.</p>
          </article>
          <article class="panel ai-panel"><div class="panel-head"><div class="ai-heading"><div class="ai-icon">✦</div><div><h3>Campus insights &amp; recommendations</h3><div class="panel-sub">Follow-up signals from saved college records</div></div></div><span class="ai-tag">RULE BASED</span></div><div class="insight-list"><button class="insight" t-foreach="ui.insights" t-as="item" t-key="item.source" t-on-click="() => this.ownerSource({kind:item.source,allowed:true})"><span class="insight-symbol"><i t-att-class="'fa fa-' + item.icon" aria-hidden="true"/></span><span><strong t-esc="item.title"/><span class="insight-copy" t-esc="item.text"/><span class="tag" t-esc="item.tag"/></span></button><p t-if="!ui.insights.length" class="empty">No follow-up signals in the records available for this scope.</p></div><button class="btn light" t-on-click="() => this.chooseModule({key:'reports'})">View all analytics ↗</button></article>
        </section>
        <section class="bottom-grid decision-grid">
          <section class="panel decision-panel" id="decision-overview">
            <div class="panel-head"><div><h3>Decision Overview</h3><div class="panel-sub">Pending proposals, approval deadlines and expected campus impact</div></div><span class="pill amber"><t t-esc="ui.decision_count"/> <t t-esc="ui.decision_count === 1 ? 'decision' : 'decisions'"/></span></div>
            <div class="decision-list"><article class="decision-item" t-foreach="ui.decisions" t-as="item" t-key="item.id">
              <div t-att-class="'decision-icon ' + item.tone" aria-hidden="true" t-esc="item.icon"/>
              <div class="decision-copy"><h4><button class="decision-open" t-on-click="() => this.ownerOverviewAction('decisions',item.id)" title="Review this submitted budget request" t-esc="item.name"/></h4>
                <div class="decision-deadline"><span aria-hidden="true">▣</span><span>Deadline: <t t-esc="item.deadline || 'Not set'"/></span><t t-if="item.days !== null"><span>·</span><span t-esc="item.days &lt; 0 ? Math.abs(item.days) + ' days overdue' : item.days === 0 ? 'Due today' : item.days + ' days left'"/></t></div>
                <div class="decision-impact"><strong>Expected impact:</strong> <t t-esc="item.impact"/></div>
              </div><div class="decision-budget" t-esc="ownerCompactMoney(item.amount)"/>
            </article></div><p t-if="!ui.decisions.length" class="empty" t-esc="ui.decision_allowed ? 'No submitted budget proposals are awaiting a decision.' : 'Budget request access is required.'"/>
            <div class="decision-footer"><span>Submitted budget requests · active college<t t-if="ui.decision_count > 3"> · Showing the next 3 deadlines</t></span><span><strong>Total proposed budget: <t t-esc="ownerCompactMoney(ui.decision_budget)"/></strong></span></div>
          </section>
          <article class="panel owner-calendar-panel" id="campus-events">
            <div class="panel-head"><div><h3>Event management</h3><div class="panel-sub">Upcoming activities in the college calendar</div></div><button class="text-link" t-att-disabled="!ui.calendar.allowed" t-on-click="() => this.ownerOpenAction('ideastone_erp.action_college_calendar')">View events ↗</button></div>
            <div class="owner-event-counts"><div><strong t-esc="ui.calendar.upcoming"/><small>Upcoming</small></div><div><strong t-esc="ui.calendar.pending === null ? '—' : ui.calendar.pending"/><small>Awaiting approval · not tracked</small></div><div><strong t-esc="ui.calendar.today"/><small>Happening today</small></div></div>
            <div class="deadline-list"><div class="deadline" t-foreach="ui.calendar.rows" t-as="item" t-key="item.id"><div class="datebox"><strong t-esc="ownerDay(item.date)"/><small t-esc="ownerMonthShort(item.date)"/></div><div class="deadline-info"><strong t-esc="item.name"/><small><t t-esc="item.category"/> · <t t-esc="item.venue"/></small></div><span class="pill blue">Upcoming</span></div></div>
            <p t-if="!ui.calendar.rows.length" class="empty" t-esc="ui.calendar.allowed ? 'No upcoming events.' : 'Calendar access is required.'"/>
          </article>
        </section>
        <section class="panel owner-performance-panel" id="student-performance"><div class="panel-head"><div><h3>Student performance</h3><div class="panel-sub">Latest published assessment · <t t-esc="ui.performance.assessment || 'No published results for this period'"/></div></div><button class="text-link" t-att-disabled="!ownerCanOpen('ideastone_erp.mvp_results')" t-on-click="() => this.ownerOpenAction('ideastone_erp.mvp_results')">View performance ↗</button></div>
          <t t-if="ui.performance.allowed &amp;&amp; ui.performance.pass_rate !== null"><div class="owner-performance-metrics"><div><small>Overall pass rate</small><strong><t t-esc="ui.performance.pass_rate"/>%</strong></div><div><small>Average score</small><strong><t t-esc="ui.performance.average"/> / 100</strong></div><div><small>Distinction students (75%+)</small><strong t-esc="ui.performance.distinctions"/></div><div><small>Students needing support (&lt;50%)</small><strong t-esc="ui.performance.support_needed"/></div></div><div class="bar-list"><div t-foreach="ui.performance.year_rates" t-as="row" t-key="row.label"><div class="bar-label"><span><t t-esc="row.label"/> · <t t-esc="row.students"/> students</span><strong><t t-esc="row.rate"/>%</strong></div><div class="bar-track"><div class="bar-fill green" t-att-style="'width:' + row.rate + '%'"/></div></div></div></t>
          <p t-else="" class="empty" t-esc="ui.performance.allowed ? 'No published results for this period.' : 'Academic results access is required.'"/><p class="section-note"><t t-esc="ui.performance.marks_pending"/> past examinations awaiting publication. Rates include only unique students in the assessment named above.</p>
        </section>
        <section class="panel deadlines-panel" id="exams"><div class="panel-head"><div><h3>Upcoming dates &amp; deadlines</h3><div class="panel-sub">Examinations, fee due dates and admissions milestones</div></div><button class="text-link" t-att-disabled="!ownerCanOpen('ideastone_erp.action_college_calendar')" t-on-click="() => this.ownerOpenAction('ideastone_erp.action_college_calendar')">Open calendar ↗</button></div>
          <div class="deadline-list"><div class="deadline" t-foreach="ui.deadlines" t-as="item" t-key="item.key"><div class="datebox"><strong t-esc="ownerDay(item.date)"/><small t-esc="ownerMonthShort(item.date)"/></div><div class="deadline-info"><strong t-esc="item.name"/><small t-esc="item.detail"/></div><span t-att-class="item.overdue ? 'pill amber' : 'pill blue'" t-esc="item.overdue ? 'Overdue' : 'Upcoming'"/></div></div><p t-if="!ui.deadlines.length" class="empty">No upcoming milestones or overdue fees in this academic scope.</p>
        </section>
        <section class="bottom-grid"><article class="panel"><div class="panel-head"><div><h3>Recent activity</h3><div class="panel-sub">Latest audited workflow actions in the selected period</div></div><button class="text-link" t-att-disabled="!ownerCanOpen('ideastone_erp.mvp_audit')" t-on-click="() => this.ownerOpenAction('ideastone_erp.mvp_audit')">View audit log ↗</button></div><div class="table-wrap"><table class="data-table"><thead><tr><th>ACTIVITY</th><th>OWNER</th><th>TIME</th><th>STATUS</th></tr></thead><tbody><tr t-foreach="ui.recent.slice(0,4)" t-as="item" t-key="item.id"><td t-esc="item.name"/><td><div class="person"><span class="avatar" t-esc="item.actor.slice(0,2).toUpperCase()"/><t t-esc="item.actor"/></div></td><td t-esc="item.when"/><td><span class="pill blue">Recorded</span></td></tr><tr t-if="!ui.recent.length"><td colspan="4" class="empty">No audited workflow actions in this period.</td></tr></tbody></table></div></article>
          <article class="panel"><div class="panel-head"><div><h3>Operational watchlist</h3><div class="panel-sub">Items that need an owner or follow-up</div></div><span class="pill red"><t t-esc="ui.watchlist.filter(row => row.allowed &amp;&amp; row.count).length"/> <t t-esc="ui.watchlist.filter(row => row.allowed &amp;&amp; row.count).length === 1 ? 'signal' : 'signals'"/></span></div><div class="deadline-list"><div class="deadline" t-foreach="ui.watchlist.filter(row => row.allowed &amp;&amp; row.count)" t-as="item" t-key="item.kind"><span t-att-class="'datebox watch-icon ' + item.tone"><i t-att-class="'fa fa-' + item.icon" aria-hidden="true"/></span><div class="deadline-info"><strong t-esc="item.label"/><small><t t-esc="item.allowed ? item.count : 'Access required'"/> · <t t-esc="item.detail"/></small></div><button class="btn" t-att-disabled="!item.allowed" t-on-click="() => this.ownerOverviewAction(item.kind)">Review</button></div><p t-if="!ui.watchlist.some(row => row.allowed &amp;&amp; row.count)" class="empty">No urgent follow-ups in this scope.</p></div></article></section>
        <section class="panel quick-panel"><div class="panel-head"><div><h3>Quick access</h3><div class="panel-sub">Open permitted campus modules</div></div></div><div class="quick-grid"><button class="quick" t-foreach="ownerQuickActions" t-as="item" t-key="item.label" t-on-click="() => this.ownerQuick(item)"><span class="quick-icon"><i t-att-class="'fa fa-' + item.icon" aria-hidden="true"/></span><strong t-esc="item.label"/><small t-esc="item.detail"/></button></div></section>
        <footer class="footer"><span>VCET Campus ERP · Owner / Admin workspace · Powered by Ideastone</span><span>Saved college records · Rule-based follow-up signals</span></footer>
      </t>
    </div>
  </t>
  <t t-name="ideastone_erp.OwnerReportFilters">
    <Dialog title="'Report filters'" size="'md'" contentClass="'admin_filter_dialog'">
      <form id="admin_overview_filter_form" class="admin_overview" t-on-submit.prevent="apply">
        <div class="filters">
          <div class="field"><label for="admin_from">From</label><input id="admin_from" type="date" required="required" t-model="state.date_from" t-att-disabled="state.busy"/></div>
          <div class="field"><label for="admin_to">Through</label><input id="admin_to" type="date" required="required" t-model="state.date_to" t-att-disabled="state.busy"/></div>
          <div class="field"><label for="admin_year">Academic year</label><select id="admin_year" t-model="state.year_id" t-att-disabled="state.busy"><option value="">All academic years</option><option t-foreach="props.years" t-as="year" t-key="year.id" t-att-value="year.id" t-esc="year.name"/></select></div>
        </div>
        <p t-if="state.error" class="alert alert-danger mt-3 mb-0" role="alert" t-esc="state.error"/>
      </form>
      <t t-set-slot="footer"><div class="admin_overview"><button class="btn primary" type="submit" form="admin_overview_filter_form" t-att-disabled="state.busy">Apply filters</button><button class="btn" type="button" t-on-click="props.close" t-att-disabled="state.busy">Cancel</button></div></t>
    </Dialog>
  </t>
</templates>
