<templates xml:space="preserve">
  <!-- The upstream timed review advert obscures forms and steals keyboard focus. -->
  <t t-inherit="web.WebClient" t-inherit-mode="extension">
    <xpath expr="//G2Review" position="replace"/>
  </t>
  <t t-name="ideastone_erp.OwnerOverview">
    <section class="campus_faculty_welcome"><div><span>YOUR CAMPUS, CONNECTED</span><h2>Welcome back, <t t-esc="state.user"/></h2><p>Admissions, academics and accounts, connected through saved college records.</p><span t-if="state.is_demo" class="campus_demo_label">DEMONSTRATION COLLEGE Â· SAMPLE DATA</span></div><i class="fa fa-university" aria-hidden="true"/></section>
    <form class="campus_owner_filters campus_panel" t-on-submit.prevent="loadOwnerMetrics">
      <label>From<input type="date" class="form-control" required="required" t-model="state.ownerFilters.date_from"/></label>
      <label>Through<input type="date" class="form-control" required="required" t-model="state.ownerFilters.date_to"/></label>
      <label>Academic year<select class="form-select" t-model="state.ownerFilters.year_id"><option value="">All academic years</option><option t-foreach="state.ownerMetrics.years" t-as="year" t-key="year.id" t-att-value="year.id" t-esc="year.name"/></select></label>
      <button class="btn btn-primary" t-att-disabled="state.ownerLoading">Apply filters</button>
    </form>
    <p t-if="state.ownerLoading" role="status">Loading saved recordsâ€¦</p>
    <div t-if="state.ownerError" class="alert alert-danger" role="alert"><t t-esc="state.ownerError"/><button class="btn btn-outline-danger ms-2" t-on-click="loadOwnerMetrics">Retry</button></div>
    <t t-if="!state.ownerError &amp;&amp; !state.ownerLoading">
      <section class="campus_stats" aria-label="College summary"><button class="campus_stat campus_owner_stat" t-foreach="state.ownerMetrics.stats" t-as="stat" t-key="stat.label" t-on-click="() => this.ownerSource(stat)" t-att-disabled="!stat.allowed"><div><span t-esc="stat.label"/><strong t-esc="stat.value"/><small t-esc="stat.detail"/></div><i class="fa fa-angle-right" aria-hidden="true"/></button></section>
      <section t-if="state.ownerMetrics.setup.some(item => !item.ready)" class="campus_panel mb-4"><h2>Finish your college setup</h2><p class="campus_muted">Configure these records before enrolling students or creating class rosters.</p><div class="campus_owner_setup"><button t-foreach="state.ownerMetrics.setup" t-as="item" t-key="item.label" class="btn" t-att-class="item.ready ? 'btn-light' : 'btn-outline-primary'" t-on-click="() => this.open(item)"><i t-att-class="item.ready ? 'fa fa-check me-2' : 'fa fa-plus me-2'"/><t t-esc="item.label"/></button></div></section>
      <div class="campus_owner_charts">
        <section class="campus_panel"><h2>Admissions funnel</h2><p class="campus_muted">Applications in the selected period, grouped by current decision stage.</p><div t-if="state.ownerMetrics.funnel.some(row => row.value)"><div class="campus_chart_row" t-foreach="state.ownerMetrics.funnel" t-as="row" t-key="row.label"><div><span t-esc="row.label"/><strong t-esc="row.value"/></div><div class="campus_chart_track"><span t-att-style="'width:' + chartWidth(row.value, state.ownerMetrics.funnel)"/></div></div></div><p t-else="" class="campus_empty">No applications in this period. Start with Admissions â†’ Enquiries.</p></section>
        <section class="campus_panel"><h2>Monthly collection &amp; outstanding</h2><p class="campus_muted">Net receipts by posting month; open balances by due month as of the report end date. Amounts use your college currency.</p><div class="campus_chart_row" t-foreach="state.ownerMetrics.collection" t-as="row" t-key="row.label"><div><span t-esc="row.label"/><strong>Net <t t-esc="number(row.collected)"/> Â· Due <t t-esc="number(row.dues)"/></strong></div><div class="campus_chart_track"><span t-att-style="'width:' + chartWidth(row.collected, state.ownerMetrics.collection, ['collected','dues'])"/></div><div class="campus_chart_track campus_chart_due"><span t-att-style="'width:' + chartWidth(row.dues, state.ownerMetrics.collection, ['collected','dues'])"/></div></div><p t-if="!state.ownerMetrics.collection.length" class="campus_empty">No fee records yet. Assign a fee structure, post an invoice and record a payment.</p></section>
        <section class="campus_panel"><h2>Attendance trend</h2><p class="campus_muted">Completed, uncancelled sessions. Late counts as present; excused follows the college policy.</p><div class="campus_chart_row" t-foreach="state.ownerMetrics.trend" t-as="row" t-key="row.label"><div><span t-esc="row.label"/><strong><t t-esc="number(row.value)"/>%</strong></div><div class="campus_chart_track campus_chart_attendance"><span t-att-style="'width:' + row.value + '%'"/></div></div><p t-if="!state.ownerMetrics.trend.length" class="campus_empty">No submitted attendance in this period. Open a timetable session and take attendance.</p></section>
        <section class="campus_panel"><h2>Active students by programme</h2><p class="campus_muted">Current active students and running enrolments in the selected academic year.</p><div class="campus_chart_row" t-foreach="state.ownerMetrics.programmes" t-as="row" t-key="row.label"><div><span t-esc="row.label"/><strong t-esc="row.value"/></div><div class="campus_chart_track"><span t-att-style="'width:' + chartWidth(row.value, state.ownerMetrics.programmes)"/></div></div><p t-if="!state.ownerMetrics.programmes.length" class="campus_empty">No active enrolments. Convert an approved application or import validated student records.</p></section>
        <section class="campus_panel"><h2>Recent activity</h2><div t-foreach="state.ownerMetrics.recent" t-as="item" t-key="item.id" class="campus_owner_activity"><strong t-esc="item.name"/><small><t t-esc="item.actor"/> Â· <t t-esc="item.when"/></small></div><p t-if="!state.ownerMetrics.recent.length" class="campus_empty">No audited workflow actions in this period.</p></section>
        <section class="campus_panel"><h2>Upcoming exams &amp; fees due</h2><div t-foreach="state.ownerMetrics.upcoming" t-as="item" t-key="item.id" class="campus_owner_activity"><strong t-esc="item.name"/><small t-esc="item.when"/></div><div t-foreach="state.ownerMetrics.due_dates" t-as="item" t-key="item.invoice" class="campus_owner_activity"><strong><t t-esc="item.student"/> Â· <t t-esc="number(item.balance)"/> due</strong><small><t t-esc="item.invoice"/> Â· <t t-esc="item.due"/></small></div><p t-if="!state.ownerMetrics.upcoming.length &amp;&amp; !state.ownerMetrics.due_dates.length" class="campus_empty">No upcoming exams or unpaid invoices in your selected academic scope.</p></section>
        <section class="campus_panel"><h2>Published notices</h2><div t-foreach="state.ownerMetrics.notices" t-as="item" t-key="item.id" class="campus_owner_activity"><strong t-esc="item.name"/><small><t t-esc="item.date"/> Â· <t t-esc="item.audience"/></small></div><p t-if="!state.ownerMetrics.notices.length" class="campus_empty">No current in-app notices. Publish a notice from Communication.</p></section>
      </div>
    </t>
  </t>
</templates>
