<templates xml:space="preserve">
  <!-- The upstream timed review advert obscures forms and steals keyboard focus. -->
  <t t-inherit="web.WebClient" t-inherit-mode="extension"><xpath expr="//G2Review" position="replace"/></t>
  <t t-name="ideastone_erp.OwnerOverview">
    <t t-set="ui" t-value="ownerUI"/>
    <div class="admin_overview">
      <header class="page-head"><div><div class="eyebrow">Campus intelligence</div><h1>Admin overview</h1><div class="subtitle">Your campus at a glance — performance, priorities and recorded insights.</div></div><div class="actions"><div class="period" aria-label="Reporting period"><button type="button" t-att-class="ownerPeriodSelected('today') ? 'selected' : ''" t-att-aria-pressed="ownerPeriodSelected('today')" t-att-disabled="state.ownerLoading" t-on-click="() => this.ownerPeriod('today')">Today</button><button type="button" t-att-class="ownerPeriodSelected('month') ? 'selected' : ''" t-att-aria-pressed="ownerPeriodSelected('month')" t-att-disabled="state.ownerLoading" t-on-click="() => this.ownerPeriod('month')">This month</button><button type="button" t-att-class="ownerPeriodSelected('semester') ? 'selected' : ''" t-att-aria-pressed="!!ownerPeriodSelected('semester')" t-att-disabled="state.ownerLoading || !ui.semester" title="Uses the current semester when its dates are unambiguous in this academic scope" t-on-click="() => this.ownerPeriod('semester')">Semester</button></div><button class="btn filter-button" type="button" aria-label="Filters" title="Filters" t-on-click="ownerOpenFilters" t-att-disabled="state.ownerLoading"><i class="fa fa-filter" aria-hidden="true"/></button><button class="btn" type="button" t-on-click="loadOwnerMetrics" t-att-disabled="state.ownerLoading"><i class="fa fa-refresh" aria-hidden="true"/> Refresh</button><button class="btn primary" type="button" title="Print or save this overview as PDF" t-on-click="ownerPrint" t-att-disabled="state.ownerLoading || !!state.ownerError"><i class="fa fa-download" aria-hidden="true"/> Export report</button></div></header>
      <section class="hero"><div><div class="hero-kicker">✦ Your campus, connected</div><h2><t t-esc="ui.greeting"/>, <t t-esc="state.user"/>.</h2><p>Here is the latest operational snapshot. Your campus assistant highlights saved records that may need attention.</p><span t-if="state.is_demo" class="demo-note">Demonstration college · sample records</span></div><div class="hero-right"><div class="ai-status"><small><span class="pulse"/> CAMPUS PULSE</small><strong t-esc="ui.insights.length ? 'Follow-ups to review' : 'Saved college records'"/><small><t t-esc="ui.insights.length"/> <t t-esc="ui.insights.length === 1 ? 'recommendation' : 'recommendations'"/> · <t t-esc="ui.watchlist.filter(row => row.allowed &amp;&amp; row.count).length"/> <t t-esc="ui.watchlist.filter(row => row.allowed &amp;&amp; row.count).length === 1 ? 'watchlist signal' : 'watchlist signals'"/></small></div><i class="fa fa-university hero-illustration" aria-hidden="true"/></div></section>
      <div class="snapshot-strip"><div><span class="snapshot-dot"/><span><strong>Live campus snapshot</strong><small><t t-esc="ownerYearLabel"/> · Updated <t t-esc="ui.updated"/></small></span></div><div class="snapshot-right"><span><t t-esc="ui.kpis.length"/> key indicators</span><span class="snapshot-separator"/><span><t t-esc="ui.insights.length"/> <t t-esc="ui.insights.length === 1 ? 'recorded insight' : 'recorded insights'"/></span></div></div>
      <p t-if="state.ownerLoading" class="loading-note" role="status">Loading saved college records…</p><div t-if="state.ownerError" class="alert alert-danger" role="alert"><t t-esc="state.ownerError"/><button class="btn" t-on-click="loadOwnerMetrics">Retry</button></div>
      <t t-if="!state.ownerError &amp;&amp; !state.ownerLoading">
        <div class="section-head"><div><h3>Campus performance</h3><p>Key indicators for the selected scope; current-count cards show their scope below.</p></div><button class="text-link" t-on-click="() => this.chooseModule({key:'reports'})">View all analytics ↗</button></div>
        <section class="kpis" aria-label="College summary"><button type="button" class="kpi campus_owner_stat" t-foreach="ui.kpis" t-as="stat" t-key="stat.kind" t-on-click="() => this.ownerSource(stat)" t-att-disabled="!stat.allowed"><div class="kpi-top"><span class="kpi-label" t-esc="stat.label"/><span t-att-class="'kpi-icon ' + stat.tone"><i t-att-class="'fa fa-' + stat.icon" aria-hidden="true"/></span></div><div class="kpi-value" t-esc="stat.value"/><div class="kpi-meta" t-esc="stat.detail"/></button></section>
        <section t-if="state.ownerMetrics.setup.some(item => !item.ready)" class="setup-note"><strong>Finish your college setup</strong><div><button t-foreach="state.ownerMetrics.setup.filter(item => !item.ready)" t-as="item" t-key="item.label" class="btn" t-on-click="() => this.open(item)"><i class="fa fa-plus" aria-hidden="true"/> <t t-esc="item.label"/></button></div></section>
        <section class="content-grid campus_owner_charts">
          <article class="panel activity-panel"><div class="panel-head"><div><h3>Campus activity trend</h3><div class="panel-sub">Monthly attendance and admissions conversion · selected period</div></div><span class="pill blue">Saved records</span></div>
            <svg t-if="ui.activity.length" class="chart" viewBox="0 0 620 235" role="img" aria-label="Monthly campus activity, 0 to 100 percent"><line t-foreach="[30,70,110,150,190]" t-as="y" t-key="y" class="gridline" x1="48" t-att-y1="y" x2="600" t-att-y2="y"/><text x="9" y="33">100%</text><text x="16" y="73">75%</text><text x="16" y="113">50%</text><text x="16" y="153">25%</text><text x="22" y="193">0%</text><polyline t-foreach="ownerActivityPoints('attendance')" t-as="points" t-key="points_index" class="lineblue" t-att-points="points"/><polyline t-foreach="ownerActivityPoints('conversion')" t-as="points" t-key="points_index" class="linegreen" t-att-points="points"/><t t-foreach="ui.activity" t-as="row" t-key="row.label"><circle t-if="row.attendance !== null" t-att-cx="ui.activity.length === 1 ? 320 : 55 + row_index * 530 / (ui.activity.length - 1)" t-att-cy="190 - row.attendance * 1.6" r="3.5" fill="#1769e8"/><circle t-if="row.conversion !== null" t-att-cx="ui.activity.length === 1 ? 320 : 55 + row_index * 530 / (ui.activity.length - 1)" t-att-cy="190 - row.conversion * 1.6" r="3" fill="#25ae8b"/><text t-if="row_index % Math.max(1, Math.ceil(ui.activity.length / 8)) === 0" t-att-x="ui.activity.length === 1 ? 320 : 55 + row_index * 530 / (ui.activity.length - 1)" y="215" text-anchor="middle" t-esc="ownerMonth(row.label)"/></t></svg><p t-else="" class="empty">No completed attendance or applications in this period.</p>
            <div class="chart-legend"><span><i class="legend-dot blue"/>Attendance rate</span><span><i class="legend-dot green"/>Admissions conversion</span></div><details t-if="ui.activity.length" class="chart-data"><summary>View chart data</summary><div class="table-wrap"><table class="data-table"><thead><tr><th>Month</th><th>Attendance</th><th>Admissions converted</th></tr></thead><tbody><tr t-foreach="ui.activity" t-as="row" t-key="row.label"><td t-esc="ownerMonth(row.label)"/><td t-esc="row.attendance === null ? 'Not recorded' : number(row.attendance) + '%'"/><td t-esc="row.conversion === null ? 'Not recorded' : number(row.conversion) + '%'"/></tr></tbody></table></div></details>
          </article>
          <article class="panel"><div class="panel-head"><div><h3>Admissions funnel</h3><div class="panel-sub">Applicant progression by current decision stage</div></div><button class="text-link" t-att-disabled="!ownerCanOpen('ideastone_erp.mvp_applications')" t-on-click="() => this.ownerOpenAction('ideastone_erp.mvp_applications')">Open admissions ↗</button></div><div class="donut-wrap"><svg class="donut" viewBox="0 0 160 160" role="img" aria-label="Admissions stage distribution"><circle cx="80" cy="80" r="56" fill="none" stroke="#edf2f8" stroke-width="17"/><circle t-foreach="ownerFunnel" t-as="row" t-key="row.label" cx="80" cy="80" r="56" fill="none" t-att-stroke="row.color" stroke-width="17" t-att-stroke-dasharray="row.dash" t-att-stroke-dashoffset="row.offset" transform="rotate(-90 80 80)"/><text x="80" y="76" text-anchor="middle" class="donut-total" t-esc="ui.funnel.reduce((sum,row) => sum + row.value,0)"/><text x="80" y="94" text-anchor="middle" class="donut-caption">Applications</text></svg><div class="donut-legend"><div class="legend-row" t-foreach="ownerFunnel" t-as="row" t-key="row.label"><span class="legend-name"><i class="legend-dot" t-att-style="'background:' + row.color"/><t t-esc="row.label"/></span><strong><t t-esc="row.value"/> · <t t-esc="number(row.percent)"/>%</strong></div></div></div><div class="data-note">Counts reconcile to applications in the selected date range and academic year.</div></article>
        </section>
        <section class="content-grid">
          <article class="panel collection-panel" id="fees">
            <div class="panel-head"><div><h3>Monthly fee collection</h3><div class="panel-sub">Collected amount compared with billed fees · last six due months</div></div><span class="pill green" t-esc="ui.fee_percent === null ? 'No billed fees' : ui.fee_percent + '% collected'"/></div>
            <div t-if="ui.fee_allowed" class="fee-chart" role="img" aria-label="Monthly fee collection against posted invoices by due month, as of the report end date">
              <div class="fee-chart-legend"><span><i class="fee-key collected"/>Collected</span><span><i class="fee-key target"/>Remaining to collect</span><span class="fee-unit">Amounts in ₹ · L = lakh</span></div>
              <div class="fee-bars"><div t-foreach="ui.fee_months" t-as="row" t-key="row.label" t-att-class="'fee-month' + (row_last ? ' current' : '')">
                <div class="fee-values"><strong t-esc="ownerCompactMoney(row.collected)"/><small>/ <t t-esc="ownerCompactMoney(row.target)"/></small></div>
                <div class="fee-bar-track"><div class="fee-bar-fill" t-att-style="'height:' + Math.min(100, row.percent || 0) + '%;min-height:' + (row.collected ? '4px' : '0')"/></div>
                <span class="fee-month-label" t-esc="ownerMonth(row.label)"/><span class="fee-percent" t-esc="row.percent === null ? 'No billed fees' : Math.round(row.percent) + '% collected'"/>
              </div></div>
            </div><p t-else="" class="empty">Fee reporting access is required.</p>
            <div class="chart-legend fee-note">Posted invoice amounts form the billed-fee target. Collections and remaining balances use the same due-month invoices, as of <strong t-esc="state.ownerAppliedFilters.date_to"/>.</div>
          </article>
          <article class="panel ai-panel"><div class="panel-head"><div class="ai-heading"><div class="ai-icon">✦</div><div><h3>Campus insights &amp; recommendations</h3><div class="panel-sub">Follow-up signals from saved college records</div></div></div><span class="ai-tag">RULE BASED</span></div><div class="insight-list"><button class="insight" t-foreach="ui.insights" t-as="item" t-key="item.source" t-on-click="() => this.ownerSource({kind:item.source,allowed:true})"><span class="insight-symbol"><i t-att-class="'fa fa-' + item.icon" aria-hidden="true"/></span><span><strong t-esc="item.title"/><span class="insight-copy" t-esc="item.text"/><span class="tag" t-esc="item.tag"/></span></button><p t-if="!ui.insights.length" class="empty">No follow-up signals in the records available for this scope.</p></div><button class="btn light" t-on-click="() => this.chooseModule({key:'reports'})">View all analytics ↗</button></article>
        </section>
        <section class="bottom-grid decision-grid">
          <section class="panel decision-panel" id="decision-overview">
            <div class="panel-head"><div><h3>Decision Overview</h3><div class="panel-sub">Pending proposals, approval deadlines and expected campus impact</div></div><span class="pill amber"><t t-esc="ui.decision_count"/> <t t-esc="ui.decision_count === 1 ? 'decision' : 'decisions'"/></span></div>
            <div class="decision-list"><article class="decision-item" t-foreach="ui.decisions" t-as="item" t-key="item.id">
              <div t-att-class="'decision-icon ' + item.tone" aria-hidden="true" t-esc="item.icon"/>
              <div class="decision-copy"><h4><button class="decision-open" t-on-click="() => this.ownerOverviewAction('decisions',item.id)" title="Review this submitted budget request" t-esc="item.name"/></h4>
                <div class="decision-deadline"><span aria-hidden="true">▣</span><span>Deadline: <t t-esc="item.deadline || 'Not set'"/></span><t t-if="item.days !== null"><span>·</span><span t-esc="item.days &lt; 0 ? Math.abs(item.days) + ' days overdue' : item.days === 0 ? 'Due today' : item.days + ' days left'"/></t></div>
                <div class="decision-impact"><strong>Expected impact:</strong> <t t-esc="item.impact"/></div>
              </div><div class="decision-budget" t-esc="ownerCompactMoney(item.amount)"/>
            </article></div><p t-if="!ui.decisions.length" class="empty" t-esc="ui.decision_allowed ? 'No submitted budget proposals are awaiting a decision.' : 'Budget request access is required.'"/>
            <div class="decision-footer"><span>Submitted budget requests · active college<t t-if="ui.decision_count > 3"> · Showing the next 3 deadlines</t></span><span><strong>Total proposed budget: <t t-esc="ownerCompactMoney(ui.decision_budget)"/></strong></span></div>
          </section>
          <article class="panel" id="attendance"><div class="panel-head"><div><h3>Attendance by department</h3><div class="panel-sub">Completed sessions · college threshold <t t-esc="ui.threshold"/>%</div></div><button class="text-link" t-on-click="() => this.ownerSource({kind:'attendance',allowed:true})">View details ↗</button></div><div class="bar-list"><div t-foreach="ui.departments.slice(0,6)" t-as="row" t-key="row.label"><div class="bar-label"><span t-esc="row.label"/><strong><t t-esc="number(row.value)"/>%</strong></div><div class="bar-track"><div t-att-class="row.value &lt; ui.threshold ? 'bar-fill amber' : 'bar-fill green'" t-att-style="'width:' + row.value + '%'"/></div></div></div><p t-if="!ui.departments.length" class="empty">No completed eligible attendance in this period.</p><p class="section-note">Late counts as present; excused sessions follow the college policy. Lowest rates appear first.</p></article>
          <article class="panel deadlines-panel" id="exams"><div class="panel-head"><div><h3>Upcoming dates &amp; deadlines</h3><div class="panel-sub">Examination schedules and posted fee due dates</div></div><button class="text-link" t-att-disabled="!ownerCanOpen('ideastone_erp.mvp_exams')" t-on-click="() => this.ownerOpenAction('ideastone_erp.mvp_exams')">Open exams ↗</button></div><div class="deadline-list"><div class="deadline" t-foreach="ui.upcoming.slice(0,3)" t-as="item" t-key="item.id"><div class="datebox"><strong t-esc="item.day"/><small t-esc="item.month"/></div><div class="deadline-info"><strong t-esc="item.name"/><small t-esc="item.when"/></div><span class="pill blue">Upcoming</span></div><div class="deadline" t-foreach="state.ownerMetrics.due_dates.slice(0,3)" t-as="item" t-key="item.id"><div class="datebox"><strong t-esc="ownerDay(item.due)"/><small t-esc="ownerMonthShort(item.due)"/></div><div class="deadline-info"><strong t-esc="item.student"/><small><t t-esc="item.invoice"/> · <t t-esc="ownerMoney(item.balance)"/> due</small></div><span t-att-class="item.due &lt; state.ownerAppliedFilters.date_to ? 'pill amber' : 'pill blue'" t-esc="item.due &lt; state.ownerAppliedFilters.date_to ? 'Overdue' : 'Fee due'"/></div></div><p t-if="!ui.upcoming.length &amp;&amp; !state.ownerMetrics.due_dates.length" class="empty">No upcoming exams or unpaid invoices in this academic scope.</p></article></section>
        <section class="panel events-panel" id="campus-events"><div class="panel-head"><div class="ai-heading"><div class="ai-icon">✦</div><div><h3>Campus events &amp; experiences</h3><div class="panel-sub">Cultural fests, student life, innovation showcases and campus-wide celebrations</div></div></div><div class="events-head-right"><span class="pill blue"><t t-esc="ui.event_count"/> scheduled</span><button class="btn light" t-att-disabled="!ui.event_allowed" t-on-click="() => this.ownerOverviewAction('events')"><i class="fa fa-calendar" aria-hidden="true"/> Event calendar</button></div></div>
          <t t-if="ui.events.length"><t t-set="featured" t-value="ui.events[0]"/><div class="events-feature"><div class="event-feature-date"><div class="calendar-tile"><strong t-esc="featured.day"/><small t-esc="featured.month"/></div><div><div class="featured-label">Featured event · Next on campus</div><h4 t-esc="featured.name"/><p t-esc="featured.category"/></div></div><div class="event-feature-copy"><h4 t-esc="featured.name"/><p t-esc="featured.description || 'Open this event for its schedule and registration details.'"/><div class="event-meta"><span><i class="fa fa-clock-o" aria-hidden="true"/> <t t-esc="featured.time"/></span><span><i class="fa fa-map-marker" aria-hidden="true"/> <t t-esc="featured.venue"/></span><span><i class="fa fa-user-o" aria-hidden="true"/> <t t-esc="featured.organizer"/></span></div><button class="event-open feature-open" t-on-click="() => this.ownerOverviewAction('events',featured.id)">View event ↗</button></div></div><div class="event-list"><article class="event-card" t-foreach="ui.events.slice(1)" t-as="event" t-key="event.id"><div t-att-class="'event-date-mini tone-' + event_index"><strong t-esc="event.day"/><small t-esc="event.month"/></div><div class="event-info"><h4 t-esc="event.name"/><p><t t-esc="event.time"/> · <t t-esc="event.venue"/></p><div class="event-bottom"><span class="event-category" t-esc="event.category"/><button class="event-open" t-on-click="() => this.ownerOverviewAction('events',event.id)">View event ↗</button></div></div></article></div></t><p t-else="" class="empty" t-esc="ui.event_allowed ? 'No active campus events are scheduled in the next 90 days. Create an event to start planning.' : 'Event access is required to view the campus calendar.'"/>
          <div class="events-foot"><span>Next 90 days · active college · event times use your account timezone.</span><button class="event-open" t-att-disabled="!ui.event_create" t-on-click="() => this.ownerOverviewAction('create_event')">＋ Create event</button></div>
        </section>
        <section class="bottom-grid"><article class="panel"><div class="panel-head"><div><h3>Recent activity</h3><div class="panel-sub">Latest audited workflow actions in the selected period</div></div><button class="text-link" t-att-disabled="!ownerCanOpen('ideastone_erp.mvp_audit')" t-on-click="() => this.ownerOpenAction('ideastone_erp.mvp_audit')">View audit log ↗</button></div><div class="table-wrap"><table class="data-table"><thead><tr><th>ACTIVITY</th><th>OWNER</th><th>TIME</th><th>STATUS</th></tr></thead><tbody><tr t-foreach="ui.recent" t-as="item" t-key="item.id"><td t-esc="item.name"/><td><div class="person"><span class="avatar" t-esc="item.actor.slice(0,2).toUpperCase()"/><t t-esc="item.actor"/></div></td><td t-esc="item.when"/><td><span class="pill blue">Recorded</span></td></tr><tr t-if="!ui.recent.length"><td colspan="4" class="empty">No audited workflow actions in this period.</td></tr></tbody></table></div></article>
          <article class="panel"><div class="panel-head"><div><h3>Operational watchlist</h3><div class="panel-sub">Items that need an owner or follow-up</div></div><span class="pill red"><t t-esc="ui.watchlist.filter(row => row.allowed &amp;&amp; row.count).length"/> <t t-esc="ui.watchlist.filter(row => row.allowed &amp;&amp; row.count).length === 1 ? 'signal' : 'signals'"/></span></div><div class="deadline-list"><div class="deadline" t-foreach="ui.watchlist" t-as="item" t-key="item.kind"><span t-att-class="'datebox watch-icon ' + item.tone"><i t-att-class="'fa fa-' + item.icon" aria-hidden="true"/></span><div class="deadline-info"><strong t-esc="item.label"/><small><t t-esc="item.allowed ? item.count : 'Access required'"/> · <t t-esc="item.detail"/></small></div><button class="btn" t-att-disabled="!item.allowed" t-on-click="() => this.ownerOverviewAction(item.kind)">Review</button></div></div></article></section>
        <section class="panel quick-panel"><div class="panel-head"><div><h3>Quick actions</h3><div class="panel-sub">Shortcuts to frequent admin workflows</div></div><span class="pill blue">Your permitted actions</span></div><div class="quick-grid"><button class="quick" t-foreach="ownerQuickActions" t-as="item" t-key="item.label" t-on-click="() => this.ownerQuick(item)"><span class="quick-icon"><i t-att-class="'fa fa-' + item.icon" aria-hidden="true"/></span><strong t-esc="item.label"/><small t-esc="item.detail"/></button></div></section>
        <footer class="footer"><span>VCET Campus ERP · Owner / Admin workspace · Powered by Ideastone</span><span>Saved college records · Rule-based follow-up signals</span></footer>
      </t>
    </div>
  </t>
  <t t-name="ideastone_erp.OwnerReportFilters">
    <Dialog title="'Report filters'" size="'md'" contentClass="'admin_filter_dialog'">
      <form id="admin_overview_filter_form" class="admin_overview" t-on-submit.prevent="apply">
        <div class="filters">
          <div class="field"><label for="admin_from">From</label><input id="admin_from" type="date" required="required" t-model="state.date_from" t-att-disabled="state.busy"/></div>
          <div class="field"><label for="admin_to">Through</label><input id="admin_to" type="date" required="required" t-model="state.date_to" t-att-disabled="state.busy"/></div>
          <div class="field"><label for="admin_year">Academic year</label><select id="admin_year" t-model="state.year_id" t-att-disabled="state.busy"><option value="">All academic years</option><option t-foreach="props.years" t-as="year" t-key="year.id" t-att-value="year.id" t-esc="year.name"/></select></div>
        </div>
        <p t-if="state.error" class="alert alert-danger mt-3 mb-0" role="alert" t-esc="state.error"/>
      </form>
      <t t-set-slot="footer"><div class="admin_overview"><button class="btn primary" type="submit" form="admin_overview_filter_form" t-att-disabled="state.busy">Apply filters</button><button class="btn" type="button" t-on-click="props.close" t-att-disabled="state.busy">Cancel</button></div></t>
    </Dialog>
  </t>
</templates>
