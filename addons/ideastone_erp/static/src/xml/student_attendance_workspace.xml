<templates xml:space="preserve">
  <t t-name="ideastone_erp.StudentAttendanceWorkspace">
    <main class="campus_student_attendance">
      <div t-if="state.error" class="sa_error" role="alert"><t t-esc="state.error"/><button type="button" t-on-click="load">Retry</button></div>
      <div t-if="state.loading" class="sa_loading" role="status">Loading student attendance…</div>
      <t t-elif="state.data">
        <section class="sa_header sa_panel">
          <div class="sa_heading"><span class="sa_round_icon"><i class="fa fa-users"/></span><div><h1>Student Attendance</h1><p>Home <i class="fa fa-angle-right"/> Attendance <i class="fa fa-angle-right"/> <strong>Student Attendance</strong></p></div><span class="sa_last_login" t-if="state.data.last_login">Last Login: <t t-esc="state.data.last_login"/></span></div>
          <div class="sa_filters">
            <label>Institution <select aria-label="Institution"><option t-esc="state.data.company"/></select></label>
            <label>Department <select aria-label="Department" t-on-change="changeDepartment"><option value="" t-att-selected="!state.departmentId">All departments</option><t t-foreach="state.data.departments" t-as="department" t-key="department.id"><option t-att-value="department.id" t-att-selected="String(department.id) === state.departmentId" t-esc="department.name"/></t></select></label>
            <label>Staff <select aria-label="Staff" t-on-change="changeFaculty"><option value="" t-att-selected="!state.facultyId">All staff</option><t t-foreach="state.data.faculty" t-as="person" t-key="person.id"><option t-att-value="person.id" t-att-selected="String(person.id) === state.facultyId" t-esc="person.name"/></t></select></label>
          </div>
        </section>

        <section class="sa_metrics" aria-label="Student attendance metrics">
          <article class="sa_metric"><span class="sa_metric_icon blue"><i class="fa fa-book"/></span><div><small>Active Classes</small><strong t-esc="state.data.metrics.classes"/><p>For selected academic year</p></div></article>
          <article class="sa_metric"><span class="sa_metric_icon green"><i class="fa fa-users"/></span><div><small>Total Students Tracked</small><strong t-esc="state.data.metrics.students"/><p>Across active classes</p></div></article>
          <article class="sa_metric"><span class="sa_metric_icon red"><i class="fa fa-user"/></span><div><small>Today Absentees</small><strong t-esc="state.data.metrics.absentees"/><p>From submitted attendance</p></div></article>
          <article class="sa_metric"><span class="sa_metric_icon purple"><i class="fa fa-pie-chart"/></span><div><small>Attendance Rate</small><strong><t t-esc="state.data.metrics.rate === null ? '—' : state.data.metrics.rate + '%'"/></strong><p>Completed sessions this month</p></div></article>
          <article class="sa_metric"><span class="sa_metric_icon orange"><i class="fa fa-calendar"/></span><div><small>Sessions Logged Today</small><strong t-esc="state.data.metrics.sessions"/><p>Class hours recorded</p></div></article>
        </section>

        <div class="sa_top_grid">
          <section class="sa_panel sa_classes"><header><div class="sa_title"><i class="fa fa-book"/><h2>Active Classes of Acad Year <t t-esc="academicYearName"/></h2></div><button type="button" class="sa_icon_button" title="Download classes CSV" aria-label="Download classes CSV" t-on-click="exportClasses"><i class="fa fa-download"/></button></header>
            <div class="sa_class_filters"><label>Institution<select aria-label="Class institution"><option t-esc="state.data.company"/></select></label><label>Semester<select aria-label="Semester" t-on-change="changeTerm"><t t-foreach="state.data.terms" t-as="term" t-key="term.id"><option t-att-value="term.id" t-att-selected="String(term.id) === state.termId" t-esc="term.name"/></t><option t-if="!state.data.terms.length">No semesters configured</option></select></label></div>
            <div class="sa_table_scroll"><table><thead><tr><th>#</th><th aria-label="Select class"/><th>Class Name</th><th>From Date</th><th>To Date</th><th>Sem</th><th>Total</th></tr></thead><tbody><t t-foreach="classesPage" t-as="row" t-key="row.id"><tr t-att-class="String(row.id) === state.batchId ? 'selected' : ''" t-on-click="() => this.selectClass(row.id)"><td t-esc="state.classPage * 4 + row_index + 1"/><td><input type="radio" name="sa-class" t-att-checked="String(row.id) === state.batchId" aria-label="Select class"/></td><td t-esc="row.name"/><td t-esc="row.from"/><td t-esc="row.to"/><td t-esc="row.semester || '—'"/><td class="sa_total" t-esc="row.total"/></tr></t><tr t-if="!classesPage.length"><td colspan="7" class="sa_empty">No active classes for this selection.</td></tr></tbody></table></div>
            <footer><span>Showing <t t-esc="state.data.classes.length ? state.classPage * 4 + 1 : 0"/> to <t t-esc="Math.min((state.classPage + 1) * 4, state.data.classes.length)"/> of <t t-esc="state.data.classes.length"/> classes</span><div class="sa_pager"><button type="button" aria-label="Previous classes" t-att-disabled="state.classPage === 0" t-on-click="() => this.setClassPage(-1)"><i class="fa fa-angle-left"/></button><strong t-esc="state.classPage + 1"/><button type="button" aria-label="Next classes" t-att-disabled="state.classPage + 1 >= classPages" t-on-click="() => this.setClassPage(1)"><i class="fa fa-angle-right"/></button></div></footer>
          </section>

          <section class="sa_panel sa_roster"><header><div class="sa_title"><i class="fa fa-users"/><h2>View &amp; Select Absentia Student(s) in class</h2></div></header>
            <div class="sa_roster_toolbar"><label>Status <select aria-label="Student status filter" t-on-change="changeRosterFilter"><option value="all">Absent</option><option value="absent">Selected absent</option></select></label><label class="sa_check_label"><input type="checkbox" t-att-checked="state.showRegister" t-on-change="toggleRegister"/> Show Reg.No</label><button type="button" class="sa_primary" t-att-disabled="!state.data.can_save || state.saving" t-on-click="save"><i class="fa fa-floppy-o"/> <t t-esc="state.saving ? 'Saving…' : 'Save'"/></button></div>
            <div class="sa_table_scroll"><table><thead><tr><th>#</th><th><input type="checkbox" aria-label="Select all visible students as absent" t-on-change="toggleAllAbsent" t-att-disabled="!state.data.can_save"/></th><th>Roll No</th><th t-if="state.showRegister">Reg.No</th><th>Student Name</th></tr></thead><tbody><t t-foreach="studentsPage" t-as="student" t-key="student.id"><tr><td t-esc="state.studentPage * 6 + student_index + 1"/><td><input type="checkbox" t-att-checked="isAbsent(student.id)" t-att-disabled="!state.data.can_save" t-on-change="() => this.toggleAbsent(student.id)" t-att-aria-label="'Mark ' + student.name + ' absent'"/></td><td t-esc="student.roll"/><td t-if="state.showRegister" t-esc="student.reg"/><td t-esc="student.name"/></tr></t><tr t-if="!studentsPage.length"><td t-att-colspan="state.showRegister ? 5 : 4" class="sa_empty">No students in this class for the selected date.</td></tr></tbody></table></div>
            <footer><span>Showing <t t-esc="visibleStudents.length ? state.studentPage * 6 + 1 : 0"/> to <t t-esc="Math.min((state.studentPage + 1) * 6, visibleStudents.length)"/> of <t t-esc="visibleStudents.length"/> students</span><div class="sa_pager"><button type="button" aria-label="Previous students" t-att-disabled="state.studentPage === 0" t-on-click="() => this.setStudentPage(-1)"><i class="fa fa-angle-left"/></button><strong t-esc="state.studentPage + 1"/><button type="button" aria-label="Next students" t-att-disabled="state.studentPage + 1 >= studentPages" t-on-click="() => this.setStudentPage(1)"><i class="fa fa-angle-right"/></button></div></footer>
          </section>
        </div>

        <div class="sa_bottom_grid">
          <section class="sa_panel sa_trend"><header><div class="sa_title"><i class="fa fa-bar-chart"/><h2><t t-esc="state.chart === 'weekly' ? 'Weekly' : 'Monthly'"/> Attendance Trend - <t t-esc="state.data.month_name"/> <t t-esc="state.data.year"/></h2></div><div class="sa_toggle"><button type="button" t-att-class="state.chart === 'monthly' ? 'active' : ''" t-on-click="() => this.setChart('monthly')">Monthly</button><button type="button" t-att-class="state.chart === 'weekly' ? 'active' : ''" t-on-click="() => this.setChart('weekly')">Weekly</button></div></header><div class="sa_chart"><div class="sa_y_axis"><span>100</span><span>80</span><span>60</span><span>40</span><span>20</span><span>0</span></div><div class="sa_bars"><t t-foreach="chartBars" t-as="bar" t-key="bar.label"><div class="sa_bar_group"><strong><t t-esc="bar.rate"/>%</strong><div class="sa_bar" t-att-style="'height:' + bar.rate + '%'"/><small t-esc="bar.label"/></div></t></div></div><p t-if="state.data.metrics.rate === null" class="sa_chart_note">The trend will appear after attendance sheets are submitted.</p></section>
          <section class="sa_panel sa_hours"><header><div class="sa_title"><i class="fa fa-clock-o"/><h2>Select Hour</h2></div></header><div class="sa_hours_toolbar"><label>Date<input type="date" t-att-value="state.date" t-on-change="changeDate"/></label><span class="sa_class_name" t-esc="selectedClass?.name || 'Select a class'"/></div><div class="sa_hours_body"><div class="sa_table_scroll"><table><thead><tr><th>#</th><th>Hour</th><th>Session</th><th>Ab Count</th></tr></thead><tbody><t t-foreach="state.data.hours" t-as="hour" t-key="hour.id"><tr t-att-class="String(hour.id) === state.sessionId ? 'selected' : ''" t-on-click="() => this.selectHour(hour.id)"><td><input type="radio" name="sa-hour" t-att-checked="String(hour.id) === state.sessionId" aria-label="Select teaching hour"/></td><td t-esc="hour.number"/><td><t t-esc="hour.time"/><small t-esc="hour.subject"/></td><td t-esc="hour.absent"/></tr></t><tr t-if="!state.data.hours.length"><td colspan="4" class="sa_empty">No teaching hours scheduled on this date.</td></tr></tbody></table></div><div class="sa_notes"><label>Enter Notes of Lesson<textarea rows="5" placeholder="Enter lesson notes here…" t-att-value="state.notes" t-on-input="changeNotes" t-att-disabled="!state.data.can_save"/></label><button type="button" class="sa_history" t-att-disabled="!state.batchId" t-on-click="viewHistory"><i class="fa fa-clock-o"/> View Attendance History</button></div></div><p t-if="state.data.sheet_state === 'done'" class="sa_sheet_notice">Submitted attendance is read only. Use the authorized correction flow to change it.</p></section>
        </div>

        <section class="sa_panel sa_insights"><header><div class="sa_title"><i class="fa fa-magic"/><h2>AI Attendance Insights</h2></div><button type="button" class="sa_outline" t-on-click="viewInsights">View Insights</button></header><div class="sa_insight_cards"><t t-foreach="state.data.insights" t-as="insight" t-key="insight.title"><article t-att-class="insight.tone"><span><i t-att-class="'fa ' + insight.icon"/></span><div><h3 t-esc="insight.title"/><p t-esc="insight.text"/></div></article></t></div></section>
      </t>
    </main>
  </t>
</templates>
