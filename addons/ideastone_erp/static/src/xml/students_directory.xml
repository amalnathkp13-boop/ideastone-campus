<templates xml:space="preserve">
  <t t-name="ideastone_erp.StudentsDirectoryWorkspace">
    <main class="campus_students_workspace" t-ref="content">
      <p t-if="state.loading" class="loading-note" role="status">Loading student records…</p>
      <div t-if="state.error" class="alert alert-danger" role="alert"><span t-esc="state.error"/><button class="btn" type="button" t-on-click="load">Retry</button></div>
      <t t-if="state.data &amp;&amp; !state.error &amp;&amp; !state.loading">
        <div class="crumbrow"><span>VCET Campus / <strong>Students / <t t-esc="state.screen === 'directory' ? 'Student directory' : title"/></strong></span><div class="scope"><label>Academic year <select class="select" aria-label="Academic year" t-model="state.filters.year_id" t-on-change="yearChanged"><option value="0">All academic years</option><option t-foreach="state.data.years" t-as="year" t-key="year.id" t-att-value="year.id" t-esc="year.name"/></select></label><span t-esc="state.data.today"/></div></div>
        <p t-if="state.data.is_demo" class="demo-note">Demonstration college · Sample records for preview</p>
        <div t-if="['all','department'].includes(state.screen)" class="backline"><button type="button" t-on-click="() => this.show('directory')">← Student directory</button><span t-if="state.screen === 'department'">Department workspace</span></div>
        <t t-if="state.screen === 'department'"><div class="detailhero"><div><h1 t-esc="title"/><p>Explore enrolled students, class sections and programme-level records.</p></div><div class="detailstats"><div><strong t-esc="number(department?.count)"/><span>Student records</span></div><div><strong t-esc="percent(department?.fill)"/><span>Capacity filled</span></div><div><strong t-esc="number(department?.sections)"/><span>Sections</span></div></div></div></t>
        <div t-else="" class="headingrow"><div><h1 t-esc="title"/><p t-esc="state.screen === 'enrolments' ? 'Manage student course registrations, academic progression, section changes and placement history.' : state.screen === 'all' ? 'Search the complete student directory across departments and sections.' : 'A live overview of enrolment, department strength, class sections and student records.'"/></div><button t-if="state.screen === 'directory'" class="btn" type="button" t-on-click="load"><i class="fa fa-refresh" aria-hidden="true"/> Refresh</button><button t-elif="state.screen === 'all'" class="btn" type="button" t-on-click="() => this.exportRows()"><i class="fa fa-download" aria-hidden="true"/> Export students</button><button t-else="" class="btn primary" type="button" t-att-disabled="!state.data.create_enrolment" t-on-click="() => this.open('enrolment',null,true)">＋ New enrolment</button></div>
        <t t-if="state.screen === 'directory'"><section class="hero"><div><div class="hero-label">ONE CAMPUS · EVERY STUDENT</div><h2>Know your student community at a glance.</h2><p>Move from campus-wide insights to department, programme, section and individual student records without leaving the directory.</p></div><div class="hero-stat"><strong t-esc="number(c.total)"/><span>student records</span></div></section></t>
        <div t-if="['directory','enrolments'].includes(state.screen)" class="kpis"><article class="kpi" t-foreach="stats" t-as="stat" t-key="stat.label"><div class="kpi-top"><span t-esc="stat.label"/><span class="kpi-icon"><i t-att-class="'fa fa-' + stat.icon" aria-hidden="true"/></span></div><strong t-esc="number(stat.value)"/><div class="kpi-foot" t-att-class="stat.warn ? 'review-note' : ''" t-esc="stat.detail"/></article></div>
        <t t-if="state.screen === 'directory'">
          <div class="sectionhead"><div><h2>Department strength</h2><p>Select a department to explore year-wise sections and enrolled students.</p></div><div class="actions"><button class="filter-toggle icon-only" type="button" aria-label="Filter departments" t-att-aria-expanded="state.filterOpen ? 'true' : 'false'" t-on-click="() => state.filterOpen = !state.filterOpen"><i class="fa fa-filter" aria-hidden="true"/></button><button class="btn lightblue" type="button" t-on-click="() => this.show('all')">View all students ↗</button><button class="btn" type="button" t-on-click="() => this.exportRows('departments')">Export report <i class="fa fa-download" aria-hidden="true"/></button></div></div>
          <div t-if="state.filterOpen" class="filter-panel"><div class="field"><label for="students_department_filter">Department</label><select id="students_department_filter" t-model="state.filters.department_id"><option value="0">All departments</option><option t-foreach="state.data.departments" t-as="dept" t-key="dept.id" t-att-value="dept.id" t-esc="dept.name"/></select></div><div class="field"><label for="students_capacity_filter">Capacity utilisation</label><select id="students_capacity_filter" t-model="state.filters.capacity"><option value="">All capacity levels</option><option value="under80">Below 80%</option><option value="80to89">80%–89%</option><option value="90plus">90% and above</option></select></div><div class="field"><label for="students_section_count_filter">Class sections</label><select id="students_section_count_filter" t-model="state.filters.section_size"><option value="">Any number of sections</option><option value="small">2–4 sections</option><option value="large">5+ sections</option></select></div><div class="filter-actions"><button class="btn" type="button" t-on-click="resetFilters">Reset</button><button class="btn primary" type="button" t-on-click="() => state.filterOpen = false">Apply</button></div><div class="filter-count">Showing <t t-esc="departments.length"/> of <t t-esc="state.data.departments.length"/> departments</div></div>
          <div class="deptgrid"><article class="dept" t-foreach="departments" t-as="dept" t-key="dept.id"><div class="dept-head"><div class="dept-icon"><i class="fa fa-graduation-cap" aria-hidden="true"/></div><span class="dept-code" t-esc="dept.code"/></div><h3 t-esc="dept.name"/><div class="dept-sub"><t t-esc="dept.sections"/> class sections · <t t-esc="state.data.year_label"/></div><div class="dept-counts"><strong t-esc="number(dept.count)"/><span>/ <t t-esc="dept.capacity ? number(dept.capacity) : '—'"/> seats</span><span class="percent" t-esc="percent(dept.fill)"/></div><div class="progress" role="img" t-att-aria-label="'Capacity filled: ' + percent(dept.fill)"><span t-att-style="bar(dept.fill)"/></div><div class="dept-metrics"><div class="metric"><b t-esc="number(dept.active)"/><small>Active</small></div><div class="metric"><b t-esc="number(dept.inactive)"/><small>Inactive / review</small></div><div class="metric"><b t-esc="number(dept.available)"/><small>Seats available</small></div></div><div class="dept-actions"><button class="textbtn" type="button" t-on-click="() => this.show('department',dept.id)">View students</button><button class="textbtn arrow" type="button" t-att-aria-label="'Open ' + dept.name" t-on-click="() => this.show('department',dept.id)">→</button></div></article><p t-if="!departments.length" class="panel empty">No departments match these filters.</p></div>
          <p class="data-note">Capacity uses configured admission intakes in this academic scope. A dash means no capacity has been configured. Student counts are distinct within each department.</p>
          <div class="lowergrid"><section class="panel"><h3>Class &amp; section overview</h3><p class="desc">Sections with the highest running enrolment and their current student strength.</p><div class="quickrows"><button class="quickrow" type="button" t-foreach="leadingSections" t-as="section" t-key="section.id" t-on-click="() => this.showSection(section)"><span class="quickico"><i class="fa fa-th-large" aria-hidden="true"/></span><span class="quick-copy"><b t-esc="section.name"/><small><t t-esc="section.semester"/> · <t t-esc="section.programme"/></small></span><span class="tag"><t t-esc="number(section.count)"/> students</span></button><p t-if="!leadingSections.length" class="empty">No class sections in this academic scope.</p></div></section><section class="panel"><h3>Student insights</h3><p class="desc">Operational prompts based on saved student and placement records.</p><div class="insight"><span class="spark">✧</span><div><b>Profile completion opportunity</b><p><t t-esc="number(c.attention)"/> student records have missing contact, registration or placement details. Review the saved profiles before academic verification.</p></div></div><div class="insight"><span class="spark">↗</span><div><b>Department planning</b><p>Use recorded section strength and configured intake capacity to plan class groups and faculty allocation.</p></div></div><button class="btn lightblue full-width" type="button" t-on-click="reviewProfiles">Explore student insights →</button></section></div>
          <div class="sectionhead"><div><h2>Recently updated student records</h2><p>Quick access to recently created or modified profiles.</p></div><button class="btn" type="button" t-on-click="() => this.show('all')">Open directory ↗</button></div><t t-call="ideastone_erp.StudentsDirectoryTable"/>
        </t>
        <t t-elif="state.screen === 'department'">
          <div class="sectionhead"><div><h2>Classes &amp; sections</h2><p>Choose a class section to see its complete student roster.</p></div><select class="select" aria-label="Year of study" t-model="state.filters.study_year" t-on-change="departmentChanged"><option value="0">All years of study</option><option t-foreach="studyYears" t-as="year" t-key="year" t-att-value="year">Year <t t-esc="year"/></option></select></div>
          <div class="sectiontiles"><article class="sectile" t-foreach="sections" t-as="section" t-key="section.id" t-att-class="+state.filters.batch_id === section.id ? 'selected' : ''"><div class="top"><span t-esc="section.study_year ? 'YEAR ' + section.study_year : 'YEAR NOT ASSIGNED'"/><span t-esc="department?.code"/></div><h3 t-esc="section.name"/><p><t t-esc="section.semester"/> · <t t-esc="section.programme"/></p><div class="bottom"><b><t t-esc="number(section.count)"/> students</b><button class="view" type="button" t-on-click="() => this.chooseSection(section)">View roster</button></div></article><p t-if="!sections.length" class="panel empty">No sections are configured in this academic scope.</p></div>
          <div class="sectionhead roster-heading"><div><h2>Student roster</h2><p>Students with a saved enrolment in this department and selected section.</p></div><button class="btn" type="button" t-on-click="() => this.exportRows()">Export roster <i class="fa fa-download" aria-hidden="true"/></button></div><t t-call="ideastone_erp.StudentsRosterToolbar"/><t t-call="ideastone_erp.StudentsDirectoryTable"/>
        </t>
        <t t-elif="state.screen === 'all'"><t t-call="ideastone_erp.StudentsRosterToolbar"/><t t-call="ideastone_erp.StudentsDirectoryTable"/></t>
        <t t-elif="state.screen === 'enrolments'">
          <div class="sectionhead"><div><h2>Enrolment &amp; transfer records</h2><p>Review recorded placements, effective dates and student movement history.</p></div><div class="actions"><button class="filter-toggle icon-only" type="button" aria-label="Filter enrolments and transfers" t-att-aria-expanded="state.filterOpen ? 'true' : 'false'" t-on-click="() => state.filterOpen = !state.filterOpen"><i class="fa fa-filter" aria-hidden="true"/></button><button class="btn" type="button" t-on-click="() => this.exportRows()">Export queue <i class="fa fa-download" aria-hidden="true"/></button></div></div>
          <div t-if="state.filterOpen" class="filter-panel"><div class="field"><label for="students_record_type">Record type</label><select id="students_record_type" t-model="state.filters.record_type"><option value="">All record types</option><option value="running">Running enrolment</option><option value="finished">Finished placement</option><option value="incomplete">Placement needs details</option></select></div><div class="field"><label for="students_enrol_status">Recorded status</label><select id="students_enrol_status" t-model="state.filters.status"><option value="">All statuses</option><option value="running">Running</option><option value="finished">Finished</option></select></div><div class="field"><label for="students_submitted">Created</label><select id="students_submitted" t-model="state.filters.submitted"><option value="">Any time</option><option value="recent">Last 7 days</option></select></div><div class="filter-actions"><button class="btn" type="button" t-on-click="resetFilters">Reset</button><button class="btn primary" type="button" t-on-click="applyEnrolmentFilters">Apply</button></div><div class="filter-count"><t t-esc="number(state.data.total_rows)"/> saved enrolment records match the current filters</div></div>
          <form class="toolbar" t-on-submit.prevent="filter"><label class="search"><i class="fa fa-search" aria-hidden="true"/><input type="search" aria-label="Search enrolments" placeholder="Search student, course, record ID…" maxlength="200" t-model="state.query"/></label><button class="btn" type="submit">Search</button></form>
          <div class="tablewrap" tabindex="0" aria-label="Enrolment records"><table><thead><tr><th>RECORD ID</th><th>STUDENT</th><th>RECORD TYPE</th><th>PROGRAMME / SECTION</th><th>CREATED</th><th>STATUS</th><th>ACTION</th></tr></thead><tbody><tr t-foreach="state.data.rows" t-as="row" t-key="row.id"><td><b t-esc="row.reference"/></td><td><b t-esc="row.name"/><small class="cell-detail" t-esc="row.register"/></td><td t-esc="row.type"/><td><t t-esc="row.programme"/><small class="cell-detail"><t t-esc="row.section"/> · <t t-esc="row.year"/></small></td><td t-esc="row.submitted"/><td><span t-att-class="'status ' + row.tone" t-esc="row.status"/></td><td><button class="view" type="button" t-on-click="() => this.open('enrolment',row.id)">Review</button></td></tr><tr t-if="!state.data.rows.length"><td colspan="7" class="empty">No enrolment records match these filters.</td></tr></tbody></table></div>
          <p class="data-note">These are saved enrolment records. A separate transfer-request approval queue is not configured. Use the existing record form to manage placements and preserve their effective dates and reasons.</p>
          <div class="lowergrid"><section class="panel"><h3>Transfer workflow</h3><p class="desc">Use the existing enrolment controls to retain student history.</p><div class="quickrows"><div class="quickrow"><span class="quickico">01</span><div class="quick-copy"><b>Review the current placement</b><small>Confirm the student's programme, section and academic period.</small></div><span class="tag">Review</span></div><div class="quickrow"><span class="quickico">02</span><div class="quick-copy"><b>Check the receiving section</b><small>Review its roster and configured intake capacity.</small></div><span class="tag warn">Check</span></div><div class="quickrow"><span class="quickico">03</span><div class="quick-copy"><b>Record effective dates and a reason</b><small>Finish the previous placement with the required reason.</small></div><span class="tag">History</span></div><div class="quickrow"><span class="quickico">04</span><div class="quick-copy"><b>Create the new placement</b><small>Retain previous academic records and their audit history.</small></div><span class="tag">Record</span></div></div></section><section class="panel"><h3>Smart checks</h3><p class="desc">Recorded details to review before changing a placement.</p><div class="insight"><span class="spark">✧</span><div><b>Check receiving section strength</b><p>Review the actual roster and admission capacity. Section-specific capacity limits are not configured.</p></div></div><div class="insight"><span class="spark">✓</span><div><b>Preserve the student history</b><p>Existing controls protect placements referenced by attendance, results or fee records. Retain them and create a new placement.</p></div></div></section></div>
        </t>
        <div t-if="state.screen !== 'directory'" class="pagination"><span><t t-esc="state.data.total_rows ? state.page * 30 + 1 : 0"/>–<t t-esc="Math.min((state.page + 1) * 30,state.data.total_rows)"/> of <t t-esc="number(state.data.total_rows)"/> records</span><div><button class="btn" type="button" t-att-disabled="!state.page" t-on-click="() => this.paginate(-1)">Previous</button><button class="btn" type="button" t-att-disabled="!state.data.has_next" t-on-click="() => this.paginate(1)">Next</button></div></div>
        <footer class="foot">VCET Campus ERP · Owner / Admin workspace · Powered by Ideastone</footer>
      </t>
    </main>
  </t>
  <t t-name="ideastone_erp.StudentsRosterToolbar"><form class="toolbar" t-on-submit.prevent="filter"><label class="search"><i class="fa fa-search" aria-hidden="true"/><input type="search" aria-label="Search students" maxlength="200" placeholder="Search name, register number, programme…" t-model="state.query"/></label><select t-if="state.screen === 'all'" class="select" aria-label="Filter department" t-model="state.filters.department_id" t-on-change="departmentChanged"><option value="0">All departments</option><option t-foreach="state.data.departments" t-as="dept" t-key="dept.id" t-att-value="dept.id" t-esc="dept.name"/></select><select t-else="" class="select" aria-label="Filter section" t-model="state.filters.batch_id" t-on-change="filter"><option value="0">All sections</option><option t-foreach="sections" t-as="section" t-key="section.id" t-att-value="section.id" t-esc="section.name"/></select><select class="select" aria-label="Filter student status" t-model="state.filters.status" t-on-change="filter"><option value="">All statuses</option><option t-foreach="state.data.statuses" t-as="status" t-key="status.key" t-att-value="status.key" t-esc="status.name"/></select><button class="btn" type="submit">Search</button><button t-if="state.filters.attention" class="btn lightblue" type="button" t-on-click="resetFilters">Clear review filter</button></form></t>
  <t t-name="ideastone_erp.StudentsDirectoryTable"><div class="tablewrap" tabindex="0" aria-label="Student records"><table><thead><tr><th>STUDENT</th><th t-if="state.screen !== 'directory'">REGISTER NO.</th><th t-if="state.screen !== 'department'">DEPARTMENT / PROGRAMME</th><th t-if="state.screen !== 'directory'">PROGRAMME / YEAR</th><th>CLASS / SECTION</th><th t-if="state.screen === 'directory'">LAST UPDATED</th><th t-if="state.screen === 'department'">EMAIL</th><th>STATUS</th><th>ACTION</th></tr></thead><tbody><tr t-foreach="state.screen === 'directory' ? state.data.recent : state.data.rows" t-as="row" t-key="row.id"><td><div class="studentname"><span class="studentavatar" t-esc="initials(row.name)"/><div><b t-esc="row.name"/><small t-esc="state.screen === 'directory' ? row.register : row.email"/></div></div></td><td t-if="state.screen !== 'directory'" t-esc="row.register"/><td t-if="state.screen !== 'department'"><t t-esc="row.department"/><small class="cell-detail" t-esc="row.programme"/></td><td t-if="state.screen !== 'directory'"><t t-esc="row.programme"/><small class="cell-detail"><t t-esc="row.year"/> · <t t-esc="row.semester"/></small></td><td t-esc="row.section"/><td t-if="state.screen === 'directory'" t-esc="row.updated"/><td t-if="state.screen === 'department'" t-esc="row.email"/><td><span t-att-class="'status ' + row.tone" t-esc="row.status"/></td><td><button class="view" type="button" t-on-click="() => this.open('student',row.id)">View profile</button></td></tr><tr t-if="!(state.screen === 'directory' ? state.data.recent.length : state.data.rows.length)"><td colspan="8" class="empty">No students match this academic scope or search. Add students through the existing admission and enrolment workflows.</td></tr></tbody></table></div></t>
</templates>
