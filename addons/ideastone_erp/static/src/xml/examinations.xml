<templates xml:space="preserve">
  <t t-name="ideastone_erp.ExaminationsWorkspace">
    <main class="campus_exams_workspace" t-ref="content"><div class="content">
      <p t-if="state.loading" class="loading-note" role="status">Loading examination records…</p>
      <div t-if="state.error" class="notice error" role="alert"><span t-esc="state.error"/> <button class="btn" t-on-click="load">Retry</button></div>
      <t t-if="state.data &amp;&amp; !state.error">
        <div class="crumb"><span>VCET Campus / <strong t-esc="page[1]"/></span><div class="scope"><label>Academic year <select aria-label="Academic year" t-model="state.filters.year_id" t-on-change="filter"><option value="0">All academic years</option><option t-foreach="state.data.years" t-as="year" t-key="year.id" t-att-value="year.id" t-esc="year.name"/></select></label><span t-esc="state.data.today"/></div></div>
        <div class="pagehead"><div><h1 t-esc="page[1]"/><p t-esc="page[2]"/></div><div class="actions"><button class="btn" t-on-click="load" t-att-disabled="state.loading"><i class="fa fa-refresh" aria-hidden="true"/> Refresh</button><button class="btn primary" t-on-click="primary" t-att-disabled="state.loading || (view !== 'results' &amp;&amp; !state.data.can_create)"><span t-if="view !== 'results'" aria-hidden="true">＋ </span><t t-esc="page[3]"/></button></div></div>
        <div class="grid kpis"><article t-foreach="stats" t-as="stat" t-key="stat.label" class="card kpi"><div class="kicon" t-att-class="stat.tone"><span aria-hidden="true" t-esc="stat.icon"/></div><div><div class="klabel" t-esc="stat.label"/><div class="kvalue" t-att-class="{'word-value': stat.value === 'Per exam'}" t-esc="stat.value"/><div class="kmeta" t-esc="stat.detail"/></div></article></div>

        <t t-if="view === 'overview'">
          <div class="grid split"><section class="card section"><div class="sectionhead"><div><h2>Upcoming examinations</h2><p>Configured exam sessions in the next 30 days.</p></div><button class="linkbtn" t-on-click="() => this.show('sessions')">View all →</button></div><div class="exam-list"><article t-foreach="state.data.upcoming" t-as="exam" t-key="exam.id" class="exam-row"><div class="datebox"><span t-esc="exam.month"/><t t-esc="exam.day"/></div><div><button class="exam-title title-button" t-on-click="() => this.open('sessions',exam.id)" t-esc="exam.name"/><div class="subline"><t t-esc="exam.audience"/> · <t t-esc="exam.type"/> · <t t-esc="exam.section"/></div></div><span class="badge blue" t-esc="exam.days ? 'In ' + exam.days + ' days' : 'Today'"/></article><div t-if="!state.data.upcoming.length" class="empty"><strong>No upcoming examinations</strong>Scheduled sessions in the next 30 days will appear here.</div></div></section>
          <section class="card section"><div class="sectionhead"><div><h2>Result snapshot</h2><p t-esc="state.data.snapshot"/></div><button class="linkbtn" t-on-click="() => this.show('results')">View results →</button></div><div class="performance"><div><div class="perf-head"><strong>Passed</strong><span t-esc="percent(c.pass_rate)"/></div><div class="track"><div class="fill" t-att-style="'width:' + (c.pass_rate || 0) + '%'"/></div></div><div><div class="perf-head"><strong>Failed</strong><span t-esc="percent(c.failure_rate)"/></div><div class="track"><div class="fill light" t-att-style="'width:' + (c.failure_rate || 0) + '%'"/></div></div><div><div class="perf-head"><strong>Absent</strong><span>Not tracked</span></div><div class="track"><div class="fill green" style="width:0%"/></div></div><div><div class="perf-head"><strong>Withheld</strong><span>Not tracked</span></div><div class="track"><div class="fill amber" style="width:0%"/></div></div></div><div class="grid snapshot-stats"><div class="mini-stat"><span>Pass rate</span><strong t-esc="percent(c.pass_rate)"/></div><div class="mini-stat"><span>Failure rate</span><strong t-esc="percent(c.failure_rate)"/></div><div class="mini-stat"><span>Absent / withheld</span><strong>—</strong></div></div><div class="notice">Rates use entered marks from the latest published session in each department. Absent and withheld outcomes are not classified by the current marks roster.</div></section></div>
          <div class="grid lower"><section class="card section"><div class="sectionhead"><div><h2>Department-wise performance</h2><p t-esc="state.data.snapshot"/></div><button class="linkbtn" t-on-click="() => this.show('results')">Detailed results →</button></div><div class="table-scroll"><table class="depttable"><thead><tr><th>Department</th><th>Evaluated</th><th>Pass</th><th>Failure</th><th>Pass rate</th></tr></thead><tbody><tr t-foreach="performance" t-as="dept" t-key="dept.id"><td t-esc="dept.name"/><td t-esc="dept.appeared"/><td t-esc="dept.passed"/><td t-esc="dept.failed"/><td class="pct" t-esc="percent(dept.rate)"/></tr><tr t-if="!performance.length"><td colspan="5" class="empty">No published results in this scope.</td></tr></tbody></table></div></section>
          <section class="card section"><div class="sectionhead"><div><h2>Recent examination activity</h2><p>Latest updates to saved records.</p></div><button class="linkbtn" t-on-click="() => this.show('papers')">Question papers →</button></div><div class="activity"><article t-foreach="state.data.activity" t-as="item" t-key="item.id" class="activity-item"><div class="activity-mark" t-att-class="item.tone" aria-hidden="true" t-esc="item.icon"/><div><button class="title-button activity-title" t-on-click="() => this.open(item.kind,item.record_id)" t-esc="item.name"/><p t-esc="item.detail"/></div></article><div t-if="!state.data.activity.length" class="empty">No examination activity yet.</div></div></section></div>
          <section class="workspaces-section"><div class="sectionhead"><div><h2>Examination workspaces</h2><p>Open a focused workspace for each task.</p></div></div><div class="grid feature-grid"><button t-foreach="features" t-as="feature" t-key="feature[0]" class="card feature" t-on-click="() => this.show(feature[0])"><div class="kicon" t-att-class="feature[5]" aria-hidden="true" t-esc="feature[1]"/><h3 t-esc="feature[2]"/><p t-esc="feature[3]"/><div class="feature-foot"><span t-esc="feature[4]"/><span aria-hidden="true">→</span></div></button></div></section>
        </t>

        <t t-if="view === 'results'">
          <div class="grid lower results-panels"><section class="card section"><div class="sectionhead"><div><h2>Department-wise pass percentage</h2><p>Latest published session in each department.</p></div></div><div t-if="performance.length" class="chart"><div t-foreach="performance" t-as="dept" t-key="dept.id" class="bar-group"><div class="bars"><div class="bar" t-att-style="'height:' + (dept.rate || 0) + '%'" t-att-title="dept.name + ': ' + percent(dept.rate)"/><div class="bar target" style="height:85%" title="Reference benchmark: 85%"/></div><div class="barlabel" t-esc="dept.code"/></div></div><div t-else="" class="empty">No published result data to chart.</div><div class="chartlegend"><span>Pass rate</span><span>Reference benchmark (85%)</span></div><div class="notice">A low pass rate is a review signal. Consider subject difficulty, assessment design and prior cohorts before drawing conclusions.</div></section><section class="card section"><div class="sectionhead"><div><h2>Missing entries to resolve</h2><p>Follow up before results are finalized.</p></div></div><div class="activity"><article t-foreach="state.data.missing_exams" t-as="exam" t-key="exam.id" class="activity-item"><div class="activity-mark amber">!</div><div><strong><t t-esc="exam.name"/> · <t t-esc="exam.section"/></strong><p><t t-esc="exam.missing"/> marks not entered · <t t-esc="exam.session"/></p><button class="linkbtn" t-on-click="() => this.open('marks',exam.id)">Review entries →</button></div></article><div t-if="!state.data.missing_exams.length" class="empty"><strong>No missing entries</strong>Saved examination rosters are complete or have not been loaded.</div></div></section></div>
        </t>

        <section t-if="['sessions','marks','grades','results'].includes(view)" class="card section records-section">
          <div class="sectionhead"><div><h2 t-esc="tableTitle"/><p t-esc="tableDescription"/></div></div>
          <div class="filters"><input type="search" class="field search" aria-label="Search examination records" placeholder="Search examination records…" maxlength="200" t-model="state.query" t-on-input="search"/><select t-if="view === 'sessions'" aria-label="Exam type" t-model="state.filters.type_id" t-on-change="filter"><option value="0">All exam types</option><option t-foreach="state.data.types" t-as="type" t-key="type.id" t-att-value="type.id" t-esc="type.name"/></select><select t-if="view === 'results'" aria-label="Exam session" t-model="state.filters.session_id" t-on-change="filter"><option value="0">All exam sessions</option><option t-foreach="state.data.sessions" t-as="session" t-key="session.id" t-att-value="session.id" t-esc="session.name"/></select><select t-if="view === 'sessions' || view === 'marks'" aria-label="Examination status" t-model="state.filters.status" t-on-change="filter"><option value="">All statuses</option><option t-foreach="statuses" t-as="status" t-key="status[0]" t-att-value="status[0]" t-esc="status[1]"/></select></div>
          <div class="tablewrap"><table class="table"><thead><tr><th t-foreach="columns" t-as="column" t-key="column" t-esc="column"/></tr></thead><tbody><tr t-foreach="tableRows" t-as="row" t-key="row.id"><td t-foreach="row.cells" t-as="cell" t-key="cell_index"><span t-if="cell.tone" class="badge" t-att-class="cell.tone" t-esc="cell.text"/><button t-elif="cell_index === 0 &amp;&amp; view === &apos;results&apos;" class="title-button result-title" t-on-click="() => this.openRow(row)" t-esc="cell.text"/><strong t-elif="cell_index === 0" t-esc="cell.text"/><t t-else="" t-esc="cell.text"/><span t-if="cell.sub" class="muted" t-esc="cell.sub"/></td><td t-if="view !== &apos;results&apos;"><button class="smallbtn blue" t-on-click="() => this.openRow(row)" t-esc="view === 'grades' ? 'Edit' : view === 'marks' ? 'Open marks' : view === 'results' ? 'Review' : 'View'"/></td></tr><tr t-if="!tableRows.length"><td t-att-colspan="columns.length" class="empty"><strong>No matching records</strong>Create a record or adjust your search and filters.</td></tr></tbody></table></div>
          <div class="pagination-row"><span><t t-esc="state.data.total_rows ? state.page * 30 + 1 : 0"/>–<t t-esc="state.page * 30 + state.data.rows.length"/> of <t t-esc="state.data.total_rows"/> records</span><div class="actions"><button class="smallbtn" t-att-disabled="!state.page || state.loading" t-on-click="() => this.paginate(-1)">Previous</button><button class="smallbtn" t-att-disabled="(state.page + 1) * 30 &gt;= state.data.total_rows || state.loading" t-on-click="() => this.paginate(1)">Next</button></div></div>
          <div t-if="view === 'sessions'" class="notice">Session records retain the configured exam type, academic year, programme, section and examination window.</div><div t-if="view === 'marks'" class="notice">Use the existing examination form to load the roster, enter marks, submit, approve and publish. Missing marks and confirmed zero marks remain distinct. Room allocation is not stored on the current exam model.</div><div t-if="view === 'grades'" class="notice">Published examinations retain their assigned scale. The existing workflow validates a complete, non-overlapping scale before publication and protects bands used by locked results.</div><div t-if="view === 'results'" class="notice">Totals count subject result entries. Missing marks are not classified as failures. Absent and withheld outcomes are not stored separately in this roster.</div>
        </section>

        <t t-if="view === 'papers'">
          <section class="card section"><div class="sectionhead"><div><h2>Browse by department</h2><p>Select a department to open its upcoming and previous question sets.</p></div><span class="badge blue"><t t-esc="state.data.departments.length"/> departments</span></div><div class="grid paper-grid"><button class="card dept-card" t-foreach="departments" t-as="dept" t-key="dept.id" t-on-click="() => this.chooseDepartment(dept)"><div class="dept-top"><span class="kicon" t-att-class="departmentTheme(dept).tone" aria-hidden="true" t-esc="departmentTheme(dept).icon"/><span class="dept-code" t-esc="dept.code"/></div><h3 t-esc="dept.name"/><p><t t-esc="dept.papers"/> question sets · <t t-esc="dept.completed"/> completed · <t t-esc="dept.pending"/> remaining</p><div class="paper-status"><span>Latest update: <t t-esc="dept.updated"/></span><span class="badge" t-att-class="dept.pending ? 'amber' : dept.papers ? 'green' : 'blue'" t-esc="dept.pending ? dept.pending + ' in progress' : dept.papers ? 'Completed' : 'No papers'"/></div></button></div><div class="notice"><strong>Approval workflow:</strong> HOD approval, approved-version locking and version history are not configured in the current document model. Personal faculty document access remains in force; a saved or completed document is not evidence of HOD approval.</div><div t-if="!state.data.papers_allowed" class="notice">Your account does not have access to faculty question-paper files. Contact the college administrator for the appropriate existing document role.</div></section>
          <section t-if="state.department !== null" class="card section department-papers"><div class="sectionhead"><div><h2 t-esc="state.data.departments.find(d => d.id === state.department)?.name || 'Department question papers'"/><p>Upcoming and previous question sets with file details and update timestamps.</p></div><button class="btn" t-on-click="allDepartments">← All departments</button></div><div class="subnav"><button t-foreach="[['all','All papers'],['upcoming','Upcoming exams'],['previous','Previous papers']]" t-as="tab" t-key="tab[0]" t-att-class="{active: state.paperFilter === tab[0]}" t-on-click="() => this.paperPeriod(tab[0])" t-esc="tab[1]"/></div><div class="filters"><input type="search" class="field search" aria-label="Search question papers" placeholder="Search subject, exam or paper ID…" maxlength="200" t-model="state.query" t-on-input="search"/><select aria-label="Question paper exam type" t-model="state.filters.type_id" t-on-change="filter"><option value="0">All exam types</option><option t-foreach="state.data.types" t-as="type" t-key="type.id" t-att-value="type.id" t-esc="type.name"/></select></div><div class="paper-list"><article class="paper-item" t-foreach="paperRows" t-as="paper" t-key="paper.id"><div class="pdficon" aria-hidden="true">PDF</div><div class="paper-info"><strong><t t-esc="paper.name"/> <span class="badge" t-att-class="paper.tone" t-esc="paper.status"/></strong><p><t t-esc="paper.subject"/> · <t t-esc="paper.exam"/> · Paper ID: <t t-esc="paper.code"/><br/>Uploaded by: <t t-esc="paper.owner"/> · Last updated: <b t-esc="paper.updated"/><br/>File: <t t-esc="paper.filename"/></p></div><div class="paper-actions"><button class="smallbtn blue" t-on-click="() => this.open('papers',paper.id)">Open file &amp; details</button><button class="smallbtn" disabled="disabled" title="The current document model does not store historical file versions">Version history</button></div></article><div t-if="!paperRows.length" class="empty"><strong>No question papers match this selection.</strong>Upload a permitted question paper or adjust the filters.</div></div><div class="pagination-row"><span><t t-esc="state.data.total_rows"/> saved files in this selection</span><div class="actions"><button class="smallbtn" t-att-disabled="!state.page || state.loading" t-on-click="() => this.paginate(-1)">Previous</button><button class="smallbtn" t-att-disabled="(state.page + 1) * 30 &gt;= state.data.total_rows || state.loading" t-on-click="() => this.paginate(1)">Next</button></div></div></section>
        </t>
      </t>
    </div></main>
  </t>
</templates>
