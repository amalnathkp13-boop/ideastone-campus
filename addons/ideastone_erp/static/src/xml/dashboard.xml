<templates xml:space="preserve">
  <t t-name="ideastone_erp.Navigation">
    <div class="campus_navigation">
      <button t-ref="navToggle" class="campus_mobile_toggle" t-on-click="() => state.open = !state.open" t-att-aria-expanded="state.open ? 'true' : 'false'" aria-controls="campus_sidebar" aria-label="Toggle campus navigation"><i class="fa fa-bars"/></button>
      <button t-if="state.open" class="campus_nav_backdrop" t-on-click="closeNav" aria-label="Close campus navigation"/>
      <aside id="campus_sidebar" class="campus_sidebar" t-att-class="{ 'is-open': state.open, 'is-leave': state.leavePage }" aria-label="Campus navigation">
        <t t-if="state.leavePage">
          <button class="campus_brand" t-on-click="home" aria-label="Campus overview"><span class="campus_brand_crop"><img src="/ideastone_campus/static/src/img/vcet-logo.png" alt="VCET"/></span><span>Campus ERP</span></button>
          <label for="campus_nav_search" class="visually-hidden">Find a module</label><input id="campus_nav_search" class="campus_nav_search" type="search" placeholder="Find a module…" t-model="state.filter"/>
          <nav aria-label="Campus modules">
            <button class="campus_nav_link campus_home_link" t-on-click="home"><i class="fa fa-home"/> Campus overview</button>
            <p t-if="state.loading" role="status" class="px-3">Loading navigation…</p>
            <div t-if="state.error" class="px-3" role="alert"><p t-esc="state.error"/><button class="btn btn-sm btn-light" t-on-click="load">Retry</button></div>
            <t t-foreach="groups" t-as="group" t-key="group.label"><div class="campus_nav_heading" t-esc="group.label"/><t t-foreach="group.items" t-as="item" t-key="item.action"><button class="campus_nav_link" t-att-class="{active: item.action === 'ideastone_erp.action_faculty_leave_page'}" t-att-aria-current="item.action === 'ideastone_erp.action_faculty_leave_page' ? 'page' : undefined" t-on-click="() => this.open(item)" t-esc="item.label"/></t></t>
          </nav>
          <a class="campus_self_service" href="/my/campus">My campus self-service <i class="fa fa-external-link"/></a>
        </t>
        <t t-else="">
        <button class="campus_brand" t-on-click="home" aria-label="Campus overview"><img src="/ideastone_campus/static/src/img/vcet-wordmark.png" alt="VCET"/><span>Campus Management ERP</span></button>
        <div class="campus_nav_heading" t-esc="state.is_owner_workspace ? 'COLLEGE WORKSPACE' : state.faculty_modules.length ? 'FACULTY WORKSPACE' : 'WORKSPACES'"/>
        <nav t-if="state.faculty_modules.length" aria-label="Faculty main modules"><t t-foreach="state.faculty_modules" t-as="module" t-key="module.key"><button class="campus_nav_link" t-att-class="{active: state.module === module.key}" t-att-aria-current="state.module === module.key ? 'page' : undefined" t-on-click="() => this.chooseModule(module)"><i t-att-class="'fa fa-' + module.icon" aria-hidden="true"/><span t-esc="module.label"/></button></t></nav>
        <nav t-else=""><t t-foreach="state.pages" t-as="item" t-key="item.key"><button class="campus_nav_link" t-att-class="{active: state.page === item.key}" t-on-click="() => this.go(item)"><i t-att-class="'fa fa-' + item.icon" aria-hidden="true"/><span t-esc="item.label"/></button></t></nav>
        <div t-if="state.error" role="alert"><p t-esc="state.error"/><button class="btn btn-light" t-on-click="load">Retry</button></div>
        <div class="campus_side_bottom"><strong t-esc="state.company"/><span t-esc="state.workspace_role"/><a href="/my/campus">My campus self-service <i class="fa fa-external-link"/></a></div>
        </t>
      </aside>
      <nav t-if="facultyModule" class="campus_faculty_subnav" aria-label="Faculty submodules">
        <strong t-esc="facultyModule.label"/>
        <button class="campus_subnav_scroll" t-on-click="() => this.scrollSubmodules(-1)" aria-label="Previous submodules"><i class="fa fa-angle-left"/></button>
        <div t-ref="subnavStrip"><t t-foreach="facultyModule.items" t-as="item" t-key="item.label"><button t-att-class="{active: item.tool ? state.activeTool === item.tool : item.action_id ? state.activeAction === item.action_id : state.page === item.page}" t-on-click="() => this.facultyGo(item)" t-esc="item.label"/></t></div>
        <button class="campus_subnav_scroll" t-on-click="() => this.scrollSubmodules(1)" aria-label="Next submodules"><i class="fa fa-angle-right"/></button>
      </nav>
    </div>
  </t>
  <t t-name="ideastone_erp.Dashboard">
    <main class="campus_dashboard" id="campus_main">
      <div class="campus_crumb"><span>VCET Campus / <t t-esc="pageTitle"/></span><span><t t-esc="state.today"/> · <strong t-esc="state.workspace_role"/></span></div>
      <header class="campus_page_heading"><div><h1 t-esc="pageTitle"/><p t-esc="state.company"/></div><button class="btn btn-outline-primary" t-on-click="load" t-att-disabled="state.loading"><i class="fa fa-refresh me-2"/>Refresh</button></header>
      <div t-if="state.error" class="alert alert-danger" role="alert"><span t-esc="state.error"/><button class="btn btn-outline-danger ms-2" t-on-click="load">Retry</button></div>
      <p t-if="state.loading" role="status"><i class="fa fa-spinner fa-spin me-2"/>Loading your campus…</p>
      <t t-elif="!state.error">
        <t t-if="state.page === 'owner-overview' &amp;&amp; state.is_owner_workspace"><t t-call="ideastone_erp.OwnerOverview"/></t>
        <t t-elif="state.page === 'overview'">
          <section t-if="state.faculty_modules.length" class="campus_faculty_welcome"><div><span>YOUR CAMPUS, CONNECTED</span><h2>Welcome back, <t t-esc="state.user"/></h2><p>Plan your day, manage your classes and keep every responsibility in view.</p><button class="btn btn-light" t-on-click="() => this.open({action:'ideastone_erp.action_faculty_task'})"><i class="fa fa-check-square-o me-2"/>Open my tasks</button></div><i class="fa fa-graduation-cap" aria-hidden="true"/></section>
          <section class="campus_stats" aria-label="Current campus summary"><t t-foreach="state.stats" t-as="stat" t-key="stat.label"><article class="campus_stat"><div><span t-esc="stat.label"/><strong t-esc="stat.value"/><small t-esc="stat.detail"/></div><i class="fa fa-bar-chart" aria-hidden="true"/></article></t></section>
          <div class="campus_overview_grid"><section class="campus_panel"><h2>Actions requiring attention</h2><p class="campus_muted">Authorized queues from current records.</p><t t-foreach="state.queues" t-as="queue" t-key="queue.label"><button class="campus_queue" t-on-click="() => this.open(queue)"><span><strong t-esc="queue.label"/><small t-esc="queue.detail"/></span><b t-esc="queue.count"/></button></t><p t-if="!state.queues.length" class="campus_empty">Use your assigned modules below to manage classes and student work.</p><div class="campus_info">Access follows your authenticated account, college, and approved responsibilities. Refresh after an appointment is approved or revoked.</div></section>
          <section class="campus_panel"><h2 t-esc="state.is_admin ? 'Institution management' : 'Your next actions'"/><p class="campus_muted">Frequent workspaces, with the complete directory one click away.</p><div class="campus_quick"><button class="campus_module" t-on-click="() => this.go({key:'modules'})"><i class="fa fa-th-large"/><strong>Browse modules</strong><small>Search your available workspaces</small></button><button class="campus_module" t-on-click="() => this.go({key:'reports'})"><i class="fa fa-bar-chart"/><strong>Reports &amp; exports</strong><small>Filtered, traceable outputs</small></button><t t-foreach="state.quick" t-as="item" t-key="item.action"><button class="campus_module" t-on-click="() => this.open(item)"><i class="fa fa-external-link"/><strong t-esc="item.label"/><small t-esc="item.group"/></button></t></div></section></div>
          <section class="campus_panel mt-4"><h2>Faculty responsibilities</h2><p class="campus_muted">Effective dates and approval status are checked by the server.</p><div class="table-responsive"><table class="table"><thead><tr><th>Faculty</th><th>Additional role</th><th>Collections</th><th>Until</th><th>State</th></tr></thead><tbody><t t-foreach="state.appointments" t-as="r" t-key="r.id"><tr><td t-esc="r.faculty"/><td t-esc="r.role"/><td t-esc="r.scope"/><td t-esc="r.until"/><td><span class="campus_badge" t-esc="r.effective ? 'Active' : r.state === 'approved' ? 'Outside effective dates' : r.state"/></td></tr></t><tr t-if="!state.appointments.length"><td colspan="5">No appointments in your permitted scope.</td></tr></tbody></table></div></section>
        </t>
        <t t-elif="state.page === 'analytics' &amp;&amp; state.faculty_modules.length">
          <section class="campus_stats"><t t-foreach="state.stats" t-as="stat" t-key="stat.label"><article class="campus_stat"><div><span t-esc="stat.label"/><strong t-esc="stat.value"/><small t-esc="stat.detail"/></div><i class="fa fa-bar-chart"/></article></t></section>
          <div class="campus_overview_grid"><section class="campus_panel"><h2>Upcoming classes · next 7 days</h2><div t-foreach="state.faculty_schedule" t-as="session" t-key="session.id" class="campus_queue"><span><strong t-esc="session.subject"/><small t-esc="session.batch"/></span><span t-esc="session.when"/></div><p t-if="!state.faculty_schedule.length" class="campus_empty">No confirmed upcoming classes in your timetable.</p></section><section class="campus_panel"><h2>My open tasks</h2><button t-foreach="state.faculty_tasks" t-as="task" t-key="task.id" class="campus_queue" t-on-click="() => this.open({action:'ideastone_erp.action_faculty_task'})"><span><strong t-esc="task.name"/><small t-esc="task.state"/></span><span t-esc="task.due"/></button><p t-if="!state.faculty_tasks.length" class="campus_empty">No open tasks.</p></section></div>
        </t>
        <t t-elif="state.page === 'faculty-module' &amp;&amp; facultyModule">
          <section class="campus_faculty_module_intro"><i t-att-class="'fa fa-' + facultyModule.icon"/><div><h2 t-esc="facultyModule.label"/><p>Select a submodule above or open a workspace below.</p></div><span class="campus_badge"><t t-esc="facultyModule.items.length"/> workspaces</span></section>
          <div class="campus_modules"><t t-foreach="facultyModule.items" t-as="item" t-key="item.label"><button class="campus_module campus_faculty_tile" t-on-click="() => this.facultyGo(item)"><i t-att-class="'fa fa-' + facultyModule.icon"/><strong t-esc="item.label"/><small>Open workspace <i class="fa fa-arrow-right"/></small></button></t></div>
        </t>
        <t t-elif="state.page === 'surveys' &amp;&amp; state.faculty_modules.length">
          <p class="campus_muted">Surveys addressed to your account. Responses are saved by the survey form.</p>
          <div class="campus_modules"><section t-foreach="state.faculty_surveys" t-as="survey" t-key="survey.id" class="campus_panel"><h2 t-esc="survey.name"/><p><span class="campus_badge" t-esc="survey.state === 'done' ? 'Completed' : survey.state === 'in_progress' ? 'In progress' : 'Not started'"/></p><p t-if="survey.deadline">Deadline: <t t-esc="survey.deadline"/></p><p t-if="survey.expired &amp;&amp; survey.state !== 'done'" class="campus_muted">The response deadline has passed.</p><a t-else="" class="btn btn-primary" t-att-href="survey.url" target="_blank" rel="noopener noreferrer" t-esc="survey.state === 'done' ? 'View my responses' : 'Open survey'"/></section></div>
          <p t-if="!state.faculty_surveys.length" class="campus_empty">No survey invitations. Your college can invite your staff account when a survey is ready.</p>
        </t>
        <t t-elif="state.page === 'help' &amp;&amp; state.faculty_modules.length">
          <div class="campus_modules"><section class="campus_panel"><h2>Teaching &amp; attendance</h2><p>Open My task list to find class attendance, timetable, assignments and lesson plans. Attendance must match your assigned timetable session.</p></section><section class="campus_panel"><h2>Profile &amp; personal tasks</h2><p>Update your own staff profile and qualifications. Use My tasks &amp; e-diary to plan work, record notes, attach documents and track due dates in the calendar.</p></section><section class="campus_panel"><h2>Requests &amp; support</h2><p>Use Campus services to submit a service request or grievance. Save the draft before submitting it for the existing approval workflow. Contact your college administrator for additional responsibilities.</p></section><section class="campus_panel"><h2>Library access</h2><p>Browse the catalogue where permitted. The circulation desk appears only during an effective, approved Library In-charge appointment.</p></section><section class="campus_panel"><h2>Reports</h2><p>Choose the report period and programme before exporting attendance. Reports use completed attendance and remain internal drafts.</p></section><section class="campus_panel"><h2>Account &amp; privacy</h2><p>Use your account menu above to manage your session and log out. Main modules are on the left and their submodules appear across the top.</p></section></div>
        </t>
        <t t-elif="state.page === 'modules'">
          <div class="campus_module_heading"><p>Installed screens are listed below. Each action also requires backend access rights.</p><label class="campus_module_search">Search modules<input type="search" class="form-control" placeholder="Search modules…" t-model="state.filter"/></label></div>
          <p t-if="!groups.length" role="status">No modules match your search.</p>
          <t t-foreach="groups" t-as="group" t-key="group.label"><section class="campus_module_group"><h2 t-esc="group.label"/><div class="campus_modules"><t t-foreach="group.items" t-as="item" t-key="item.action"><button class="campus_module campus_module_row" t-on-click="() => this.open(item)" t-att-disabled="!item.allowed"><i class="fa fa-folder-open-o"/><span><strong t-esc="item.label"/><small t-esc="item.allowed ? 'Installed · Available to your account' : 'Installed · Permission required'"/></span><i class="fa fa-angle-right ms-auto"/></button></t></div></section></t>
        </t>
        <t t-elif="state.page === 'reports'">
          <p class="campus_muted">Reports use current permissions. An export never publishes results or changes source records.</p><div class="campus_modules"><article class="campus_panel"><i class="fa fa-calendar-check-o campus_report_icon"/><h2>Attendance shortage</h2><p>Completed class attendance with period, programme, batch, threshold, totals, and an immutable export log.</p><span class="campus_badge">PDF / CSV · Internal draft</span><button t-if="state.report_allowed" class="btn btn-primary mt-3" t-on-click="() => this.open({action:'ideastone_erp.action_attendance_export'})">Choose report filters</button><p t-else="" class="campus_muted mt-3">Attendance read access is required. Contact the college administrator.</p></article><article t-if="state.payroll_allowed" class="campus_panel"><i class="fa fa-file-text-o campus_report_icon"/><h2>Payroll statements</h2><p>Open an authorized payslip, then use Print to generate its salary statement.</p><button class="btn btn-outline-primary" t-on-click="() => this.open({action:'ideastone_erp.action_payslip'})">Open payroll records</button></article></div>
        </t>
        <t t-elif="state.page === 'library' &amp;&amp; state.library_allowed">
          <div class="campus_info mb-4">Issue and return copies from your approved collections in this college. Fine settlement, stock adjustments and deletion require separate authority.</div>
          <section class="campus_panel"><h2>Issue a library copy</h2><form t-on-submit.prevent="searchDesk" class="campus_library_search"><label for="campus_library_query">Copy name, book title or barcode<input id="campus_library_query" type="search" class="form-control" maxlength="200" t-model="state.query"/></label><label for="campus_card_query">Borrower card number<input id="campus_card_query" type="search" class="form-control" maxlength="200" t-model="state.cardQuery"/></label><button class="btn btn-outline-primary" t-att-disabled="state.busy">Search</button></form>
          <div class="campus_library_fields"><label for="campus_copy">Available copy<select id="campus_copy" class="form-select" t-model="state.unit"><option value="">Choose a copy</option><t t-foreach="state.desk.units" t-as="u" t-key="u.id"><option t-att-value="u.id" t-esc="u.label"/></t></select></label><label for="campus_card">Borrower card<select id="campus_card" class="form-select" t-model="state.card"><option value="">Choose a borrower</option><t t-foreach="state.desk.cards" t-as="c" t-key="c.id"><option t-att-value="c.id" t-esc="c.label"/></t></select></label><button class="btn btn-primary" t-att-disabled="state.busy || !state.unit || !state.card" t-on-click="issue">Issue copy</button></div><p class="campus_muted">Up to 30 matching copies and cards. Search a specific barcode or card number to narrow the list.</p></section>
          <section class="campus_panel mt-4"><h2>Outstanding loans</h2><div class="table-responsive"><table class="table"><thead><tr><th>Book</th><th>Card</th><th>Due</th><th>Action</th></tr></thead><tbody><t t-foreach="state.desk.loans" t-as="r" t-key="r.id"><tr><td t-esc="r.title"/><td t-esc="r.borrower"/><td t-esc="r.due"/><td><button class="btn btn-outline-primary" t-att-disabled="state.busy" t-on-click="() => this.returnLoan(r.id)">Return copy</button></td></tr></t><tr t-if="!state.desk.loans.length"><td colspan="4">No outstanding loans in your permitted collections.</td></tr></tbody></table></div><div class="d-flex gap-2"><button class="btn btn-outline-primary" t-on-click="() => this.loanPage(-1)" t-att-disabled="state.busy || !state.loanPage">Previous</button><button class="btn btn-outline-primary" t-on-click="() => this.loanPage(1)" t-att-disabled="state.busy || !state.desk.next">Next</button></div></section>
        </t>
      </t>
      <footer class="campus_footer">VCET Campus ERP · <t t-esc="state.workspace_role"/> workspace · Powered by Ideastone</footer>
    </main>
  </t>
</templates>
