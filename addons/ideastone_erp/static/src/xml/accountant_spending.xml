<templates xml:space="preserve">
<t t-name="ideastone_erp.AccountantSpending"><div class="accountant_spending"><section class="content">
  <div class="crumb">VCET Campus <span>/</span> Spending <span>/</span> <b><t t-esc="label"/> bills</b></div>
  <div class="headingrow"><div><h1><t t-esc="label"/> bills</h1><p t-esc="description"/></div><button class="primary" t-on-click="openNew">＋ New bill</button></div>
  <p t-if="state.error" class="spend-error" role="alert"><t t-esc="state.error"/> <button t-on-click="load">Retry</button></p>
  <p t-if="state.loading" role="status">Loading spending records…</p>
  <div class="kpis"><article class="kpi" t-foreach="stats" t-as="s" t-key="s.label"><div class="kpihead"><t t-esc="s.label"/><span class="kpiicon" t-att-class="s.tone" t-esc="s.icon"/></div><strong t-att-class="s.tone" t-esc="s.value"/><small t-esc="s.note"/></article></div>
  <div class="layout spending-layout">
    <article class="panel"><div class="panelhead"><div><h3><t t-esc="label"/> spending overview</h3><p>Monthly bill value · amounts in company currency</p></div><div class="period-picker" t-ref="picker"><button class="period-trigger" aria-haspopup="menu" t-att-aria-expanded="state.menu ? 'true' : 'false'" t-on-click="() => state.menu = !state.menu"><span class="period-selection"><span class="period-icon">▦</span><span t-esc="state.period"/></span><span aria-hidden="true">⌄</span></button><div class="period-menu" t-att-class="{open:state.menu}" role="menu"><button t-foreach="['Last 6 months','Current year']" t-as="p" t-key="p" class="period-option" t-att-class="{selected:state.period === p}" role="menuitem" t-on-click="() => this.period(p)"><t t-esc="p"/><span class="check">✓</span></button></div></div></div>
      <div class="panelbody"><div class="chart" role="img" t-att-aria-label="label + ' monthly bill totals and paid amounts'"><div t-foreach="chart" t-as="m" t-key="m.key" class="barcol"><div class="bars"><div class="bar" t-att-style="'height:'+m.totalHeight+'%'" t-att-title="m.label + ' bill total: ' + money(m.total)"/><div class="bar expense" t-att-style="'height:'+m.paidHeight+'%'" t-att-title="m.label + ' paid: ' + money(m.paid)"/></div><span class="barlabel" t-esc="m.label"/></div></div><div class="legend"><span><i class="dot"/>Bill total</span><span><i class="dot alt"/>Amount paid</span></div></div>
    </article>
    <article class="panel"><div class="panelhead"><div><h3><t t-esc="label"/> spending attention</h3><p>Items to check before settlement</p></div></div><div class="panelbody">
      <div class="insight"><span class="insighticon">!</span><div><b t-esc="largestDue ? 'Large ' + label.toLowerCase() + ' bill pending' : 'No unpaid bills recorded'"/><p t-if="largestDue"><t t-esc="largestDue.reference"/> has <t t-esc="money(largestDue.due)"/> due. Confirm supporting documents and approval.</p><p t-else="">Review new bills and supporting evidence before settlement.</p><span class="tag">Approval check</span></div></div>
      <div class="insight"><span class="insighticon insight-blue">↗</span><div><b>Department spending needs review</b><p>Review department entries for category and allocation accuracy.</p><span class="tag">Department review</span></div></div>
    </div></article>
  </div>
  <article class="panel"><div class="panelhead"><div><h3><t t-esc="label"/> bill register</h3><p t-esc="mode === 'event' ? 'Search and review event bills for the selected period.' : 'Search and review maintenance bills, service partners and costs.'"/></div><button class="primary" t-on-click="openNew">＋ New bill</button></div>
    <div class="toolbar" role="group" aria-label="Spending bill filters"><input aria-label="Search bills" placeholder="Search bill number, partner or reference…" t-model="state.search"/><select aria-label="Category" t-model="state.category"><option value="">All categories</option><option value="maintenance">Maintenance</option><option value="event">College event</option></select><select aria-label="Department" t-model="state.department"><option value="">All departments</option><option t-foreach="state.departments" t-as="d" t-key="d.id" t-att-value="d.id" t-esc="d.name"/></select><select aria-label="Payment status" t-model="state.payment"><option value="">All payment statuses</option><option value="Not Paid">Not Paid</option><option value="Partially Paid">Partially Paid</option><option value="Paid">Paid</option></select><button t-on-click="reset">Reset</button></div>
    <div class="tablewrap"><table><thead><tr><th>Bill number</th><th>Partner</th><th>Bill date</th><th>Reference</th><th>Category</th><th>Department</th><th>Total</th><th>Amount due</th><th>Payment status</th><th>Action</th></tr></thead><tbody><tr t-foreach="filtered" t-as="r" t-key="r.id"><td t-esc="r.name"/><td t-esc="r.partner"/><td t-esc="dateLabel(r.date)"/><td t-esc="r.reference"/><td><span class="category-chip" t-att-class="r.category === 'event' ? 'event-chip' : 'maintenance-chip'" t-esc="categoryLabel(r.category)"/></td><td t-esc="r.department"/><td t-esc="money(r.total)"/><td class="amber" t-esc="money(r.due)"/><td><span class="status" t-att-class="r.status === 'Paid' ? 'paid' : 'due'" t-esc="r.status"/></td><td><button t-on-click="() => this.view(r)">View</button></td></tr></tbody></table><p class="empty" t-if="!filtered.length &amp;&amp; !state.loading">No bills match the selected filters.</p></div><div class="panelbody spending-count">Showing <b t-esc="filtered.length"/> bills · Saved records in the active college</div>
  </article>
</section>
<div t-if="state.modal" class="spend-overlay" t-on-click="closeOverlay"><section class="spend-modal" role="dialog" aria-modal="true" aria-labelledby="spend-modal-title" t-ref="modal"><header><h3 id="spend-modal-title" t-esc="state.modal === 'new' ? 'Create new ' + label.toLowerCase() + ' bill' : 'Bill details'"/><button aria-label="Close bill popup" t-on-click="close" t-att-disabled="state.saving">✕</button></header>
  <t t-if="state.modal === 'view'"><dl><t t-foreach="[{label:'Bill number',value:state.selected.name},{label:'Partner',value:state.selected.partner},{label:'Bill date',value:dateLabel(state.selected.date)},{label:'Reference',value:state.selected.reference},{label:'Category',value:categoryLabel(state.selected.category)},{label:'Department',value:state.selected.department},{label:'Total',value:money(state.selected.total)},{label:'Amount due',value:money(state.selected.due)},{label:'Payment status',value:state.selected.status}]" t-as="d" t-key="d.label"><dt t-esc="d.label"/><dd t-esc="d.value"/></t></dl><footer><button t-on-click="close">Close</button><button class="primary" t-on-click="openRecord">Open bill ↗</button></footer></t>
  <form t-else="" t-on-submit="save"><p t-if="state.formError" class="spend-error" role="alert" t-esc="state.formError"/><label>Partner<select required="required" t-model="state.form.vendor_id"><option value="">Choose vendor / partner</option><option t-foreach="state.vendors" t-as="v" t-key="v.id" t-att-value="v.id" t-esc="v.name"/></select></label><label>Category<select t-model="state.form.category"><option value="maintenance">Maintenance</option><option value="event">College event</option></select></label><label>Department<select required="required" t-model="state.form.department_id"><option value="">Choose department</option><option t-foreach="state.departments" t-as="d" t-key="d.id" t-att-value="d.id" t-esc="d.name"/></select></label><label>Bill amount (<t t-esc="state.currency"/>)<input type="number" min="0.01" step="0.01" required="required" placeholder="0.00" t-model="state.form.amount"/></label><div class="spend-formrow"><label>Bill date<input type="date" required="required" t-model="state.form.date"/></label><label>Reference<input maxlength="250" t-model="state.form.reference" placeholder="Vendor reference"/></label></div><p class="spend-formnote">Save a draft for review. Posting and payment use the existing ERP bill workflow.</p><footer><button type="button" t-on-click="close" t-att-disabled="state.saving">Cancel</button><button type="submit" class="primary" t-att-disabled="state.saving" t-esc="state.saving ? 'Saving…' : 'Save draft'"/></footer></form>
</section></div>
</div></t></templates>
