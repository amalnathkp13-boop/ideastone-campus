<templates xml:space="preserve">
<t t-name="ideastone_erp.AccountantDirectory"><div class="fee_directory"><div class="content">
<div class="crumb">Campus home / Students &amp; dues</div>
<div class="headrow"><div class="heading"><h1 t-esc="title"/><p>Browse students by department, academic year and section.</p></div><div class="actions"><t t-if="!filterBarVisible"><div class="search"><span>⌕</span><input aria-label="Search fee directory" placeholder="Search…" t-model="state.search"/></div><button class="btn" t-on-click="reset">↻ Reset</button></t><button t-if="state.mode !== 'directory' || state.student" class="btn" t-on-click="exportRows">⇩ Export list</button><button t-if="state.mode === 'pending'" class="btn primary" t-on-click="reminders">✉ Send fee reminders</button></div></div>
<p t-if="state.error" role="alert" t-esc="state.error"/>
<div class="metrics"><article class="metric" t-foreach="metrics" t-as="m" t-key="m.label"><div class="metric-top"><t t-esc="m.label"/><span class="metric-icon" t-esc="m.icon"/></div><strong t-esc="m.value"/><small t-esc="m.note"/></article></div>
<div class="crumbline"><button t-on-click="() => this.back('department')">All departments</button><t t-if="state.department"><span>›</span><button t-on-click="() => this.back('year')" t-esc="state.department"/></t><t t-if="state.year"><span>›</span><button t-on-click="() => this.back('section')" t-esc="state.year"/></t><t t-if="state.section"><span>›</span><button t-on-click="() => this.back('students')" t-esc="state.section"/></t><span t-if="state.student">› Fee history</span></div>
<t t-if="state.student"><div class="history-top"><div class="profile-card"><div class="profile-row"><div class="avatar large" t-esc="initials(state.student.name)"/><div><h3 t-esc="state.student.name"/><p><t t-esc="state.student.number"/> · <span class="pill amber" t-esc="state.student.pending ? 'Fee due' : 'Fee cleared'"/></p></div></div><div class="profile-details"><div class="detail" t-foreach="['department','year','section','semester']" t-as="key" t-key="key"><label t-esc="key"/><strong t-esc="state.student[key]"/></div></div></div><div class="summary-card"><div class="sum" t-foreach="[{label:'Fee amount',value:money(state.student.total)},{label:'Paid to date',value:money(state.student.paid)},{label:'Pending balance',value:money(state.student.pending)},{label:'Payment completion',value:(state.student.total ? Math.round(state.student.paid/state.student.total*100) : 0)+'%'},{label:'Payment entries',value:state.student.ledger.length},{label:'Account status',value:state.student.pending ? 'Outstanding' : 'Cleared'}]" t-as="s" t-key="s.label"><span t-esc="s.label"/><strong t-esc="s.value"/></div></div></div>
<section class="table-wrap"><div class="table-head"><div><h2>Fee transaction history</h2><p>Payment ledger, receipts and outstanding fee details.</p></div><button class="btn" t-on-click="exportRows">⇩ Export ledger</button></div><div class="table-scroll"><table><thead><tr><th>Payment / due date</th><th>Receipt / reference</th><th>Description</th><th>Payment mode</th><th>Amount</th><th>Status</th><th>Receipt</th></tr></thead><tbody><tr t-foreach="state.student.ledger" t-as="r" t-key="r.id"><td t-esc="r.date"/><td t-esc="r.name"/><td t-esc="r.description"/><td t-esc="r.mode"/><td t-esc="money(r.total)"/><td><span class="pill" t-att-class="r.pending ? 'amber' : 'green'" t-esc="r.status"/></td><td><button class="view" t-on-click="() => this.receipt(r)" t-esc="r.pending ? 'View invoice ↗' : 'View receipt ↗'"/></td></tr></tbody></table><p class="empty" t-if="!state.student.ledger.length">No posted fee invoices.</p></div></section></t>
<t t-elif="state.mode === 'accounts' || state.level === 'students'">
<div t-if="state.mode === 'directory'" class="pending-dept-header directory-filter-heading"><div><h2><t t-esc="state.department"/> · Student fee directory</h2><p>Showing <t t-esc="filteredRows.length"/> of <t t-esc="rows.length"/> students in <t t-esc="state.department"/></p></div><button class="btn" t-on-click="() => this.back('department')">← All departments</button></div>
<div class="pending-controls" t-att-class="{'account-controls': state.mode === 'accounts'}" role="group" aria-label="Student fee filters">
<input class="pending-search" aria-label="Search student name or registration number" t-att-placeholder="state.mode === 'accounts' ? 'Search student name or registration number...' : '⌕  Search name or registration number...'" t-model="state.search"/>
<select t-if="state.mode === 'accounts'" aria-label="Department" t-model="state.department"><option value="">All departments</option><option t-foreach="departments" t-as="d" t-key="d" t-att-value="d" t-esc="d"/></select>
<select aria-label="Academic year" t-model="state.year"><option value="">All years</option><option t-foreach="years" t-as="y" t-key="y" t-att-value="y" t-esc="y"/></select>
<select t-if="state.mode === 'accounts'" aria-label="Semester" t-model="state.semester"><option value="">All semesters</option><option t-foreach="semesters" t-as="s" t-key="s" t-att-value="s" t-esc="s"/></select>
<select aria-label="Fee status" t-model="state.status"><option value="" t-esc="state.mode === 'accounts' ? 'All account statuses' : 'All due statuses'"/><t t-if="state.mode !== 'accounts'"><option value="Overdue">Overdue</option><option value="Due soon">Due soon</option><t t-if="state.mode === 'directory'"><option value="Outstanding">Outstanding</option><option value="Cleared">Cleared</option></t></t><t t-else=""><option value="Outstanding">Outstanding</option><option value="Cleared">Cleared</option></t></select>
<button class="btn" t-on-click="resetFilters">↻ Reset</button>
</div>

<section class="table-wrap"><div class="table-head"><div><h2 t-esc="state.mode === 'pending' ? 'Students with pending fees' : 'Student fee accounts'"/><p><t t-esc="filteredRows.length"/> students shown</p></div><button class="btn" t-on-click="exportRows">⇩ Export list</button></div><div class="table-scroll"><table><thead><tr><th>Register number</th><th>Student name</th><th>Department</th><th>Year / Section</th><th>Semester</th><th>Total fee</th><th>Paid</th><th>Pending</th><th>Status</th><th>Action</th></tr></thead><tbody><tr t-foreach="filteredRows" t-as="r" t-key="r.id"><td t-esc="r.number"/><td><div class="student"><div class="avatar" t-esc="initials(r.name)"/><div><b t-esc="r.name"/><small t-esc="r.phone"/></div></div></td><td><span class="pill blue" t-esc="r.code"/></td><td><t t-esc="r.year"/> / <t t-esc="r.section"/></td><td t-esc="r.semester"/><td t-esc="money(r.total)"/><td class="paid" t-esc="money(r.paid)"/><td class="balance" t-esc="money(r.pending)"/><td><span class="pill" t-att-class="r.pending ? 'amber' : 'green'" t-esc="r.overdue ? 'Overdue' : r.pending ? 'Outstanding' : 'Cleared'"/></td><td><button class="view" t-on-click="() => this.openStudent(r)">View fee history ↗</button></td></tr></tbody></table><p class="empty" t-if="!filteredRows.length">No students match the selected filters.</p></div></section></t>
<t t-else=""><div class="section-title"><h2 t-esc="state.level === 'department' ? 'Departments' : state.level === 'year' ? 'Academic years' : 'Sections'"/><span>Choose a card to continue</span></div><div class="grid"><button class="dept-card" t-foreach="cards" t-as="c" t-key="c.name" t-on-click="() => this.drill(c)"><div class="card-head"><div class="dept-icon" t-esc="c.code"/><span class="arrow">↗</span></div><h3 t-esc="c.name"/><div class="sub">Student strength and fee status</div><div class="card-stats"><div><strong t-esc="c.count"/><span>Students</span></div><div><strong><t t-esc="c.rate"/>%</strong><span>Fee collected</span></div><div><strong t-esc="money(c.pending)"/><span>Pending balance</span></div></div><div class="progress"><i t-att-style="'width:'+c.rate+'%'"/></div></button></div><p class="empty" t-if="!cards.length">No students in this scope.</p></t>
</div></div></t></templates>
