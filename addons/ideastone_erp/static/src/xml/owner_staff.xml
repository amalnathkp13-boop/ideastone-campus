<templates xml:space="preserve">
  <t t-name="ideastone_erp.OwnerStaffDirectory">
    <main class="campus_owner_staff"><div class="content">
      <div class="crumbrow"><span>VCET Campus / Faculty &amp; Staff / <strong t-esc="state.screen === 'overview' ? 'Staff directory' : (department?.code || 'Staff directory')"/></span><span><t t-esc="date(state.data?.today)"/> · Owner / Admin</span></div>
      <div t-if="state.error" class="staff_error" role="alert"><span t-esc="state.error"/><button type="button" class="btn" t-on-click="load">Retry</button></div>
      <p t-if="state.loading" role="status">Loading staff records…</p>
      <t t-elif="state.data">
        <t t-if="state.screen === 'overview'">
          <header class="headingrow"><div><h1>Staff Directory</h1><p>A campus-wide overview of faculty strength, department teams and staff records.</p></div><button type="button" class="btn" t-on-click="load"><i aria-hidden="true" class="fa fa-refresh"/> Refresh</button></header>
          <section class="hero"><div><span class="hero-label">ONE CAMPUS · EVERY STAFF MEMBER</span><h2>Know your faculty and staff community at a glance.</h2><p>Move from campus-wide staff strength to department, teaching and non-teaching teams, then open individual staff profiles.</p></div><div class="hero-stat"><strong t-esc="rows.length"/><span>staff records</span></div></section>
          <section class="kpis" aria-label="Staff summary">
            <article class="kpi"><div class="kpi-top">Total staff <span class="kpi-icon"><i aria-hidden="true" class="fa fa-users"/></span></div><strong t-esc="rows.length"/><div class="kpi-foot">Across all departments</div></article>
            <article class="kpi"><div class="kpi-top">Teaching staff <span class="kpi-icon"><i aria-hidden="true" class="fa fa-graduation-cap"/></span></div><strong t-esc="teaching"/><div class="kpi-foot">Faculty and academic team</div></article>
            <article class="kpi"><div class="kpi-top">Non-teaching staff <span class="kpi-icon"><i aria-hidden="true" class="fa fa-id-card-o"/></span></div><strong t-esc="rows.length - teaching"/><div class="kpi-foot">Technical, administrative and support</div></article>
            <article class="kpi"><div class="kpi-top">Currently active <span class="kpi-icon"><i aria-hidden="true" class="fa fa-check-circle"/></span></div><strong t-esc="active"/><div class="kpi-foot"><span class="good">Active staff</span> · excluding leave and inactive records</div></article>
          </section>
          <header class="sectionhead"><div><h2>Department strength</h2><p>Select a department to explore teaching and non-teaching staff.</p></div><button type="button" class="textbtn" t-on-click="manageStaff">Manage staff records <i aria-hidden="true" class="fa fa-external-link"/></button></header>
          <div class="deptgrid"><article t-foreach="state.data.departments" t-as="dept" t-key="dept.key" class="dept">
            <div class="dept-head"><span class="dept-icon"><i aria-hidden="true" t-att-class="departmentIcon(dept)"/></span><span class="dept-code" t-esc="dept.code"/></div>
            <h3 t-esc="dept.name"/><div class="dept-sub">Teaching and non-teaching staff</div>
            <div class="dept-counts"><strong t-esc="dept.total"/><span>staff members</span><span class="percent"><t t-esc="percent(dept)"/>% teaching</span></div>
            <div class="progress" role="img" t-att-aria-label="percent(dept) + '% teaching'"><span t-att-style="'width:' + percent(dept) + '%'"/></div>
            <div class="dept-metrics"><div class="metric"><b t-esc="dept.teaching"/><small>Teaching staff</small></div><div class="metric"><b t-esc="dept.non_teaching"/><small>Non-teaching staff</small></div></div>
            <button type="button" class="dept-actions" t-on-click="() => this.selectDepartment(dept)"><span>View staff categories</span><i aria-hidden="true" class="fa fa-arrow-right"/></button>
          </article></div>
          <div t-if="!state.data.departments.length" class="panel empty">No staff records yet. Add staff records to populate this directory.</div>
        </t>
        <t t-if="state.screen === 'categories' &amp;&amp; department">
          <div class="backline"><button type="button" t-on-click="() => state.screen = 'overview'">← All departments</button><span>Department staff</span></div>
          <section class="detailhero"><div><span class="eyebrow">Department directory</span><h2 t-esc="department.name"/><p>Choose a staff category to browse its members.</p></div><div class="detailstats"><div><strong t-esc="department.total"/><span>Total staff</span></div><div><strong t-esc="department.teaching"/><span>Teaching</span></div><div><strong t-esc="department.non_teaching"/><span>Non-teaching</span></div></div></section>
          <div class="deptgrid categories"><article class="dept"><div class="dept-head"><span class="dept-icon"><i aria-hidden="true" class="fa fa-graduation-cap"/></span><span class="countpill"><t t-esc="department.teaching"/> staff</span></div><h3>Teaching staff</h3><p class="dept-sub">Faculty members responsible for teaching, academic delivery and student guidance.</p><button type="button" class="dept-actions" t-on-click="() => this.selectCategory('teaching')"><span>View teaching staff</span><i aria-hidden="true" class="fa fa-arrow-right"/></button></article><article class="dept"><div class="dept-head"><span class="dept-icon"><i aria-hidden="true" class="fa fa-id-card-o"/></span><span class="countpill"><t t-esc="department.non_teaching"/> staff</span></div><h3>Non-teaching staff</h3><p class="dept-sub">Technical, laboratory, administrative and support staff.</p><button type="button" class="dept-actions" t-on-click="() => this.selectCategory('non_teaching')"><span>View non-teaching staff</span><i aria-hidden="true" class="fa fa-arrow-right"/></button></article></div>
        </t>
        <t t-if="state.screen === 'list' &amp;&amp; department">
          <div class="backline"><button type="button" t-on-click="() => state.screen = 'categories'">← Department categories</button></div>
          <header class="headingrow"><div><span class="eyebrow" t-esc="categoryLabel"/><h1><t t-esc="categoryLabel"/> · <t t-esc="department.name"/></h1><p>Search staff records and select a person to view their basic profile.</p></div><span class="countpill"><t t-esc="categoryRows.length"/> staff</span></header>
          <div class="toolbar"><label class="search"><i aria-hidden="true" class="fa fa-search"/><input aria-label="Search staff" placeholder="Search name, code, designation or email…" t-model="state.query"/></label><select class="select" aria-label="Designation" t-model="state.designation"><option value="">All designations</option><option t-foreach="designations" t-as="title" t-key="title" t-att-value="title" t-esc="title"/></select><select class="select" aria-label="Staff status" t-model="state.status"><option value="">All statuses</option><option>Active</option><option>On leave</option><option>Inactive</option></select></div>
          <div class="tablewrap" tabindex="0" aria-label="Staff directory table"><table><thead><tr><th>STAFF MEMBER</th><th>STAFF CODE</th><th>DESIGNATION</th><th>DEPARTMENT</th><th>EMAIL</th><th>STATUS</th><th>PROFILE</th></tr></thead><tbody><tr t-foreach="filteredRows" t-as="person" t-key="person.key"><td><div class="person"><span class="person-avatar" t-esc="initials(person.name)"/><div><b t-esc="person.name"/><small t-esc="categoryLabel"/></div></div></td><td t-esc="person.code"/><td t-esc="person.designation"/><td t-esc="person.department_code"/><td t-esc="person.email"/><td><span class="status" t-att-class="person.status === 'Active' ? '' : 'pending'" t-esc="person.status"/></td><td><button type="button" class="view" t-att-aria-label="'View profile of ' + person.name" t-on-click="() => this.openProfile(person)">View profile</button></td></tr><tr t-if="!filteredRows.length"><td colspan="7" class="empty">No staff match these filters.</td></tr></tbody></table></div>
        </t>
        <t t-if="state.screen === 'profile' &amp;&amp; selectedPerson">
          <div class="backline"><button type="button" t-on-click="() => state.screen = 'list'">← Staff list</button><span>Basic profile</span></div>
          <section class="detailhero"><div class="detailperson"><span class="detailavatar" t-esc="initials(selectedPerson.name)"/><div><span class="eyebrow" t-esc="categoryLabel"/><h2 t-esc="selectedPerson.name"/><p><t t-esc="selectedPerson.designation"/> · <t t-esc="selectedPerson.department"/></p><span class="status" t-att-class="selectedPerson.status === 'Active' ? '' : 'pending'" t-esc="selectedPerson.status"/></div></div><div class="detailstats"><div><strong t-esc="selectedPerson.code"/><span>Staff code</span></div><div><strong t-esc="selectedPerson.joining_date ? selectedPerson.joining_date.slice(0,4) : '—'"/><span>Joined</span></div></div></section>
          <div class="profilegrid"><section class="panel" t-foreach="profileSections" t-as="group" t-key="group.title"><h3 t-esc="group.title"/><div class="fieldgrid"><div class="info" t-foreach="group.fields" t-as="field" t-key="field[0]"><label t-esc="field[0]"/><strong t-esc="field[1]"/></div></div></section></div><div class="actions profile-actions"><button type="button" class="btn" t-on-click="openRecord">Open staff record <i aria-hidden="true" class="fa fa-external-link"/></button></div>
        </t>
        <footer class="foot"><t t-esc="state.data.company"/> · Faculty &amp; Staff</footer>
      </t>
    </div></main>
  </t>

  <t t-name="ideastone_erp.OwnerStaffLeave" t-inherit="ideastone_erp.FacultyLeavePage" t-inherit-mode="primary">
    <xpath expr="//main" position="attributes"><attribute name="class">campus_leave_page campus_owner_staff_leave</attribute></xpath>
    <xpath expr="//header[@class='leave_heading']/div" position="inside"><p class="staff_subtitle">Submit staff leave requests and track approval status.</p></xpath>
    <xpath expr="//section[hasclass('leave_insights')]/header" position="after"><p class="staff_insight_note">Rule-based highlights from saved leave records.</p></xpath>
    <xpath expr="//section[hasclass('leave_approval')]" position="replace">
      <section t-else="" class="leave_panel leave_approval"><header><h2>Online Leave Application Approval By HoD</h2><span class="staff_pending_count"><t t-esc="review.rows.length"/> pending</span></header><p t-if="review.error" role="alert" t-esc="review.error"/>
        <div class="leave_table_scroll"><table><thead><tr><th>Staff member</th><th>Leave type</th><th>Date</th><th>Days</th><th>Reason</th><th>Status</th><th>Action</th></tr></thead><tbody><tr t-foreach="review.rows" t-as="record" t-key="record.id"><td t-esc="record.name"/><td t-esc="record.type"/><td t-esc="dateLabel(record)"/><td t-esc="record.days"/><td class="leave_ellipsis" t-att-title="record.reason" t-esc="record.reason"/><td><span class="leave_status pending" t-esc="record.status"/></td><td class="staff_review_actions"><button type="button" class="text" t-on-click="() => this.reviewRecord(record)">Review</button><t t-if="record.can_approve"><button type="button" class="staff_approve" t-att-disabled="review.busy" t-on-click="() => this.decide(record, 'approve')">Approve</button><button type="button" class="staff_refuse" t-att-disabled="review.busy" t-on-click="() => this.decide(record, 'refuse')">Reject</button></t></td></tr><tr t-if="!review.rows.length &amp;&amp; !review.error"><td colspan="7" class="leave_empty">No pending requests in your permitted approval scope.</td></tr></tbody></table></div>
      </section>
    </xpath>
  </t>

  <t t-name="ideastone_erp.OwnerStaffPayroll" t-inherit="ideastone_erp.PayrollHistoryPage" t-inherit-mode="primary">
    <xpath expr="//main" position="attributes"><attribute name="t-att-class">'campus_payroll_history campus_owner_staff_payroll' + (state.isAdmin ? ' payroll_admin' : '')</attribute></xpath>
    <xpath expr="//section[hasclass('payroll_hero')]" position="replace"><header class="staff_payroll_heading"><div><p class="staff_crumb">Campus › Faculty &amp; Staff › Payroll History</p><span class="payroll_eyebrow">STAFF · PAYROLL</span><h1>Payroll History</h1><p>A clear view of your salary, contributions and payslips.</p></div><span class="payroll_hero_note">Your payroll records</span></header></xpath>
    <xpath expr="//select[@aria-label='Report options']" position="replace"><select aria-label="Report options" t-on-change="changeMode"><option value="history">Complete History</option><option value="salary">Salary Summary</option><option value="deductions">Deductions Summary</option></select></xpath>
    <xpath expr="//div[hasclass('payroll_featured')]" position="replace"/>
    <xpath expr="//div[hasclass('payroll_bar_track')]" position="before"><strong class="payroll_bar_value" t-esc="formatMoney(bar.value)"/></xpath>
    <xpath expr="//div[hasclass('payroll_history_header')]//h2" position="replace"><h2 t-esc="reportTitle"/></xpath>
    <xpath expr="//div[hasclass('payroll_history_header')]//p" position="replace"><p><t t-esc="state.employeeName"/> · Monthly take-home pay and deductions, all in one place.</p></xpath>
    <xpath expr="//div[hasclass('payroll_table_scroller')]/table" position="replace"><table><thead><tr><th>#</th><th>Month</th><th>Year</th><th t-if="state.mode !== 'deductions'">Net Salary (<t t-esc="state.currencyCode"/>)</th><t t-if="state.mode !== 'salary'"><th>Late Days</th><th>Late Deduction (<t t-esc="state.currencyCode"/>)</th><th>P.F (<t t-esc="state.currencyCode"/>)</th><th>T.D.S (<t t-esc="state.currencyCode"/>)</th></t></tr></thead><tbody><tr t-foreach="visibleRows" t-as="row" t-key="row.id"><td t-esc="row_index + 1"/><td class="payroll_month" t-esc="rowMonth(row)"/><td t-esc="rowYear(row)"/><td t-if="state.mode !== 'deductions'" class="payroll_net" t-esc="formatMoney(row.net)"/><t t-if="state.mode !== 'salary'"><td t-esc="row.late_days"/><td t-esc="formatMoney(row.late_deduction)"/><td t-esc="formatMoney(row.pf)"/><td t-esc="formatMoney(row.tds)"/></t></tr><tr t-if="!visibleRows.length"><td colspan="8" class="payroll_empty">No approved payslips match these filters.</td></tr></tbody></table></xpath>
    <xpath expr="//section[hasclass('payroll_entry_panel')]" position="replace"><details t-if="latest" class="payroll_entry_panel"><summary>Punch entries · <t t-esc="latestLabel"/></summary><p>Attendance and payroll treatment for <t t-esc="state.employeeName"/>.</p><p t-if="state.entryError" role="alert" t-esc="state.entryError"/><div class="payroll_entry_scroller" tabindex="0"><table><thead><tr><th>Date</th><th>Check-in</th><th>Checkout</th><th>Payroll treatment</th></tr></thead><tbody><tr t-foreach="state.entries" t-as="entry" t-key="entry.id"><td t-esc="entry.date"/><td t-esc="entry.check_in"/><td t-esc="entry.check_out"/><td t-esc="entry.treatment"/></tr><tr t-if="!state.entries.length"><td colspan="4">No punch entries recorded for this payroll period.</td></tr></tbody></table></div></details></xpath>
  </t>
</templates>
