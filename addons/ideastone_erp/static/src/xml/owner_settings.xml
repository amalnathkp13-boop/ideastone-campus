<templates xml:space="preserve">
  <t t-name="ideastone_erp.OwnerSettings">
    <div class="owner_settings">
      <div class="os_crumb">VCET Campus / Owner workspace / <b t-esc="screen === 'overview' ? 'Settings overview' : title"/></div>
      <div t-if="state.error" class="os_notice" role="alert"><t t-esc="state.error"/><button class="os_btn" t-on-click="load">Retry</button></div>
      <p t-elif="state.loading" role="status">Loading settings…</p>
      <t t-else="">
        <header class="os_heading"><div><h1 t-esc="title"/><p t-esc="description"/></div>
          <div class="os_actions">
            <t t-if="screen === 'overview'"><button class="os_btn" t-on-click="() => props.openPage('audit')">View audit log</button><button class="os_btn os_primary" t-on-click="() => props.openPage('college')">Review settings <i class="fa fa-arrow-right"/></button></t>
            <button t-elif="screen === 'college'" class="os_btn os_primary" t-on-click="save" t-att-disabled="state.saving">Save changes</button>
            <button t-elif="screen === 'documents'" class="os_btn os_primary" t-on-click="() => this.openAction('ideastone_erp.mvp_requirements', null, true)">＋ Add requirement</button>
            <button t-elif="screen === 'catalogue'" class="os_btn os_primary" t-on-click="() => this.openAction('ideastone_erp.mvp_student_request_types', null, true)">＋ Add request type</button>
            <button t-elif="screen === 'audit'" class="os_btn" t-on-click="() => this.openAction('ideastone_erp.mvp_audit')">Open audit register</button>
            <button t-elif="screen === 'users'" class="os_btn os_primary" t-on-click="() => this.openAction('base.action_res_users', null, true)">＋ Invite user</button>
            <button t-elif="screen === 'numbering'" class="os_btn os_primary" t-on-click="() => this.openAction('base.ir_sequence_form', null, true)">＋ New sequence</button>
            <button t-elif="screen === 'import'" class="os_btn" t-on-click="downloadTemplate">Download template</button>
          </div>
        </header>

        <t t-if="screen === 'overview'">
          <div class="os_grid os_stats">
            <article class="os_stat"><div class="os_stathead">Configuration status <span class="os_ico"><i class="fa fa-cog"/></span></div><div class="os_num"><t t-esc="data.configuration_done"/> / <t t-esc="data.configuration_total"/></div><div class="os_hint">Core setup areas recorded</div></article>
            <article class="os_stat"><div class="os_stathead">Active users <span class="os_ico"><i class="fa fa-user-o"/></span></div><div class="os_num" t-esc="activeUsers"/><div class="os_hint">Across administrator and staff roles</div></article>
            <article class="os_stat"><div class="os_stathead">Recent changes <span class="os_ico"><i class="fa fa-history"/></span></div><div class="os_num" t-esc="data.audit_total"/><div class="os_hint">College workflow audit entries</div></article>
            <article class="os_stat"><div class="os_stathead">Import readiness <span class="os_ico"><i class="fa fa-upload"/></span></div><div class="os_num" t-esc="data.import_ready ? 'Ready' : 'Setup needed'"/><div class="os_hint">Academic year and section required</div></article>
          </div>
          <div class="os_grid os_cols">
            <section class="os_panel"><div class="os_ph"><div><h2>Essential configuration</h2><div class="os_desc">Settings that affect daily campus operations.</div></div><span class="os_badge os_blue">Core setup</span></div>
              <div class="os_row"><div class="os_rowleft"><span class="os_rowicon"><i class="fa fa-university"/></span><div><div class="os_rt">College profile</div><div class="os_rd">Name, address, contact details, logo and currency.</div></div></div><button class="os_btn os_soft" t-on-click="() => props.openPage('college')">Manage →</button></div>
              <div class="os_row"><div class="os_rowleft"><span class="os_rowicon"><i class="fa fa-check-square-o"/></span><div><div class="os_rt">Attendance &amp; OD policy</div><div class="os_rd">Shortage threshold, excused sessions and OD token rules.</div></div></div><button class="os_btn os_soft" t-on-click="() => props.openPage('college')">Review →</button></div>
              <div class="os_row"><div class="os_rowleft"><span class="os_rowicon"><i class="fa fa-file-text-o"/></span><div><div class="os_rt">Document requirements</div><div class="os_rd">Required student documents by programme.</div></div></div><button class="os_btn os_soft" t-on-click="() => props.openPage('documents')">Manage →</button></div>
              <div class="os_row"><div class="os_rowleft"><span class="os_rowicon"><i class="fa fa-list-alt"/></span><div><div class="os_rt">Student request catalogue</div><div class="os_rd">Request types available in the student portal.</div></div></div><button class="os_btn os_soft" t-on-click="() => props.openPage('catalogue')">Manage →</button></div>
            </section>
            <section class="os_panel os_security"><div class="os_ph"><div><h2>Security &amp; operational checks</h2><div class="os_desc">Controls to review regularly.</div></div><span class="os_badge os_purple">Access</span></div>
              <div class="os_row"><div class="os_rowleft"><span class="os_rowicon"><i class="fa fa-users"/></span><div><div class="os_rt">Users &amp; roles</div><div class="os_rd"><t t-esc="activeUsers"/> active accounts; <t t-esc="adminUsers"/> owner administrators.</div></div></div><button class="os_btn os_soft" t-on-click="() => props.openPage('users')">Review →</button></div>
              <div class="os_row"><div class="os_rowleft"><span class="os_rowicon"><i class="fa fa-history"/></span><div><div class="os_rt">Audit log</div><div class="os_rd">Review recent changes to college records.</div></div></div><button class="os_btn os_soft" t-on-click="() => props.openPage('audit')">Review →</button></div>
              <div class="os_row"><div class="os_rowleft"><span class="os_rowicon"><i class="fa fa-sort-numeric-asc"/></span><div><div class="os_rt">ID &amp; receipt numbering</div><div class="os_rd">Check sequence prefixes before issuing records.</div></div></div><button class="os_btn os_soft" t-on-click="() => props.openPage('numbering')">Review →</button></div>
              <div class="os_row"><div class="os_rowleft"><span class="os_rowicon"><i class="fa fa-upload"/></span><div><div class="os_rt">Student import</div><div class="os_rd">Validate CSV rows before committing.</div></div></div><button class="os_btn os_soft" t-on-click="() => props.openPage('import')">Open →</button></div>
            </section>
          </div>
          <section class="os_panel"><div class="os_ph"><div><h2>Recent configuration activity</h2><div class="os_desc">Latest entries from the college audit log.</div></div><button class="os_btn os_soft" t-on-click="() => props.openPage('audit')">View all →</button></div>
            <div class="os_tablewrap"><table class="os_table"><thead><tr><th>Created on</th><th>Actor</th><th>Action</th><th>Area</th><th>Record</th></tr></thead><tbody><tr t-foreach="data.audits.slice(0, 5)" t-as="row" t-key="row.id"><td t-esc="row.when"/><td t-esc="row.actor"/><td t-esc="row.action"/><td t-esc="row.area"/><td t-esc="row.record"/></tr><tr t-if="!data.audits.length"><td colspan="5">No audit entries recorded for this college.</td></tr></tbody></table></div>
          </section>
        </t>

        <t t-elif="screen === 'college'">
          <div class="os_grid os_cols"><section class="os_panel"><div class="os_ph"><div><h2>College profile</h2><div class="os_desc">Used across campus records and communication.</div></div><span class="os_badge os_blue">Institution</span></div>
            <div class="os_formgrid"><label class="os_field os_full">College name<input t-model="state.form.name"/></label><label class="os_field os_full">Street address<input t-model="state.form.street"/></label><label class="os_field">City<input t-model="state.form.city"/></label><label class="os_field">Phone<input t-model="state.form.phone"/></label><label class="os_field">Official email<input type="email" t-model="state.form.email"/></label><label class="os_field">Currency<input t-att-value="data.currency_name" readonly="readonly"/></label></div>
            <div class="os_notice">Use the approved college name and contact details consistently on receipts, notices and student records. Change currency in the college record after checking accounting impact.</div>
          </section><section class="os_panel"><div class="os_ph"><div><h2>Attendance &amp; OD policy</h2><div class="os_desc">Confirm approved policy before updating.</div></div><span class="os_badge os_amber">Review required</span></div>
            <div class="os_formgrid"><label class="os_field os_full">Attendance shortage threshold (%)<input type="number" min="0" max="100" t-model="state.form.campus_attendance_threshold"/></label><label class="os_field os_full">Campus excused-session policy<select t-model="state.form.campus_excused_policy"><option value="exclude">Exclude excused sessions</option><option value="present">Count excused as present</option><option value="absent">Count excused as absent</option></select></label><label class="os_field os_full">OD tokens per semester<input type="number" min="0" t-model="state.form.campus_od_default_tokens"/></label><label class="os_field os_full">OD token charging rule<select t-model="state.form.campus_od_token_rule"><option value="request">One token per request</option><option value="day">One token per OD day</option></select></label></div>
            <div class="os_row"><div><div class="os_rt">Enable student portal</div><div class="os_rd">Allow student self-service features.</div></div><button class="os_toggle" t-att-class="{on: state.form.campus_student_portal_enabled}" t-att-aria-pressed="state.form.campus_student_portal_enabled ? 'true' : 'false'" aria-label="Enable student portal" t-on-click="() => state.form.campus_student_portal_enabled = !state.form.campus_student_portal_enabled"/></div>
            <div class="os_row"><div><div class="os_rt">Allow contact/address updates</div><div class="os_rd">Students submit profile changes for review.</div></div><button class="os_toggle" t-att-class="{on: state.form.campus_student_contact_edit}" t-att-aria-pressed="state.form.campus_student_contact_edit ? 'true' : 'false'" aria-label="Allow student contact updates" t-on-click="() => state.form.campus_student_contact_edit = !state.form.campus_student_contact_edit"/></div>
          </section></div>
          <section class="os_panel"><div class="os_ph"><div><h2>AI assistant integration</h2><div class="os_desc">Optional integration; restrict secrets to authorised administrators.</div></div><span class="os_badge os_purple">Optional</span></div><div class="os_row"><div><div class="os_rt">Enable Campus Assistant</div><div class="os_rd">Enable only after endpoint and access controls are verified.</div></div><button class="os_toggle" disabled="disabled" aria-label="Campus Assistant unavailable"/></div><div class="os_formgrid"><label class="os_field">API-compatible endpoint<input placeholder="Not configured" disabled="disabled"/></label><label class="os_field">Model<input placeholder="Not configured" disabled="disabled"/></label><label class="os_field">Assistant calls per month<input type="number" placeholder="Not configured" disabled="disabled"/></label><label class="os_field">API key<input type="password" placeholder="Configured secret is hidden" disabled="disabled"/></label></div><div class="os_notice">No live assistant endpoint is configured in this ERP. No API key is stored or displayed by this workspace.</div></section>
        </t>

        <t t-elif="screen === 'documents'">
          <div class="os_grid os_stats"><article class="os_stat"><div class="os_stathead">Active requirements <span class="os_ico">▤</span></div><div class="os_num" t-esc="activeRequirements.length"/><div class="os_hint">Current college configuration</div></article><article class="os_stat"><div class="os_stathead">Programme-specific <span class="os_ico">▦</span></div><div class="os_num" t-esc="activeRequirements.filter(row => row.applies_to !== 'All programmes').length"/><div class="os_hint">Selected programmes</div></article><article class="os_stat"><div class="os_stathead">College-wide <span class="os_ico">◎</span></div><div class="os_num" t-esc="activeRequirements.filter(row => row.applies_to === 'All programmes').length"/><div class="os_hint">Across programmes</div></article><article class="os_stat"><div class="os_stathead">Inactive <span class="os_ico">◷</span></div><div class="os_num" t-esc="data.requirements.length - activeRequirements.length"/><div class="os_hint">Not required for current intake</div></article></div>
          <section class="os_panel"><div class="os_ph"><div><h2>Requirement register</h2><div class="os_desc">Collect only documents that are necessary.</div></div><input class="os_search" type="search" placeholder="Search requirements…" t-model="state.search"/></div><div class="os_tablewrap"><table class="os_table"><thead><tr><th>Requirement</th><th>Applies to</th><th>Required</th><th>Active</th><th>Action</th></tr></thead><tbody><tr t-foreach="filteredRows" t-as="row" t-key="row.id"><td t-esc="row.name"/><td t-esc="row.applies_to"/><td t-esc="row.required ? 'Yes' : 'No'"/><td><span class="os_badge" t-att-class="row.active ? 'os_green' : ''" t-esc="row.active ? 'Active' : 'Inactive'"/></td><td><button class="os_btn" t-on-click="() => this.openAction('ideastone_erp.mvp_requirements', row.id)">Edit</button></td></tr><tr t-if="!filteredRows.length"><td colspan="5">No matching requirements.</td></tr></tbody></table></div></section>
        </t>

        <t t-elif="screen === 'catalogue'">
          <section class="os_panel"><div class="os_ph"><div><h2>Available request types</h2><div class="os_desc">Request types shown in the student portal.</div></div><input class="os_search" type="search" placeholder="Search requests…" t-model="state.search"/></div><div class="os_tablewrap"><table class="os_table"><thead><tr><th>Request type</th><th>Code</th><th>Category</th><th>Assigned office</th><th>Active</th><th>Action</th></tr></thead><tbody><tr t-foreach="filteredRows" t-as="row" t-key="row.id"><td t-esc="row.name"/><td t-esc="row.code"/><td t-esc="row.kind"/><td>Not configured</td><td><span class="os_badge" t-att-class="row.active ? 'os_green' : ''" t-esc="row.active ? 'Active' : 'Inactive'"/></td><td><button class="os_btn" t-on-click="() => this.openAction('ideastone_erp.mvp_student_request_types', row.id)" t-esc="row.template ? 'View' : 'Edit'"/></td></tr><tr t-if="!filteredRows.length"><td colspan="6">No matching request types.</td></tr></tbody></table></div></section>
          <section class="os_panel os_spaced"><div class="os_ph"><div><h2>Awaiting student requests</h2><div class="os_desc">Requests submitted through the student portal that still need staff review.</div></div><span class="os_badge os_amber"><t t-esc="data.requests.length"/> awaiting</span></div><div class="os_tablewrap"><table class="os_table"><thead><tr><th>Request ID</th><th>Student</th><th>Request type</th><th>Submitted</th><th>Assigned office</th><th>Status</th><th>Action</th></tr></thead><tbody><tr t-foreach="data.requests" t-as="row" t-key="row.id"><td t-esc="row.reference"/><td><t t-esc="row.student"/><t t-if="row.number"> · <t t-esc="row.number"/></t></td><td t-esc="row.type"/><td t-esc="row.submitted"/><td>Not configured</td><td><span class="os_badge os_amber" t-esc="row.status"/></td><td><button class="os_btn" t-on-click="() => this.openStudentRequest(row.id)">Review</button></td></tr><tr t-if="!data.requests.length"><td colspan="7">No student requests are awaiting review.</td></tr></tbody></table></div></section>
        </t>

        <t t-elif="screen === 'audit'">
          <div class="os_grid os_stats"><article class="os_stat"><div class="os_stathead">Entries shown <span class="os_ico">≡</span></div><div class="os_num" t-esc="data.audits.length"/><div class="os_hint">Latest 100 audit entries</div></article><article class="os_stat"><div class="os_stathead">Actors <span class="os_ico">♙</span></div><div class="os_num" t-esc="actors"/><div class="os_hint">Users in the shown entries</div></article><article class="os_stat"><div class="os_stathead">Configuration changes <span class="os_ico">⚙</span></div><div class="os_num" t-esc="configurationChanges"/><div class="os_hint">Among shown entries</div></article><article class="os_stat"><div class="os_stathead">Total entries <span class="os_ico">◷</span></div><div class="os_num" t-esc="data.audit_total"/><div class="os_hint">Current college audit log</div></article></div>
          <section class="os_panel"><div class="os_ph"><div><h2>Activity history</h2><div class="os_desc">Search by actor, action, area or record reference.</div></div><input class="os_search" type="search" placeholder="Search audit log…" t-model="state.search"/></div><div class="os_tablewrap"><table class="os_table"><thead><tr><th>Created on</th><th>Actor</th><th>Action</th><th>Area</th><th>Record</th><th>Reason</th></tr></thead><tbody><tr t-foreach="filteredRows" t-as="row" t-key="row.id"><td t-esc="row.when"/><td t-esc="row.actor"/><td t-esc="row.action"/><td t-esc="row.area"/><td t-esc="row.record"/><td t-esc="row.reason"/></tr><tr t-if="!filteredRows.length"><td colspan="6">No matching audit entries.</td></tr></tbody></table></div><div class="os_notice">Audit records are append-only for normal users. Record reasons for sensitive changes.</div></section>
        </t>

        <t t-elif="screen === 'users'">
          <div class="os_grid os_stats"><article class="os_stat"><div class="os_stathead">Total users <span class="os_ico">♙</span></div><div class="os_num" t-esc="data.users.length"/><div class="os_hint">Accounts in this college</div></article><article class="os_stat"><div class="os_stathead">Confirmed <span class="os_ico">✓</span></div><div class="os_num" t-esc="confirmedUsers"/><div class="os_hint">Active accounts that connected</div></article><article class="os_stat"><div class="os_stathead">Never connected <span class="os_ico">◷</span></div><div class="os_num" t-esc="activeUsers - confirmedUsers"/><div class="os_hint">Review account necessity</div></article><article class="os_stat"><div class="os_stathead">Admin roles <span class="os_ico">⚙</span></div><div class="os_num" t-esc="adminUsers"/><div class="os_hint">Keep elevated access limited</div></article></div>
          <section class="os_panel"><div class="os_ph"><div><h2>User access register</h2><div class="os_desc">Review access state and role assignment.</div></div><input class="os_search" type="search" placeholder="Search users…" t-model="state.search"/></div><div class="os_userlist"><div class="os_userrow" t-foreach="filteredRows" t-as="row" t-key="row.id"><div class="os_person"><i t-esc="row.name.split(' ').map(part => part[0]).slice(0,2).join('').toUpperCase()"/><div><b t-esc="row.name"/><small t-esc="row.login"/></div></div><div class="os_role" t-esc="row.role"/><span class="os_badge" t-att-class="row.active &amp;&amp; row.confirmed ? 'os_green' : ''" t-esc="!row.active ? 'Inactive' : row.confirmed ? 'Confirmed' : 'Never connected'"/></div><p t-if="!filteredRows.length" class="os_empty">No matching users.</p></div><div class="os_notice">Use role-based access, remove access promptly when responsibilities change, and review accounts that have never connected.</div></section>
        </t>

        <t t-elif="screen === 'numbering'">
          <section class="os_panel"><div class="os_ph"><div><h2>Sequence register</h2><div class="os_desc">Check prefixes and next numbers before modifying a live sequence.</div></div><input class="os_search" type="search" placeholder="Search sequences…" t-model="state.search"/></div><div class="os_tablewrap"><table class="os_table"><thead><tr><th>Sequence name</th><th>Prefix</th><th>Digits</th><th>Next number</th><th>Step</th><th>Company</th><th>Status</th></tr></thead><tbody><tr t-foreach="filteredRows" t-as="row" t-key="row.id"><td t-esc="row.name"/><td t-esc="row.prefix"/><td t-esc="row.digits"/><td t-esc="row.next"/><td t-esc="row.step"/><td t-esc="row.company"/><td><span class="os_badge os_green">Active</span></td></tr><tr t-if="!filteredRows.length"><td colspan="7">No matching sequences.</td></tr></tbody></table></div><div class="os_notice"><b>Important:</b> Do not reset sequences after records have been issued. Check uniqueness and downstream receipt/report dependencies first.</div></section>
        </t>

        <t t-elif="screen === 'import'">
          <div class="os_grid os_cols"><section class="os_panel"><div class="os_ph"><div><h2>Import workflow</h2><div class="os_desc">Follow these steps to reduce duplicate or incomplete records.</div></div><span class="os_badge os_blue">3 steps</span></div><div class="os_row"><div class="os_rowleft"><span class="os_rowicon">1</span><div><div class="os_rt">Upload CSV file</div><div class="os_rd">Choose a UTF-8 CSV containing student records.</div></div></div><span class="os_badge">Required</span></div><div class="os_row"><div class="os_rowleft"><span class="os_rowicon">2</span><div><div class="os_rt">Map and validate columns</div><div class="os_rd">Required: student_number, first_name, last_name, phone, section_code.</div></div></div><span class="os_badge">Required</span></div><div class="os_row"><div class="os_rowleft"><span class="os_rowicon">3</span><div><div class="os_rt">Preview and commit</div><div class="os_rd">Resolve duplicate numbers and missing academic configuration first.</div></div></div><span class="os_badge os_amber">Review</span></div><div class="os_notice">Do not commit until the preview has been checked and a recovery procedure is available.</div></section>
            <section class="os_panel"><div class="os_ph"><div><h2>Upload file</h2><div class="os_desc">The ERP validates the file before any student records are created.</div></div></div><label class="os_field">Company<input t-att-value="data.company.name" readonly="readonly"/></label><label class="os_field os_filefield">CSV file<input type="file" accept=".csv,text/csv" t-on-change="(event) => this.onFileChange(event)"/></label><label class="os_field os_filefield">Selected filename<input t-att-value="state.filename" placeholder="No file selected" readonly="readonly"/></label><div class="os_notice">Choose a CSV file, then review the ERP validation result before committing any rows.</div><div class="os_panel_actions"><button class="os_btn os_primary" t-on-click="() => this.previewImport()" t-att-disabled="state.saving">Preview &amp; validate</button></div></section></div>
        </t>
      </t>
    </div>
  </t>
</templates>
