<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="cron_provision_students" model="ir.cron">
      <field name="name">LMS: provision student accounts</field>
      <field name="model_id" ref="openeducat_core.model_op_student"/>
      <field name="state">code</field>
      <field name="code">model._cron_provision_lms()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="numbercall">-1</field>
      <field name="active" eval="True"/>
    </record>
    <record id="cron_provision_faculty" model="ir.cron">
      <field name="name">LMS: provision faculty accounts</field>
      <field name="model_id" ref="openeducat_core.model_op_faculty"/>
      <field name="state">code</field>
      <field name="code">model._cron_provision_lms()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="numbercall">-1</field>
      <field name="active" eval="True"/>
    </record>
  </data>
</odoo>
