<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- Company identity used on every screen, receipt and report.
         Change these in Settings → Companies after install. -->
    <record id="base.main_company" model="res.company">
      <field name="name">Ideastone Demo Engineering College</field>
      <field name="street">NH-544, Perundurai Road</field>
      <field name="city">Erode</field>
      <field name="zip">638052</field>
      <field name="phone">+91 424 240 0000</field>
      <field name="email">office@campus.local</field>
      <field name="website">https://campus.local</field>
      <field name="campus_affiliation">Anna University, Chennai</field>
      <field name="campus_approval">AICTE, New Delhi</field>
      <field name="campus_naac_grade">A</field>
      <field name="campus_code">2607</field>
    </record>

    <!-- Browser window title -->
    <record id="web_window_title" model="ir.config_parameter">
      <field name="key">web.window_title</field>
      <field name="value">erp.vcet</field>
    </record>
  </data>
</odoo>
