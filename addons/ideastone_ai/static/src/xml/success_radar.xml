<templates xml:space="preserve">
  <t t-name="ideastone_ai.SuccessRadarPage">
    <main class="campus_ai_page radar_page">
      <div t-if="state.error" class="ai_error" role="alert"><t t-esc="state.error"/> <button type="button" t-on-click="load">Retry</button></div>
      <div t-if="state.loading" class="ai_loading" role="status">Scoring students…</div>
      <t t-elif="state.data">
        <section class="ai_heading">
          <span class="ai_heading_icon"><i class="fa fa-heartbeat" aria-hidden="true"/></span>
          <div><h1>Student Success Radar</h1><p>Early-warning scores from attendance, results, fees and engagement, with the reason behind every point. <t t-esc="roleLabel"/> · <t t-esc="state.data.company"/> · <t t-esc="state.data.today"/></p></div>
          <button type="button" class="ai_icon_button" title="Export displayed rows (up to 500)" aria-label="Export displayed rows (up to 500)" t-on-click="exportCsv"><i class="fa fa-download" aria-hidden="true"/></button>
        </section>

        <section class="ai_metrics" aria-label="Risk summary">
          <article class="ai_metric"><small>Students scored</small><strong t-esc="state.data.summary.students"/><span>Active, current semester</span></article>
          <article class="ai_metric tone_high"><small>Needs attention</small><strong t-esc="state.data.summary.high"/><span><t t-esc="percent(state.data.summary.high)"/>% of students · score 50+</span></article>
          <article class="ai_metric tone_watch"><small>Watch</small><strong t-esc="state.data.summary.watch"/><span><t t-esc="percent(state.data.summary.watch)"/>% · score 25–49</span></article>
          <article class="ai_metric tone_low"><small>Low recorded score</small><strong t-esc="state.data.summary.low"/><span><t t-esc="percent(state.data.summary.low)"/>% · score under 25; check data coverage</span></article>
        </section>

        <section class="ai_panel radar_factors" t-if="state.data.summary.top_factors.length" aria-label="Leading factors">
          <h2>What is driving risk</h2>
          <div class="radar_factor_bars">
            <div t-foreach="state.data.summary.top_factors" t-as="factor" t-key="factor.key" class="radar_factor_bar">
              <span t-esc="factorLabel(factor.key)"/>
              <div class="radar_bar"><span t-attf-style="width: #{percent(factor.count)}%" t-attf-class="radar_bar_fill factor_#{factor.key}"/></div>
              <strong><t t-esc="factor.count"/> students</strong>
            </div>
          </div>
        </section>

        <form class="ai_filters" t-on-submit="search" aria-label="Filters">
          <label>Department <select t-att-value="state.departmentId" t-on-change="changeDepartment"><option value="">All departments</option><t t-foreach="state.data.departments" t-as="d" t-key="d.id"><option t-att-value="d.id" t-att-selected="isSelected(d.id, state.departmentId)" t-esc="d.name"/></t></select></label>
          <label>Class <select t-att-value="state.batchId" t-on-change="changeBatch"><option value="">All classes</option><t t-foreach="batches" t-as="b" t-key="b.id"><option t-att-value="b.id" t-att-selected="isSelected(b.id, state.batchId)" t-esc="b.name"/></t></select></label>
          <label>Band <select t-att-value="state.band" t-on-change="changeBand"><option value="">All bands</option><option value="high" t-att-selected="state.band === 'high'">Needs attention</option><option value="watch" t-att-selected="state.band === 'watch'">Watch</option><option value="low" t-att-selected="state.band === 'low'">Low recorded score</option></select></label>
          <label>Search <input type="search" placeholder="Name or number" t-att-value="state.query" t-on-input="updateQuery"/></label>
          <button type="submit" class="ai_button">Apply</button>
        </form>

        <section class="ai_panel" aria-label="Students ranked by risk">
          <p t-if="!state.data.rows.length" class="ai_empty">No students match these filters.</p>
          <table t-else="" class="radar_table">
            <thead><tr><th scope="col">Student</th><th scope="col">Class</th><th scope="col">Score</th><th scope="col">Why</th><th scope="col">Suggested action</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
            <tbody>
              <t t-foreach="state.data.rows" t-as="row" t-key="row.id">
                <tr t-attf-class="radar_row band_#{row.band}">
                  <td><strong t-esc="row.name"/><small><t t-esc="row.number"/><t t-if="row.mentor"> · Mentor: <t t-esc="row.mentor"/></t></small></td>
                  <td><t t-esc="row.batch"/><small t-esc="row.semester"/></td>
                  <td><span t-attf-class="radar_score band_#{row.band}" t-esc="row.score"/><small t-esc="row.provisional ? 'Limited attendance history' : bandLabel(row.band)"/></td>
                  <td>
                    <span t-foreach="row.factors" t-as="factor" t-key="factor.key" t-attf-class="radar_chip factor_#{factor.key}" t-att-title="factor.detail"><t t-esc="factorLabel(factor.key)"/> +<t t-esc="factor.points"/></span>
                    <span t-if="!row.factors.length" class="radar_chip factor_ok">No scored concerns</span>
                  </td>
                  <td class="radar_action" t-esc="row.action"/>
                  <td class="radar_buttons">
                    <button type="button" class="ai_link" t-on-click="() => this.toggle(row.id)" t-att-aria-expanded="state.open === row.id ? 'true' : 'false'"><t t-esc="state.open === row.id ? 'Hide' : 'Details'"/></button>
                    <button t-if="state.data.can_counsel" type="button" class="ai_link" t-on-click="() => this.counsel(row)">Record counselling</button>
                    <button t-if="state.data.can_open_student" type="button" class="ai_link" t-on-click="() => this.openStudent(row)">Open</button>
                  </td>
                </tr>
                <tr t-if="state.open === row.id" class="radar_details">
                  <td colspan="6">
                    <ul>
                      <li t-foreach="row.factors" t-as="factor" t-key="factor.key"><strong t-esc="factorLabel(factor.key)"/> (+<t t-esc="factor.points"/>): <t t-esc="factor.detail"/></li>
                      <li><strong>Attendance</strong>: <t t-esc="row.attendance.rate === null ? 'not recorded' : row.attendance.rate + '%'"/> of <t t-esc="row.attendance.conducted"/> classes; <t t-esc="row.attendance.remaining"/> scheduled classes remain<t t-if="row.attendance.need !== null">; needs <t t-esc="row.attendance.need"/> more to reach <t t-esc="row.attendance.threshold"/>%</t>.</li>
                      <li><strong>Results</strong>: <t t-esc="row.academics.average === null ? 'no published exams' : row.academics.average + '% average across ' + row.academics.exams + ' exams, ' + row.academics.fails + ' below pass marks'"/>.</li>
                      <li><strong>Fees</strong>: <t t-esc="row.fees.overdue ? state.data.currency_symbol + ' ' + row.fees.overdue + ' overdue (' + row.fees.days + ' days)' : 'nothing overdue'"/>.</li>
                      <li><strong>Engagement</strong>: <t t-esc="row.engagement.od_days"/> OD and <t t-esc="row.engagement.leave_days"/> leave day(s) this semester<t t-if="row.engagement.last_counseling">; last counselling <t t-esc="row.engagement.last_counseling"/></t>.</li>
                    </ul>
                  </td>
                </tr>
              </t>
            </tbody>
          </table>
          <p t-if="state.data.truncated" class="ai_note">Showing the first 500 students. Narrow the filters to see the rest.</p>
        </section>
        <p class="ai_note">How scoring works: attendance up to 40 points (term-to-date rate against the <t t-esc="state.data.threshold"/>% threshold, a drop in the last four weeks, and whether the threshold is still reachable), results up to 30, overdue fees up to 15, leave/OD and missed counselling follow-ups up to 15. Scores are explainable rules over this college's records; nothing leaves the server.</p>
      </t>
    </main>
  </t>
</templates>
