<templates xml:space="preserve">
  <t t-name="ideastone_principal.Notices">
    <main class="pn-notices" id="campus_main"><div class="content">
      <div class="error" t-if="state.error" role="alert"><t t-esc="state.error"/> <button class="btn pn-compact" t-on-click="refresh">Retry</button></div>
      <p t-if="!state.data &amp;&amp; state.loading" role="status">Loading notices…</p>
      <t t-if="state.data">
        <div class="crumb"><span>VCET Campus / <b>Principal workspace / Notices &amp; circulars</b></span><span><t t-esc="date(state.data.today)"/> · <b>Principal</b></span></div>
        <div class="heading"><div><h1>Notices &amp; circulars</h1><p class="subtitle">Review active communications, approve upcoming notices and keep campus-wide messaging on schedule.</p></div><div><button class="btn" t-on-click="refresh" t-att-disabled="state.loading">↻ Refresh</button><button class="btn primary" t-on-click="() => this.open()">＋ Create notice</button></div></div>
        <section class="kpis" aria-label="Notice summary">
          <div class="kpi"><div class="kpitop">Active notices <span class="ico">▤</span></div><div class="value" t-esc="state.data.counts.active"/><div class="note">Currently visible to campus audiences</div></div>
          <div class="kpi"><div class="kpitop">Pending approval <span class="ico amber">⚑</span></div><div class="value" t-esc="state.data.counts.pending"/><div class="note">Awaiting principal decision</div></div>
          <div class="kpi"><div class="kpitop">Upcoming notices <span class="ico violet">◷</span></div><div class="value" t-esc="state.data.counts.upcoming"/><div class="note">Scheduled for future publication</div></div>
          <div class="kpi"><div class="kpitop">Expiring this week <span class="ico green">✓</span></div><div class="value" t-esc="state.data.counts.expiring"/><div class="note">Review visibility and archive dates</div></div>
        </section>
        <div class="layout"><section class="panel"><div class="panelhead"><div><h2 class="ptitle">Notice approval queue</h2><p class="pdesc">Current and scheduled notices submitted for principal review.</p></div><span class="pill"><t t-esc="state.data.counts.pending"/> awaiting review</span></div>
          <div class="controls"><div class="search"><input aria-label="Search notices" placeholder="Search title, reference or owner…" t-model="state.search" t-on-input="filtersChanged"/></div><select aria-label="Notice status" t-model="state.status" t-on-change="filtersChanged"><option value="all">All statuses</option><option value="pending">Pending approval</option><option value="scheduled">Scheduled</option><option value="published">Published</option><option value="returned">Returned for edits</option><option value="draft">Draft</option><option value="archived">Archived</option></select><select aria-label="Notice audience" t-model="state.audience" t-on-change="filtersChanged"><option value="all">All audiences</option><option value="students">Students</option><option value="staff">Faculty &amp; staff</option><option value="all-campus">All campus</option><option value="parents">Parents</option></select></div>
          <div class="notices"><article class="notice" t-foreach="rows" t-as="row" t-key="row.id">
            <div><div class="ntitle" t-esc="row.name"/><div class="meta">Ref: <t t-esc="row.reference"/> · Audience: <t t-esc="row.audience_label"/> · Submitted by: <t t-esc="row.office"/><span t-if="row.state === 'scheduled'">Scheduled: <t t-esc="date(row.publish_at)"/></span><span t-if="row.state === 'published'">Published: <t t-esc="date(row.published_on)"/></span></div><div class="summary" t-esc="row.summary"/><div class="summary" t-if="row.return_note"><b>Return feedback:</b> <t t-esc="row.return_note"/></div></div>
            <div class="right"><span class="pill state" t-att-class="statusClass(row)" t-esc="row.status"/><div class="rowactions"><t t-if="row.state === 'pending'"><button class="btn pn-compact approve" t-att-disabled="state.busy" t-on-click="() => this.approve(row)">Approve</button><button class="btn pn-compact return" t-att-disabled="state.busy" t-on-click="() => this.returnNotice(row)">Return</button></t><button class="btn pn-compact" t-att-aria-label="'View ' + row.name" t-on-click="() => this.open(row.id)">View</button></div></div>
          </article></div><div class="empty" t-if="!filtered.length">No notices match these filters.</div><div class="pager" t-if="pageCount > 1"><button class="btn pn-compact" t-att-disabled="!state.page" t-on-click="previous">Previous</button><span>Page <t t-esc="state.page + 1"/> of <t t-esc="pageCount"/></span><button class="btn pn-compact" t-att-disabled="state.page + 1 >= pageCount" t-on-click="next">Next</button></div>
        </section>
        <aside class="rightcol"><section class="panel"><div class="panelhead"><div><h2 class="ptitle">✧ AI notice insights</h2><p class="pdesc">Review signals from the saved notice queue.</p></div></div><div class="insights"><div class="insight" t-foreach="state.data.insights" t-as="insight" t-key="insight.title"><span class="mark" t-att-class="insight.icon === '!' ? 'warn' : ''" t-esc="insight.icon"/><div><strong t-esc="insight.title"/><p t-esc="insight.text"/></div></div></div></section>
          <section class="panel"><div class="panelhead"><div><h2 class="ptitle">Upcoming publication</h2><p class="pdesc">Next approved notices on the calendar.</p></div><span class="pill" style="background:#eff3f8;color:#59718b">Next 7 days</span></div><div class="events"><button class="event event-button" t-foreach="state.data.upcoming" t-as="row" t-key="row.id" t-on-click="() => this.open(row.id)"><span class="date"><b t-esc="date(row.publish_at, 'month').toUpperCase()"/><strong t-esc="date(row.publish_at, 'day')"/></span><span><span class="eventtitle" t-esc="row.name"/><span class="eventmeta"><t t-esc="row.audience_label"/> · Scheduled notice<br/>Publication: <t t-esc="date(row.publish_at, 'time')"/></span></span></button><div class="empty" t-if="!state.data.upcoming.length">No approved publications scheduled in the next 7 days.</div></div></section>
        </aside></div>
        <section class="panel guidance"><div class="guidance-head"><h2 class="ptitle">Approval guidance</h2><p class="pdesc">Quick checks before approving or returning a notice</p></div><div class="guidance-items"><div class="guidance-item"><span class="mark">1</span><div><strong>Validate content</strong><span>Confirm dates, venue, audience and responsible office.</span></div></div><div class="guidance-item"><span class="mark">2</span><div><strong>Check visibility</strong><span>Ensure publish and expiry dates match the action period.</span></div></div><div class="guidance-item"><span class="mark">3</span><div><strong>Give clear feedback</strong><span>State the required correction when returning a notice.</span></div></div></div></section><div class="footnote">VCET Campus ERP · Principal workspace · <t t-esc="state.data.company"/></div>
      </t>
    </div></main>
  </t>
  <t t-name="ideastone_principal.NoticeReturn"><Dialog title="'Return notice for edits'" size="'md'"><div class="pn-return"><strong t-esc="props.notice.name"/><label for="pn-return-reason">Correction required</label><textarea id="pn-return-reason" t-model="state.reason" placeholder="Explain what needs to be changed…" t-att-disabled="state.busy"/><p class="error" role="alert" t-if="state.error" t-esc="state.error"/></div><t t-set-slot="footer"><button class="btn pn-return-confirm" t-on-click="confirm" t-att-disabled="state.busy">Return notice</button><button class="btn pn-return-cancel" t-on-click="props.close" t-att-disabled="state.busy">Cancel</button></t></Dialog></t>
</templates>
