<templates xml:space="preserve">
  <t t-name="ideastone_principal.StaffDirectory" t-inherit="ideastone_erp.OwnerStaffDirectory" t-inherit-mode="primary">
    <xpath expr="//main" position="attributes"><attribute name="class">campus_principal_staff</attribute></xpath>
    <xpath expr="//div[hasclass('crumbrow')]/span[2]" position="replace"><span><t t-esc="state.data?.today"/> · <strong>Principal</strong></span></xpath>
    <xpath expr="//header[hasclass('sectionhead')]/button" position="replace"><span class="countpill" t-esc="state.data.demo ? 'Sample directory data' : 'Saved directory data'"/></xpath>

    <xpath expr="//section[hasclass('kpis')]/article[1]//span[hasclass('kpi-icon')]" position="replace"><span class="kpi-icon">♟</span></xpath>
    <xpath expr="//section[hasclass('kpis')]/article[2]//span[hasclass('kpi-icon')]" position="replace"><span class="kpi-icon">▤</span></xpath>
    <xpath expr="//section[hasclass('kpis')]/article[3]//span[hasclass('kpi-icon')]" position="replace"><span class="kpi-icon">▣</span></xpath>
    <xpath expr="//section[hasclass('kpis')]/article[4]//span[hasclass('kpi-icon')]" position="replace"><span class="kpi-icon">✓</span></xpath>
    <xpath expr="//section[hasclass('kpis')]/article[1]/div[hasclass('kpi-foot')]" position="replace"><div class="kpi-foot">Across all listed departments</div></xpath>
    <xpath expr="//section[hasclass('kpis')]/article[2]/div[hasclass('kpi-foot')]" position="replace"><div class="kpi-foot">Faculty and academic delivery</div></xpath>
    <xpath expr="//section[hasclass('kpis')]/article[3]/div[hasclass('kpi-foot')]" position="replace"><div class="kpi-foot">Technical, lab and administration</div></xpath>
    <xpath expr="//section[hasclass('kpis')]/article[4]/div[hasclass('kpi-foot')]" position="replace"><div class="kpi-foot" t-esc="state.data.demo ? 'Based on sample directory records' : 'Based on saved directory records'"/></xpath>
    <xpath expr="//article[@t-foreach='state.data.departments']//span[hasclass('dept-icon')]" position="replace"><span class="dept-icon" t-esc="departmentGlyph(dept)"/></xpath>
    <xpath expr="//div[hasclass('categories')]/article[1]//span[hasclass('dept-icon')]" position="replace"><span class="dept-icon">♟</span></xpath>
    <xpath expr="//div[hasclass('categories')]/article[2]//span[hasclass('dept-icon')]" position="replace"><span class="dept-icon">▣</span></xpath>
    <xpath expr="//header[hasclass('headingrow')]/span[hasclass('countpill')]" position="replace"><span class="countpill"><t t-esc="filteredRows.length"/> staff</span></xpath>
    <xpath expr="//td[@t-esc='person.department_code']" position="attributes"><attribute name="t-esc">person.department</attribute></xpath>
    <xpath expr="//div[hasclass('profile-actions')]" position="replace"/>
    <xpath expr="//footer" position="replace"><footer class="foot">VCET Campus ERP · Principal workspace · Powered by Ideastone</footer></xpath>
  </t>
  <t t-name="ideastone_principal.StaffWorkspace">
    <main class="campus_principal_staff"><div class="content">
      <div class="crumbrow"><span>VCET Campus / Faculty &amp; Staff / <strong t-esc="view === 'payroll' ? 'Staff Attendance &amp; Payroll' : 'New staff applications'"/></span><span><t t-esc="state.data?.today"/> · <strong>Principal</strong></span></div>
      <p t-if="state.error" class="staff-error" role="alert"><t t-esc="state.error"/> <button class="btn" t-on-click="load">Retry</button></p>
      <p t-if="state.loading" role="status">Loading saved staff records…</p>
      <t t-if="state.data &amp;&amp; view === 'applications'">
        <header class="headingrow"><div><h1>New Staff Applications</h1><p>Review applications for teaching and non-teaching vacancies, verify eligibility and record recruitment decisions.</p></div><div class="actions"><button class="btn lightblue" t-on-click="reset">↻ Reset filters</button><button class="btn primary" t-on-click="() => this.openApplication()">＋ New application</button></div></header>
        <section class="hero"><div><div class="hero-label">RECRUITMENT · PRINCIPAL WORKSPACE</div><h2>Review applicants for campus positions</h2><p>Application details, qualification checks, document verification, interview progress and final decision in one place.</p></div><div class="hero-stat"><strong t-esc="pending"/><span>awaiting decision</span></div></section>
        <section class="kpis" aria-label="Recruitment summary"><article t-foreach="applicationCards" t-as="card" t-key="card[0]" class="kpi"><div class="kpi-top"><span t-esc="card[0]"/><span class="kpi-icon" t-esc="card[3]"/></div><strong t-esc="card[1]"/><div class="kpi-foot" t-esc="card[2]"/></article></section>
        <div class="toolbar"><label class="search"><span aria-hidden="true">⌕</span><input aria-label="Search applications" placeholder="Search applicant, ID, role or department..." t-model="state.query"/></label><select class="select" aria-label="Application staff type" t-model="state.type"><option value="">All staff types</option><option value="teaching">Teaching</option><option value="non_teaching">Non-teaching</option></select><select class="select" aria-label="Application status" t-model="state.status"><option value="">All statuses</option><option value="pending">Pending</option><option value="interview">Interview</option><option value="approved">Approved</option><option value="rejected">Rejected</option></select></div>
        <div class="tablewrap applications-table-wrap" tabindex="0" aria-label="Staff applications table"><table class="applications-table"><thead><tr><th>Applicant</th><th>Role / type</th><th>Department</th><th>Qualification</th><th>Experience</th><th>Documents</th><th>Interview</th><th>Status</th><th>Principal action</th></tr></thead><tbody>
          <tr t-foreach="applications" t-as="row" t-key="row.id"><td><div class="person"><span class="person-avatar" t-esc="initials(row.name)"/><div><b t-esc="row.name"/><small t-esc="row.reference"/></div></div></td><td><b t-esc="row.role"/><br/><small t-esc="label(row.staff_type)"/></td><td t-esc="row.department_id[1]"/><td t-esc="row.qualification"/><td t-esc="row.experience"/><td><span class="status" t-att-class="statusClass(row.documents)" t-esc="label(row.documents)"/></td><td t-esc="date(row.interview_date)"/><td><span class="status" t-att-class="statusClass(row.state)" t-esc="label(row.state)"/></td><td><div class="actions"><button class="view" t-att-aria-label="'Details for ' + row.name" t-on-click="() => this.show(row)">Details</button><t t-if="['pending','interview'].includes(row.state)"><button class="btn primary" t-att-aria-label="'Approve ' + row.name" t-on-click="() => this.show(row,'approved')">Approve</button><button class="btn" t-att-aria-label="'Reject ' + row.name" t-on-click="() => this.show(row,'rejected')">Reject</button></t></div></td></tr>
          <tr t-if="!applications.length"><td colspan="9" class="empty">No matching applications.</td></tr>
        </tbody></table></div><footer class="foot"><t t-esc="state.data.demo ? 'Sample recruitment records' : 'Saved recruitment records'"/> · Decisions and review history are stored in the college recruitment register.</footer>
      </t>
      <t t-if="state.data &amp;&amp; view === 'payroll'">
        <header class="headingrow"><div><h1>Staff Attendance &amp; Payroll</h1><p>Monitor staff punches, late arrivals, attendance patterns and salary deductions.</p></div><span class="countpill">▣ Principal overview</span></header>
        <div class="payroll-filterbar"><label class="payroll-filter">View<select aria-label="Payroll report view" t-model="state.report"><option value="history">Attendance &amp; deductions</option><option value="salary">Salary summary</option><option value="deductions">Late deduction summary</option></select></label><label class="payroll-filter">Academic year<select aria-label="Payroll year" t-model="state.year" t-on-change="(event) => this.changePeriod('year',event.target.value)"><option value="">All periods</option><option t-foreach="state.data.years" t-as="year" t-key="year" t-att-value="year" t-esc="year"/></select></label><label class="payroll-filter">Month<select aria-label="Payroll month" t-model="state.month" t-on-change="(event) => this.changePeriod('month',event.target.value)"><option value="">All months</option><option t-foreach="['January','February','March','April','May','June','July','August','September','October','November','December']" t-as="month" t-key="month" t-att-value="month_index + 1" t-esc="month"/></select></label><button class="btn primary" t-on-click="exportReport" t-att-disabled="state.loading || !!state.error">↓ Export report</button></div>
        <section class="payroll-kpis" aria-label="Attendance and payroll summary">
          <article class="payroll-kpi"><div class="payroll-kpi-top">Staff present today <span class="payroll-kpi-icon">✓</span></div><strong><t t-esc="state.data.present"/> <small class="attendance-ratio">/ <t t-esc="state.data.total"/></small></strong><small><t t-esc="state.data.total ? Math.round(100*state.data.present/state.data.total) : 0"/>% attendance · <t t-esc="state.data.today"/></small></article>
          <article class="payroll-kpi"><div class="payroll-kpi-top">Late punches today <span class="payroll-kpi-icon red">◷</span></div><strong t-esc="state.data.late_today"/><small>After <t t-esc="state.data.threshold"/> threshold</small></article>
          <article class="payroll-kpi"><div class="payroll-kpi-top">Salary deductions <span class="payroll-kpi-icon purple">₹</span></div><strong t-esc="money(state.data.deductions)"/><small>Selected period · approved payslips</small></article>
          <article class="payroll-kpi"><div class="payroll-kpi-top">Repeated late punches <span class="payroll-kpi-icon blue">↗</span></div><strong t-esc="state.data.repeated"/><small>3+ late arrivals in selected period</small></article>
        </section>
        <div class="payroll-main-grid"><section class="payroll-record-panel"><span class="payroll-pill source-note" t-esc="state.data.demo ? 'Sample saved data' : 'Saved college records'"/><h2 class="payroll-panel-title" t-esc="reportTitle"/><p class="payroll-muted">Review first punch, late arrivals, monthly count and salary deductions.</p>
          <div class="payroll-table-wrap" tabindex="0" aria-label="Staff payroll table"><table class="payroll-table"><thead><tr><th t-foreach="payrollColumns" t-as="column" t-key="column" t-esc="column"/></tr></thead><tbody><tr t-foreach="rows" t-as="row" t-key="row.id"><td t-foreach="payrollValues(row)" t-as="value" t-key="value_index"><strong t-if="value_index === 0" t-esc="value"/><span t-elif="state.report === 'history' &amp;&amp; value_index === 7" class="payroll-pill" t-att-class="row.status === 'Late' ? 'punch-late' : 'punch-on-time'" t-esc="value"/><t t-else="" t-esc="value"/></td></tr><tr t-if="!rows.length"><td colspan="8" class="empty">No staff records match the selected scope.</td></tr></tbody></table></div>
          <div class="payroll-footnote"><span>◇ Deductions come from approved payroll; punches follow the existing campus policy.</span><span>Showing <t t-esc="rows.length"/> staff</span></div>
        </section><div class="payroll-right"><section class="payroll-card"><h2 class="payroll-panel-title">Staff punching trend</h2><p class="payroll-muted">On-time vs late first punches across the week</p><div class="salary-chart" role="img" aria-label="Weekday late first punch counts"><div class="salary-bar-col" t-foreach="trend" t-as="point" t-key="point.day"><strong><t t-esc="point.late"/> late</strong><div class="salary-bar" t-att-class="{current:point.late === Math.max(...trend.map(p => p.late))}" t-att-style="'--bar-height:' + point.height + 'px'" t-att-title="point.label + ': ' + point.late + ' late, ' + point.on_time + ' on time'"/><small t-esc="point.label"/></div></div><p class="payroll-muted" t-esc="trendText"/></section>
          <section class="payroll-card"><h2 class="payroll-panel-title">Attendance signals</h2><div class="payroll-insights"><div class="payroll-insight"><span class="payroll-insight-icon">◷</span><div><b>Late arrival cluster</b><p>Review weekdays and departments with higher late-punch counts.</p></div></div><div class="payroll-insight tax"><span class="payroll-insight-icon">₹</span><div><b>Deduction review</b><p>Verify approved late permissions and attendance exceptions before finalizing deductions.</p></div></div><div class="payroll-insight info"><span class="payroll-insight-icon">↗</span><div><b>Repeated late punches</b><p><t t-esc="state.data.repeated"/> staff have 3+ late arrivals in the selected period. Apply campus attendance policy consistently.</p></div></div></div></section>
        </div></div>
      </t><footer t-if="view === 'payroll'" class="foot">VCET Campus ERP · Principal workspace · Powered by Ideastone</footer>
    </div>
    <div t-if="state.modal" class="staff-overlay" t-on-click="closeOverlay"><section class="application-dialog" role="dialog" aria-modal="true" aria-labelledby="staff-dialog-title" t-ref="modal"><header><h2 id="staff-dialog-title" t-esc="state.modal === 'details' ? 'Application details' : decisionTitle"/><button class="btn" aria-label="Close application popup" t-on-click="close" t-att-disabled="state.busy">✕</button></header>
      <p t-if="state.modalError" role="alert" class="staff-error" t-esc="state.modalError"/>
      <t t-if="state.modal === 'details'"><div class="application-fields"><div class="info" t-foreach="[['Applicant',state.selected.name],['Application ID',state.selected.reference],['Role / type',state.selected.role + ' · ' + label(state.selected.staff_type)],['Department',state.selected.department_id[1]],['Qualification',state.selected.qualification],['Experience',state.selected.experience],['Documents',label(state.selected.documents)],['Interview',date(state.selected.interview_date)],['Status',label(state.selected.state)]]" t-as="field" t-key="field[0]"><label t-esc="field[0]"/><strong t-esc="field[1]"/></div></div><h3>Panel review</h3><p class="review-note" t-esc="state.selected.review || 'No panel review recorded.'"/><t t-if="state.selected.decided_on"><h3>Decision record</h3><p><t t-esc="state.selected.decided_by_id[1]"/> · <t t-esc="date(state.selected.decided_on)"/></p><p class="review-note" t-esc="state.selected.decision_note || 'Approved after review.'"/></t><footer><button class="btn" t-on-click="close">Close</button><button class="btn primary" t-on-click="() => this.openApplication(state.selected.id)">Open application / documents ↗</button></footer></t>
      <form t-else="" t-on-submit="decide"><p><strong t-esc="state.selected.name"/> · <t t-esc="state.selected.role"/></p><p t-if="state.decision === 'approved'">Confirm eligibility and supporting documents before recording approval.</p><label class="decision-label">Decision note<textarea t-model="state.note" t-att-required="state.decision === 'rejected'" placeholder="Record your review or reason for rejection" maxlength="5000"/></label><footer><button class="btn" type="button" t-on-click="close" t-att-disabled="state.busy">Cancel</button><button class="btn primary" type="submit" t-att-disabled="state.busy" t-esc="state.busy ? 'Saving…' : decisionConfirmation"/></footer></form>
    </section></div></main>
  </t>
</templates>
