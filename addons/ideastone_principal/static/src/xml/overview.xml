<templates xml:space="preserve">
  <t t-name="ideastone_principal.Overview">
    <t t-set="d" t-value="state.data.dashboard"/>
    <div class="crumbrow"><span>VCET Campus / Principal workspace / Principal overview</span><span t-esc="state.data.today"/></div>
    <div class="pagehead"><div><h1>Principal overview</h1><p>Institutional performance, operational risks, and decisions requiring leadership attention.</p></div><div class="head-actions"><span class="chip">Saved records · Principal view</span><button class="btn" type="button" t-on-click="load">⟳ Refresh view</button></div></div>
    <section class="hero"><div><div class="eyebrow">YOUR CAMPUS, CONNECTED · PRINCIPAL WORKSPACE</div><h2 style="color:#fff !important">Welcome back, <t t-esc="state.data.user"/></h2><p style="color:#e2f0ff !important">A consolidated view of campus performance, academic progress, and pending institutional actions.</p></div><div class="hero-right"><strong t-esc="state.data.company"/><small><t t-esc="d.year"/> · <t t-esc="d.semester"/></small></div></section>
    <div class="metric-grid">
      <article class="metric"><div class="metric-top"><span class="metric-icon">♙</span></div><label>Active students</label><strong t-esc="d.students"/><div class="metric-bottom"><small>Across <t t-esc="d.programmes"/> programmes</small><span class="trend">Saved records</span></div></article>
      <article class="metric"><div class="metric-top"><span class="metric-icon green">♟</span></div><label>Active faculty &amp; staff</label><strong t-esc="d.faculty"/><div class="metric-bottom"><small>Active faculty directory</small><span class="trend">Current</span></div></article>
      <article class="metric"><div class="metric-top"><span class="metric-icon amber">▤</span></div><label>Fee collection</label><strong><t t-esc="d.currency"/><t t-esc="d.fee_collected.toLocaleString('en-IN')"/></strong><div class="metric-bottom"><small><t t-esc="d.currency"/><t t-esc="d.fee_billed.toLocaleString('en-IN')"/> assessed · current year</small><span class="trend" t-esc="percent(d.fee_rate) + ' complete'"/></div></article>
      <article class="metric"><div class="metric-top"><span class="metric-icon violet">⚑</span></div><label>Pending principal decisions</label><strong t-esc="state.data.counts.pending + state.data.counts.student_leave"/><div class="metric-bottom"><small><t t-esc="state.data.counts.student_leave"/> student leave requests</small><button class="trend metric-link" type="button" t-on-click="() => this.openModule('ideastone_principal.action_principal_decisions')">Needs review →</button></div></article>
    </div>
    <div class="layout"><div class="column">
      <section class="panel"><div class="panelhead"><div><h3>Campus performance</h3><p>Academic attendance and fee collection · monthly trend</p></div><select class="btn" aria-label="Chart period" t-on-change="choosePeriod"><option value="6">Last 6 months</option><option value="4">Last 4 months</option></select></div>
        <div class="chartbox" role="img" aria-label="Monthly student attendance and fee collection progress"><div class="chart-grid"><span>100%</span><span>80%</span><span>60%</span><span>40%</span><span>20%</span></div><div class="chart-bars"><div class="chart-month" t-foreach="trendRows" t-as="month" t-key="month.month"><div class="chart-pair"><div class="chart-bar attendance" t-att-style="barHeight(month.attendance)" t-att-title="'Attendance ' + percent(month.attendance)"/><div class="chart-bar fees" t-att-style="barHeight(month.collection)" t-att-title="'Fee collection ' + percent(month.collection)"/></div><small t-esc="monthLabel(month.month)"/></div></div></div>
        <div class="chart-legend"><span><i class="dot attendance-dot"/>Student attendance</span><span><i class="dot fees-dot"/>Fee collection progress</span><span class="chart-latest">Attendance latest: <b t-esc="percent(d.attendance_rate)"/></span></div>
      </section>
      <section class="panel academic-readiness"><div class="panelhead"><div><h3>Academic delivery &amp; assessment</h3><p>Institution-wide readiness snapshot · current semester</p></div><span class="pill blue" t-esc="d.semester"/></div><div class="readiness-grid"><div class="readiness-item" t-foreach="d.readiness" t-as="item" t-key="item.name"><div class="readiness-meta"><span t-esc="item.name"/><b t-esc="percent(item.value)"/></div><div class="track"><div class="fill" t-att-class="['', 'green', 'amber', 'green'][item_index]" t-att-style="barWidth(item.value)"/></div><small t-esc="item.note"/></div></div><div class="readiness-foot"><span><b>Principal focus:</b> review academic measures that need completion before the assessment window.</span><span class="pill amber">Saved records</span></div></section>
      <section class="panel"><div class="panelhead"><div><h3>Department performance</h3><p>Current attendance snapshot · completed registers</p></div><button class="link" type="button" t-on-click="() => this.openModule('ideastone_erp.mvp_departments')">Department view →</button></div><div class="department-chart" t-if="d.departments.length" role="img" aria-label="Department attendance rates"><div class="dept-column" t-foreach="d.departments" t-as="department" t-key="department.name"><div class="dept-value" t-esc="percent(department.rate)"/><div class="dept-bar"><span t-att-class="department.rate &lt; 85 ? 'amber' : department.rate &lt; 90 ? 'green' : ''" t-att-style="barHeight(department.rate)"/></div><div class="dept-label" t-esc="department.name"/></div></div><p class="empty" t-if="!d.departments.length">Attendance by department will appear after completed registers are saved.</p></section>
      <section class="panel student-support"><div class="panelhead"><div><h3>Student support &amp; retention</h3><p>Early-warning indicators requiring coordinated follow-up</p></div><span class="pill blue">Student affairs</span></div><div class="support-grid"><div class="support-stat"><span>Students below attendance threshold</span><strong t-esc="d.shortage"/><small>Threshold: <t t-esc="d.threshold"/>%</small></div><div class="support-stat"><span>Students flagged for mentoring</span><strong t-esc="d.shortage"/><small>Attendance follow-up candidates</small></div><div class="support-stat"><span>Mentoring review coverage</span><strong t-esc="percent(d.mentoring_rate)"/><small>At-risk students with counseling follow-up</small></div><div class="support-stat"><span>Year-to-date retention</span><strong>—</strong><small>Historical cohort data not recorded</small></div></div><div class="support-foot"><b>Suggested follow-up</b><span>Ask HoDs and class advisors to validate at-risk lists, record interventions, and review progress at the next principal meeting.</span></div></section>
      <section class="panel quick-oversight-compact"><div class="panelhead"><div><h3>Quick oversight</h3><p>Direct entry points for principal review</p></div></div><div class="actionlist"><button class="action" type="button" t-on-click="() => this.openModule('ideastone_erp.action_admissions_overview')"><div><strong>Admissions oversight</strong><br/><span>Applications and exceptions</span></div><b>→</b></button><button class="action" type="button" t-on-click="() => this.openModule('ideastone_erp.mvp_years')"><div><strong>Academic planning</strong><br/><span>Calendar, exams, outcomes</span></div><b>→</b></button><button class="action" type="button" t-on-click="() => this.openModule('ideastone_erp.mvp_faculty')"><div><strong>Faculty oversight</strong><br/><span>Workload and staff matters</span></div><b>→</b></button></div></section>
    </div><div class="column right">
      <section class="panel"><div class="panelhead"><div><h3>Student outcomes</h3><p>Placement and academic progression</p></div><button class="link" type="button" t-on-click="() => this.openModule('ideastone_erp.action_placement_candidate')">Explore →</button></div><div class="donut-area"><div class="donut" t-att-style="donutStyle(d.placement)"><div class="donut-center"><strong t-esc="percent(d.placement.rate)"/><small>placement rate</small></div></div><div class="legend-list"><div><i class="dot attendance-dot"/>Placed <b t-esc="d.placement.placed"/></div><div><i class="dot" style="background:#36a3f7"/>Higher studies <b t-esc="d.placement.higher_studies"/></div><div><i class="dot fees-dot"/>Seeking <b t-esc="d.placement.seeking"/></div><div><i class="dot" style="background:#f2b34b"/>Not eligible <b t-esc="d.placement.not_eligible"/></div></div></div><div class="queue-note"><t t-esc="d.placement.total"/> students with recorded placement or study plans</div></section>
      <section class="panel"><div class="panelhead"><div><h3>Campus operations</h3><p>Key operational indicators</p></div><span class="pill green">Saved records</span></div><div class="mini-bars"><div class="barline" t-foreach="d.operations" t-as="item" t-key="item.name"><span t-esc="item.name"/><div class="track"><div class="fill" t-att-class="['green', '', 'amber', 'green'][item_index]" t-att-style="barWidth(item.value)"/></div><b t-esc="percent(item.value)"/></div></div></section>
      <section class="panel ai-panel"><div class="panelhead"><div class="ai-title"><div class="ai-symbol">✦</div><div><h3>AI insights &amp; recommendations</h3><p>Priority signals generated from saved campus data</p></div></div><span class="ai-label">AI ASSIST</span></div><div class="insight" t-foreach="d.insights" t-as="insight" t-key="insight.title"><div class="insight-icon" t-esc="insight.icon"/><div><strong t-esc="insight.title"/><p t-esc="insight.text"/><small t-esc="insight.tag"/></div></div><p class="empty" t-if="!d.insights.length">No priority signals from the recorded attendance, fee, or admissions data.</p><button class="ai-action" type="button" t-on-click="togglePlan">✦ Generate action plan</button><div class="action-plan" t-att-class="state.showPlan ? 'show' : ''"><strong>Suggested leadership actions</strong><ol><li t-foreach="d.insights" t-as="insight" t-key="insight.title"><button type="button" t-on-click="() => this.openModule(insight.action)" t-esc="insight.title + ' →'"/></li></ol><span t-if="!d.insights.length">Review current campus records and refresh this page as new data is entered.</span></div></section>
      <section class="panel"><div class="panelhead"><div><h3>Principal attention</h3><p>Alerts and upcoming milestones</p></div><button class="link" type="button" t-on-click="() => this.openModule('ideastone_erp.action_college_calendar')">Calendar →</button></div><button class="notice" type="button" t-if="d.shortage" t-on-click="() => this.openModule('ideastone_erp.mvp_report_attendance')"><span class="notice-icon">!</span><span><strong>Attendance below threshold</strong><small><t t-esc="d.shortage"/> students below <t t-esc="d.threshold"/>% · review intervention plans</small></span></button><button class="notice" type="button" t-if="d.upcoming_exam" t-on-click="() => this.openModule('ideastone_erp.action_examinations_overview')"><span class="notice-icon">▦</span><span><strong>Upcoming examination</strong><small><t t-esc="d.upcoming_exam.name"/> · <t t-esc="d.upcoming_exam.date"/></small></span></button><button class="notice" type="button" t-if="state.data.counts.pending" t-on-click="() => this.openModule('ideastone_principal.action_principal_decisions')"><span class="notice-icon">⚑</span><span><strong>Principal decisions</strong><small><t t-esc="state.data.counts.pending"/> submitted requests await review</small></span></button><p class="empty" t-if="!d.shortage &amp;&amp; !d.upcoming_exam &amp;&amp; !state.data.counts.pending">No principal alerts from current records.</p></section>
    </div></div><div class="foot">Institutional overview · values update from saved campus ERP records.</div>
  </t>
</templates>
