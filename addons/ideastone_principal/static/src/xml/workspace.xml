<templates xml:space="preserve"><t t-name="ideastone_principal.Workspace"><main class="campus_principal_workspace" id="campus_main"><div class="page"><p t-if="state.loading" role="status" class="loading">Refreshing Principal records…</p><div t-if="state.error" class="notice-error" role="alert"><span t-esc="state.error"/> <button class="btn" t-on-click="load">Retry</button></div><t t-if="state.data"><t t-if="view === 'overview'"><div class="campus_principal_home"><div class="content"><t t-call="ideastone_principal.Overview"/></div></div></t><t t-else=""><div class="breadcrumb"><span>VCET Campus / Principal workspace / <t t-esc="isQueue ? title : 'Decisions / ' + title"/></span><span t-esc="date(state.data.today)"/></div>
<section t-if="isQueue" class="view active"><div class="heading"><div><h1 t-esc="title"/><p class="subtitle">Institutional oversight and decisions from campus records.</p></div><div class="head-actions"><span class="tag">Saved records · Principal view</span><button class="btn" t-on-click="load" t-att-disabled="state.loading">↻ Refresh</button></div></div>
<div class="metrics"><div class="metric"><div class="metric-icon">♙</div><div class="metric-label">Active students</div><div class="metric-value" t-esc="metrics[0].value"/><div class="metric-note">Across academic years</div></div><div class="metric"><div class="metric-icon">♟</div><div class="metric-label">Faculty &amp; staff</div><div class="metric-value" t-esc="metrics[1].value"/><div class="metric-note">Active staff records</div></div><div class="metric"><div class="metric-icon">▤</div><div class="metric-label">All applications</div><div class="metric-value" t-esc="metrics[2].value"/><div class="metric-note">Includes legacy admissions</div></div><div class="metric"><div class="metric-icon">⚑</div><div class="metric-label">Awaiting decision</div><div class="metric-value" t-esc="metrics[3].value"/><div class="metric-note">Principal review required</div></div></div>
<div class="layout"><div class="stack"><div class="panel"><div class="panel-head"><h2 class="panel-title"><span class="symbol">⚑</span> Principal decision queue</h2><span class="subinfo">Pending items <span class="pill pending" t-esc="pendingCount"/></span></div><div class="filters"><div class="search"><input placeholder="Search request, staff or student…" t-model="state.search" aria-label="Search records"/></div><select t-model="state.category" aria-label="Request category"><option value="">All request types</option><option t-foreach="categories" t-as="category" t-key="category" t-att-value="category" t-esc="category"/></select></div><div class="table-wrap"><table><thead><tr><th>Request</th><th>Category</th><th>Submitted by</th><th>Due / submitted</th><th>Status</th><th>Action</th></tr></thead><tbody><tr t-foreach="filteredRows" t-as="row" t-key="row.key"><td><strong t-esc="row.subject"/><br/><small t-esc="row.code || row.key"/></td><td t-esc="row.category"/><td t-esc="row.name"/><td t-esc="date(row.submitted)"/><td><span class="pill" t-att-class="row.status" t-esc="statusLabel(row.status,row.kind)"/></td><td><button class="btn soft" t-on-click="() => this.openDecision(row)">Review</button></td></tr><tr t-if="!filteredRows.length"><td colspan="6" class="empty">No pending items match this filter.</td></tr></tbody></table></div><p class="note" style="margin-top:10px">Queue includes leave, admissions, academic, student-affairs, finance/facilities, and staff-administration decisions. Student leave is limited to exceptional long-term cases requiring Principal-level authority; routine short leaves remain with the advisor / HoD. Review the record and enter a decision remark.</p></div>
<div class="panel"><div class="panel-head"><h2 class="panel-title"><span class="symbol">☑</span> Approval workflow</h2></div><div class="detail-grid"><div class="detail"><span>Step 1</span><strong>Request submitted</strong></div><div class="detail"><span>Step 2</span><strong>Advisor / HoD review</strong></div><div class="detail"><span>Step 3</span><strong>Principal decision</strong></div></div><p class="note" style="margin-top:12px">Every decision retains the decision-maker, timestamp, outcome and remark. Staff approvals use the connected leave calendar and balances; student approvals preserve the advisor / HoD routing history.</p></div></div>
<div class="stack"><div class="panel"><div class="panel-head"><h2 class="panel-title"><span class="symbol">▦</span> Campus overview</h2></div><div class="quick-links"><button type="button" class="quick-link" t-on-click="() => this.related('admissions')">Admissions <span>→</span></button><button type="button" class="quick-link" t-on-click="() => this.related('students')">Students <span>→</span></button><button type="button" class="quick-link" t-on-click="() => this.related('exams')">Examinations <span>→</span></button><button type="button" class="quick-link" t-on-click="() => this.go('staff')">Staff leave approvals <span>→</span></button></div></div><div class="panel"><div class="panel-head"><h2 class="panel-title"><span class="symbol">✓</span> Principal action reminders</h2></div><p class="note">Review the request details and supporting documents, confirm recommendations, check date conflicts or staffing coverage, then approve or reject with a concise reason.</p></div></div></div></section>
<section t-if="view === 'student'" class="view active"><div class="heading"><div><h1>Student leave approvals</h1><p class="subtitle">Review long-term student leave requests routed through the advisor and Head of Department.</p></div><div class="head-actions"><span class="tag">Principal review</span><button class="btn" t-on-click="load" t-att-disabled="state.loading">↻ Refresh</button></div></div>
<div class="metrics"><div class="metric"><div class="metric-icon">◷</div><div class="metric-label">Pending review</div><div class="metric-value" t-esc="metrics[0].value"/><div class="metric-note">Awaiting Principal decision</div></div><div class="metric"><div class="metric-icon">✓</div><div class="metric-label">Approved this month</div><div class="metric-value" t-esc="metrics[1].value"/><div class="metric-note">Saved approval decisions</div></div><div class="metric"><div class="metric-icon">♙</div><div class="metric-label">On leave today</div><div class="metric-value" t-esc="metrics[2].value"/><div class="metric-note">Approved student leave</div></div><div class="metric"><div class="metric-icon">!</div><div class="metric-label">Needs attention</div><div class="metric-value" t-esc="metrics[3].value"/><div class="metric-note">Supporting details to verify</div></div></div>
<div class="panel"><div class="panel-head"><h2 class="panel-title"><span class="symbol">▤</span> Student leave request register</h2><span class="subinfo">Saved student records</span></div><div class="filters"><div class="search"><input placeholder="Search name, register number, programme…" t-model="state.search" aria-label="Search records"/></div><select t-model="state.type" aria-label="Leave type"><option value="">All leave types</option><option t-foreach="leaveTypes" t-as="type" t-key="type" t-att-value="type" t-esc="type"/></select><select t-model="state.status" aria-label="Approval status"><option value="">All statuses</option><option>Pending</option><option>Approved</option><option>Rejected</option></select></div><div class="table-wrap"><table><thead><tr><th>Student</th><th>Leave type / reason</th><th>Dates / duration</th><th>Advisor</th><th>HoD</th><th>Status</th><th>Action</th></tr></thead><tbody><tr t-foreach="filteredRows" t-as="row" t-key="row.key"><td><div class="person"><div class="person-icon" t-esc="initials(row.name)"/><div><strong t-esc="row.name"/><small><t t-esc="row.code"/> · <t t-esc="row.department"/></small></div></div></td><td><strong t-esc="row.type"/><br/><small t-esc="row.reason"/></td><td><strong t-esc="date(row.from)"/><br/><small>to <t t-esc="date(row.to)"/></small><br/><small><t t-esc="row.days"/> day(s)</small></td><td><span class="pill approved">Recommended</span><br/><small t-esc="row.advisor"/></td><td><span class="pill approved">Recommended</span><br/><small t-esc="row.hod"/></td><td><span class="pill" t-att-class="row.status" t-esc="statusLabel(row.status,row.kind)"/></td><td><div t-if="row.status === 'pending'" class="row-actions"><button class="mini-btn" title="Review student leave" aria-label="Review student leave" t-on-click="() => this.openDecision(row)">↗</button><button class="mini-btn" title="Approve student leave" aria-label="Approve student leave" t-on-click="() => this.openDecision(row)">✓</button><button class="mini-btn" title="Reject student leave" aria-label="Reject student leave" t-on-click="() => this.openDecision(row,'rejected')">×</button></div><button t-else="" class="btn" t-on-click="() => this.openDecision(row,'approved',true)">Details</button></td></tr><tr t-if="!filteredRows.length"><td colspan="7" class="empty">No student leave requests match these filters.</td></tr></tbody></table></div><p class="note" style="margin-top:11px">Review attachments and recommendations before granting leave. A decision remark is required for audit and notification.</p></div></section>

<section t-if="view === 'events'" class="view active">
  <div class="heading">
    <div><h1>Event management</h1><p class="subtitle">Review upcoming campus events, verify planning requirements, and approve proposals awaiting the Principal’s sign-off.</p></div>
    <div class="head-actions"><span class="tag">Principal review</span><button class="btn" t-on-click="load" t-att-disabled="state.loading">↻ Refresh</button><button class="btn soft" t-on-click="() => this.related('proposal')">Event proposals</button></div>
  </div>
  <div class="metrics">
    <div class="metric"><div class="metric-icon">▦</div><div class="metric-label">Upcoming events</div><div class="metric-value" t-esc="metrics[0].value"/><div class="metric-note">Scheduled in the next 60 days</div></div>
    <div class="metric"><div class="metric-icon">✍</div><div class="metric-label">Awaiting signature</div><div class="metric-value" t-esc="metrics[1].value"/><div class="metric-note">Principal approval required</div></div>
    <div class="metric"><div class="metric-icon">◷</div><div class="metric-label">Planning checks pending</div><div class="metric-value" t-esc="metrics[2].value"/><div class="metric-note">Venue, budget or safety follow-up</div></div>
    <div class="metric"><div class="metric-icon">₹</div><div class="metric-label">Proposed event budget</div><div class="metric-value" t-esc="metrics[3].value"/><div class="metric-note">Across listed upcoming events</div></div>
  </div>
  <div class="layout">
    <div class="stack">
      <div class="panel">
        <div class="panel-head"><div><h2>Principal approval queue</h2><p class="subtitle">Event proposals requiring review or signature</p></div><span class="tag"><t t-esc="eventPending"/> pending</span></div>
        <div class="filters"><div class="search"><input placeholder="Search event, organizer or reference…" t-model="state.search" aria-label="Search records"/></div><select t-model="state.status" aria-label="Approval status"><option value="">All approval statuses</option><option>Pending signature</option><option>Approved</option><option>Needs changes</option><option>Rejected</option></select></div>
        <div class="table-wrap"><table><thead><tr><th>Event / reference</th><th>Organizer</th><th>Date &amp; venue</th><th>Budget</th><th>Approval</th><th>Action</th></tr></thead><tbody><tr t-foreach="filteredRows" t-as="row" t-key="row.key"><td><strong t-esc="row.subject"/><br/><small><t t-esc="row.code"/> · <t t-esc="row.reason"/></small></td><td t-esc="row.name"/><td><t t-esc="date(row.from)"/><br/><small t-esc="row.venue"/></td><td t-esc="money(row.budget)"/><td><span class="pill event-status" t-att-class="row.status" t-esc="statusLabel(row.status,row.kind)"/></td><td><div t-if="row.status === 'pending'" class="event-action"><button class="btn soft" t-on-click="() => this.openDecision(row)">Sign &amp; approve</button><button class="btn" t-on-click="() => this.openDecision(row,'changes')">Return</button></div><button t-else="" class="btn" t-on-click="() => this.openDecision(row,'approved',true)">Review</button></td></tr><tr t-if="!filteredRows.length"><td colspan="6" class="empty">No event proposals match these filters.</td></tr></tbody></table></div>
      </div>
      <div class="panel">
        <div class="panel-head"><div><h2>Upcoming event calendar</h2><p class="subtitle">Approved events and events in the review pipeline</p></div><span class="tag">Next 60 days</span></div>
        <div class="table-wrap"><table><thead><tr><th>Date</th><th>Event</th><th>Expected attendees</th><th>Venue</th><th>Readiness</th></tr></thead><tbody><tr t-foreach="calendarRows" t-as="row" t-key="row.key"><td t-esc="date(row.from)"/><td><strong t-esc="row.subject"/><br/><small t-esc="row.code"/></td><td t-esc="row.attendees.toLocaleString('en-IN')"/><td t-esc="row.venue"/><td><span class="pill event-status" t-att-class="row.status === 'approved' ? 'approved' : 'pending'" t-esc="row.status === 'approved' ? 'Approved · logistics in progress' : row.readiness"/></td></tr><tr t-if="!calendarRows.length"><td colspan="5" class="empty">No upcoming events in the next 60 days.</td></tr></tbody></table></div>
      </div>
    </div>
    <div class="stack">
      <div class="panel">
        <div class="panel-head"><div><h2>Principal review checklist</h2><p class="subtitle">Check key details before signing</p></div><span class="symbol">✓</span></div>
        <div class="checklist">
          <div class="check-row"><span class="check-mark">1</span><div><strong>Purpose &amp; ownership</strong><p class="subtitle">Organizer, department, event objective and intended audience are clear.</p></div></div>
          <div class="check-row"><span class="check-mark">2</span><div><strong>Venue &amp; schedule</strong><p class="subtitle">Venue availability, date, setup and academic timetable conflicts are checked.</p></div></div>
          <div class="check-row"><span class="check-mark">3</span><div><strong>Budget &amp; funding</strong><p class="subtitle">Estimated cost, funding source, vendors and financial approval are recorded.</p></div></div>
          <div class="check-row"><span class="check-mark">4</span><div><strong>Safety &amp; logistics</strong><p class="subtitle">Crowd size, security, emergency access, facilities and required permissions are reviewed.</p></div></div>
          <div class="check-row"><span class="check-mark">5</span><div><strong>Final sign-off</strong><p class="subtitle">Approve, request changes, or reject with a documented reason before confirmation.</p></div></div>
        </div>
      </div>
      <div class="panel">
        <div class="panel-head"><div><h2>Approval workflow</h2><p class="subtitle">Suggested routing for campus event proposals</p></div></div>
        <div class="workflow"><div class="workflow-step"><span>01</span><div><strong>Organizer submits proposal</strong><small>Event purpose, date, venue, audience and budget</small></div></div><div class="workflow-step"><span>02</span><div><strong>Department / event coordinator review</strong><small>Completeness, venue and resource coordination</small></div></div><div class="workflow-step"><span>03</span><div><strong>Finance, facilities &amp; safety review</strong><small>Additional checks based on event scale and risk</small></div></div><div class="workflow-step"><span>04</span><div><strong>Principal decision &amp; signature</strong><small>Approve, request changes, or decline; record the decision</small></div></div><div class="workflow-step"><span>05</span><div><strong>Confirmation &amp; post-event closeout</strong><small>Notify organizer; record attendance and expenses after the event</small></div></div></div>
      </div>
    </div>
  </div>
</section>

<section t-if="view === 'staff'" class="view active"><div class="heading"><div><h1>Staff leave approvals</h1><p class="subtitle">Principal review of staff leave requests, recommendations, coverage plans, and final decisions.</p></div><div class="head-actions"><span class="tag">Staff records · Principal view</span><button class="btn" t-on-click="load" t-att-disabled="state.loading">↻ Refresh</button></div></div>
<div class="metrics"><div class="metric"><div class="metric-icon">◷</div><div class="metric-label">Pending Principal review</div><div class="metric-value" t-esc="metrics[0].value"/><div class="metric-note">Requests awaiting decision</div></div><div class="metric"><div class="metric-icon">✓</div><div class="metric-label">Approved this month</div><div class="metric-value" t-esc="metrics[1].value"/><div class="metric-note">Across staff departments</div></div><div class="metric"><div class="metric-icon">♙</div><div class="metric-label">Staff on leave today</div><div class="metric-value" t-esc="metrics[2].value"/><div class="metric-note">Approved leave in effect</div></div><div class="metric"><div class="metric-icon">▤</div><div class="metric-label">Days requested</div><div class="metric-value" t-esc="metrics[3].value"/><div class="metric-note">Across pending requests</div></div></div>
<div class="layout"><div class="stack"><div class="panel"><div class="panel-head"><h2 class="panel-title"><span class="symbol">▤</span> Staff leave request register</h2><button class="btn soft" t-on-click="exportCSV">Export CSV ↓</button></div><div class="filters"><div class="search"><input placeholder="Search staff name, ID, department…" t-model="state.search" aria-label="Search records"/></div><select t-model="state.type" aria-label="Leave type"><option value="">All leave types</option><option t-foreach="leaveTypes" t-as="type" t-key="type" t-att-value="type" t-esc="type"/></select><select t-model="state.status" aria-label="Approval status"><option value="">All statuses</option><option>Pending</option><option>Approved</option><option>Rejected</option></select></div><div class="table-wrap"><table class="staff-register-table"><thead><tr><th>Staff member</th><th>Leave request</th><th>Dates / duration</th><th>Balance</th><th>Status</th><th>Decision</th></tr></thead><tbody><tr t-foreach="filteredRows" t-as="row" t-key="row.key"><td><div class="person"><div class="person-icon" t-esc="initials(row.name)"/><div><strong t-esc="row.name"/><small><t t-esc="row.code"/> · <t t-esc="row.department"/></small></div></div></td><td><strong t-esc="row.type"/><br/><small t-esc="row.reason"/><br/><small t-esc="row.recommendation"/></td><td><strong t-esc="date(row.from)"/><br/><small>to <t t-esc="date(row.to)"/></small><br/><small><t t-esc="row.days"/> day(s)</small></td><td><t t-esc="row.balance === null ? '—' : row.balance + ' d'"/></td><td><span class="pill" t-att-class="row.status" t-esc="statusLabel(row.status,row.kind)"/></td><td><t t-if="row.status === 'pending'"><div class="row-actions"><button class="btn primary" t-on-click="() => this.openDecision(row)">Approve</button><button class="btn" t-on-click="() => this.openDecision(row,'rejected')">Reject</button></div></t><button t-else="" class="btn" t-on-click="() => this.openDecision(row,'approved',true)">Details</button></td></tr><tr t-if="!filteredRows.length"><td colspan="6" class="empty">No staff leave requests match these filters.</td></tr></tbody></table></div><p class="note" style="margin-top:10px">Decisions are saved to the college server. Approved requests update Odoo leave balances and the staff leave calendar.</p></div>
<div class="panel"><div class="panel-head"><h2 class="panel-title"><span class="symbol">↺</span> Principal decision history</h2><span class="subinfo">Saved records</span></div><div class="table-wrap"><table><thead><tr><th>Staff member / remark</th><th>Request</th><th>Decision</th><th>Recorded at</th></tr></thead><tbody><tr t-foreach="history" t-as="item" t-key="item.id"><td><strong t-esc="item.name"/><br/><small t-esc="item.remark"/></td><td t-esc="item.subject"/><td><span class="pill" t-att-class="item.outcome" t-esc="statusLabel(item.outcome)"/></td><td><t t-esc="timestamp(item.at)"/><br/><small t-esc="item.actor"/></td></tr><tr t-if="!history.length"><td colspan="4" class="empty">No saved decisions yet.</td></tr></tbody></table></div></div></div>
<div class="stack"><div class="panel"><div class="panel-head"><h2 class="panel-title"><span class="symbol">✓</span> Review checklist</h2></div><div class="checklist"><div class="checkrow"><span>Leave balance / category</span><strong>Verify</strong></div><div class="checkrow"><span>HoD recommendation</span><strong>Review</strong></div><div class="checkrow"><span>Date overlap / staffing cover</span><strong>Check</strong></div><div class="checkrow"><span>Decision remark</span><strong>Required</strong></div><div class="checkrow"><span>Staff notification</span><strong>After decision</strong></div></div><div class="coverage">Every decision retains the Principal, timestamp, outcome and remark. Approved staff leave is reflected in the connected leave balance and resource calendar.</div></div>
<div class="panel"><div class="panel-head"><h2 class="panel-title"><span class="symbol">✦</span> Staffing overview</h2></div><div class="insight"><strong>Coverage consideration</strong><p>Review concurrent leave in the same department, especially during examinations, admissions, or scheduled campus events.</p></div><p class="note">Recommended request data: staff ID, designation, department, leave category, date range, working-day count, balance before/after, reason, supporting documents, coverage/substitute plan, recommendation, and decision log.</p></div>
<div class="panel"><div class="panel-head"><h2 class="panel-title"><span class="symbol">→</span> Related records</h2></div><div class="quick-links"><button type="button" class="quick-link" t-on-click="() => this.related('staff')">Staff directory <span>→</span></button><button type="button" class="quick-link" t-on-click="() => this.balances()">Leave policy &amp; balances <span>→</span></button><button type="button" class="quick-link" t-on-click="() => this.related('attendance')">Staff attendance <span>→</span></button><button type="button" class="quick-link" t-on-click="() => this.related('calendar')">Campus calendar <span>→</span></button></div></div></div></div></section>
<section t-if="view === 'notices'"><div class="heading"><div><h1>Notices &amp; circulars</h1><p class="subtitle">Draft and publish official Principal notices.</p></div><button class="btn primary" t-on-click="openNotices">Manage notices</button></div><div class="panel"><div class="table-wrap"><table><thead><tr><th>Notice</th><th>Audience</th><th>Status</th><th>Date</th><th>Action</th></tr></thead><tbody><tr t-foreach="state.data.notices || []" t-as="row" t-key="row.id"><td t-esc="row.name"/><td t-esc="row.audience"/><td t-esc="row.state"/><td t-esc="date(row.date)"/><td><button class="btn" t-on-click="() => this.openNotice(row.id)">Open</button></td></tr><tr t-if="!state.data.notices?.length"><td colspan="5" class="empty">No saved Principal notices.</td></tr></tbody></table></div></div></section><footer class="foot"><t t-esc="state.data.company"/> · Principal workspace · Saved college records</footer></t></t></div><div t-if="state.modal" class="modal-backdrop" t-on-click="backdropClick"><section class="modal" role="dialog" aria-modal="true" aria-labelledby="principal-modal-title" t-ref="dialog" t-on-keydown="modalKeys">
<div class="modal-head"><h2 id="principal-modal-title" t-esc="modalTitle"/><button class="btn" aria-label="Close review" t-on-click="closeModal" t-att-disabled="state.saving">×</button></div>
<div class="modal-body"><t t-if="state.modal.balances"><p class="note">Balances are calculated from the connected Odoo leave allocations. A dash means the category does not require an allocation.</p><div class="balance-list"><div t-foreach="staffBalances" t-as="row" t-key="row.key" class="summary"><strong t-esc="row.name"/><br/><t t-esc="row.type"/> · <t t-esc="row.balance === null ? 'No allocation required' : row.balance + ' days remaining'"/></div><p t-if="!staffBalances.length" class="empty">No assigned staff leave balances to display.</p></div></t>
<t t-else=""><t t-set="row" t-value="state.modal.row"/><div class="summary"><strong t-esc="row.subject"/><p t-esc="row.name"/><p t-if="row.code"><t t-esc="row.code"/> · <t t-esc="row.department || row.venue || ''"/></p><p t-if="row.from"><t t-esc="date(row.from)"/> – <t t-esc="date(row.to)"/><t t-if="row.days"> · <t t-esc="row.days"/> day(s)</t></p><p t-esc="row.reason"/><p t-if="row.kind === 'staff'"><strong>Leave balance: </strong><t t-esc="row.balance === null ? 'No allocation required' : row.balance + ' days'"/><br/><t t-esc="row.designation"/></p><p t-if="row.kind === 'student'"><strong>Advisor: </strong><t t-esc="row.advisor"/> · Recommended<br/><strong>HoD: </strong><t t-esc="row.hod"/> · Recommended</p><p t-if="row.recommendation"><strong>Recommendation: </strong><t t-esc="row.recommendation"/></p><p t-if="row.coverage"><strong>Coverage: </strong><t t-esc="row.coverage"/></p><p t-if="row.details" t-esc="row.details"/><p t-if="row.kind === 'event'"><strong>Budget: </strong><t t-esc="money(row.budget)"/> · <t t-esc="row.funding"/><br/><strong>Planning checks: </strong><t t-esc="row.readiness"/><br/><t t-esc="row.safety"/></p><div class="attachments"><a t-foreach="row.attachments || []" t-as="file" t-key="file.id" t-att-href="file.url" target="_blank" rel="noopener" t-esc="file.name"/></div></div>
<t t-if="!state.modal.readonly"><div><label for="principal-outcome">Principal decision</label><select id="principal-outcome" t-model="state.outcome" t-att-disabled="state.saving"><option value="approved">Approve request</option><option value="rejected">Reject request</option><option t-if="row.kind === 'event'" value="changes">Request changes</option></select></div><div><label for="principal-remark">Decision remark <span style="color:#b33c4a">*</span></label><textarea id="principal-remark" rows="3" t-model="state.remark" t-att-disabled="state.saving" placeholder="Enter approval note or reason for rejection…" required="required"/></div></t>
<t t-else=""><p class="note"><strong>Status: </strong><t t-esc="statusLabel(row.status,row.kind)"/></p><div t-foreach="state.data.history.filter(item => item.kind === row.kind &amp;&amp; item.source_id === row.id)" t-as="item" t-key="item.id" class="summary"><strong t-esc="statusLabel(item.outcome)"/> · <t t-esc="item.actor"/><br/><t t-esc="timestamp(item.at)"/><p t-esc="item.remark"/></div></t></t><div t-if="state.modalError" class="notice-error" role="alert" t-esc="state.modalError"/></div>
<div class="modal-foot"><button class="btn" t-on-click="closeModal" t-att-disabled="state.saving" t-esc="state.modal.readonly || state.modal.balances ? 'Close' : 'Cancel'"/><button t-if="!state.modal.readonly &amp;&amp; !state.modal.balances" class="btn primary" t-on-click="saveDecision" t-att-disabled="state.saving" t-esc="state.saving ? 'Saving…' : 'Save decision'"/></div></section></div></main></t></templates>
