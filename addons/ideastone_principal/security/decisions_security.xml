<odoo>
  <record id="acl_principal_decision_log" model="ir.model.access"><field name="name">Principal decision history</field><field name="model_id" ref="model_ideastone_principal_decision_log"/><field name="group_id" ref="group_principal"/><field name="perm_read" eval="True"/></record>
  <record id="rule_decision_log_company" model="ir.rule"><field name="name">Own Principal decision evidence</field><field name="model_id" ref="model_ideastone_principal_decision_log"/><field name="global" eval="True"/><field name="domain_force">[('company_id','in',company_ids),('decided_by_id','=',user.id)]</field></record>
  <record id="acl_event_proposal_user" model="ir.model.access"><field name="name">Event proposal participants</field><field name="model_id" ref="model_ideastone_principal_event_proposal"/><field name="group_id" ref="base.group_user"/><field name="perm_read" eval="True"/><field name="perm_write" eval="True"/><field name="perm_create" eval="True"/><field name="perm_unlink" eval="True"/></record>
  <record id="rule_event_proposal_company" model="ir.rule"><field name="name">Event proposal college</field><field name="model_id" ref="model_ideastone_principal_event_proposal"/><field name="global" eval="True"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
  <record id="rule_event_proposal_participant" model="ir.rule"><field name="name">Event proposal participants</field><field name="model_id" ref="model_ideastone_principal_event_proposal"/><field name="groups" eval="[(4,ref('base.group_user'))]"/><field name="domain_force">['|','|',('requester_id','=',user.id),('coordinator_id','=',user.id),('principal_id','=',user.id)]</field></record>
  <record id="acl_principal_hr_leave_read" model="ir.model.access"><field name="name">Principal assigned leave read</field><field name="model_id" ref="hr_holidays.model_hr_leave"/><field name="group_id" ref="group_principal"/><field name="perm_read" eval="True"/></record>
  <record id="rule_principal_hr_leave_read" model="ir.rule"><field name="name">Principal assigned leave records</field><field name="model_id" ref="hr_holidays.model_hr_leave"/><field name="groups" eval="[(4,ref('group_principal'))]"/><field name="domain_force">[('principal_reviewer_id','=',user.id),('employee_id.company_id','in',company_ids)]</field></record>
  <record id="acl_principal_hr_attendance_read" model="ir.model.access"><field name="name">Principal college attendance read</field><field name="model_id" ref="hr_attendance.model_hr_attendance"/><field name="group_id" ref="group_principal"/><field name="perm_read" eval="True"/></record>
  <record id="rule_principal_hr_attendance_read" model="ir.rule"><field name="name">Principal college attendance</field><field name="model_id" ref="hr_attendance.model_hr_attendance"/><field name="groups" eval="[(4,ref('group_principal'))]"/><field name="domain_force">[('employee_id.company_id','in',company_ids)]</field></record>
</odoo>
