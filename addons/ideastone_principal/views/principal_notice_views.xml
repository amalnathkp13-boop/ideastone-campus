<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_principal_notice_tree" model="ir.ui.view">
    <field name="name">ideastone.principal.notice.tree</field>
    <field name="model">ideastone.principal.notice</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="audience"/>
        <field name="author_id"/>
        <field name="published_on"/>
        <field name="state" widget="badge"/>
      </tree>
    </field>
  </record>
  <record id="view_principal_notice_form" model="ir.ui.view">
    <field name="name">ideastone.principal.notice.form</field>
    <field name="model">ideastone.principal.notice</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_publish" type="object" string="Publish" class="oe_highlight" invisible="state != 'draft'"/>
          <button name="action_archive" type="object" string="Archive" invisible="state != 'published'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,published,archived"/>
        </header>
        <sheet>
          <group>
            <field name="name" readonly="state != 'draft'"/>
            <field name="audience" readonly="state != 'draft'"/>
            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
            <field name="author_id"/>
            <field name="published_on"/>
          </group>
          <field name="body" readonly="state != 'draft'"/>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="action_principal_notices" model="ir.actions.act_window">
    <field name="name">Notices &amp; Circulars</field>
    <field name="res_model">ideastone.principal.notice</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>
