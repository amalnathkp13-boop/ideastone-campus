<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_principal_notice_tree" model="ir.ui.view">
    <field name="name">ideastone.principal.notice.tree</field>
    <field name="model">ideastone.principal.notice</field>
    <field name="arch" type="xml">
      <tree>
        <field name="reference"/>
        <field name="name"/>
        <field name="audience"/>
        <field name="author_id"/>
        <field name="published_on"/>
        <field name="state" widget="badge"/>
      </tree>
    </field>
  </record>
  <record id="view_principal_notice_form" model="ir.ui.view">
    <field name="name">ideastone.principal.notice.form</field>
    <field name="model">ideastone.principal.notice</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_submit" type="object" string="Submit for approval" class="oe_highlight" invisible="state not in ('draft', 'returned')"/>
          <button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="state != 'pending'"/>
          <button name="action_archive" type="object" string="Archive" invisible="state not in ('published', 'scheduled')"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,pending,scheduled,published,returned,archived"/>
        </header>
        <sheet>
          <group>
            <field name="reference"/>
            <field name="name" readonly="state not in ('draft', 'returned')"/>
            <field name="audience" readonly="state not in ('draft', 'returned')"/>
            <field name="office" readonly="state not in ('draft', 'returned')"/>
            <field name="publish_at" readonly="state not in ('draft', 'returned')"/>
            <field name="expires_at" readonly="state not in ('draft', 'returned')"/>
            <field name="return_note" invisible="not return_note"/>
            <field name="company_id" groups="base.group_multi_company" readonly="state not in ('draft', 'returned')"/>
            <field name="author_id"/>
            <field name="published_on"/>
          </group>
          <field name="body" readonly="state not in ('draft', 'returned')"/>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="action_principal_notices" model="ir.actions.act_window">
    <field name="name">Notices &amp; Circulars</field>
    <field name="res_model">ideastone.principal.notice</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>
