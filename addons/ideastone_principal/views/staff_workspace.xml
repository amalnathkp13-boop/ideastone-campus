<odoo>
  <record id="staff_application_sequence" model="ir.sequence"><field name="name">Staff applications</field><field name="code">principal.staff.application</field><field name="prefix">APP-</field><field name="padding">5</field><field name="company_id" eval="False"/></record>
  <record id="staff_application_company_rule" model="ir.rule"><field name="name">Recruitment applications by college</field><field name="model_id" ref="model_ideastone_principal_staff_application"/><field name="global" eval="True"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="staff_application_form" model="ir.ui.view"><field name="name">principal.staff.application.form</field><field name="model">ideastone.principal.staff.application</field><field name="arch" type="xml"><form string="Staff application"><header>
    <button name="action_schedule_interview" type="object" string="Schedule interview" invisible="state != 'pending'"/>
    <button name="action_approve" type="object" string="Approve" class="oe_highlight" groups="ideastone_principal.group_principal" invisible="state not in ['pending','interview']"/>
    <button name="action_reject" type="object" string="Reject" groups="ideastone_principal.group_principal" invisible="state not in ['pending','interview']"/>
    <field name="state" widget="statusbar" statusbar_visible="pending,interview,approved,rejected"/>
  </header><sheet><h1><field name="name" placeholder="Applicant name" readonly="state in ['approved','rejected']"/></h1><group>
    <group><field name="reference"/><field name="staff_type" readonly="state in ['approved','rejected']"/><field name="role" readonly="state in ['approved','rejected']"/><field name="department_id" domain="[('company_id','in',[False,company_id])]" readonly="state in ['approved','rejected']"/><field name="company_id" readonly="1"/></group>
    <group><field name="qualification" readonly="state in ['approved','rejected']"/><field name="experience" readonly="state in ['approved','rejected']"/><field name="documents" readonly="state in ['approved','rejected']"/><field name="interview_date" readonly="state in ['approved','rejected']"/></group>
  </group><group><field name="review" readonly="state in ['approved','rejected']"/><field name="attachment_ids" widget="many2many_binary" readonly="state in ['approved','rejected']"/><field name="decision_note" readonly="state in ['approved','rejected']"/><field name="decided_by_id"/><field name="decided_on"/></group></sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div></form></field></record>
  <record id="staff_application_tree" model="ir.ui.view"><field name="name">principal.staff.application.tree</field><field name="model">ideastone.principal.staff.application</field><field name="arch" type="xml"><tree><field name="reference"/><field name="name"/><field name="staff_type"/><field name="role"/><field name="department_id"/><field name="documents"/><field name="interview_date"/><field name="state" widget="badge"/></tree></field></record>
  <record id="action_staff_application_records" model="ir.actions.act_window"><field name="name">Staff applications</field><field name="res_model">ideastone.principal.staff.application</field><field name="view_mode">tree,form</field><field name="domain">[('company_id','=',allowed_company_ids[0])]</field></record>
  <record id="action_staff_directory" model="ir.actions.client"><field name="name">Staff directory</field><field name="tag">ideastone_principal.staff_directory</field><field name="context">{'campus_module':'staff'}</field></record>
  <record id="action_staff_applications" model="ir.actions.client"><field name="name">New staff applications</field><field name="tag">ideastone_principal.staff_workspace</field><field name="params">{'view':'applications'}</field><field name="context">{'campus_module':'staff'}</field></record>
  <record id="action_staff_payroll" model="ir.actions.client"><field name="name">Payroll History</field><field name="tag">ideastone_principal.staff_workspace</field><field name="params">{'view':'payroll'}</field><field name="context">{'campus_module':'staff'}</field></record>
</odoo>
