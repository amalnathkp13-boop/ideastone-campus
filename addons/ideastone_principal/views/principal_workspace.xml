<odoo>
  <record id="action_principal_overview" model="ir.actions.client">
    <field name="name">Principal overview</field>
    <field name="tag">ideastone_principal.workspace</field>
    <field name="params">{'view': 'overview'}</field>
    <field name="context">{'campus_module': 'home'}</field>
  </record>
  <record id="action_principal_decisions" model="ir.actions.client">
    <field name="name">Principal decisions</field>
    <field name="tag">ideastone_principal.workspace</field>
    <field name="params">{'view': 'decisions'}</field>
    <field name="context">{'campus_module': 'decisions'}</field>
  </record>
  <record id="action_principal_notices_workspace" model="ir.actions.client">
    <field name="name">Principal notices</field>
    <field name="tag">ideastone_principal.notices</field>
    <field name="params">{'view': 'notices'}</field>
    <field name="context">{'campus_module': 'principal_notices'}</field>
  </record>
  <menuitem id="menu_principal_root" name="Principal" sequence="3" groups="group_principal"
            action="action_principal_overview" web_icon="ideastone_campus,static/description/icon.png"/>
  <menuitem id="menu_principal_overview" name="Overview" parent="menu_principal_root"
            action="action_principal_overview" sequence="1"/>
  <menuitem id="menu_principal_decisions" name="Decisions" parent="menu_principal_root"
            action="action_principal_decisions" sequence="2"/>
  <menuitem id="menu_principal_notices" name="Notices" parent="menu_principal_root"
            action="action_principal_notices_workspace" sequence="3"/>
  <menuitem id="menu_principal_my_requests" name="My principal requests"
            parent="ideastone_erp.menu_operations" action="action_principal_my_requests"
            sequence="80" groups="base.group_user"/>
</odoo>
