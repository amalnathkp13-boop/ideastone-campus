<odoo>
  <record id="action_principal_staff_leave" model="ir.actions.client"><field name="name">Staff leave approvals</field><field name="tag">ideastone_principal.workspace</field><field name="params">{'view':'staff'}</field><field name="context">{'campus_module':'decisions'}</field></record>
  <record id="action_principal_student_leave" model="ir.actions.client"><field name="name">Student leave approvals</field><field name="tag">ideastone_principal.workspace</field><field name="params">{'view':'student'}</field><field name="context">{'campus_module':'decisions'}</field></record>
  <record id="action_principal_events" model="ir.actions.client"><field name="name">Event management</field><field name="tag">ideastone_principal.workspace</field><field name="params">{'view':'events'}</field><field name="context">{'campus_module':'decisions'}</field></record>
  <record id="view_principal_event_tree" model="ir.ui.view"><field name="name">Principal event proposals</field><field name="model">ideastone.principal.event.proposal</field><field name="arch" type="xml"><tree><field name="name"/><field name="organizer"/><field name="date_start"/><field name="venue"/><field name="budget"/><field name="state" widget="badge"/></tree></field></record>
  <record id="view_principal_event_form" model="ir.ui.view"><field name="name">Principal event proposal</field><field name="model">ideastone.principal.event.proposal</field><field name="arch" type="xml"><form>
    <header><button name="action_submit" type="object" string="Submit proposal" class="oe_highlight" invisible="not can_submit"/><button name="action_forward" type="object" string="Forward to Principal" class="oe_highlight" invisible="not can_forward"/><field name="state" widget="statusbar"/></header>
    <sheet><field name="can_edit" invisible="True"/><field name="can_submit" invisible="True"/><field name="can_forward" invisible="True"/><group><group><field name="name" readonly="not can_edit"/><field name="company_id" groups="base.group_multi_company"/><field name="requester_id"/><field name="coordinator_id" readonly="not can_edit"/><field name="principal_id" readonly="not can_edit"/><field name="organizer" readonly="not can_edit"/></group><group><field name="date_start" readonly="not can_edit"/><field name="date_end" readonly="not can_edit"/><field name="venue" readonly="not can_edit"/><field name="audience" readonly="not can_edit"/><field name="attendees" readonly="not can_edit"/><field name="budget" readonly="not can_edit"/><field name="currency_id" invisible="True"/><field name="funding" readonly="not can_edit"/></group></group>
    <group><field name="purpose" readonly="not can_edit"/><field name="safety_plan" readonly="not can_edit"/><field name="venue_checked" readonly="not can_edit"/><field name="budget_checked" readonly="not can_edit"/><field name="safety_checked" readonly="not can_edit"/><field name="recommendation" readonly="not can_edit"/><field name="calendar_event_id" readonly="True"/></group></sheet><chatter/>
  </form></field></record>
  <record id="action_principal_event_proposals" model="ir.actions.act_window"><field name="name">Event proposals</field><field name="res_model">ideastone.principal.event.proposal</field><field name="view_mode">tree,form</field><field name="context">{'campus_module':'decisions'}</field></record>
  <menuitem id="menu_my_event_proposals" name="Event proposals" parent="ideastone_erp.menu_operations" action="action_principal_event_proposals" sequence="81" groups="base.group_user"/>
  <record id="view_hr_leave_principal_details" model="ir.ui.view"><field name="name">Staff leave Principal routing</field><field name="model">hr.leave</field><field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Principal review" groups="hr_holidays.group_hr_holidays_user"><field name="principal_reviewer_id"/><field name="principal_recommendation"/><field name="principal_coverage"/></group></xpath></field></record>
  <record id="view_company_principal_leave_route" model="ir.ui.view"><field name="name">College Principal leave routing</field><field name="model">res.company</field><field name="inherit_id" ref="base.view_company_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Principal leave routing" groups="base.group_system"><field name="principal_leave_reviewer_id" domain="[('company_ids','in',[id])]"/></group></xpath></field></record>
  <record id="view_student_leave_principal_details" model="ir.ui.view"><field name="name">Student leave supporting details</field><field name="model">campus.student.leave</field><field name="inherit_id" ref="ideastone_erp.view_student_leave_form"/><field name="arch" type="xml"><field name="reason" position="after"><field name="principal_leave_category" readonly="state != 'draft'"/><field name="principal_supporting_details" readonly="state != 'draft'"/></field></field></record>
</odoo>
