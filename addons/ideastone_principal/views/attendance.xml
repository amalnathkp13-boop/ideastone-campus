        <field name="name">Attendance Overview</field>
        <field name="tag">ideastone_principal.attendance</field>
        <field name="params" eval="{'tab': 'overview'}"/>
        <field name="context">{'campus_module': 'attendance'}</field>
    </record>
    <record id="action_attendance_faculty" model="ir.actions.client">
        <field name="name">Faculty Attendance</field>
        <field name="tag">ideastone_principal.attendance</field>
        <field name="params" eval="{'tab': 'faculty'}"/>
        <field name="context">{'campus_module': 'attendance'}</field>
    </record>
    <record id="action_attendance_students" model="ir.actions.client">
        <field name="name">Student Attendance</field>
        <field name="tag">ideastone_principal.attendance</field>
        <field name="params" eval="{'tab': 'students'}"/>
        <field name="context">{'campus_module': 'attendance'}</field>
    </record>
</odoo>
